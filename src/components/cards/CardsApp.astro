---

---

<div
  class="device-frame-wrapper w-full h-full flex justify-center items-center"
>
  <div class="device-frame">
    <!-- Pantalla del dispositivo -->
    <div class="device-screen relative bg-white overflow-hidden flex flex-col">
      <!-- Status Bar -->
      <div
        class="relative z-20 shrink-0 h-[44px] flex items-center justify-between px-6 pt-2"
      >
        <!-- Time -->
        <div
          class="text-[15px] font-semibold text-black w-[54px] text-center tracking-tight"
        >
          9:41
        </div>

        <!-- Dynamic Island -->
        <div
          class="absolute left-1/2 -translate-x-1/2 top-[11px] h-[36px] w-[120px] bg-black rounded-[24px]"
        >
        </div>

        <!-- Status Icons -->
        <div class="flex items-center justify-end gap-1.5 text-black w-[54px]">
          <!-- Signal -->
          <svg width="18" height="12" viewBox="0 0 18 12" fill="currentColor">
            <path
              d="M1.5 8.5C1.5 8.22386 1.72386 8 2 8H3.5C3.77614 8 4 8.22386 4 8.5V11.5C4 11.7761 3.77614 12 3.5 12H2C1.72386 12 1.5 11.7761 1.5 11.5V8.5Z"
            ></path>
            <path
              d="M5.5 5.5C5.5 5.22386 5.72386 5 6 5H7.5C7.77614 5 8 5.22386 8 5.5V11.5C8 11.7761 7.77614 12 7.5 12H6C5.72386 12 5.5 11.7761 5.5 11.5V5.5Z"
            ></path>
            <path
              d="M9.5 2.5C9.5 2.22386 9.72386 2 10 2H11.5C11.7761 2 12 2.22386 12 2.5V11.5C12 11.7761 11.7761 12 11.5 12H10C9.72386 12 9.5 11.7761 9.5 11.5V2.5Z"
            ></path>
            <path
              d="M13.5 0.5C13.5 0.223858 13.7239 0 14 0H15.5C15.7761 0 16 0.223858 16 0.5V11.5C16 11.7761 15.7761 12 15.5 12H14C13.7239 12 13.5 11.7761 13.5 11.5V0.5Z"
            ></path>
          </svg>
          <!-- Wifi -->
          <svg
            width="16"
            height="12"
            viewBox="0 0 16 12"
            fill="currentColor"
            class="ml-0.5"
          >
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M8 1.5C4.94389 1.5 2.14626 2.61053 0.0503023 4.45339C-0.103061 4.58826 -0.011831 4.83515 0.177651 4.89674C0.792556 5.09657 1.44226 5.29747 2.06227 5.4851C2.19069 5.52396 2.33129 5.4988 2.43477 5.41944C4.01358 4.20857 5.94042 3.5 8 3.5C10.0596 3.5 11.9864 4.20857 13.5652 5.41944C13.6687 5.4988 13.8093 5.52396 13.9377 5.4851C14.5577 5.29747 15.2074 5.09657 15.8223 4.89674C16.0118 4.83515 16.1031 4.58826 15.9497 4.45339C13.8537 2.61053 11.0561 1.5 8 1.5ZM8 5.5C6.46328 5.5 5.04576 6.00762 3.88658 6.8778C3.78505 6.95402 3.7663 7.098 3.84478 7.19912L7.69707 12.1623C7.84852 12.3574 8.15148 12.3574 8.30293 12.1623L12.1552 7.19912C12.2337 7.098 12.215 6.95402 12.1134 6.8778C10.9542 6.00762 9.53672 5.5 8 5.5Z"
            ></path>
          </svg>
          <!-- Battery -->
          <div
            class="relative w-[25px] h-[12px] border-[1px] border-black/30 rounded-[3px] ml-1"
          >
            <div
              class="absolute top-0 bottom-0 left-0 bg-black rounded-[1px] m-[1.5px]"
              style="width: 18px;"
            >
            </div>
            <div
              class="absolute top-[3px] -right-[1.5px] w-[1.5px] h-[4px] bg-black/30 rounded-r-[1px]"
            >
            </div>
          </div>
        </div>
      </div>

      <!-- Header -->
      <div
        class="relative px-6 py-2 flex shrink-0 items-center justify-between z-20 bg-white"
      >
        <button
          class="text-sm text-gray-500 font-medium flex items-center gap-1 transition-opacity hover:text-gray-900 cursor-pointer"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg
          >
          back
        </button>
        <!-- Logo centered -->
        <div
          class="absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 w-20 flex justify-center"
        >
          <img
            src="/images/zelify_logo.png"
            alt="Zelify"
            class="h-6 object-contain"
          />
        </div>
        <div class="w-10"></div>
      </div>

      <!-- Main Content -->
      <div
        class="flex-1 flex flex-col relative overflow-hidden bg-[#F2F4F8] pb-[80px]"
      >
        <!-- Card Image Area -->
        <div
          class="flex-shrink-0 px-6 py-8 flex justify-center relative z-10 mt-2"
        >
          <div
            class="relative w-full max-w-[320px] shadow-2xl rounded-3xl overflow-hidden"
          >
            <!-- Simulated Card Image -->
            <div
              class="w-full aspect-[1.586/1] relative bg-[#001E3C] rounded-2xl p-6 text-white flex flex-col justify-between overflow-hidden"
            >
              <!-- Background Pattern -->
              <div
                class="absolute inset-0 opacity-20 pointer-events-none"
                style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 20px 20px;"
              >
              </div>

              <div class="flex justify-between items-start z-10">
                <!-- Chip -->
                <div class="flex items-center gap-3">
                  <svg
                    width="40"
                    height="30"
                    viewBox="0 0 40 30"
                    fill="none"
                    stroke="#FFFFFF"
                    stroke-opacity="0.6"
                    stroke-width="1.5"
                  >
                    <rect x="0.75" y="0.75" width="38.5" height="28.5" rx="4.25"
                    ></rect>
                    <path d="M12 1V29"></path>
                    <path d="M28 1V29"></path>
                    <path d="M0 15H40"></path>
                    <path d="M12 10C12 10 16 10 16 14C16 18 12 18 12 18"></path>
                  </svg>
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#4ade80"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12.55a11 11 0 0 1 14.08 0"></path>
                    <path d="M1.42 9a16 16 0 0 1 21.16 0"></path>
                    <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
                  </svg>
                </div>
                <!-- Brand -->
                <div class="flex items-center gap-2">
                  <span class="text-[#84cc16] font-bold text-xl">7</span>
                  <span class="font-semibold text-lg tracking-wide">Zelify</span
                  >
                </div>
              </div>

              <div class="z-10 mt-auto">
                <p class="text-xs text-gray-300 font-medium mb-1">
                  Valentina Duarte
                </p>
                <div class="flex justify-between items-end">
                  <p class="font-mono text-lg tracking-widest opacity-90">
                    **** **** **** 1234
                  </p>
                  <!-- Mastercard Logo -->
                  <div class="flex -space-x-4">
                    <div class="w-8 h-8 rounded-full bg-[#EB001B] opacity-80">
                    </div>
                    <div class="w-8 h-8 rounded-full bg-[#F79E1B] opacity-80">
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Horizontal Actions Container -->
        <div class="flex-shrink-0 w-full px-5 isolate mt-4">
          <div
            class="flex flex-row items-center justify-center w-full"
            id="actions-container"
          >
            <!-- 1. Number (Blue) -->
            <div
              class="action-item relative flex items-center justify-center cursor-pointer overflow-hidden transition-all duration-300 z-[60] shadow-sm select-none"
              data-id="number"
              style="height: 60px; min-width: 60px; border-radius: 18px; border: 4px solid #F2F4F8; background-color: #002A8F; color: white; margin-left: 0px;"
            >
              <div
                class="flex flex-col items-center justify-center w-full gap-1 px-1"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  class="transition-transform duration-300"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="2" y="5" width="20" height="14" rx="2"></rect><line
                    x1="2"
                    y1="10"
                    x2="22"
                    y2="10"></line></svg
                >
                <span
                  class="text-[10px] font-bold tracking-wide label-text block"
                  >Number</span
                >
              </div>
            </div>

            <!-- 2. Wallet -->
            <div
              class="action-item relative flex items-center justify-center cursor-pointer overflow-hidden transition-all duration-300 z-[50] shadow-sm select-none"
              data-id="wallet"
              style="height: 60px; width: 60px; border-radius: 18px; border: 4px solid #F2F4F8; background-color: #E2E4EA; color: #9CA3AF; margin-left: -18px;"
            >
              <div class="flex flex-col items-center justify-center w-full">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="2" y="4" width="20" height="16" rx="2"></rect><line
                    x1="2"
                    y1="10"
                    x2="22"
                    y2="10"></line></svg
                >
                <span
                  class="text-[10px] font-bold tracking-wide label-text hidden"
                  >Wallet</span
                >
              </div>
            </div>

            <!-- 3. Add -->
            <div
              class="action-item relative flex items-center justify-center cursor-pointer overflow-hidden transition-all duration-300 z-[40] shadow-sm select-none"
              data-id="freeze"
              style="height: 60px; width: 60px; border-radius: 18px; border: 4px solid #F2F4F8; background-color: #E2E4EA; color: #9CA3AF; margin-left: -18px;"
            >
              <div class="flex flex-col items-center justify-center w-full">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><line x1="12" y1="5" x2="12" y2="19"></line><line
                    x1="5"
                    y1="12"
                    x2="19"
                    y2="12"></line></svg
                >
                <span
                  class="text-[10px] font-bold tracking-wide label-text hidden"
                  >Add</span
                >
              </div>
            </div>

            <!-- 4. Security -->
            <div
              class="action-item relative flex items-center justify-center cursor-pointer overflow-hidden transition-all duration-300 z-[30] shadow-sm select-none"
              data-id="security"
              style="height: 60px; width: 60px; border-radius: 18px; border: 4px solid #F2F4F8; background-color: #E2E4EA; color: #9CA3AF; margin-left: -18px;"
            >
              <div class="flex flex-col items-center justify-center w-full">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                  ></path><path d="M9 12l2 2 4-4"></path></svg
                >
                <span
                  class="text-[10px] font-bold tracking-wide label-text hidden"
                  >Security</span
                >
              </div>
            </div>

            <!-- 5. More -->
            <div
              class="action-item relative flex items-center justify-center cursor-pointer overflow-hidden transition-all duration-300 z-[20] shadow-sm select-none"
              data-id="more"
              style="height: 60px; width: 60px; border-radius: 18px; border: 4px solid #F2F4F8; background-color: #E2E4EA; color: #9CA3AF; margin-left: -18px;"
            >
              <div class="flex flex-col items-center justify-center w-full">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><circle cx="12" cy="12" r="1"></circle><circle
                    cx="19"
                    cy="12"
                    r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg
                >
                <span
                  class="text-[10px] font-bold tracking-wide label-text hidden"
                  >More</span
                >
              </div>
            </div>

            <!-- 6. Lock -->
            <div
              class="action-item relative flex items-center justify-center cursor-pointer overflow-hidden transition-all duration-300 z-[10] shadow-sm select-none"
              data-id="lock"
              style="height: 60px; width: 60px; border-radius: 18px; border: 4px solid #F2F4F8; background-color: #E2E4EA; color: #9CA3AF; margin-left: -18px;"
            >
              <div class="flex flex-col items-center justify-center w-full">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="3" y="11" width="18" height="11" rx="2" ry="2"
                  ></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
                >
                <span
                  class="text-[10px] font-bold tracking-wide label-text hidden"
                  >Lock</span
                >
              </div>
            </div>
          </div>
        </div>

        <!-- Static Text Info -->
        <div class="px-8 mt-10 space-y-4">
          <div class="flex justify-between items-center">
            <span class="text-sm font-medium text-gray-500">Card Type</span>
            <span class="text-base font-semibold text-gray-900"
              >Virtual Credit</span
            >
          </div>
          <div class="flex justify-between items-center">
            <span class="text-sm font-medium text-gray-500">Account</span>
            <span class="text-base font-semibold text-gray-900">Credit</span>
          </div>
        </div>
      </div>

      <!-- Bottom Sheet -->
      <div
        id="bottom-sheet"
        class="absolute bottom-0 left-0 right-0 z-[100] transition-transform duration-500 cubic-bezier(0.32, 0.72, 0, 1) translate-y-0"
        style="height: 380px; will-change: transform;"
      >
        <!-- Actual Card Shape -->
        <div
          class="w-full h-full bg-white rounded-t-[32px] shadow-[0_-10px_40px_rgba(0,0,0,0.1)] flex flex-col relative"
        >
          <!-- Header Area (Draggable) -->
          <div
            id="sheet-header"
            class="w-full h-[80px] flex items-center justify-center flex-shrink-0 cursor-grab active:cursor-grabbing relative"
          >
            <!-- Collapse/Expand Icon & Title -->
            <div class="flex flex-col items-center gap-1">
              <!-- Chevron -->
              <div class="w-full flex justify-center pt-2">
                <svg
                  id="sheet-arrow"
                  class="w-6 h-6 text-gray-400 transition-transform duration-300"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M5 15l7-7 7 7"></path>
                </svg>
              </div>
              <span
                id="sheet-title"
                class="text-[15px] font-medium text-gray-600">Card details</span
              >
            </div>

            <!-- Drag Indicator Pill (Optional, but good for UX) -->
            <div
              class="absolute bottom-2 w-[134px] h-[5px] bg-gray-300/50 rounded-full"
            >
            </div>
          </div>

          <!-- Content (Scrollable) -->
          <div
            class="flex-1 overflow-y-auto px-6 pb-6"
            id="sheet-content-area"
            style="opacity: 0.3; pointer-events: none; transition: opacity 0.3s;"
          >
            <!-- Content is injected via JS depending on active tab -->
            <div id="content-number" class="w-full space-y-4">
              <div class="space-y-4">
                <div
                  class="flex justify-between items-center py-2 border-b border-gray-100"
                >
                  <span class="text-sm text-gray-500">Número de Tarjeta</span>
                  <span
                    class="text-sm font-bold text-gray-900 font-mono tracking-wide"
                    >**** **** **** 1234</span
                  >
                </div>
                <div
                  class="flex justify-between items-center py-2 border-b border-gray-100"
                >
                  <span class="text-sm text-gray-500">Vencimiento</span>
                  <span class="text-sm font-bold text-gray-900">12/25</span>
                </div>
              </div>
            </div>

            <div id="content-wallet" class="w-full space-y-4 hidden">
              <div class="space-y-4 pt-2">
                <div class="bg-gray-50 rounded-2xl p-5 space-y-4">
                  <div class="flex justify-between items-center">
                    <span class="text-sm font-medium text-gray-600"
                      >Gastado hoy</span
                    >
                    <span class="text-base font-bold text-[#002A8F]"
                      >$122,20</span
                    >
                  </div>
                  <div
                    class="w-full h-2 bg-gray-200 rounded-full overflow-hidden"
                  >
                    <div
                      class="h-full bg-[#002A8F] rounded-full"
                      style="width: 35%;"
                    >
                    </div>
                  </div>
                  <div class="flex justify-between text-xs text-gray-400">
                    <span>$0</span>
                    <span>$3,000 limit</span>
                  </div>
                </div>
              </div>
            </div>

            <div id="content-freeze" class="w-full space-y-4 hidden">
              <div class="space-y-4 pt-2">
                <div
                  class="flex items-center justify-between p-4 bg-gray-50 rounded-2xl"
                >
                  <div class="flex items-center gap-3">
                    <div
                      class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600"
                    >
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><line x1="12" y1="5" x2="12" y2="19"></line><line
                          x1="5"
                          y1="12"
                          x2="19"
                          y2="12"></line></svg
                      >
                    </div>
                    <span class="text-sm font-medium text-gray-900"
                      >Añadir Saldo</span
                    >
                  </div>
                  <svg
                    width="20"
                    height="20"
                    class="text-gray-400"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><polyline points="9 18 15 12 9 6"></polyline></svg
                  >
                </div>
              </div>
            </div>

            <div id="content-security" class="w-full space-y-4 hidden">
              <div class="space-y-4 pt-2">
                <div class="flex items-center justify-between py-2">
                  <span class="text-sm text-gray-600">Autenticación 2FA</span>
                  <div
                    class="w-10 h-6 bg-green-500 rounded-full relative cursor-pointer"
                  >
                    <div
                      class="absolute right-1 top-1 w-4 h-4 bg-white rounded-full shadow-sm"
                    >
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div id="content-more" class="w-full space-y-4 hidden">
              <div class="grid grid-cols-2 gap-4 pt-2">
                <div
                  class="bg-gray-50 p-4 rounded-xl flex flex-col items-center gap-2"
                >
                  <svg
                    class="text-gray-600 w-6 h-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><path d="M3 12h18M3 6h18M3 18h18"></path></svg
                  >
                  <span class="text-xs font-semibold">Historial</span>
                </div>
                <div
                  class="bg-gray-50 p-4 rounded-xl flex flex-col items-center gap-2"
                >
                  <svg
                    class="text-gray-600 w-6 h-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><path d="M12 20h9"></path><path
                      d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                    ></path></svg
                  >
                  <span class="text-xs font-semibold">Editar</span>
                </div>
              </div>
            </div>

            <div id="content-lock" class="w-full space-y-4 hidden">
              <div class="text-center py-6">
                <div
                  class="w-16 h-16 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-4"
                >
                  <svg
                    width="32"
                    height="32"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><rect x="3" y="11" width="18" height="11" rx="2" ry="2"
                    ></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
                  >
                </div>
                <h3 class="text-lg font-bold text-gray-900 mb-2">
                  Bloquear Tarjeta
                </h3>
                <p class="text-sm text-gray-500 mb-6">
                  Nadie podrá usar esta tarjeta temporalmente.
                </p>
                <button
                  class="w-full bg-[#FF3B30] text-white font-bold py-3 rounded-xl shadow-lg shadow-red-200 active:scale-95 transition-transform"
                  >Confirmar Bloqueo</button
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const actions = document.querySelectorAll(".action-item");
    const sheet = document.getElementById("bottom-sheet");
    const sheetHeader = document.getElementById("sheet-header");
    const sheetArrow = document.getElementById("sheet-arrow");
    const sheetContentArea = document.getElementById("sheet-content-area");
    const sheetTitle = document.getElementById("sheet-title");

    // State
    let activeId = "number";

    // Bottom Sheet Physics Constants
    const SHEET_COLLAPSED_TRANSLATE = "calc(100% - 80px)"; // Only show header (80px)
    const SHEET_EXPANDED_TRANSLATE = "0px";
    let isExpanded = false;

    // Action Data
    const actionData = {
      number: { title: "Card details", label: "Number" },
      wallet: { title: "Wallet Status", label: "Wallet" },
      freeze: { title: "Add Balance", label: "Add" },
      security: { title: "Security Settings", label: "Security" },
      more: { title: "More Options", label: "More" },
      lock: { title: "Lock Card", label: "Lock" },
    };

    // Styling constants
    const ACTIVE_BG = "#002A8F";
    const INACTIVE_BG = "#E2E4EA";
    const ACTIVE_COLOR = "white";
    const INACTIVE_COLOR = "#9CA3AF";
    const ACTIVE_WIDTH = "95px";
    const INACTIVE_WIDTH = "60px";

    // Initialize Sheet Position
    if (sheet)
      sheet.style.transform = `translateY(${SHEET_COLLAPSED_TRANSLATE})`;

    function updateActionUI(selectedId) {
      activeId = selectedId;
      const selectedIndex = Array.from(actions).findIndex(
        (el) => el.getAttribute("data-id") === selectedId,
      );

      actions.forEach((el, index) => {
        const id = el.getAttribute("data-id");
        const isActive = id === selectedId;
        const dist = Math.abs(selectedIndex - index);

        // Z-Index hierarchy: Active is top, neighbors are below
        const zIndex = 100 - dist;
        el.style.zIndex = zIndex.toString();

        if (isActive) {
          el.style.width = ACTIVE_WIDTH;
          el.style.backgroundColor = ACTIVE_BG;
          el.style.color = ACTIVE_COLOR;
          el.style.transform = "scale(1.05)";
          el.style.marginLeft = index === 0 ? "0px" : "-15px";

          // Show label
          const label = el.querySelector(".label-text");
          if (label) {
            label.classList.remove("hidden");
            label.classList.add("block");
          }
        } else {
          el.style.width = INACTIVE_WIDTH;
          el.style.backgroundColor = INACTIVE_BG;
          el.style.color = INACTIVE_COLOR;
          el.style.transform = "scale(1)";
          el.style.marginLeft = index === 0 ? "0px" : "-18px";

          // Hide label
          const label = el.querySelector(".label-text");
          if (label) {
            label.classList.add("hidden");
            label.classList.remove("block");
          }
        }
      });

      // Update Content
      ["number", "wallet", "freeze", "security", "more", "lock"].forEach(
        (key) => {
          const c = document.getElementById(`content-${key}`);
          if (c) c.classList.add("hidden");
        },
      );
      const currentContent = document.getElementById(`content-${selectedId}`);
      if (currentContent) currentContent.classList.remove("hidden");

      if (isExpanded && sheetTitle) {
        const titlesES = {
          number: "Card details",
          wallet: "Estado",
          freeze: "Añadir Saldo",
          security: "Seguridad",
          more: "Más Opciones",
          lock: "Bloquear",
        };
        sheetTitle.innerText = titlesES[selectedId];
      } else if (sheetTitle) {
        sheetTitle.innerText = "Card details";
      }
    }

    // Toggle Sheet State
    function setSheetState(expanded) {
      isExpanded = expanded;
      if (isExpanded) {
        sheet.style.transform = `translateY(${SHEET_EXPANDED_TRANSLATE})`;
        sheetArrow.style.transform = "rotate(180deg)";
        sheetContentArea.style.opacity = "1";
        sheetContentArea.style.pointerEvents = "auto";

        const titlesES = {
          number: "Card details",
          wallet: "Estado",
          freeze: "Añadir Saldo",
          security: "Seguridad",
          more: "Más Opciones",
          lock: "Bloquear",
        };
        if (sheetTitle) sheetTitle.innerText = titlesES[activeId];
      } else {
        sheet.style.transform = `translateY(${SHEET_COLLAPSED_TRANSLATE})`;
        sheetArrow.style.transform = "rotate(0deg)";
        sheetContentArea.style.opacity = "0.3";
        sheetContentArea.style.pointerEvents = "none";
        if (sheetTitle) sheetTitle.innerText = "Card details";
      }
    }

    // Click on Header toggles
    if (sheetHeader) {
      sheetHeader.addEventListener("click", () => {
        setSheetState(!isExpanded);
      });

      // Touch / Drag Logic
      let startY = 0;
      let currentY = 0;
      let isDragging = false;

      sheetHeader.addEventListener(
        "touchstart",
        (e) => {
          startY = e.touches[0].clientY;
          isDragging = true;
          sheet.style.transition = "none";
        },
        { passive: true },
      );

      document.addEventListener(
        "touchmove",
        (e) => {
          if (!isDragging) return;
          currentY = e.touches[0].clientY;
          const deltaY = currentY - startY;

          if (isExpanded) {
            if (deltaY < 0) return;
            sheet.style.transform = `translateY(${deltaY}px)`;
          }
        },
        { passive: true },
      );

      document.addEventListener("touchend", (e) => {
        if (!isDragging) return;
        isDragging = false;
        sheet.style.transition =
          "transform 0.5s cubic-bezier(0.32, 0.72, 0, 1)";

        const deltaY = currentY - startY;
        const threshold = 50;

        if (isExpanded) {
          if (deltaY > threshold) {
            setSheetState(false);
          } else {
            setSheetState(true);
          }
        } else {
          if (deltaY < -threshold) {
            // Drag up to open
            setSheetState(true);
          } else {
            setSheetState(false);
          }
        }
      });
    }

    // Action Click Listeners
    actions.forEach((action) => {
      action.addEventListener("click", () => {
        const id = action.getAttribute("data-id");
        updateActionUI(id);
        if (isExpanded) {
          const titlesES = {
            number: "Card details",
            wallet: "Estado",
            freeze: "Añadir Saldo",
            security: "Seguridad",
            more: "Más Opciones",
            lock: "Bloquear",
          };
          if (sheetTitle) sheetTitle.innerText = titlesES[id];
        }
      });
    });

    // Initialize
    updateActionUI("number");
  });
</script>

<style>
  /* Custom Styles if needed beyond Tailwind */
  .device-frame-wrapper {
    perspective: 1000px;
  }
</style>
