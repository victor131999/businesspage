---
import DeviceFrame from "../DeviceFrame.astro";
---

<DeviceFrame>
  <!-- Header -->
  <div
    class="relative px-6 py-2 flex shrink-0 items-center justify-between z-20 bg-white"
  >
    <button
      class="text-sm text-gray-500 font-medium flex items-center gap-1 transition-opacity hover:text-gray-900 cursor-pointer"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg
      >
      Atrás
    </button>
    <!-- Logo centered -->
    <div
      class="absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 w-20 flex justify-center"
    >
      <img
        src="/images/zelify_logo.png"
        alt="Zelify"
        class="h-6 object-contain"
      />
    </div>
    <div class="w-10"></div>
  </div>

  <!-- Main Content -->
  <div class="flex-1 flex flex-col relative overflow-hidden bg-white pb-[80px]">
    <!-- Card Image Area -->
    <div class="flex-shrink-0 px-6 py-8 flex justify-center relative z-10 mt-2">
      <div
        class="relative w-full max-w-[320px] shadow-2xl rounded-3xl overflow-hidden"
      >
        <!-- Simulated Card Image -->
        <div
          class="w-full aspect-[1.586/1] relative bg-[#001E3C] rounded-2xl p-6 text-white flex flex-col justify-between overflow-hidden"
        >
          <!-- Background Pattern -->
          <div
            class="absolute inset-0 opacity-20 pointer-events-none"
            style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 20px 20px;"
          >
          </div>

          <div class="flex justify-between items-start z-10">
            <!-- Chip -->
            <div class="flex items-center gap-3">
              <svg
                width="40"
                height="30"
                viewBox="0 0 40 30"
                fill="none"
                stroke="#FFFFFF"
                stroke-opacity="0.6"
                stroke-width="1.5"
              >
                <rect x="0.75" y="0.75" width="38.5" height="28.5" rx="4.25"
                ></rect>
                <path d="M12 1V29"></path>
                <path d="M28 1V29"></path>
                <path d="M0 15H40"></path>
                <path d="M12 10C12 10 16 10 16 14C16 18 12 18 12 18"></path>
              </svg>
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#4ade80"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12.55a11 11 0 0 1 14.08 0"></path>
                <path d="M1.42 9a16 16 0 0 1 21.16 0"></path>
                <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
              </svg>
            </div>
            <!-- Brand -->
            <div class="flex items-center gap-2">
              <span class="text-[#84cc16] font-bold text-xl">7</span>
              <span class="font-semibold text-lg tracking-wide">Zelify</span>
            </div>
          </div>

          <div class="z-10 mt-auto">
            <p class="text-xs text-gray-300 font-medium mb-1">
              Valentina Duarte
            </p>
            <div class="flex justify-between items-end">
              <p class="font-mono text-lg tracking-widest opacity-90">
                **** **** **** 1234
              </p>
              <!-- Mastercard Logo -->
              <div class="flex -space-x-4">
                <div class="w-8 h-8 rounded-full bg-[#EB001B] opacity-80"></div>
                <div class="w-8 h-8 rounded-full bg-[#F79E1B] opacity-80"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Horizontal Actions Container -->
    <div class="flex-shrink-0 w-full px-5 isolate mt-4">
      <div
        class="flex flex-row items-center justify-center w-full"
        id="actions-container"
      >
        <!-- 1. Number (Blue) -->
        <div
          class="action-item relative flex items-center justify-center cursor-pointer overflow-hidden transition-all duration-300 z-[60] shadow-sm select-none"
          data-id="number"
          style="height: 60px; min-width: 60px; border-radius: 18px; border: 4px solid #F2F4F8; background-color: #002A8F; color: white; margin-left: 0px;"
        >
          <div
            class="flex flex-col items-center justify-center w-full gap-1 px-1"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              class="transition-transform duration-300"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="2" y="5" width="20" height="14" rx="2"></rect><line
                x1="2"
                y1="10"
                x2="22"
                y2="10"></line></svg
            >
            <span class="text-[10px] font-bold tracking-wide label-text block"
              >Número</span
            >
          </div>
        </div>

        <!-- 2. Wallet -->
        <div
          class="action-item relative flex items-center justify-center cursor-pointer overflow-hidden transition-all duration-300 z-[50] shadow-sm select-none"
          data-id="wallet"
          style="height: 60px; width: 60px; border-radius: 18px; border: 4px solid #F2F4F8; background-color: #E2E4EA; color: #9CA3AF; margin-left: -18px;"
        >
          <div class="flex flex-col items-center justify-center w-full">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="2" y="4" width="20" height="16" rx="2"></rect><line
                x1="2"
                y1="10"
                x2="22"
                y2="10"></line></svg
            >
            <span class="text-[10px] font-bold tracking-wide label-text hidden"
              >Billetera</span
            >
          </div>
        </div>

        <!-- 3. Add -->
        <div
          class="action-item relative flex items-center justify-center cursor-pointer overflow-hidden transition-all duration-300 z-[40] shadow-sm select-none"
          data-id="freeze"
          style="height: 60px; width: 60px; border-radius: 18px; border: 4px solid #F2F4F8; background-color: #E2E4EA; color: #9CA3AF; margin-left: -18px;"
        >
          <div class="flex flex-col items-center justify-center w-full">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><line x1="12" y1="5" x2="12" y2="19"></line><line
                x1="5"
                y1="12"
                x2="19"
                y2="12"></line></svg
            >
            <span class="text-[10px] font-bold tracking-wide label-text hidden"
              >Congelar</span
            >
          </div>
        </div>

        <!-- 4. Security -->
        <div
          class="action-item relative flex items-center justify-center cursor-pointer overflow-hidden transition-all duration-300 z-[30] shadow-sm select-none"
          data-id="security"
          style="height: 60px; width: 60px; border-radius: 18px; border: 4px solid #F2F4F8; background-color: #E2E4EA; color: #9CA3AF; margin-left: -18px;"
        >
          <div class="flex flex-col items-center justify-center w-full">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
              ></path><path d="M9 12l2 2 4-4"></path></svg
            >
            <span class="text-[10px] font-bold tracking-wide label-text hidden"
              >Seguridad</span
            >
          </div>
        </div>

        <!-- 5. More -->
        <div
          class="action-item relative flex items-center justify-center cursor-pointer overflow-hidden transition-all duration-300 z-[20] shadow-sm select-none"
          data-id="more"
          style="height: 60px; width: 60px; border-radius: 18px; border: 4px solid #F2F4F8; background-color: #E2E4EA; color: #9CA3AF; margin-left: -18px;"
        >
          <div class="flex flex-col items-center justify-center w-full">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="1"></circle><circle
                cx="19"
                cy="12"
                r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg
            >
            <span class="text-[10px] font-bold tracking-wide label-text hidden"
              >Más</span
            >
          </div>
        </div>

        <!-- 6. Lock -->
        <div
          class="action-item relative flex items-center justify-center cursor-pointer overflow-hidden transition-all duration-300 z-[10] shadow-sm select-none"
          data-id="lock"
          style="height: 60px; width: 60px; border-radius: 18px; border: 4px solid #F2F4F8; background-color: #E2E4EA; color: #9CA3AF; margin-left: -18px;"
        >
          <div class="flex flex-col items-center justify-center w-full">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="3" y="11" width="18" height="11" rx="2" ry="2"
              ></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
            >
            <span class="text-[10px] font-bold tracking-wide label-text hidden"
              >Bloquear</span
            >
          </div>
        </div>
      </div>
    </div>

    <!-- Static Text Info -->
    <div class="px-8 mt-10 space-y-4">
      <div class="flex justify-between items-center">
        <span class="text-sm font-medium text-gray-500">Tipo de Tarjeta</span>
        <span class="text-base font-semibold text-gray-900"
          >Crédito Virtual</span
        >
      </div>
      <div class="flex justify-between items-center">
        <span class="text-sm font-medium text-gray-500">Cuenta</span>
        <span class="text-base font-semibold text-gray-900">Crédito</span>
      </div>
    </div>
  </div>

  <!-- Bottom Sheet -->
  <div
    id="bottom-sheet"
    class="absolute bottom-0 left-0 right-0 z-[100] transition-transform duration-500 cubic-bezier(0.32, 0.72, 0, 1) translate-y-0"
    style="height: 380px; will-change: transform;"
  >
    <!-- Actual Card Shape -->
    <div
      class="w-full h-full bg-white/30 backdrop-blur-xl border-t border-white/40 rounded-t-[32px] shadow-[0_-10px_40px_rgba(0,0,0,0.15)] flex flex-col relative"
    >
      <!-- Header Area (Draggable) -->
      <div
        id="sheet-header"
        class="w-full h-[80px] flex items-center justify-center flex-shrink-0 cursor-grab active:cursor-grabbing relative"
      >
        <!-- Collapse/Expand Icon & Title -->
        <div class="flex flex-col items-center gap-1">
          <!-- Chevron -->
          <div class="w-full flex justify-center pt-2">
            <svg
              id="sheet-arrow"
              class="w-6 h-6 text-gray-400 transition-transform duration-300"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M5 15l7-7 7 7"></path>
            </svg>
          </div>
          <span id="sheet-title" class="text-[15px] font-medium text-gray-600"
            >Detalle de tarjeta</span
          >
        </div>

        <!-- Drag Indicator Pill (Optional, but good for UX) -->
        <div
          class="absolute bottom-2 w-[134px] h-[5px] bg-gray-300/50 rounded-full"
        >
        </div>
      </div>

      <!-- Content (Scrollable) -->
      <div
        class="flex-1 overflow-y-auto px-6 pb-6"
        id="sheet-content-area"
        style="opacity: 0.3; pointer-events: none; transition: opacity 0.3s;"
      >
        <!-- Content is injected via JS depending on active tab -->
        <div id="content-number" class="w-full space-y-4">
          <div class="space-y-3">
            <div class="flex justify-between items-center py-2">
              <span class="text-xs text-gray-500">Número de tarjeta</span>
              <span
                class="text-sm font-semibold text-gray-900 font-mono tracking-wide"
                >**** **** **** 1234</span
              >
            </div>
            <div class="flex justify-between items-center py-2">
              <span class="text-xs text-gray-500">Fecha de expiración</span>
              <span class="text-sm font-semibold text-gray-900">12/25</span>
            </div>

            <div class="flex justify-between items-start pt-1">
              <span class="text-xs text-gray-500 pt-3">CVV</span>
              <div class="flex flex-col items-end gap-2">
                <div class="relative flex items-center justify-center">
                  <svg class="transform -rotate-90" width="60" height="60">
                    <circle
                      cx="30"
                      cy="30"
                      r="20"
                      stroke="#e5e7eb"
                      stroke-width="3"
                      fill="none"></circle>
                    <circle
                      id="cvv-circle"
                      cx="30"
                      cy="30"
                      r="20"
                      stroke="#22c55e"
                      stroke-width="3"
                      fill="none"
                      class="transition-all duration-1000 ease-linear"
                      stroke-dasharray="125.66"
                      stroke-dashoffset="0"
                      stroke-linecap="round"></circle>
                  </svg>
                  <div
                    class="absolute inset-0 flex items-center justify-center"
                  >
                    <span
                      id="cvv-text"
                      class="text-lg font-bold font-mono transition-colors duration-300 text-[#22c55e]"
                      >123</span
                    >
                  </div>
                </div>
                <p
                  class="text-[10px] text-gray-400 text-right max-w-[150px] leading-tight"
                >
                  Este CVV se actualiza cada 30 segundos
                </p>
              </div>
            </div>
          </div>
        </div>

        <div id="content-wallet" class="w-full space-y-4 hidden">
          <div class="space-y-3">
            <div class="flex justify-between items-center py-2">
              <span class="text-xs text-gray-500">Gastado hoy</span>
              <span class="text-sm font-semibold text-gray-900">$450.00</span>
            </div>
            <div class="flex justify-between items-center py-2">
              <span class="text-xs text-gray-500">Límite diario</span>
              <span class="text-sm font-semibold text-gray-900">$1,000.00</span>
            </div>
            <div class="flex justify-between items-center py-2">
              <span class="text-xs text-gray-500">Disponible</span>
              <span class="text-sm font-semibold text-gray-900">$550.00</span>
            </div>
          </div>
        </div>

        <div id="content-freeze" class="w-full space-y-4 hidden">
          <div class="space-y-3">
            <div class="flex justify-between items-center py-2">
              <span class="text-xs text-gray-500">Estado</span>
              <span class="text-sm font-semibold text-green-500">Activa</span>
            </div>
            <div class="flex justify-between items-center py-2">
              <span class="text-xs text-gray-500">Última congelación</span>
              <span class="text-sm font-semibold text-gray-900">Nunca</span>
            </div>
            <div class="flex justify-between items-center py-2">
              <span class="text-xs text-gray-500">Puede congelar</span>
              <span class="text-sm font-semibold text-gray-900">Sí</span>
            </div>
          </div>
        </div>

        <div id="content-security" class="w-full space-y-4 hidden">
          <div class="space-y-3">
            <div class="flex justify-between items-center py-2">
              <span class="text-xs text-gray-500">Verificación 2FA</span>
              <span class="text-sm font-semibold text-green-500">Activada</span>
            </div>
            <div class="flex justify-between items-center py-2">
              <span class="text-xs text-gray-500">Notificaciones</span>
              <span class="text-sm font-semibold text-gray-900">Activada</span>
            </div>
            <div class="flex justify-between items-center py-2">
              <span class="text-xs text-gray-500">Último acceso</span>
              <span class="text-sm font-semibold text-gray-900"
                >Hace 2 horas</span
              >
            </div>
          </div>
        </div>

        <div id="content-more" class="w-full space-y-4 hidden">
          <div class="space-y-3">
            <div class="flex justify-between items-center py-2">
              <span class="text-xs text-gray-500">Configuración</span>
              <span class="text-sm font-semibold text-gray-900">Disponible</span
              >
            </div>
            <div class="flex justify-between items-center py-2">
              <span class="text-xs text-gray-500">Historial</span>
              <span class="text-sm font-semibold text-gray-900">Ver todo</span>
            </div>
            <div class="flex justify-between items-center py-2">
              <span class="text-xs text-gray-500">Soporte</span>
              <span class="text-sm font-semibold text-gray-900">Contactar</span>
            </div>
          </div>
        </div>

        <div id="content-lock" class="w-full space-y-4 hidden">
          <div class="space-y-3">
            <!-- Current Status -->
            <div class="flex justify-between items-center py-2">
              <span class="text-xs text-gray-500">Estado actual</span>
              <span class="text-sm font-semibold text-green-500"
                >Desbloqueada</span
              >
            </div>

            <!-- Info Box -->
            <div class="bg-gray-50 rounded-2xl p-4 space-y-3 mb-4">
              <p class="text-xs text-gray-500 leading-relaxed">
                Al bloquear tu tarjeta, se desactivarán todas las transacciones
                hasta que la desbloquees nuevamente.
              </p>

              <div class="space-y-2">
                <div class="flex items-start gap-2">
                  <svg
                    class="w-3.5 h-3.5 text-gray-400 mt-0.5 shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span class="text-xs text-gray-500"
                    >Las transacciones pendientes se completarán</span
                  >
                </div>
                <div class="flex items-start gap-2">
                  <svg
                    class="w-3.5 h-3.5 text-gray-400 mt-0.5 shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span class="text-xs text-gray-500"
                    >Puedes desbloquearla en cualquier momento</span
                  >
                </div>
                <div class="flex items-start gap-2">
                  <svg
                    class="w-3.5 h-3.5 text-gray-400 mt-0.5 shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span class="text-xs text-gray-500"
                    >No se generarán cargos adicionales</span
                  >
                </div>
              </div>
            </div>

            <!-- Button -->
            <button
              class="w-full bg-[#E11D48] hover:bg-[#BE123C] text-white font-bold py-3 rounded-xl shadow-lg shadow-red-200/50 active:scale-95 transition-all text-sm mt-2"
            >
              Bloquear tarjeta
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</DeviceFrame>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const actions = document.querySelectorAll(".action-item");
    const sheet = document.getElementById("bottom-sheet");
    const sheetHeader = document.getElementById("sheet-header");
    const sheetArrow = document.getElementById("sheet-arrow");
    const sheetContentArea = document.getElementById("sheet-content-area");
    const sheetTitle = document.getElementById("sheet-title");

    // State
    let activeId = "number";

    // --- Dynamic CVV Logic ---
    const TOTAL_TIME = 30;
    let timeLeft = TOTAL_TIME;
    let cvvInterval: any;

    function generateCVV() {
      return Math.floor(100 + Math.random() * 900).toString();
    }

    function getCVVColor(percentage: any) {
      if (percentage > 0.5) return "#22c55e"; // green-500
      if (percentage > 0.25) return "#eab308"; // yellow-500
      return "#ef4444"; // red-500
    }

    function updateCVV() {
      const circle = document.getElementById("cvv-circle");
      const text = document.getElementById("cvv-text");

      if (!circle || !text) return;

      const percentage = timeLeft / TOTAL_TIME;
      const circumference = 125.66; // 2 * PI * 20
      const strokeDashoffset = circumference - percentage * circumference;
      const color = getCVVColor(percentage);

      circle.style.strokeDashoffset = strokeDashoffset.toString();
      circle.setAttribute("stroke", color);

      text.style.color = color;

      // Update text content only when reset to avoid flickering,
      // effectively handled by state reset logic but ensuring consistency here if needed
    }

    function startCVVTimer() {
      const text = document.getElementById("cvv-text");
      if (text) text.innerText = generateCVV();

      updateCVV();

      if (cvvInterval) clearInterval(cvvInterval as any);

      cvvInterval = setInterval(() => {
        timeLeft -= 1;

        if (timeLeft < 0) {
          // Should reset
          timeLeft = TOTAL_TIME;
          if (text) text.innerText = generateCVV();
        }

        updateCVV();
      }, 1000);
    }

    // Start Logic
    startCVVTimer();

    // Bottom Sheet Physics Constants
    const SHEET_COLLAPSED_TRANSLATE = "calc(100% - 80px)"; // Only show header (80px)
    const SHEET_EXPANDED_TRANSLATE = "0px";
    let isExpanded = false;

    // Action Data
    const actionData = {
      number: { title: "Detalle de tarjeta", label: "Número" },
      wallet: { title: "Estado de billetera", label: "Billetera" },
      freeze: { title: "Estado de congelación", label: "Congelar" },
      security: { title: "Configuración de seguridad", label: "Seguridad" },
      more: { title: "Más opciones", label: "Más" },
      lock: { title: "Bloquear Tarjeta", label: "Bloquear" },
    };

    // Styling constants
    const ACTIVE_BG = "#002A8F";
    const INACTIVE_BG = "#E2E4EA";
    const ACTIVE_COLOR = "white";
    const INACTIVE_COLOR = "#9CA3AF";
    const ACTIVE_WIDTH = "95px";
    const INACTIVE_WIDTH = "60px";

    // Initialize Sheet Position
    // Initialize Sheet Position
    if (sheet)
      sheet.style.transform = `translateY(${SHEET_COLLAPSED_TRANSLATE})`;

    // Define Titles Map Interface
    interface TitlesMap {
      [key: string]: string;
    }

    const titlesES: TitlesMap = {
      number: "Detalle de tarjeta",
      wallet: "Detalle de consumo diario",
      freeze: "Estado de congelación",
      security: "Configuración de seguridad",
      more: "Mas opciones",
      lock: "Bloquear tarjeta",
    };

    function updateActionUI(selectedId: string) {
      activeId = selectedId;
      const selectedIndex = Array.from(actions).findIndex(
        (el) => el.getAttribute("data-id") === selectedId,
      );

      actions.forEach((el, index) => {
        const element = el as HTMLElement;
        const id = element.getAttribute("data-id");
        const isActive = id === selectedId;
        const dist = Math.abs(selectedIndex - index);

        // Z-Index hierarchy
        const zIndex = 100 - dist;
        element.style.zIndex = zIndex.toString();

        if (isActive) {
          element.style.width = ACTIVE_WIDTH;
          element.style.backgroundColor = ACTIVE_BG;
          element.style.color = ACTIVE_COLOR;
          element.style.transform = "scale(1.05)";
          element.style.marginLeft = index === 0 ? "0px" : "-15px";

          // Show label
          const label = element.querySelector(".label-text");
          if (label) {
            label.classList.remove("hidden");
            label.classList.add("block");
          }
        } else {
          element.style.width = INACTIVE_WIDTH;
          element.style.backgroundColor = INACTIVE_BG;
          element.style.color = INACTIVE_COLOR;
          element.style.transform = "scale(1)";
          element.style.marginLeft = index === 0 ? "0px" : "-18px";

          // Hide label
          const label = element.querySelector(".label-text");
          if (label) {
            label.classList.add("hidden");
            label.classList.remove("block");
          }
        }
      });

      // Update Content
      Object.keys(titlesES).forEach((key) => {
        const c = document.getElementById(`content-${key}`);
        if (c) c.classList.add("hidden");
      });
      const currentContent = document.getElementById(`content-${selectedId}`);
      if (currentContent) currentContent.classList.remove("hidden");

      if (sheetTitle) {
        sheetTitle.innerText = titlesES[selectedId] || "Detalle de tarjeta";
      }
    }

    // Toggle Sheet State
    // Toggle Sheet State
    function setSheetState(expanded: boolean) {
      isExpanded = expanded;
      if (isExpanded) {
        if (sheet)
          sheet.style.transform = `translateY(${SHEET_EXPANDED_TRANSLATE})`;
        if (sheetArrow) sheetArrow.style.transform = "rotate(180deg)";
        if (sheetContentArea) {
          sheetContentArea.style.opacity = "1";
          sheetContentArea.style.pointerEvents = "auto";
        }

        const titlesES: TitlesMap = {
          number: "Detalle de tarjeta",
          wallet: "Detalle de consumo diario",
          freeze: "Estado de congelación",
          security: "Configuración de seguridad",
          more: "Mas opciones",
          lock: "Bloquear tarjeta",
        };
        if (sheetTitle)
          sheetTitle.innerText = titlesES[activeId] || "Detalle de tarjeta";
      } else {
        if (sheet)
          sheet.style.transform = `translateY(${SHEET_COLLAPSED_TRANSLATE})`;
        if (sheetArrow) sheetArrow.style.transform = "rotate(0deg)";
        if (sheetContentArea) {
          sheetContentArea.style.opacity = "0.3";
          sheetContentArea.style.pointerEvents = "none";
        }
      }
    }

    // Click on Header toggles
    if (sheetHeader) {
      sheetHeader.addEventListener("click", () => {
        setSheetState(!isExpanded);
      });

      // Touch / Drag Logic
      let startY = 0;
      let currentY = 0;
      let isDragging = false;

      sheetHeader.addEventListener(
        "touchstart",
        (e) => {
          startY = e.touches[0].clientY;
          isDragging = true;
          if (sheet) sheet.style.transition = "none";
        },
        { passive: true },
      );

      document.addEventListener(
        "touchmove",
        (e) => {
          if (!isDragging) return;
          currentY = e.touches[0].clientY;
          const deltaY = currentY - startY;

          if (isExpanded) {
            if (deltaY < 0) return;
            if (sheet) sheet.style.transform = `translateY(${deltaY}px)`;
          }
        },
        { passive: true },
      );

      document.addEventListener("touchend", (e) => {
        if (!isDragging) return;
        isDragging = false;
        if (sheet)
          sheet.style.transition =
            "transform 0.5s cubic-bezier(0.32, 0.72, 0, 1)";

        const deltaY = currentY - startY;
        const threshold = 50;

        if (isExpanded) {
          if (deltaY > threshold) {
            setSheetState(false);
          } else {
            setSheetState(true);
          }
        } else {
          if (deltaY < -threshold) {
            // Drag up to open
            setSheetState(true);
          } else {
            setSheetState(false);
          }
        }
      });
    }

    // Action Click Listeners
    actions.forEach((action) => {
      action.addEventListener("click", () => {
        const id = action.getAttribute("data-id");
        if (id) {
          updateActionUI(id);
        }
      });
    });

    // Initialize
    updateActionUI("number");
  });
</script>

<style>
  /* Custom Styles if needed beyond Tailwind */
  .device-frame-wrapper {
    perspective: 1000px;
  }
</style>
