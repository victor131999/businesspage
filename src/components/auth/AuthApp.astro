---
// Componente AuthApp - Dispositivo móvil con flujo de autenticación
---

<!-- Contenedor del dispositivo móvil -->
<div class="device-container">
  <!-- Frame del iPhone -->
  <div class="device-frame-wrapper">
    <div class="device-frame">
      <!-- Pantalla del dispositivo -->
      <div class="device-screen">
        <!-- Status Bar con Dynamic Island -->
        <div class="device-status-bar">
          <div class="status-time">9:41</div>
          <div class="dynamic-island">
            <div class="island-shape"></div>
            <div class="island-speaker"></div>
          </div>
          <div class="status-icons">
            <svg class="signal-icon" fill="none" viewBox="0 0 20 12">
              <path
                d="M1 8h2v2H1V8zm3-2h2v4H4V6zm3-2h2v6H7V4zm3-1h2v7h-2V3z"
                fill="currentColor"></path>
            </svg>
            <div class="battery-icon">
              <div class="battery-level"></div>
            </div>
          </div>
        </div>

        <!-- Contenido del dispositivo -->
        <div class="device-content">
          <!-- Header con back y logo -->
          <div class="device-header">
            <button class="device-back-btn" id="device-back-btn"
              >&lt; back</button
            >
            <div class="device-logo">
              <img src="/images/zelify_logo.png" alt="Zelify" />
            </div>
            <div class="device-header-spacer"></div>
          </div>

          <!-- Animación GIF según el paso -->
          <div class="device-animation">
            <img
              id="step-animation-1"
              src="/gift/ANIMACION 1.gif"
              alt="Auth animation step 1"
              style="display: block;"
            />
            <img
              id="step-animation-2"
              src="/gift/ANIMACION 1.gif"
              alt="Auth animation step 2"
              style="display: none;"
            />
            <img
              id="step-animation-3"
              src="/gift/ANIMACION 1.gif"
              alt="Auth animation step 3"
              style="display: none;"
            />
            <img
              id="step-animation-4"
              src="/gift/ANIMACION 1.gif"
              alt="Auth animation step 4"
              style="display: none;"
            />
            <img
              id="step-animation-5"
              src="/gift/ANIMACION 1.gif"
              alt="Auth animation step 5"
              style="display: none;"
            />
          </div>

          <!-- Tarjeta con fondo translúcido -->
          <div class="device-card">
            <div class="auth-phone-card">
              <!-- Indicador de progreso -->
              <div class="phone-card-dots">
                <span class="dot active"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
              </div>

              <h2 class="phone-card-title" id="step-title">Crear Cuenta</h2>
              <p class="phone-card-description" id="step-description">
                Ingresa tu nombre y correo electrónico para empezar. Te
                enviaremos un código de verificación.
              </p>

              <!-- Paso 1: Crear Cuenta -->
              <div id="step-1" class="auth-step">
                <form class="phone-card-form" id="form-step-1">
                  <div class="form-field">
                    <label>Nombre Completo<span class="required">*</span></label
                    >
                    <input
                      type="text"
                      id="fullName"
                      placeholder="John Doe"
                      required
                    />
                    <span class="field-error-message"></span>
                  </div>
                  <div class="form-field">
                    <label>Correo<span class="required">*</span></label>
                    <input
                      type="email"
                      id="email"
                      placeholder="email@example.com"
                      required
                    />
                    <span class="field-error-message"></span>
                  </div>
                  <button type="submit" class="btn-continuar">
                    Continuar →
                  </button>
                </form>
              </div>

              <div id="step-2" class="auth-step" style="display: none;">
                <form class="phone-card-form" id="form-step-2">
                  <div class="otp-wrapper">
                    <div class="otp-inputs" id="otp-email">
                      <!-- OTP Input 0 -->
                      <div class="otp-input-item" data-index="0">
                        <!-- SVG Border Overlay -->
                        <svg
                          class="otp-border-svg"
                          width="42"
                          height="48"
                          style="display: none;"
                        >
                          <rect
                            x="2"
                            y="2"
                            width="38"
                            height="44"
                            rx="10"
                            fill="none"
                            stroke="#213f8c"
                            stroke-width="2"
                            stroke-dasharray="140"
                            stroke-dashoffset="140"
                            stroke-linecap="round"
                            class="otp-border-rect"></rect>
                        </svg>
                        <!-- Checkmark Overlay -->
                        <div
                          class="otp-checkmark-overlay"
                          style="display: none;"
                        >
                          <svg
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="#213f8c"
                            stroke-width="3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path d="M20 6L9 17L4 12" class="otp-checkmark-path"
                            ></path>
                          </svg>
                        </div>
                        <!-- Error X Overlay -->
                        <div class="otp-error-overlay" style="display: none;">
                          <svg
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="#EF4444"
                            stroke-width="3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                          </svg>
                        </div>
                        <input
                          type="text"
                          class="otp-input"
                          maxlength="1"
                          inputmode="numeric"
                          data-index="0"
                        />
                      </div>
                      <!-- OTP Input 1 -->
                      <div class="otp-input-item" data-index="1">
                        <svg
                          class="otp-border-svg"
                          width="42"
                          height="48"
