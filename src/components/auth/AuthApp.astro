</style>

<script>
  // Estado del flujo
  let currentStep = 1;
  let formData: Record<string, any> = {};
  let validationErrors: Record<string, string> = {};
  let emailOTPStatus = "idle";
  let phoneOTPStatus = "idle";
  let currentLang = localStorage.getItem("ui-language") || "ES";

  // Inicializar OTP inputs
  function initOTPInputs(containerId: string) {
    const container = document.getElementById(containerId);
    if (!container) return;

    const inputs = container.querySelectorAll(
      ".otp-input",
    ) as NodeListOf<HTMLInputElement>;

    inputs.forEach((input, index) => {
      input.addEventListener("input", (e) => {
        const target = e.target as HTMLInputElement;
        const value = target.value.replace(/[^0-9]/g, "");
        target.value = value;

        if (value && index < inputs.length - 1) {
          (inputs[index + 1] as HTMLInputElement).focus();
        }
      });

      input.addEventListener("keydown", (e: Event) => {
        const keyboardEvent = e as KeyboardEvent;
        const target = e.target as HTMLInputElement;
        if (keyboardEvent.key === "Backspace" && !target.value && index > 0) {
          (inputs[index - 1] as HTMLInputElement).focus();
        }
      });

      input.addEventListener("paste", (e: Event) => {
        const clipboardEvent = e as ClipboardEvent;
        e.preventDefault();
        const pasted =
          clipboardEvent.clipboardData
            ?.getData("text")
            .replace(/[^0-9]/g, "")
            .slice(0, 6) || "";
        pasted.split("").forEach((char: string, i: number) => {
          if (inputs[i]) {
            (inputs[i] as HTMLInputElement).value = char;
          }
        });
        if (pasted.length === 6) {
          (inputs[5] as HTMLInputElement).focus();
        }
      });
    });
  }

  // Actualizar dots de progreso
  function updateProgressDots(step: number) {
    const dots = document.querySelectorAll(".phone-card-dots .dot");
    dots.forEach((dot, index) => {
      if (index < step) {
        dot.classList.add("active");
      } else {
        dot.classList.remove("active");
      }
    });
  }

  // Mostrar paso
  function showStep(step: number) {
    document.querySelectorAll(".auth-step").forEach((el, index) => {
      (el as HTMLElement).style.display = index + 1 === step ? "block" : "none";
    });

    // Cambiar animación según el paso
    for (let i = 1; i <= 5; i++) {
      const animation = document.getElementById(`step-animation-${i}`);
      if (animation) {
        (animation as HTMLElement).style.display =
          i === step ? "block" : "none";
      }
    }

    const titleEl = document.getElementById("step-title");
    const descEl = document.getElementById("step-description");
    const loginLink = document.getElementById("login-link");

    if (!titleEl || !descEl || !loginLink) return;

    // Aquí se pueden agregar las traducciones dinámicas
    const steps: Record<
      number,
      { title: string; desc?: string; descPrefix?: string }
    > = {
      1: {
        title: "Crear Cuenta",
        desc: "Ingresa tu nombre y correo electrónico para empezar. Te enviaremos un código de verificación.",
      },
      2: {
        title: "Verifica tu Correo",
        descPrefix: "Hemos enviado un código de 6 dígitos a<br /><strong>",
      },
      3: {
        title: "Agrega tu Teléfono",
        desc: "Te enviaremos un código de verificación por SMS para confirmar tu número de teléfono.",
      },
      4: {
        title: "Verifica tu Teléfono",
        descPrefix: "Hemos enviado un código de 6 dígitos a<br /><strong>",
      },
      5: {
        title: "Completa tu Perfil",
        desc: "Completa la información restante para finalizar la configuración de tu cuenta.",
      },
    };

    titleEl.textContent = steps[step].title;

    if (step === 2 && steps[step].descPrefix) {
      descEl.innerHTML =
        steps[step].descPrefix + (formData as any).email + "</strong>";
      loginLink.style.display = "none";
    } else if (step === 4 && steps[step].descPrefix) {
      descEl.innerHTML =
        steps[step].descPrefix + (formData as any).phone + "</strong>";
      loginLink.style.display = "none";
    } else {
      descEl.innerHTML = steps[step].desc || "";
      loginLink.style.display = step === 5 ? "block" : "none";
    }

    updateProgressDots(step);
    currentStep = step;
  }

  // Funciones de validación
  function validateFullName(name: string) {
    return name.trim().length >= 2;
  }

  function validateEmail(email: string) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function validatePhone(phone: string) {
    return phone.trim().length >= 10;
  }

  function validatePassword(password: string) {
    return password.length >= 8;
  }

  function showFieldError(fieldId: string, message: string) {
    validationErrors[fieldId] = message;
    const field = document.getElementById(fieldId) as HTMLInputElement | null;
    if (field) {
      field.classList.add("field-error");
      const errorEl = field.parentElement?.querySelector(
        ".field-error-message",
      ) as HTMLElement | null;
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.style.display = "block";
      }
    }
  }

  function clearFieldError(fieldId: string) {
    delete validationErrors[fieldId];
    const field = document.getElementById(fieldId) as HTMLInputElement | null;
    if (field) {
      field.classList.remove("field-error");
      const errorEl = field.parentElement?.querySelector(
        ".field-error-message",
      ) as HTMLElement | null;
      if (errorEl) {
        errorEl.style.display = "none";
      }
    }
  }

  function clearAllErrors() {
    Object.keys(validationErrors).forEach((key) => clearFieldError(key));
  }

  // Paso 1: Crear cuenta
  document.getElementById("form-step-1")?.addEventListener("submit", (e) => {
    e.preventDefault();
    clearAllErrors();

    const fullName = (
      document.getElementById("fullName") as HTMLInputElement
    ).value.trim();
    const email = (
      document.getElementById("email") as HTMLInputElement
    ).value.trim();

    let hasErrors = false;

    if (!validateFullName(fullName)) {
      showFieldError(
        "fullName",
        currentLang === "EN"
          ? "Name must be at least 2 characters"
          : "El nombre debe tener al menos 2 caracteres",
      );
      hasErrors = true;
    }

    if (!validateEmail(email)) {
      showFieldError(
        "email",
        currentLang === "EN" ? "Invalid email" : "Correo electrónico inválido",
      );
      hasErrors = true;
    }

    if (hasErrors) {
      return;
    }

    (formData as any).fullName = fullName;
    (formData as any).email = email;

    showStep(2);
    initOTPInputs("otp-email");
  });

  document.getElementById("fullName")?.addEventListener("input", () => {
    clearFieldError("fullName");
  });

  document.getElementById("email")?.addEventListener("input", () => {
    clearFieldError("email");
  });

  // Paso 2: Verificar email
  document.getElementById("form-step-2")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const inputs = document.querySelectorAll(
      "#otp-email .otp-input",
    ) as NodeListOf<HTMLInputElement>;
    const otp = Array.from(inputs)
      .map((input) => input.value)
      .join("");

    if (otp.length !== 6) {
      return;
    }

    emailOTPStatus = "verifying";
    updateOTPStatus("otp-email", "verifying");

    const isValid = otp === "202601";

    setTimeout(() => {
      if (isValid) {
        emailOTPStatus = "success";
        updateOTPStatus("otp-email", "success");
        (formData as any).emailOTP = otp;

        setTimeout(() => {
          emailOTPStatus = "idle";
          showStep(3);
        }, 3000);
      } else {
        emailOTPStatus = "error";
        updateOTPStatus("otp-email", "error");

        setTimeout(() => {
          emailOTPStatus = "idle";
          updateOTPStatus("otp-email", "idle");
          inputs.forEach((input) => (input.value = ""));
          inputs[0].focus();
        }, 2000);
      }
    }, 1000);
  });

  function updateOTPStatus(containerId: string, status: string) {
    const container = document.getElementById(containerId);
    if (!container) return;

    const items = container.querySelectorAll(".otp-input-item");
    const inputs = container.querySelectorAll(".otp-input");

    if (status === "verifying") {
      // Mostrar bordes animados en todos los items
      items.forEach((item) => {
        const svg = item.querySelector(".otp-border-svg") as HTMLElement;
        if (svg) {
          svg.style.display = "block";
          const rect = svg.querySelector(".otp-border-rect") as SVGRectElement;
          if (rect) {
            // Restart animation
            rect.style.animation = "none";
            setTimeout(() => {
              rect.style.animation = "borderDash 0.8s linear forwards";
            }, 10);
          }
        }
      });

      // Hacer transparente el borde del input
      inputs.forEach((input) => {
        (input as HTMLInputElement).style.borderColor = "transparent";
      });
    } else if (status === "success" || status === "error") {
      // Card stack collapse animation
      const centerIndex = (items.length - 1) / 2;
      const itemWidthWithGap = 48; // 42px width + 6px gap

      items.forEach((item, index) => {
        const translateX = (centerIndex - index) * itemWidthWithGap;
        const htmlItem = item as HTMLElement;

        // Apply transform and opacity transitions
        htmlItem.style.transition = `transform 1s cubic-bezier(0.2, 0, 0, 1) ${index * 120}ms, opacity 0.5s ease-out ${index * 120 + 600}ms`;
        htmlItem.style.transform = `translateX(${translateX}px)`;
        htmlItem.style.zIndex = (items.length - index + 10).toString();

        if (index !== 0) {
          htmlItem.style.opacity = "0";
        } else {
          htmlItem.style.opacity = "1";
          // Add glow effect to first item
          if (status === "success") {
            htmlItem.style.boxShadow = "0 0 15px #213f8c, 0 0 30px #213f8c66";
          } else {
            htmlItem.style.boxShadow = "0 0 15px #EF4444, 0 0 30px #EF444466";
          }
        }

        // Hide SVG borders during collapse
        const svg = item.querySelector(".otp-border-svg") as HTMLElement;
        if (svg) {
          svg.style.display = "block";
          // Set stroke color for error
          const rect = svg.querySelector(".otp-border-rect") as SVGRectElement;
          if (rect) {
            rect.setAttribute(
              "stroke",
              status === "error" ? "#EF4444" : "#213f8c",
            );
            rect.setAttribute("stroke-dashoffset", "0");
          }
        }

        // Fade out text on first item
        const input = item.querySelector(".otp-input") as HTMLInputElement;
        if (input && index === 0) {
          input.style.borderColor = "transparent";
          input.style.color = status === "error" ? "#EF4444" : "#213f8c";
        }
      });

      // Show checkmark or error X after collapse (1000ms + delay for first el)
      setTimeout(() => {
        const firstItem = items[0];
        if (status === "success") {
          const checkmarkOverlay = firstItem.querySelector(
            ".otp-checkmark-overlay",
          ) as HTMLElement;
          if (checkmarkOverlay) {
            checkmarkOverlay.style.display = "flex";
          }
        } else if (status === "error") {
          const errorOverlay = firstItem.querySelector(
            ".otp-error-overlay",
          ) as HTMLElement;
          if (errorOverlay) {
            errorOverlay.style.display = "flex";
          }
        }

        // Fade out input text
        const firstInput = firstItem.querySelector(
          ".otp-input",
        ) as HTMLInputElement;
        if (firstInput) {
          firstInput.style.opacity = "0.3";
        }
      }, 1000);
    } else if (status === "idle") {
      // Reset all animations and styles
      items.forEach((item, index) => {
        const htmlItem = item as HTMLElement;
        htmlItem.style.transform = "";
        htmlItem.style.opacity = "1";
        htmlItem.style.zIndex = "0";
        htmlItem.style.boxShadow = "none";

        // Hide overlays
        const svg = item.querySelector(".otp-border-svg") as HTMLElement;
        if (svg) svg.style.display = "none";

        const checkmark = item.querySelector(
          ".otp-checkmark-overlay",
        ) as HTMLElement;
        if (checkmark) checkmark.style.display = "none";

        const errorX = item.querySelector(".otp-error-overlay") as HTMLElement;
        if (errorX) errorX.style.display = "none";

        // Reset input styles
        const input = item.querySelector(".otp-input") as HTMLInputElement;
        if (input) {
          input.style.borderColor = "";
          input.style.color = "";
          input.style.opacity = "1";
        }
      });
    }
  }

  // Paso 3: Agregar teléfono
  document.getElementById("form-step-3")?.addEventListener("submit", (e) => {
    e.preventDefault();
    clearAllErrors();

    const phone = (
      document.getElementById("phone") as HTMLInputElement
    ).value.trim();

    if (!validatePhone(phone)) {
      showFieldError(
        "phone",
        currentLang === "EN"
          ? "Invalid phone number"
          : "Número de teléfono inválido",
      );
      return;
    }

    (formData as any).phone = phone;
    showStep(4);
    initOTPInputs("otp-phone");
  });

  document.getElementById("phone")?.addEventListener("input", () => {
    clearFieldError("phone");
  });

  // Paso 4: Verificar teléfono
  document.getElementById("form-step-4")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const inputs = document.querySelectorAll(
      "#otp-phone .otp-input",
    ) as NodeListOf<HTMLInputElement>;
    const otp = Array.from(inputs)
      .map((input) => input.value)
      .join("");

    if (otp.length !== 6) {
      return;
    }

    phoneOTPStatus = "verifying";
    updateOTPStatus("otp-phone", "verifying");

    const isValid = otp === "202601";

    setTimeout(() => {
      if (isValid) {
        phoneOTPStatus = "success";
        updateOTPStatus("otp-phone", "success");
        (formData as any).phoneOTP = otp;

        setTimeout(() => {
          phoneOTPStatus = "idle";
          showStep(5);
        }, 3000);
      } else {
        phoneOTPStatus = "error";
        updateOTPStatus("otp-phone", "error");

        setTimeout(() => {
          phoneOTPStatus = "idle";
          updateOTPStatus("otp-phone", "idle");
          inputs.forEach((input) => (input.value = ""));
          inputs[0].focus();
        }, 2000);
      }
    }, 1000);
  });

  // Paso 5: Completar perfil
  document.getElementById("form-step-5")?.addEventListener("submit", (e) => {
    e.preventDefault();
    clearAllErrors();

    const password = (document.getElementById("password") as HTMLInputElement)
      .value;
    const confirmPassword = (
      document.getElementById("confirmPassword") as HTMLInputElement
    ).value;

    let hasErrors = false;

    if (!validatePassword(password)) {
      showFieldError(
        "password",
        currentLang === "EN"
          ? "Password must be at least 8 characters"
          : "La contraseña debe tener al menos 8 caracteres",
      );
      hasErrors = true;
    }

    if (password !== confirmPassword) {
      showFieldError(
        "confirmPassword",
        currentLang === "EN"
          ? "Passwords do not match"
          : "Las contraseñas no coinciden",
      );
      hasErrors = true;
    }

    if (hasErrors) {
      return;
    }

    (formData as any).password = password;
    (formData as any).confirmPassword = confirmPassword;

    console.log("Registro completado", formData);
  });

  document.getElementById("password")?.addEventListener("input", () => {
    clearFieldError("password");
  });

  document.getElementById("confirmPassword")?.addEventListener("input", () => {
    clearFieldError("confirmPassword");
  });

  // Delegated listeners for resend links
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target && target.id === "resend-email") {
      e.preventDefault();
      console.log("Código reenviado a", (formData as any).email);
    }
    if (target && target.id === "resend-phone") {
      e.preventDefault();
      console.log("Código reenviado a", (formData as any).phone);
    }
  });

  // Back button functionality
  const backBtn = document.getElementById("device-back-btn");
  if (backBtn) {
    backBtn.addEventListener("click", () => {
      if (currentStep > 1) {
        // Reset OTP status when going back from OTP steps
        if (currentStep === 2) {
          emailOTPStatus = "idle";
          updateOTPStatus("otp-email", "idle");
        } else if (currentStep === 4) {
          phoneOTPStatus = "idle";
          updateOTPStatus("otp-phone", "idle");
        }

        showStep(currentStep - 1);
      }
    });
  }

  // Update back button visibility based on current step
  function updateBackButtonVisibility() {
    if (backBtn) {
      if (currentStep === 1) {
        backBtn.style.visibility = "hidden";
      } else {
        backBtn.style.visibility = "visible";
      }
    }
  }

  // Modify showStep to update back button visibility
  const originalShowStep = showStep;
  showStep = function (step: number) {
    originalShowStep(step);
    updateBackButtonVisibility();
  };

  // Country Selector functionality
  const countrySelectorBtn = document.getElementById("country-selector-btn");
  const countryDropdown = document.getElementById("country-dropdown");
  let selectedCountryCode = "+1";
  let selectedCountryFlag = "🇺🇸";

  if (countrySelectorBtn && countryDropdown) {
    // Toggle dropdown
    countrySelectorBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = countryDropdown.style.display === "block";
      countryDropdown.style.display = isOpen ? "none" : "block";
      countrySelectorBtn.setAttribute("aria-expanded", (!isOpen).toString());
    });

    // Select country
    const countryOptions = countryDropdown.querySelectorAll(".country-option");
    countryOptions.forEach((option) => {
      option.addEventListener("click", () => {
        const code = option.getAttribute("data-code") || "+1";
        const flag = option.getAttribute("data-flag") || "🇺🇸";

        selectedCountryCode = code;
        selectedCountryFlag = flag;

        // Update button
        const flagEl = countrySelectorBtn.querySelector(".country-flag");
        const codeEl = countrySelectorBtn.querySelector(".country-code");
        if (flagEl) flagEl.textContent = flag;
        if (codeEl) codeEl.textContent = code;

        // Update selected state
        countryOptions.forEach((opt) => opt.classList.remove("selected"));
        option.classList.add("selected");

        // Close dropdown
        countryDropdown.style.display = "none";
        countrySelectorBtn.setAttribute("aria-expanded", "false");
      });
    });

    // Close dropdown when clicking outside
    document.addEventListener("click", (e) => {
      if (
        !countrySelectorBtn.contains(e.target as Node) &&
        !countryDropdown.contains(e.target as Node)
      ) {
        countryDropdown.style.display = "none";
        countrySelectorBtn.setAttribute("aria-expanded", "false");
      }
    });
  }

  // Inicializar
  updateProgressDots(1);
  updateBackButtonVisibility();
</script>
