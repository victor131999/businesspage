<style>
  /* ===== COMPONENTE AUTHAPP - ESTILOS DEL DISPOSITIVO MÓVIL ===== */

  /* Contenedor del dispositivo */
  .device-container {
    position: relative;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    z-index: 10;
    padding: 1rem 0 2rem;
  }

  /* Frame del iPhone */
  div:global(.auth-background-section) .device-frame-wrapper {
    position: relative !important;
    z-index: 10 !important;
    transform: scale(1) !important;
    padding: 2.5rem 2rem !important;
    background-color: #f3f4f6 !important;
    border-radius: 2rem !important;
    margin: 3rem auto !important;
  }

  .device-frame {
    position: relative;
    overflow: hidden;
    border-radius: 3rem;
    border: none;
    background: transparent;
    box-shadow: none;
  }

  /* Pantalla del dispositivo */
  .device-screen {
    position: relative;
    height: 900px;
    overflow: hidden;
    border-radius: 2.5rem;
    background: #ffffff;
    margin: 0;
    display: flex;
    flex-direction: column;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.05),
      0 20px 60px rgba(0, 0, 0, 0.15);
  }

  /* Status Bar */
  .device-status-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    padding: 2.5rem 1.5rem 0.5rem;
    flex-shrink: 0;
  }

  .status-time {
    position: absolute;
    left: 1.5rem;
    top: 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #000000;
  }

  .dynamic-island {
    position: absolute;
    left: 50%;
    top: 0.75rem;
    transform: translateX(-50%);
  }

  .island-shape {
    width: 96px;
    height: 20px;
    border-radius: 999px;
    background: #000000;
  }

  .island-speaker {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
