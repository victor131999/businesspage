<script is:inline>
  // Navigation State
  window.tvNavigate = (screenId) => {
    // Hide all
    document.querySelectorAll(".tv-screen").forEach((el) => {
      el.classList.remove("active");
      el.classList.add("hidden-screen");
    });

    // Show target
    const target = document.getElementById("tv-screen-" + screenId);
    if (target) {
      target.classList.remove("hidden-screen");
      target.classList.add("active");
    }
  };

  // Contacts
  window.tvSelectContact = (name, initials, bank) => {
    // Populate summary
    const recEl = document.getElementById("tv-summary-recipient");
    if (recEl) recEl.textContent = name;

    window.tvNavigate("summary");
  };

  // Bottom Sheet Logic for Latest Transfers
  window.tvToggleHistory = (expand) => {
    const sheet = document.getElementById("tv-latest-transfers");
    if (!sheet) return;

    if (expand) {
      sheet.classList.add("expanded");
      sheet.style.height = "85%";
      sheet.style.borderRadius = "28px 28px 0 0";
    } else {
      sheet.classList.remove("expanded");
      sheet.style.height = "80px";
    }
  };

  // Slider Logic
  const slider = document.getElementById("tv-slider-thumb");
  const track = document.getElementById("tv-slider");
  let isDragging = false;
  let startX = 0;

  if (slider && track) {
    slider.addEventListener("mousedown", (e) => {
      isDragging = true;
      startX = e.clientX;
      slider.style.transition = "none";
    });

    window.addEventListener("mousemove", (e) => {
      if (!isDragging) return;
      // Calculate position
      const trackRect = track.getBoundingClientRect();
      let newLeft = e.clientX - trackRect.left - 24; // offset center

      // Constraints
      if (newLeft < 4) newLeft = 4;
      if (newLeft > trackRect.width - 52) newLeft = trackRect.width - 52; // roughly width - thumb width

      slider.style.left = newLeft + "px";

      // Check unlock
      if (newLeft >= trackRect.width - 60) {
        completeSlide();
      }
    });

    window.addEventListener("mouseup", () => {
      if (!isDragging) return;
      isDragging = false;
      // Reset if not completed
      if (
        parseInt(slider.style.left || "0") <
        track.getBoundingClientRect().width - 60
      ) {
        slider.style.transition = "left 0.3s ease";
        slider.style.left = "4px";
      }
    });
  }

  function completeSlide() {
    isDragging = false;
    window.tvNavigate("processing");

    // Start Animation Sequence
    const overlay = document.getElementById("tv-processing-overlay");
    const glint = document.getElementById("tv-processing-glint");

    if (overlay && glint) {
      // Reset styles first to ensure replayability
      overlay.style.transition = "none";
      overlay.style.clipPath = "inset(0 100% 0 0)";
      glint.style.transition = "none";
      glint.style.left = "0%";

      // Force Reflow
      void overlay.offsetWidth;

      // Start
      setTimeout(() => {
        overlay.style.transition =
          "clip-path 3s cubic-bezier(0.22, 1, 0.36, 1)";
        overlay.style.clipPath = "inset(0 0% 0 0)";

        glint.style.transition = "left 3s linear";
        glint.style.left = "100%";

        // Show success
        setTimeout(() => {
          const procView = document.getElementById("tv-processing-view");
          const successView = document.getElementById("tv-success-view");
          if (procView) procView.classList.add("hidden");
          if (successView) successView.classList.remove("hidden");

          // Open detailed sheet
          setTimeout(() => {
            const sheet = document.getElementById("tv-details-sheet");
            if (sheet) sheet.style.height = "calc(100% - 200px)";
          }, 300);
        }, 3050);
      }, 100);
    }
  }

  window.tvReset = () => {
    // Reset Views
    document.getElementById("tv-processing-view").classList.remove("hidden");
    document.getElementById("tv-success-view").classList.add("hidden");
    const slider = document.getElementById("tv-slider-thumb");
    if (slider) slider.style.left = "4px";

    const sheet = document.getElementById("tv-details-sheet");
    if (sheet) sheet.style.height = "70px";

    window.tvNavigate("amount");
  };

  window.toggleSuccessDetails = () => {
    const sheet = document.getElementById("tv-details-sheet");
    const chevron = document.getElementById("tv-details-chevron");
    if (sheet) {
      if (sheet.clientHeight > 100) {
        sheet.style.height = "70px";
        if (chevron) chevron.style.transform = "rotate(0deg)";
      } else {
        sheet.style.height = "calc(100% - 200px)";
        if (chevron) chevron.style.transform = "rotate(180deg)";
      }
    }
  };
</script>
