---
// TransfersViewApp.astro
import DeviceFrame from "../design-system/organisms/device-frame/DeviceFrame.astro";
---

<div class="device-container">
  <DeviceFrame>
    <div class="device-content">
      <!-- Screen 1: Amount (Home) -->
      <div id="tv-screen-amount" class="tv-screen active">
        <!-- Top Graphic -->
        <!-- Top Graphic (Backdrop) -->
        <!-- GIF Animado (Background Layer) -->
        <div
          class="absolute top-12 left-0 right-0 flex justify-center z-0 pointer-events-none"
        >
          <img
            src="/gift/ANIMACION%201.gif"
            alt="Connecting Animation"
            class="h-48 w-48 object-contain opacity-90 mix-blend-multiply"
          />
        </div>

        <div
          class="relative z-10 flex-1 flex flex-col overflow-hidden rounded-t-2xl backdrop-blur-sm mt-40 mb-0"
          style="background-color: rgba(255, 255, 255, 0.35);"
        >
          <!-- App Header (Inside Content) -->
          <div class="device-header">
            <div class="device-logo">
              <img src="/images/zelify_logo.png" alt="Zelify" />
            </div>
          </div>

          <div class="tv-instructions">
            <p class="tv-subtitle">¿Cuánto quieres transferir?</p>
            <p class="tv-caption">
              Selecciona la moneda según el país de destino.
            </p>
          </div>

          <!-- Amount Input Card -->
          <div class="tv-input-section">
            <label class="tv-input-label">Monto</label>
            <div class="tv-input-card">
              <input
                type="text"
                class="tv-amount-input"
                value="0.00"
                id="tv-amount-field"
                readonly
              />
              <button class="tv-currency-pill" id="tv-btn-currency">
                <span class="tv-currency-text">MXN</span>
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M9 18l6-6-6-6"></path>
                </svg>
              </button>
            </div>
          </div>

          <!-- Spacer -->
          <div class="flex-grow"></div>
        </div>

        <!-- Spacer -->
        <div class="flex-grow"></div>

        <!-- Bottom Sheet: Latest Transfers -->
        <div
          class="tv-bottom-sheet"
          id="tv-latest-transfers"
          onclick="window.tvToggleHistory(true)"
        >
          <!-- Compact View Content -->
          <div
            class="tv-sheet-header-compact"
            onclick="window.tvToggleHistory(true)"
          >
            <div class="tv-sheet-handle-icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M18 15l-6-6-6 6"></path>
              </svg>
            </div>
            <span class="tv-sheet-title-text">Transferencias recientes</span>
          </div>

          <!-- Expanded View Content -->
          <div class="tv-sheet-content-expanded">
            <div
              class="tv-sheet-header-expanded"
              onclick="event.stopPropagation(); window.tvToggleHistory(false)"
            >
              <div class="tv-sheet-handle-icon down">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M6 9l6 6 6-6"></path>
                </svg>
              </div>
              <span class="tv-sheet-subtitle">Historial</span>
              <h2 class="tv-sheet-main-title">Transferencias recientes</h2>
            </div>

            <div class="tv-history-list">
              <!-- Item 1 -->
              <div class="tv-history-item">
                <div class="tv-history-left">
                  <span class="tv-history-name">Lucía Gómez</span>
                  <span class="tv-history-date">12-10-2025</span>
                </div>
                <div class="tv-history-right">
                  <span class="tv-history-amount">-1,250.00</span>
                  <span class="tv-history-status">Completado</span>
                </div>
              </div>
              <!-- Item 2 -->
              <div class="tv-history-item">
                <div class="tv-history-left">
                  <span class="tv-history-name">Lucía Gómez</span>
                  <span class="tv-history-date">12-10-2025</span>
                </div>
                <div class="tv-history-right">
                  <span class="tv-history-amount">-1,250.00</span>
                  <span class="tv-history-status">Completado</span>
                </div>
              </div>
              <!-- Item 3 -->
              <div class="tv-history-item">
                <div class="tv-history-left">
                  <span class="tv-history-name">Lucía Gómez</span>
                  <span class="tv-history-date">12-10-2025</span>
                </div>
                <div class="tv-history-right">
                  <span class="tv-history-amount">-1,250.00</span>
                  <span class="tv-history-status">Completado</span>
                </div>
              </div>
              <!-- Item 4 -->
              <div class="tv-history-item">
                <div class="tv-history-left">
                  <span class="tv-history-name">Lucía Gómez</span>
                  <span class="tv-history-date">12-10-2025</span>
                </div>
                <div class="tv-history-right">
                  <span class="tv-history-amount">-1,250.00</span>
                  <span class="tv-history-status">Completado</span>
                </div>
              </div>
              <!-- Item 5 -->
              <div class="tv-history-item">
                <div class="tv-history-left">
                  <span class="tv-history-name">Lucía Gómez</span>
                  <span class="tv-history-date">12-10-2025</span>
                </div>
                <div class="tv-history-right">
                  <span class="tv-history-amount">-1,250.00</span>
                  <span class="tv-history-status">Completado</span>
                </div>
              </div>
              <!-- Item 6 -->
              <div class="tv-history-item">
                <div class="tv-history-left">
                  <span class="tv-history-name">Lucía Gómez</span>
                  <span class="tv-history-date">12-10-2025</span>
                </div>
                <div class="tv-history-right">
                  <span class="tv-history-amount">-1,250.00</span>
                  <span class="tv-history-status">Completado</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Screen 2: Contacts (Blur Overlay) -->
      <div id="tv-screen-contacts" class="tv-screen hidden-screen">
        <!-- Back Button -->
        <button class="tv-back-btn" onclick="window.tvNavigate('amount')">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
          Atrás
        </button>

        <!-- GIF Animation Background -->
        <div class="px-6 pt-2 absolute inset-0 z-0 pointer-events-none">
          <img
            src="/gift/ANIMACION%201.gif"
            alt="Animation"
            class="w-full h-auto max-w-full object-contain mix-blend-multiply opacity-90"
          />
        </div>

        <div
          class="tv-blur-content flex-1 flex flex-col pt-16 pb-6 relative z-10"
        >
          <div class="tv-section-header text-center mb-4">
            <h2 class="tv-section-title text-2xl font-bold text-[#004492] mb-2">
              Contactos
            </h2>
            <p class="tv-section-desc text-sm text-slate-600">
              Selecciona al destinatario
            </p>
          </div>

          <div
            class="tv-contacts-list w-full flex-1 overflow-y-auto px-1 space-y-2"
          >
            <!-- Contact 1 -->
            <div
              class="tv-contact-item group"
              onclick="window.tvSelectContact('Valentina Duarte', 'VD', '@JP - Chase - USA')"
            >
              <div
                class="tv-avatar bg-[#004492] group-hover:bg-white group-hover:text-slate-900 transition-colors"
              >
                VD
              </div>
              <div class="tv-contact-info">
                <div
                  class="tv-contact-name text-slate-900 group-hover:text-white transition-colors"
                >
                  Valentina Duarte
                </div>
                <div
                  class="tv-contact-bank text-slate-600 group-hover:text-white/90 transition-colors"
                >
                  @JP - Chase - USA
                </div>
              </div>
              <svg
                class="tv-chevron text-[#004492] group-hover:text-white transition-colors"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg
              >
            </div>
            <!-- Contact 2 -->
            <div
              class="tv-contact-item group"
              onclick="window.tvSelectContact('Carlos Mendoza', 'CM', '@CM - BBVA - México')"
            >
              <div
                class="tv-avatar bg-[#004492] group-hover:bg-white group-hover:text-slate-900 transition-colors"
              >
                CM
              </div>
              <div class="tv-contact-info">
                <div
                  class="tv-contact-name text-slate-900 group-hover:text-white transition-colors"
                >
                  Carlos Mendoza
                </div>
                <div
                  class="tv-contact-bank text-slate-600 group-hover:text-white/90 transition-colors"
                >
                  @CM - BBVA - México
                </div>
              </div>
              <svg
                class="tv-chevron text-[#004492] group-hover:text-white transition-colors"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg
              >
            </div>
            <!-- Contact 3 -->
            <div
              class="tv-contact-item group"
              onclick="window.tvSelectContact('Sofia Rodriguez', 'SR', '@SR - Santander - España')"
            >
              <div
                class="tv-avatar bg-[#004492] group-hover:bg-white group-hover:text-slate-900 transition-colors"
              >
                SR
              </div>
              <div class="tv-contact-info">
                <div
                  class="tv-contact-name text-slate-900 group-hover:text-white transition-colors"
                >
                  Sofia Rodriguez
                </div>
                <div
                  class="tv-contact-bank text-slate-600 group-hover:text-white/90 transition-colors"
                >
                  @SR - Santander - España
                </div>
              </div>
              <svg
                class="tv-chevron text-[#004492] group-hover:text-white transition-colors"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg
              >
            </div>
            <!-- Contact 4 -->
            <div
              class="tv-contact-item group"
              onclick="window.tvSelectContact('Luis Hernandez', 'LH', '@LH - Bank of America')"
            >
              <div
                class="tv-avatar bg-[#004492] group-hover:bg-white group-hover:text-slate-900 transition-colors"
              >
                LH
              </div>
              <div class="tv-contact-info">
                <div
                  class="tv-contact-name text-slate-900 group-hover:text-white transition-colors"
                >
                  Luis Hernandez
                </div>
                <div
                  class="tv-contact-bank text-slate-600 group-hover:text-white/90 transition-colors"
                >
                  @LH - Bank of America
                </div>
              </div>
              <svg
                class="tv-chevron text-[#004492] group-hover:text-white transition-colors"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg
              >
            </div>
            <!-- Contact 5 -->
            <div
              class="tv-contact-item group"
              onclick="window.tvSelectContact('Ana Martinez', 'AM', '@AM - HSBC - UK')"
            >
              <div
                class="tv-avatar bg-[#004492] group-hover:bg-white group-hover:text-slate-900 transition-colors"
              >
                AM
              </div>
              <div class="tv-contact-info">
                <div
                  class="tv-contact-name text-slate-900 group-hover:text-white transition-colors"
                >
                  Ana Martinez
                </div>
                <div
                  class="tv-contact-bank text-slate-600 group-hover:text-white/90 transition-colors"
                >
                  @AM - HSBC - UK
                </div>
              </div>
              <svg
                class="tv-chevron text-[#004492] group-hover:text-white transition-colors"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg
              >
            </div>
            <!-- Contact 6 -->
            <div
              class="tv-contact-item group"
              onclick="window.tvSelectContact('Diego Fernandez', 'DF', '@DF - Banco de Chile')"
            >
              <div
                class="tv-avatar bg-[#004492] group-hover:bg-white group-hover:text-slate-900 transition-colors"
              >
                DF
              </div>
              <div class="tv-contact-info">
                <div
                  class="tv-contact-name text-slate-900 group-hover:text-white transition-colors"
                >
                  Diego Fernandez
                </div>
                <div
                  class="tv-contact-bank text-slate-600 group-hover:text-white/90 transition-colors"
                >
                  @DF - Banco de Chile
                </div>
              </div>
              <svg
                class="tv-chevron text-[#004492] group-hover:text-white transition-colors"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Screen 3: Summary -->
      <div id="tv-screen-summary" class="tv-screen hidden-screen">
        <div class="h-full w-full relative flex flex-col">
          <!-- Back Button (Re-positioned relative) -->
          <button
            onclick="window.tvNavigate('contacts')"
            class="absolute top-4 left-0 flex items-center text-sm font-medium text-[#000b1e] hover:text-[#004492] transition-colors z-50 ml-0 pl-0"
            style="font-weight: 600;"
          >
            <svg
              class="h-5 w-5 mr-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M15 19l-7-7 7-7"></path>
            </svg>
            <span>Atrás</span>
          </button>

          <!-- GIF Background (Absolute) -->
          <div
            class="absolute top-12 left-0 right-0 flex justify-center z-0 pointer-events-none"
          >
            <img
              src="/gift/ANIMACION%201.gif"
              alt="Connecting Animation"
              class="h-48 w-48 object-contain opacity-90 mix-blend-multiply"
            />
          </div>

          <!-- Glassmorphic Card -->
          <div
            class="relative z-10 flex-1 flex flex-col overflow-hidden rounded-t-[32px] backdrop-blur-sm mt-40 mb-0 px-6 pt-6 pb-8 shadow-[0_-10px_40px_rgba(0,0,0,0.05)] border-t border-white/40"
            style="background-color: rgba(255, 255, 255, 0.35);"
          >
            <!-- Title Section (Centered) -->
            <div class="text-center mb-6">
              <h2
                class="text-[22px] font-bold text-[#2b5bf7] mb-1 leading-tight"
              >
                Confirmar la transferencia
              </h2>
              <p class="text-[13px] text-[#64748b] font-normal">
                Revisa los detalles antes de enviar.
              </p>
            </div>

            <!-- Recipient -->
            <div class="mb-5">
              <p class="text-[13px] font-medium text-[#94a3b8] mb-1">
                Destinatario
              </p>
              <p
                class="text-[17px] font-bold text-[#0f172a]"
                id="tv-summary-recipient"
              >
                Carlos Mendoza
              </p>
            </div>

            <!-- Amount -->
            <div class="mb-6">
              <p class="text-[13px] font-medium text-[#94a3b8] mb-1">Monto</p>
              <p class="text-[28px] font-bold text-[#0f172a] tracking-tight">
                1,250.00 MXN
              </p>
            </div>

            <!-- Divider -->
            <div class="h-px bg-slate-200 w-full mb-4"></div>

            <!-- Summary Details -->
            <div class="space-y-3 mb-4">
              <div class="flex justify-between items-center text-[14px]">
                <span class="text-[#64748b]">Tú envías</span>
                <span class="font-medium text-[#0f172a]">1,250.00 MXN</span>
              </div>
              <div class="flex justify-between items-center text-[14px]">
                <span class="text-[#64748b]">Tasa de cambio</span>
                <span class="font-medium text-[#0f172a]"
                  >1 MXN = 0.0580 USD</span
                >
              </div>
            </div>

            <!-- Divider -->
            <div class="h-px bg-slate-200 w-full mb-4"></div>

            <!-- Total -->
            <div class="flex justify-between items-center text-[16px] mb-auto">
              <span class="font-bold text-[#0f172a] text-lg">Total</span>
              <span class="font-bold text-[#0f172a] text-lg">$72.50 USD</span>
            </div>

            <!-- Slider Button -->
            <div class="w-full mt-6 mb-4" id="tv-slider">
              <div
                class="relative w-full h-[56px] rounded-[28px] flex items-center justify-center overflow-hidden cursor-pointer shadow-lg active:scale-[0.99] transition-transform tv-slider-track"
                style="background: linear-gradient(90deg, #1e3a8a 0%, #000080 100%);"
              >
                <span
                  class="text-white font-semibold text-[15px] pointer-events-none z-0 tracking-wide"
                >
                  Desliza para confirmar
                </span>

                <div
                  class="absolute left-1 w-[48px] h-[48px] bg-white rounded-full flex items-center justify-center cursor-grab active:cursor-grabbing z-10 shadow-md transition-transform tv-slider-thumb"
                  id="tv-slider-thumb"
                >
                  <!-- Blue Arrow Icon -->
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    class="text-[#1e3a8a]"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M9 18l6-6-6-6"></path>
                  </svg>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Screen 4: Processing & Success -->
      <div
        id="tv-screen-processing"
        class="tv-screen hidden-screen bg-white h-full relative overflow-hidden font-sans"
      >
        <!-- Processing View (Card Animation) -->
        <div
          class="flex-1 px-2 pb-24 pt-10 flex flex-col items-center justify-center min-h-0 h-full"
          id="tv-processing-view"
        >
          <!-- Card Container -->
          <div
            class="relative w-full h-full rounded-[2.5rem] overflow-hidden shadow-xl bg-[#001a33]"
          >
            <!-- Base Layer -->
            <div
              class="absolute inset-0 z-10 flex flex-col items-center justify-center h-full px-6 text-center w-full"
            >
              <h2 class="text-2xl font-bold mb-2 text-[#003366]">
                Procesando tu transacción
              </h2>
              <p class="text-[13px] text-gray-400">
                Esto puede tardar unos segundos
              </p>
              <!-- Empty Bar -->
              <div
                class="w-64 h-2 rounded-full mt-8 overflow-hidden bg-gray-200/10"
              >
              </div>
            </div>

            <!-- Overlay Layer (Clipped) -->
            <div
              id="tv-processing-overlay"
              class="absolute inset-0 z-20 overflow-hidden"
              style="clip-path: inset(0 100% 0 0); transition: clip-path 3s cubic-bezier(0.22, 1, 0.36, 1);"
            >
              <div
                class="w-full h-full flex flex-col items-center justify-center px-6 text-center"
                style="background: linear-gradient(to right, #004492 0%, #000b1e 100%);"
              >
                <!-- Content on top of gradient -->
                <div class="relative z-10 flex flex-col items-center">
                  <h2 class="text-2xl font-bold mb-2 text-white">
                    Procesando tu transacción
                  </h2>
                  <p class="text-[13px] text-white/80">
                    Esto puede tardar unos segundos
                  </p>
                  <!-- Filled Bar -->
                  <div
                    class="w-64 h-2 rounded-full mt-8 overflow-hidden bg-white/20"
                  >
                    <div
                      class="h-full w-full bg-white shadow-[0_0_10px_rgba(255,255,255,0.8)]"
                    >
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Flush Edge Effect -->
            <div
              id="tv-processing-glint"
              class="absolute top-0 bottom-0 w-20 z-30 pointer-events-none flush-effect"
              style="left: 0%; background: linear-gradient(to right, transparent, rgba(255,255,255,0.5), transparent); transform: translateX(-50%); transition: left 3s linear;"
            >
            </div>
          </div>
        </div>

        <!-- Success View -->
        <div
          class="tv-success-content hidden h-full w-full relative"
          id="tv-success-view"
        >
          <!-- Layer 1: Blue "Transfer Sent" Card (Separate) -->
          <div
            class="absolute top-6 bottom-24 left-2 right-2 rounded-[2.5rem] overflow-hidden shadow-2xl z-10 bg-[#004492]"
          >
            <div
              class="absolute inset-0 w-full h-full"
              style="background: linear-gradient(to right, #004492 0%, #000b1e 100%);"
            >
            </div>

            <div
              class="relative z-10 flex flex-col items-center justify-center h-full text-center text-white px-6"
            >
              <svg
                width="64"
                height="64"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mb-4"
              >
                <path d="M20 6L9 17l-5-5"></path>
              </svg>
              <h2 class="text-3xl font-bold mb-2">Transferencia enviada</h2>
              <p class="text-sm opacity-90 font-medium">
                Zelify notificó al destinatario
              </p>
            </div>
          </div>

          <!-- Layer 2: Transaction Details Bottom Sheet (Separate, Overlay) -->
          <div
            id="tv-details-sheet"
            class="absolute inset-x-0 bottom-0 rounded-t-[2rem] shadow-[0_-5px_30px_rgba(0,0,0,0.15)] z-20 transition-all duration-500 cubic-bezier(0.32, 0.725, 0.25, 1) flex flex-col overflow-hidden"
            style="height: 70px; background-color: rgba(255, 255, 255, 0.5); backdrop-filter: blur(4px);"
          >
            <!-- Handle Area -->
            <div
              class="w-full flex items-center justify-center h-[70px] shrink-0 cursor-pointer hover:bg-white/50 transition-colors"
              onclick="toggleSuccessDetails()"
            >
              <svg
                id="tv-details-chevron"
                class="w-6 h-6 text-slate-500 transition-transform duration-500"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 15l7-7 7 7"></path>
              </svg>
            </div>

            <!-- Expanded Content -->
            <div class="flex-1 px-8 pb-8 overflow-y-auto no-scrollbar pt-2">
              <h2 class="text-center text-[17px] font-bold text-[#1e293b] mb-6">
                Detalles de la transacción
              </h2>

              <div class="space-y-5 relative">
                <!-- Date/Hour -->
                <div>
                  <p class="text-[13px] text-slate-500 mb-0.5">Fecha/Hora</p>
                  <p class="text-[15px] font-semibold text-[#1e293b]">
