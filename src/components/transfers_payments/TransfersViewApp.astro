---
// TransfersViewApp.astro
---

<div class="tv-app-container">
  <!-- Screen 1: Amount (Home) -->
  <div id="tv-screen-amount" class="tv-screen active">
    <!-- Top Graphic -->
    <!-- Top Graphic (Backdrop) -->
    <!-- GIF Animado (Background Layer) -->
    <div
      class="absolute top-12 left-0 right-0 flex justify-center z-0 pointer-events-none"
    >
      <img
        src="/gift/ANIMACION%201.gif"
        alt="Connecting Animation"
        class="h-48 w-48 object-contain opacity-90 mix-blend-multiply"
      />
    </div>

    <!-- Main Content Area -->
    <div
      class="relative z-10 flex-1 flex flex-col overflow-hidden rounded-t-2xl backdrop-blur-sm mt-40 mb-0"
      style="background-color: rgba(255, 255, 255, 0.35);"
    >
      <!-- Title Section -->
      <h1 class="tv-title mt-6">Transfers</h1>

      <div class="tv-instructions">
        <p class="tv-subtitle">How much do you want to transfer?</p>
        <p class="tv-caption">
          Select the currency based on the destination country.
        </p>
      </div>

      <!-- Amount Input Card -->
      <div class="tv-input-section">
        <label class="tv-input-label">Amount</label>
        <div class="tv-input-card">
          <input
            type="text"
            class="tv-amount-input"
            value="0.00"
            id="tv-amount-field"
            readonly
          />
          <button class="tv-currency-pill" id="tv-btn-currency">
            <span class="tv-currency-text">MXN</span>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 18l6-6-6-6"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Spacer -->
      <div class="flex-grow"></div>
    </div>

    <!-- Spacer -->
    <div class="flex-grow"></div>

    <!-- Bottom Sheet: Latest Transfers -->
    <div
      class="tv-bottom-sheet"
      id="tv-latest-transfers"
      onclick="window.tvToggleHistory(true)"
    >
      <!-- Compact View Content -->
      <div class="tv-sheet-header-compact">
        <div class="tv-sheet-handle-icon">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 15l-6-6-6 6"></path>
          </svg>
        </div>
        <span class="tv-sheet-title-text">Latest transfers</span>
      </div>

      <!-- Expanded View Content -->
      <div class="tv-sheet-content-expanded">
        <div
          class="tv-sheet-header-expanded"
          onclick="event.stopPropagation(); window.tvToggleHistory(false)"
        >
          <div class="tv-sheet-handle-icon down">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </div>
          <span class="tv-sheet-subtitle">History</span>
          <h2 class="tv-sheet-main-title">Latest transfers</h2>
        </div>

        <div class="tv-history-list">
          <!-- Item 1 -->
          <div class="tv-history-item">
            <div class="tv-history-left">
              <span class="tv-history-name">Lucía Gómez</span>
              <span class="tv-history-date">12-10-2025</span>
            </div>
            <div class="tv-history-right">
              <span class="tv-history-amount">-1,250.00</span>
              <span class="tv-history-status">Completed</span>
            </div>
          </div>
          <!-- Item 2 -->
          <div class="tv-history-item">
            <div class="tv-history-left">
              <span class="tv-history-name">Lucía Gómez</span>
              <span class="tv-history-date">12-10-2025</span>
            </div>
            <div class="tv-history-right">
              <span class="tv-history-amount">-1,250.00</span>
              <span class="tv-history-status">Completed</span>
            </div>
          </div>
          <!-- Item 3 -->
          <div class="tv-history-item">
            <div class="tv-history-left">
              <span class="tv-history-name">Lucía Gómez</span>
              <span class="tv-history-date">12-10-2025</span>
            </div>
            <div class="tv-history-right">
              <span class="tv-history-amount">-1,250.00</span>
              <span class="tv-history-status">Completed</span>
            </div>
          </div>
          <!-- Item 4 -->
          <div class="tv-history-item">
            <div class="tv-history-left">
              <span class="tv-history-name">Lucía Gómez</span>
              <span class="tv-history-date">12-10-2025</span>
            </div>
            <div class="tv-history-right">
              <span class="tv-history-amount">-1,250.00</span>
              <span class="tv-history-status">Completed</span>
            </div>
          </div>
          <!-- Item 5 -->
          <div class="tv-history-item">
            <div class="tv-history-left">
              <span class="tv-history-name">Lucía Gómez</span>
              <span class="tv-history-date">12-10-2025</span>
            </div>
            <div class="tv-history-right">
              <span class="tv-history-amount">-1,250.00</span>
              <span class="tv-history-status">Completed</span>
            </div>
          </div>
          <!-- Item 6 -->
          <div class="tv-history-item">
            <div class="tv-history-left">
              <span class="tv-history-name">Lucía Gómez</span>
              <span class="tv-history-date">12-10-2025</span>
            </div>
            <div class="tv-history-right">
              <span class="tv-history-amount">-1,250.00</span>
              <span class="tv-history-status">Completed</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Screen 2: Contacts (Blur Overlay) -->
  <div id="tv-screen-contacts" class="tv-screen hidden-screen">
    <!-- Back Button -->
    <button class="tv-back-btn" onclick="window.tvNavigate('amount')">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M15 18l-6-6 6-6"></path>
      </svg>
      Atrás
