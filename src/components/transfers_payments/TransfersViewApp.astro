<script is:inline>
  // Bottom Sheet Toggle
  window.tvToggleHistory = (shouldExpand) => {
    const sheet = document.getElementById("tv-latest-transfers");
    if (!sheet) return;

    if (shouldExpand) {
      sheet.classList.add("expanded");
    } else {
      sheet.classList.remove("expanded");
    }
  };

  // Simple State Management
  window.tvNavigate = (screenId) => {
    document.querySelectorAll(".tv-screen").forEach((el) => {
      el.classList.remove("active");
      el.classList.add("hidden-screen");
    });

    const target = document.getElementById(`tv-screen-${screenId}`);
    if (target) {
      target.classList.remove("hidden-screen");
      target.classList.add("active");
    }
  };

  // Interactions
  // 1. Amount -> Contacts (Click on pill or input)
  const amountInput = document.getElementById("tv-amount-field");
  const currencyBtn = document.getElementById("tv-btn-currency");

  const goToContacts = () => window.tvNavigate("contacts");

  if (amountInput) amountInput.addEventListener("click", goToContacts);
  if (currencyBtn) currencyBtn.addEventListener("click", goToContacts);

  // 2. Contacts -> Summary
  window.tvSelectContact = (name, initials) => {
    // Update summary
    const recEl = document.getElementById("tv-summary-recipient");
    if (recEl) recEl.textContent = name;

    window.tvNavigate("summary");
  };

  // 3. Slider Logic
  const sliderThumb = document.getElementById("tv-slider-thumb");
  const sliderContainer = document.getElementById("tv-slider");

  if (sliderThumb && sliderContainer) {
    let isDragging = false;
    let startX = 0;

    const onDragStart = (e) => {
      isDragging = true;
      startX =
        (e.touches ? e.touches[0].clientX : e.clientX) - sliderThumb.offsetLeft;
    };

    const onDragMove = (e) => {
      if (!isDragging) return;
      const cx = e.touches ? e.touches[0].clientX : e.clientX;
      let newLeft = cx - startX;

      const maxLeft = sliderContainer.offsetWidth - sliderThumb.offsetWidth - 8;

      if (newLeft < 4) newLeft = 4;
      if (newLeft > maxLeft) newLeft = maxLeft;

      sliderThumb.style.left = newLeft + "px";

      if (newLeft >= maxLeft - 5) {
        completeTransaction();
        isDragging = false;
      }
    };

    const onDragEnd = () => {
      if (!isDragging) return;
      isDragging = false;
      // Reset if not complete
      sliderThumb.style.transition = "left 0.3s";
      sliderThumb.style.left = "4px";
      setTimeout(() => {
        sliderThumb.style.transition = "";
      }, 300);
    };

    sliderThumb.addEventListener("mousedown", onDragStart);
    sliderThumb.addEventListener("touchstart", onDragStart);

    window.addEventListener("mousemove", onDragMove);
    window.addEventListener("touchmove", onDragMove);

    window.addEventListener("mouseup", onDragEnd);
    window.addEventListener("touchend", onDragEnd);
  }

  function completeTransaction() {
    window.tvNavigate("processing");
    // Simulate loading
    setTimeout(() => {
      const procView = document.getElementById("tv-processing-view");
      const succView = document.getElementById("tv-success-view");
      if (procView) procView.classList.add("hidden");
      if (succView) succView.classList.remove("hidden");
    }, 2000);
  }

  window.tvReset = () => {
    // Reset views
    const procView = document.getElementById("tv-processing-view");
    const succView = document.getElementById("tv-success-view");
    if (procView) procView.classList.remove("hidden");
    if (succView) succView.classList.add("hidden");

    // Reset Slider
    if (sliderThumb) sliderThumb.style.left = "4px";

    window.tvNavigate("amount");
  };
</script>
