      </div>

      <div
        class="tv-contacts-list w-full flex-1 overflow-y-auto px-1 space-y-2"
      >
        <!-- Contact 1 -->
        <div
          class="tv-contact-item group"
          onclick="window.tvSelectContact('Valentina Duarte', 'VD', '@JP - Chase - USA')"
