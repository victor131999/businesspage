---
import DeviceFrame from "../design-system/organisms/device-frame/DeviceFrame.astro";
---

<div class="device-container">
  <DeviceFrame>
    <div class="device-content">
      <div class="bs-app-container">
        <!-- Screen: Dashboard -->
        <div id="bs-screen-dashboard" class="bs-screen active">
          <div class="bs-scroll-content">
            <!-- Header -->
            <div class="bs-header">
              <img src="/images/zelify_logo.png" alt="Zelify" class="bs-logo" />
            </div>

            <!-- Hero Card -->
            <div class="bs-hero-container">
              <div class="bs-main-card">
                <div class="bs-card-content">
                  <div class="bs-avatar-wrapper">
                    <img
                      src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=150&h=150&fit=crop"
                      alt="User"
                      class="bs-user-avatar"
                    />
                  </div>
                  <h2 class="bs-user-name">Hola, Annie</h2>
                  <p class="bs-total-label">Total a Pagar</p>
                  <div class="bs-amount-wrapper">
                    <span class="bs-currency">$</span>
                    <span class="bs-amount">245.00</span>
                  </div>
                </div>
              </div>

              <!-- Floating Search Bar -->
              <div class="bs-search-container">
                <div class="bs-search-bar">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="bs-search-icon"
                  >
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                  <input
                    type="text"
                    placeholder="Buscar servicios..."
                    class="bs-search-input"
                  />
                </div>
              </div>
            </div>

            <!-- Quick Access Grid -->
            <div class="bs-grid-section">
              <h3 class="bs-section-title">Servicios Básicos</h3>
              <div class="bs-services-grid">
                <!-- Item 1 -->
                <div
                  class="bs-service-item"
                  onclick="bsNavigate('electricidad', 'Electricidad')"
                >
                  <div class="bs-icon-box orange">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
                      ></polygon>
                    </svg>
                  </div>
                  <span class="bs-service-name">Luz</span>
                </div>
                <!-- Item 2 -->
                <div
                  class="bs-service-item"
                  onclick="bsNavigate('agua', 'Agua')"
                >
                  <div class="bs-icon-box blue">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                    </svg>
                  </div>
                  <span class="bs-service-name">Agua</span>
                </div>
                <!-- Item 3 -->
                <div
                  class="bs-service-item"
                  onclick="bsNavigate('internet', 'Internet')"
                >
                  <div class="bs-icon-box purple">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12.55a11 11 0 0 1 14.08 0"></path>
                      <path d="M1.42 9a16 16 0 0 1 21.16 0"></path>
                      <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
                      <line x1="12" y1="20" x2="12.01" y2="20"></line>
                    </svg>
                  </div>
                  <span class="bs-service-name">Internet</span>
                </div>
                <!-- Item 4 -->
                <div class="bs-service-item" onclick="bsNavigate('gas', 'Gas')">
                  <div class="bs-icon-box red">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M18 20V6a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v14"
                      ></path>
                      <path d="M2 20h20"></path>
                      <path d="M14 12v.01"></path>
                    </svg>
                  </div>
                  <span class="bs-service-name">Gas</span>
                </div>
              </div>
            </div>

            <!-- Stacked Bottom Sheet Visualization -->
            <div class="bs-bottom-sheet-container">
              <div class="bs-sheet-item stacked-2"></div>
              <div class="bs-sheet-item stacked-1"></div>
              <div class="bs-sheet-item active">
                <span>Seleccionar Servicio</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Screen: Provider Selection (Hidden by default) -->
        <div id="bs-screen-provider" class="bs-screen hidden-screen">
          <div class="bs-scroll-content">
            <div class="bs-header-detail">
              <button class="bs-back-btn" onclick="bsBack()">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  style="margin-right: 4px;"
                >
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                Atrás
              </button>

              <!-- Provider Title -->
              <div class="bs-title-section compact">
                <h1 class="bs-title-sm" id="bs-provider-title">Proveedor</h1>
                <p class="bs-subtitle-sm">Ingresa los detalles de pago</p>
              </div>

              <div class="bs-options-list">
                <!-- Option 1 -->
                <div class="bs-option-card">
                  <div class="bs-option-title">Mi Número de Teléfono</div>
                  <div class="bs-option-desc">Usa tu número registrado</div>
                </div>

                <!-- Option 2 -->
                <div class="bs-option-card">
                  <div class="bs-option-title">Ingresar Número de Teléfono</div>
                  <div class="bs-option-desc">
                    Ingresa el número asociado a la cuenta
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </DeviceFrame>
</div>

<style>
  /* Device Frame Layout */
  .device-container {
    position: relative;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    z-index: 10;
    padding: 1rem 0 2rem;
  }

  .device-content {
    flex: 1;
    min-height: 0;
    background: #ffffff;
    padding: 1rem 1.25rem;
    overflow-y: auto;
    overflow-x: hidden;
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .device-content::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
  }

  /* Base Layout */
  .bs-app-container {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    background: white;
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial,
      sans-serif;
  }

  .bs-screen {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    background: transparent;
    z-index: 1;
  }

  .bs-screen.hidden-screen {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.98);
    z-index: 0;
  }

  .bs-screen.active {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
    z-index: 10;
  }

  /* Dashboard Styles */
  .bs-scroll-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 24px;
    padding-top: 10px;
    overflow-y: auto;
    height: 100%;
    box-sizing: border-box;
  }

  .bs-header {
    display: flex;
    justify-content: center;
    margin-bottom: 12px;
    z-index: 20;
    position: relative;
  }

  .bs-logo {
    height: 32px;
    object-fit: contain;
  }

  .bs-hero-container {
    position: relative;
    margin-bottom: -64px;
    z-index: 0;
  }

  .bs-main-card {
    background: linear-gradient(135deg, #001e45 0%, #004492 100%);
    border-radius: 24px;
    padding: 24px;
    padding-bottom: 80px; /* Space for search bar overlap */
    color: white;
    box-shadow: 0 10px 25px rgba(0, 68, 146, 0.25);
    position: relative;
    overflow: hidden;
  }

  .bs-card-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .bs-avatar-wrapper {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.2);
    overflow: hidden;
    margin-bottom: 12px;
  }

  .bs-user-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bs-user-name {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 4px 0;
    opacity: 0.9;
  }

  .bs-total-label {
    font-size: 12px;
    opacity: 0.7;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .bs-amount-wrapper {
    display: flex;
    align-items: flex-start;
    margin-top: 8px;
  }

  .bs-currency {
    font-size: 20px;
    font-weight: 600;
    margin-top: 8px;
    margin-right: 2px;
  }

  .bs-amount {
    font-size: 42px;
    font-weight: 700;
    letter-spacing: -1px;
  }

  /* Search Bar */
  .bs-search-container {
    padding: 0 16px;
    margin-top: -30px; /* Negative margin to overlap */
    position: relative;
    z-index: 10;
  }

  .bs-search-bar {
    background: white;
    border-radius: 16px;
    padding: 16px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bs-search-icon {
    color: #94a3b8;
  }

  .bs-search-input {
    border: none;
    outline: none;
    font-size: 14px;
    color: #0f172a;
    width: 100%;
    font-family: inherit;
  }

  .bs-search-input::placeholder {
    color: #94a3b8;
  }

  /* Grid Section */
  .bs-grid-section {
    padding-top: 40px;
    margin-bottom: 24px;
  }

  .bs-section-title {
    font-size: 14px;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 16px 0;
    padding-left: 4px;
  }

  .bs-services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .bs-service-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: transform 0.2s;
  }

  .bs-service-item:hover {
    transform: translateY(-2px);
  }

  .bs-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .bs-icon-box.orange {
    background: #fff7ed;
    color: #f97316;
  }
  .bs-icon-box.blue {
    background: #eff6ff;
    color: #3b82f6;
  }
  .bs-icon-box.purple {
    background: #fdf4ff;
    color: #a855f7;
  }
  .bs-icon-box.red {
    background: #fef2f2;
    color: #ef4444;
  }

  .bs-service-name {
    font-size: 11px;
    font-weight: 500;
    color: #64748b;
  }

  /* Bottom Sheet Stacking */
  .bs-bottom-sheet-container {
    height: 80px;
    position: relative;
    width: 100%;
    margin-top: auto;
    margin-bottom: 0px;
  }

  .bs-sheet-item {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    border: 4px solid white;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    cursor: pointer;
  }

  .bs-sheet-item.active {
    bottom: 0;
    width: 100%;
    height: 64px;
    z-index: 30;
    background: linear-gradient(90deg, #001e45 0%, #004492 100%);
    color: white;
    font-weight: 600;
  }

  .bs-sheet-item.stacked-1 {
    bottom: 12px;
    width: 90%;
    height: 56px;
    z-index: 20;
    background: #e2e8f0;
    color: #475569;
  }

  .bs-sheet-item.stacked-2 {
    bottom: 24px;
    width: 82%;
    height: 56px;
    z-index: 10;
    background: #f1f5f9;
    color: #94a3b8;
  }

  /* Screen 2 Styles */
  .bs-back-btn {
    align-self: flex-start;
    display: flex;
    align-items: center;
    color: #9ca3af;
    font-size: 12px;
    background: none;
    border: none;
    cursor: pointer;
    margin-bottom: 12px;
    transition: color 0.2s;
  }

  .bs-back-btn:hover {
    color: #4b5563;
  }

  .bs-title-section.compact .bs-title-sm {
    font-size: 16px;
    font-weight: 700;
    color: #004492;
    margin: 0;
  }

  .bs-title-section.compact .bs-subtitle-sm {
    font-size: 10px;
    color: #64748b;
    margin-top: 2px;
  }

  .bs-options-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 24px;
  }

  .bs-option-card {
    background: #f8fafc;
    border-radius: 16px;
    padding: 16px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .bs-option-card:hover {
    background: #f1f5f9;
  }

  .bs-option-title {
    font-size: 14px;
    font-weight: 600;
    color: #0f172a;
    margin-bottom: 4px;
  }

  .bs-option-desc {
    font-size: 12px;
    color: #64748b;
  }
</style>

<script is:inline>
  // Navigation Logic
  window.bsNavigate = (id, name) => {
    const screen1 = document.getElementById("bs-screen-dashboard");
    const screen2 = document.getElementById("bs-screen-provider");
    const titleEl = document.getElementById("bs-provider-title");

    if (titleEl) titleEl.textContent = name;

    if (screen1 && screen2) {
      screen1.classList.remove("active");
      screen1.classList.add("hidden-screen");

      screen2.classList.remove("hidden-screen");
      screen2.classList.add("active");
    }
  };

  window.bsBack = () => {
    const screen1 = document.getElementById("bs-screen-dashboard");
    const screen2 = document.getElementById("bs-screen-provider");

    if (screen1 && screen2) {
      screen2.classList.remove("active");
      screen2.classList.add("hidden-screen");

      screen1.classList.remove("hidden-screen");
      screen1.classList.add("active");
    }
  };
</script>
