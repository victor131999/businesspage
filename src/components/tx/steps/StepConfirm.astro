<div class="step-content hidden" id="step-confirm">
  <div class="h-full w-full relative flex flex-col">
    <!-- GIF Background (Absolute) -->
    <div
      class="absolute top-12 left-0 right-0 flex justify-center z-0 pointer-events-none"
    >
      <img
        src="/gift/ANIMACION%201.gif"
        alt="Connecting Animation"
        class="h-48 w-48 object-contain opacity-90 mix-blend-multiply"
      />
    </div>

    <!-- Glassmorphic Card -->
    <div
      class="relative z-10 flex-1 flex flex-col overflow-hidden rounded-t-[32px] backdrop-blur-sm mt-28 mb-0 px-5 pt-5 pb-6 shadow-[0_-10px_40px_rgba(0,0,0,0.05)] border-t border-white/40"
      style="background-color: rgba(255, 255, 255, 0.35);"
    >
      <!-- Title Section (Centered) -->
      <div class="text-center mb-4">
        <h2 class="confirm-title text-[18px] font-bold text-[#2b5bf7] mb-1 leading-tight">
          Confirmar la transferencia
        </h2>
        <p class="confirm-subtitle text-[12px] text-[#64748b] font-normal">
          Revisa los detalles antes de enviar.
        </p>
      </div>

      <!-- Recipient -->
      <div class="mb-4">
        <p class="confirm-recipient-label text-[12px] font-medium text-[#94a3b8] mb-1">
          Destinatario
        </p>
        <p
          class="text-[15px] font-bold text-[#0f172a]"
          id="confirm-recipient-name"
        >
          Carlos Mendoza
        </p>
      </div>

      <!-- Amount -->
      <div class="mb-4">
        <p class="confirm-amount-label text-[12px] font-medium text-[#94a3b8] mb-1">
          Monto
        </p>
        <p
          class="text-[24px] font-bold text-[#0f172a] tracking-tight"
          id="confirm-amount-display"
        >
          0.00 MXN
        </p>
      </div>

      <!-- Divider -->
      <div class="h-px bg-slate-200 w-full mb-4"></div>

      <!-- Summary Details -->
      <div class="space-y-2.5 mb-3">
        <div class="flex justify-between items-center text-[13px]">
          <span class="confirm-you-send text-[#64748b]">You send</span>
          <span class="font-medium text-[#0f172a]" id="confirm-send-value"
            >0.00 MXN</span
          >
        </div>
        <div class="flex justify-between items-center text-[13px]">
          <span class="confirm-exchange-rate text-[#64748b]">Exchange rate</span>
          <span class="font-medium text-[#0f172a]">1 MXN = 0.0580 USD</span>
        </div>
      </div>

      <!-- Divider -->
      <div class="h-px bg-slate-200 w-full mb-3"></div>

      <!-- Total -->
      <div class="flex justify-between items-center text-[15px] mb-auto">
        <span class="confirm-total-label font-bold text-[#0f172a] text-[16px]">Total</span>
        <span class="font-bold text-[#0f172a] text-[16px]" id="confirm-total-value"
          >$0.00 USD</span
        >
      </div>

      <!-- Slider Button -->
      <div class="w-full mt-3 mb-0">
        <div
          class="slider-track relative w-full h-[52px] rounded-[26px] flex items-center justify-center overflow-hidden cursor-pointer shadow-lg active:scale-[0.99] transition-transform"
          id="slider-track"
          style="background: linear-gradient(90deg, #1e3a8a 0%, #000080 100%);"
        >
          <span
            class="slider-text text-white font-semibold text-[14px] pointer-events-none z-0 tracking-wide"
          >
            Slide to confirm
          </span>

          <div
            class="slider-thumb absolute left-1 w-[44px] h-[44px] bg-white rounded-full flex items-center justify-center cursor-grab active:cursor-grabbing z-10 shadow-md transition-transform"
            id="slider-thumb"
          >
            <!-- Blue Arrow Icon -->
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              class="text-[#1e3a8a]"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 18l6-6-6-6"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .step-content {
    flex: 1;
    width: 100%;
    height: 100%;
  }
</style>
