---
type NavItem = {
  label: string;
  href: string;
};

const {
  logoSrc = "/images/zelify_logo.png",
  logoAlt = "Zelify logo",
  navItems = [
    { label: "Producto", href: "/product" },
    {
      label: "Desarrollo",
      href: "https://docs.zelify.com/documentation/getting-started",
    },
    { label: "Blog", href: "/blog" },
    // { label: "Otros", href: "/blog" },
  ],
  demoHref = "http://www.zelify.com/clips",
  initialLang = "ES",
} = Astro.props as {
  logoSrc?: string;
  logoAlt?: string;
  navItems?: NavItem[];
  demoHref?: string;
  initialLang?: string;
};

import Button from "./design-system/atoms/Button.astro";
---

<header class="simple-navbar">
  <nav class="simple-navbar__inner" aria-label="Principal">
    <a class="simple-navbar__logo" href="/">
      <img src={logoSrc} alt={logoAlt} />
    </a>

    <div class="simple-navbar__links">
      {
        navItems.map((item, index) => {
          // Si es "Producto", hacer que abra el panel en lugar de navegar
          if (
            item.label.toLowerCase() === "producto" ||
            item.label.toLowerCase() === "productos"
          ) {
            return (
              <button
                class="simple-navbar__link simple-navbar__link--button"
                type="button"
                data-products-trigger
                data-i18n="navbar.products"
                data-nav-index={index}
              >
                {item.label}
              </button>
            );
          }
          // Mapear otros items a sus keys de traducción
          let i18nKey = "";
          if (item.label.toLowerCase() === "nosotros") {
            i18nKey = "navbar.about";
          } else if (item.label.toLowerCase() === "desarrollo") {
            i18nKey = "navbar.developers";
          } else if (item.label.toLowerCase() === "otros") {
            i18nKey = "navbar.others";
          }

          const isExternal =
            item.label.toLowerCase() === "desarrollo" ||
            item.href.startsWith("http");
          return (
            <a
              class="simple-navbar__link"
              href={item.href}
              target={isExternal ? "_blank" : undefined}
              rel={isExternal ? "noopener noreferrer" : undefined}
              data-i18n={i18nKey || undefined}
              data-nav-index={index}
            >
              {item.label}
            </a>
          );
        })
      }
    </div>

    <div class="simple-navbar__actions">
      <Button
        href={demoHref}
        variant="secondary"
        size="md"
        class="simple-navbar__demo-btn"
        dataI18n="navbar.demo"
      >
        Demo
      </Button>
      <button
        class="simple-navbar__lang"
        type="button"
        data-lang={initialLang.toUpperCase() === "EN" ? "EN" : "ES"}
        aria-label="Cambiar idioma"
        data-i18n-aria-label="navbar.changeLanguage"
      >
        <span class="simple-navbar__lang-text"
          >{initialLang.toUpperCase() === "EN" ? "EN" : "ES"}</span
        >
      </button>

      <!-- Mobile Menu Toggle -->
      <button
        class="simple-navbar__mobile-toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        id="mobile-menu-toggle"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu Dropdown -->
  <div class="simple-navbar__mobile-menu" id="mobile-menu">
    {
      navItems.map((item, index) => {
        // Logica duplicada para el menu movil
        if (
          item.label.toLowerCase() === "producto" ||
          item.label.toLowerCase() === "productos"
        ) {
          return (
            <button
              class="simple-navbar__link simple-navbar__link--button"
              type="button"
              data-products-trigger
              data-i18n="navbar.products"
              data-nav-index={index}
            >
              {item.label}
            </button>
          );
        }
        let i18nKey = "";
        if (item.label.toLowerCase() === "nosotros") {
          i18nKey = "navbar.about";
        } else if (item.label.toLowerCase() === "desarrollo") {
          i18nKey = "navbar.developers";
        } else if (item.label.toLowerCase() === "otros") {
          i18nKey = "navbar.others";
        }

        const isExternal =
          item.label.toLowerCase() === "desarrollo" ||
          item.href.startsWith("http");
        return (
          <a
            class="simple-navbar__link"
            href={item.href}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
            data-i18n={i18nKey || undefined}
            data-nav-index={index}
          >
            {item.label}
          </a>
        );
      })
    }
  </div>
</header>

<style>
  .simple-navbar {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 1.25rem 0;
    font-family:
      "NataSans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;

    /* Scroll behavior styles */
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10000;
    background: rgba(
      255,
      255,
      255,
      0.95
    ); /* Ensure background is visible when sticky */
    backdrop-filter: blur(8px); /* Optional: nice glass effect */
    transition: transform 0.3s ease-in-out;
  }

  .simple-navbar--hidden {
    transform: translateY(-100%);
  }

  .simple-navbar__inner {
    width: 100%; /* Use full available width */
    max-width: 1600px; /* Increased from 1200px to allow more spread */
    padding: 0 clamp(24px, 5vw, 60px); /* Slightly increased horizontal padding */
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    position: relative;
  }

  .simple-navbar__logo img {
    height: 30px;
    width: auto;
    display: block;
  }

  .simple-navbar__links {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2vw, 2.5rem);
    margin-left: 15%; /* Added separation from logo */
  }

  .simple-navbar__link {
    text-decoration: none;
    color: #184090;
    font-size: 1rem;
    font-weight: 500;
    transition: opacity 0.2s ease;
    padding: 0.25rem 0;
  }

  .simple-navbar__link:hover {
    opacity: 0.75;
  }

  .simple-navbar__link--button {
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }

  .simple-navbar__actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .simple-navbar__demo-btn {
    flex-shrink: 0;
  }

  .simple-navbar__lang {
    width: 40px;
    height: 40px;
    border: 1.5px solid #111111;
    background: #ffffff;
    color: #111111;
    font-weight: 700;
    border-radius: 8px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    text-transform: uppercase;
  }

  .simple-navbar__lang:focus-visible {
    outline: 2px solid rgba(24, 64, 144, 0.45);
    outline-offset: 2px;
  }

  /* Mobile Styles */
  .simple-navbar__mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: #184090;
    margin-left: 0.5rem;
  }

  .simple-navbar__mobile-toggle:hover {
    opacity: 0.8;
  }

  .simple-navbar__mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: #ffffff;
    display: none;
    flex-direction: column;
    padding: 1rem 0;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
    border-top: 1px solid rgba(0, 0, 0, 0.05);
    z-index: 90;
  }

  .simple-navbar__mobile-menu.is-active {
    display: flex;
  }

  .simple-navbar__mobile-menu .simple-navbar__link {
    padding: 1rem 2rem;
    width: 100%;
    text-align: left;
    display: block;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .simple-navbar__mobile-menu .simple-navbar__link:last-child {
    border-bottom: none;
  }

  @media (max-width: 900px) {
    .simple-navbar__links {
      display: none;
    }

    .simple-navbar__mobile-toggle {
      display: block;
    }
  }

  @media (min-width: 901px) {
    .simple-navbar__mobile-menu,
    .simple-navbar__mobile-menu.is-active {
      display: none !important;
    }
  }
</style>

<script is:inline>
  // Traducciones del navbar
  const navbarTranslations = {
    en: {
      "navbar.products": "Products",
      "navbar.about": "About us",
      "navbar.developers": "Developers",
      "navbar.others": "Others",
      "navbar.demo": "Demo",
      "navbar.changeLanguage": "Change language",
    },
    es: {
      "navbar.products": "Productos",
      "navbar.about": "Nosotros",
      "navbar.developers": "Desarrollo",
      "navbar.others": "Otros",
      "navbar.demo": "Demo",
      "navbar.changeLanguage": "Cambiar idioma",
    },
  };

  // Función para aplicar traducciones del navbar
  function applyNavbarTranslations(lang = "es") {
    const langKey = lang.toLowerCase();
    const translations = navbarTranslations[langKey] || navbarTranslations.es;

    // Actualizar elementos con data-i18n
    document
      .querySelectorAll(".simple-navbar [data-i18n]")
      .forEach((element) => {
        const key = element.getAttribute("data-i18n");
        if (key && translations[key]) {
          element.textContent = translations[key];
        }
      });

    // Actualizar aria-labels
    document
      .querySelectorAll(".simple-navbar [data-i18n-aria-label]")
      .forEach((element) => {
        const key = element.getAttribute("data-i18n-aria-label");
        if (key && translations[key]) {
          element.setAttribute("aria-label", translations[key]);
        }
      });
  }

  document.addEventListener("DOMContentLoaded", () => {
    // Language toggle logic
    const button = document.querySelector(".simple-navbar__lang");
    if (button) {
      const label = button.querySelector(".simple-navbar__lang-text");
      const getLang = () => (button.dataset.lang === "EN" ? "EN" : "ES");
      const setLang = (lang) => {
        button.dataset.lang = lang;
        if (label) label.textContent = lang;

        // Aplicar traducciones del navbar
        applyNavbarTranslations(lang);

        // Disparar evento de cambio de idioma con bubbles para que se propague
        const event = new CustomEvent("ui:languagechange", {
          detail: { language: lang },
          bubbles: true,
          cancelable: true,
        });
        window.dispatchEvent(event);
        document.dispatchEvent(event);

        // Guardar en localStorage
        try {
          localStorage.setItem("ui-language", lang);
          localStorage.setItem("ui-language-source", "user");
        } catch (error) {
          console.warn("Unable to persist language preference.", error);
        }
      };

      const detectBrowserLanguage = () => {
        const locale =
          (navigator.languages && navigator.languages[0]) ||
          navigator.language ||
          "";
        return locale.toLowerCase().startsWith("es") ? "ES" : "EN";
      };

      // Cargar idioma guardado
      try {
        const stored = localStorage.getItem("ui-language");
        const source = localStorage.getItem("ui-language-source");
        if (
          source === "user" &&
          stored &&
          (stored === "EN" || stored === "ES")
        ) {
          setLang(stored);
        } else {
          setLang(detectBrowserLanguage());
        }
      } catch (error) {
        setLang(detectBrowserLanguage());
      }

      button.addEventListener("click", () => {
        setLang(getLang() === "EN" ? "ES" : "EN");
      });
    }

    // Escuchar cambios de idioma desde otros componentes
    window.addEventListener(
      "ui:languagechange",
      (event) => {
        const lang = event.detail?.language || "ES";
        applyNavbarTranslations(lang);
      },
      true,
    );

    // Scroll hide/show logic
    const navbar = document.querySelector(".simple-navbar");
    let lastScrollY = window.scrollY;

    if (navbar) {
      window.addEventListener(
        "scroll",
        () => {
          const currentScrollY = window.scrollY;

          // Show navbar if scrolling up or at the very top
          if (currentScrollY < lastScrollY || currentScrollY < 50) {
            navbar.classList.remove("simple-navbar--hidden");
          }
          // Hide navbar if scrolling down and past the threshold
          else if (currentScrollY > lastScrollY && currentScrollY > 50) {
            navbar.classList.add("simple-navbar--hidden");
          }

          lastScrollY = currentScrollY;
        },
        { passive: true },
      );
    }

    // Products Panel toggle logic
    const productsTrigger = document.querySelectorAll(
      "[data-products-trigger]",
    );
    const productsPanel = document.getElementById("products-panel");

    if (productsTrigger.length > 0 && productsPanel) {
      // Abrir panel (handle multiple triggers)
      productsTrigger.forEach((trigger) => {
        trigger.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          productsPanel.classList.remove("hidden");

          // Close mobile menu if open
          const mobileMenu = document.getElementById("mobile-menu");
          if (mobileMenu && mobileMenu.classList.contains("is-active")) {
            mobileMenu.classList.remove("is-active");
          }
        });
      });

      // Cerrar panel al hacer clic fuera
      document.addEventListener("click", (e) => {
        const target = e.target;
        // Check if click is inside panel or triggers
        let isTrigger = false;
        productsTrigger.forEach((t) => {
          if (t.contains(target)) isTrigger = true;
        });

        if (
          productsPanel &&
          target instanceof Node &&
          !productsPanel.contains(target) &&
          !isTrigger &&
          !productsPanel.classList.contains("hidden")
        ) {
          productsPanel.classList.add("hidden");
        }
      });

      // Cerrar panel con ESC
      document.addEventListener("keydown", (e) => {
        if (
          e.key === "Escape" &&
          productsPanel &&
          !productsPanel.classList.contains("hidden")
        ) {
          productsPanel.classList.add("hidden");
        }
      });
    }

    // Mobile Menu Logic
    const mobileToggle = document.getElementById("mobile-menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");

    if (mobileToggle && mobileMenu) {
      mobileToggle.addEventListener("click", () => {
        const isExpanded =
          mobileToggle.getAttribute("aria-expanded") === "true";
        mobileToggle.setAttribute("aria-expanded", !isExpanded);
        mobileMenu.classList.toggle("is-active");
      });

      // Cierra el menu si se hace click fuera
      document.addEventListener("click", (e) => {
        if (
          !mobileToggle.contains(e.target) &&
          !mobileMenu.contains(e.target) &&
          mobileMenu.classList.contains("is-active")
        ) {
          mobileMenu.classList.remove("is-active");
          mobileToggle.setAttribute("aria-expanded", "false");
        }
      });

      // Close menu on link click
      const mobileLinks = mobileMenu.querySelectorAll("a");
      mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.remove("is-active");
          mobileToggle.setAttribute("aria-expanded", "false");
        });
      });
    }
  });
</script>
