---
// Props configurables
const {
  logoSrc = "/images/zelify_logo2.png",
  logoAlt = "Zelify logo",
  colors = {},
  buttons = {},
} = Astro.props;

// Variables CSS (colores + tipografía)
const cssVars = `
   --nav-text: ${colors.text ?? "#ffffff"};
   --nav-text-hover: ${colors.textHover ?? "#ffffff"};
+  --nav-bg: ${colors.background ?? "transparent"};
   --highlight-bg: ${colors.highlightBg ?? "#6AFF00"};
   --highlight-text: ${colors.highlightText ?? "#0d1117"};
   --btn-outline: ${colors.btnOutline ?? "#ffffff"};
   --btn-outline-hover: ${colors.btnOutlineHover ?? "#6AFF00"};
   --btn-light-bg: ${colors.btnLightBg ?? "#69FE00"};
   --btn-light-hover-bg: ${colors.btnLightHoverBg ?? "#d6dbe0"};
   --btn-light-text: ${colors.btnLightText ?? "#212529"};
+  --btn-light-border: ${colors.btnLightBorder ?? "var(--btn-light-bg)"};
   --dropdown-bg: ${colors.dropdownBg ?? "#CDD1DD"};
   --dropdown-link: ${colors.dropdownLink ?? "#212529"};
   --dropdown-hover-bg: ${colors.dropdownHoverBg ?? "#CDD1DD"};
   --font-family: "NataSans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
`;
---

