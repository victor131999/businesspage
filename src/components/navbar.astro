      >
        <!-- cuerpo del maletín -->
        <rect x="3" y="7" width="18" height="13" rx="3"></rect>
        <!-- manija -->
        <path d="M9 7V6a3 3 0 0 1 6 0v1"></path>
        <!-- cerradura (punto central) -->
        <circle cx="12" cy="13" r="1.7" fill="currentColor" stroke="none"
        ></circle>
      </svg>
      {buttons.first?.label ?? "Work with us"}
    </a>

    <a href={buttons.second?.href ?? "/"} class="btn btn-light">
      <svg
        class="icon"
        viewBox="0 0 24 24"
        fill="currentColor"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M10 17L15 12L10 7V10H3V14H10V17ZM20 19H12V21H20C21.1 21 22 20.1 22 19V5C22 3.9 21.1 3 20 3H12V5H20V19Z"
        ></path>
