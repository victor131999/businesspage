        <li><a href="/auth" role="menuitem">Auth</a></li>
        <li><a href="/identity" role="menuitem">Identity</a></li>
        <li><a href="/amlCompliance" role="menuitem">AML Compliance</a></li>
        <li>
          <a href="/openBankingConnect" role="menuitem">Open Banking Connect</a>
        </li>
        <li><a href="/cardIssuing" role="menuitem">Card Issuing</a></li>
        <li><a href="/moneyTransfers" role="menuitem">Money Transfers</a></li>
        <li><a href="/transactions" role="menuitem">Transactions</a></li>
        <li><a href="/payments" role="menuitem">Payments</a></li>
        <li>
          <a href="/matildaAI" role="menuitem">Matilda AI Fintech Core</a>
        </li>
        <li><a href="/insurance" role="menuitem">Insurance</a></li>
        <li>
          <a href="/discountsCoupons" role="menuitem">Discounts & Coupons</a>
        </li>
      </ul> -->
      <button id="products-trigger" class="dropdown-trigger" type="button"
        >Products</button
      >
    </li>
    <li><a href="/">Resources</a></li>
    <li><a href="/">Developers</a></li>
    <li><a href="/" class="highlight">personal</a></li>
  </ul>
  <div class="action-links">
    <a href={buttons.first?.href ?? "/"} class="btn btn-light">
      <svg
        class="icon"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
