---
/**
 * Molecule: UnderlineTabs
 * Lista de tabs minimalista con indicador de borde inferior.
 * Uso: Navegación interna de contenido.
 */
import Button from "../atoms/Button.astro";

interface Props {
    tabs: { value: string; label: string; active?: boolean }[];
    name: string; // Para identificar el grupo
    class?: string;
}

const { tabs, name, class: className = "" } = Astro.props;
---

<div class:list={["ds-underline-tabs", className]} role="tablist">
    {
        tabs.map((tab, index) => (
            <Button
                variant="tab"
                type="button"
                role="tab"
                aria-selected={tab.active ? "true" : "false"}
                class:list={[tab.active && "active"]}
                data-tab-group={name}
                data-tab-value={tab.value}
            >
                {tab.label}
                {tab.active && <span class="ds-underline-tabs__indicator" />}
            </Button>
        ))
    }
</div>

<style is:global>
    .ds-underline-tabs {
        display: flex;
        gap: 3rem; /* Más espaciado entre tabs */
        border-bottom: 1px solid #e2e8f0;
        position: relative;
        padding-bottom: 1px;
    }

    @media (max-width: 639px) {
        .ds-underline-tabs {
            gap: 1.5rem;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
    }
</style>
