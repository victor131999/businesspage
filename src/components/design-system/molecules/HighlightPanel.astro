---
/**
 * Molecule: HighlightPanel
 * Panel con fondo gris (#f3f4f6), bordes redondeados (32px) y padding.
 * Se usa para resaltar contenido (ej: tarjeta de login) en secciones como "Cómo funciona" o "Why Zelify".
 * Slot default: Contenido principal (centrado verticalmente si es necesario).
 * Slot action: Botón flotante o posicionado (ej: Play button).
 */
interface Props {
    class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["ds-highlight-panel", className]}>
    <div class="ds-highlight-panel__content">
        <slot />
    </div>
    <div class="ds-highlight-panel__action">
        <slot name="action" />
    </div>
</div>

<style is:global>
    .ds-highlight-panel {
        background-color: var(--ds-color-bg-subtle, #f3f4f6);
        padding: 3rem 2rem;
        border-radius: 32px;
        width: 100%;
        max-width: 400px; /* Default logic from demo, can be overridden */
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        box-sizing: border-box;
    }

    .ds-highlight-panel__content {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .ds-highlight-panel__action {
        width: 100%;
        display: flex;
        justify-content: flex-end;
        margin-top: 1rem;
    }

    /* Empty action slot handling if needed, but flex handles it gracefully */
</style>
