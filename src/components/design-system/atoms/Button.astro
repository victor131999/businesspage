---
/**
 * Atom: Button
 * Variantes: primary | secondary | ghost | outline | icon | destructive
 * Tamaños: sm | md | lg
 * Estados: loading, disabled, fullWidth
 */
import Spinner from "./Spinner.astro";

interface Props {
  variant?:
    | "primary"
    | "secondary"
    | "ghost"
    | "outline"
    | "icon"
    | "destructive"
    | "tab";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit" | "reset";
  href?: string;
  class?: string;
  disabled?: boolean;
  loading?: boolean;
  fullWidth?: boolean;
  ariaLabel?: string;
  dataI18n?: string;
  [key: string]: unknown;
}

const {
  variant = "primary",
  size = "md",
  type = "button",
  href,
  class: className = "",
  disabled = false,
  loading = false,
  fullWidth = false,
  ariaLabel,
  dataI18n,
  ...rest
} = Astro.props;

const isLink = !!href;
const Tag = isLink ? "a" : "button";
---

<Tag
  href={!disabled && !loading ? href : undefined}
  type={!isLink ? type : undefined}
  class:list={[
    "ds-button",
    `ds-button--${variant}`,
    `ds-button--${size}`,
    { "ds-button--loading": loading },
    { "ds-button--full-width": fullWidth },
    className,
  ]}
  disabled={disabled || loading}
  aria-label={ariaLabel}
  data-i18n={dataI18n}
  {...rest}
>
  {
    loading && (
      <span class="ds-button__spinner">
        <Spinner size="sm" color="current" />
      </span>
    )
  }

  <span
    class:list={[
      "ds-button__content",
      { "ds-button__content--hidden": loading },
    ]}
  >
    <slot name="icon-left" />
    <slot />
    <slot name="icon-right" />
  </span>
</Tag>

<style is:global>
  .ds-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--ds-font-family);
    font-weight: var(--ds-font-weight-medium, 500);
    cursor: pointer;
    border: none;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
    border-radius: var(--ds-radius-lg, 14px);
    position: relative;
  }

  /* Full Width */
  .ds-button--full-width {
    width: 100%;
    display: flex;
  }

  /* Sizes */
  .ds-button--sm {
    padding: 0.5rem 1rem;
    font-size: var(--ds-font-size-sm, 1rem);
    min-height: 36px;
  }
  .ds-button--md {
    padding: 0.75rem 2rem;
    font-size: var(--ds-font-size-lg, 1.1rem);
    min-height: 48px;
  }
  .ds-button--lg {
    padding: 1rem 2.5rem;
    font-size: var(--ds-font-size-xl, 1.25rem);
    min-height: 56px;
  }

  /* Variant: Primary */
  .ds-button--primary {
    background: var(--ds-color-primary, #213f8c);
    color: #ffffff;
  }
  .ds-button--primary:hover:not(:disabled) {
    background: var(--ds-color-primary-light, #2a4fa8);
  }

  /* Variant: Secondary (Neon Green) - NO CHANGES */
  .ds-button--secondary {
    background: var(--ds-color-accent, #93fb4d);
    color: var(--ds-color-text, #00223e);
    box-shadow: var(--ds-shadow-cta);
  }
  .ds-button--secondary:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: var(--ds-shadow-cta-hover);
  }

  /* Variant: Destructive (New) */
  .ds-button--destructive {
    background: var(--ds-color-error, #d92d20);
    color: #ffffff;
  }
  .ds-button--destructive:hover:not(:disabled) {
    background: #b91c1c; /* Darker red */
    box-shadow: 0 4px 12px rgba(217, 45, 32, 0.3);
  }

  /* Variant: Outline */
  .ds-button--outline {
    background: transparent;
    color: var(--ds-color-text, #00223e);
    border: 2px solid var(--ds-color-border, #00223e);
  }
  .ds-button--outline:hover:not(:disabled) {
    background: var(--ds-color-bg-subtle, #f8f9fa);
  }
  .ds-button--outline.active {
    background: var(--ds-color-border, #00223e);
    color: #ffffff;
    border-color: var(--ds-color-border, #00223e);
  }

  /* Variant: Ghost */
  .ds-button--ghost {
    background: transparent;
    color: var(--ds-color-text);
    padding-left: 1rem;
    padding-right: 1rem;
  }
  .ds-button--ghost:hover:not(:disabled) {
    background: var(--ds-color-bg-subtle, #f8f9fa);
  }

  /* Variant: Icon (Circular) */
  .ds-button--icon {
    padding: 0;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    flex-shrink: 0;
    background: transparent;
  }
  .ds-button--icon img,
  .ds-button--icon svg {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  /* Loading State */
  .ds-button--loading {
    cursor: wait;
    opacity: 0.8;
  }

  .ds-button__spinner {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ds-button__content {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ds-button__content--hidden {
    opacity: 0;
    visibility: hidden;
  }

  /* Disabled state */
  .ds-button:disabled:not(.ds-button--loading) {
    opacity: 0.6;
    cursor: not-allowed;
    pointer-events: none;
    filter: grayscale(0.5); /* Additional visual cue */
  }

  /* Variant: Tab */
  .ds-button--tab {
    background: transparent;
    color: var(--ds-color-text-muted, #64748b);
    border-radius: 0;
    padding: 0.75rem 0;
    min-height: auto;
    font-weight: 400;
  }
  .ds-button--tab:hover:not(:disabled) {
    color: var(--ds-color-primary, #213f8c);
  }
  .ds-button--tab.active {
    color: var(--ds-color-primary, #213f8c);
    font-weight: 500;
  }
  .ds-button--tab.active::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: -10%;
    width: 120%;
    height: 2px;
    background-color: var(--ds-color-primary, #213f8c);
  }

  @media (max-width: 639px) {
    .ds-button--md {
      padding: 0.7rem 1.5rem;
      font-size: 1rem;
    }
    .ds-button-full-mobile {
      width: 100%;
    }

    .ds-button--tab {
      flex-shrink: 0;
    }
  }
</style>
