---
/**
 * Atom: Button
 * Variantes: primary | secondary | ghost | outline | icon
 * Tamaños: sm | md | lg
 */
interface Props {
  variant?: "primary" | "secondary" | "ghost" | "outline" | "icon";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit" | "reset";
  href?: string;
  class?: string;
  disabled?: boolean;
  ariaLabel?: string;
  dataI18n?: string;
  [key: string]: unknown;
}

const {
  variant = "primary",
  size = "md",
  type = "button",
  href,
  class: className = "",
  disabled = false,
  ariaLabel,
  dataI18n,
  ...rest
} = Astro.props;

const isLink = !!href;
const Tag = isLink ? "a" : "button";
---

<Tag
  href={href}
  type={!isLink ? type : undefined}
  class:list={[
    "ds-button",
    `ds-button--${variant}`,
    `ds-button--${size}`,
    className,
  ]}
  disabled={disabled}
  aria-label={ariaLabel}
  data-i18n={dataI18n}
  {...rest}
>
  <slot />
</Tag>

<style is:global>
  .ds-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--ds-font-family);
    font-weight: var(--ds-font-weight-medium, 500);
    cursor: pointer;
    border: none;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
    border-radius: var(--ds-radius-lg, 14px);
  }

  /* Sizes */
  .ds-button--sm {
    padding: 0.5rem 1rem;
    font-size: var(--ds-font-size-sm, 1rem);
    min-height: 36px;
  }
  .ds-button--md {
    padding: 0.75rem 2rem;
    font-size: var(--ds-font-size-lg, 1.1rem);
    min-height: 48px;
  }
  .ds-button--lg {
    padding: 1rem 2.5rem;
    font-size: var(--ds-font-size-xl, 1.25rem);
    min-height: 56px;
  }

  /* Variant: Primary */
  .ds-button--primary {
    background: var(--ds-color-primary, #213f8c);
    color: #ffffff;
  }
  .ds-button--primary:hover:not(:disabled) {
    background: var(--ds-color-primary-light, #2a4fa8);
  }

  /* Variant: Secondary (Neon Green) */
  .ds-button--secondary {
    background: var(--ds-color-accent, #93fb4d);
    color: var(--ds-color-text, #00223e);
    box-shadow: var(--ds-shadow-cta);
  }
  .ds-button--secondary:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: var(--ds-shadow-cta-hover);
  }

  /* Variant: Outline */
  .ds-button--outline {
    background: transparent;
    color: var(--ds-color-text, #00223e);
    border: 2px solid var(--ds-color-border, #00223e);
  }
  .ds-button--outline:hover:not(:disabled) {
    background: var(--ds-color-bg-subtle, #f8f9fa);
  }
  .ds-button--outline.active {
    background: var(--ds-color-border, #00223e);
    color: #ffffff;
    border-color: var(--ds-color-border, #00223e);
  }

  /* Variant: Ghost */
  .ds-button--ghost {
    background: transparent;
    color: var(--ds-color-text);
    padding-left: 1rem;
    padding-right: 1rem;
  }
  .ds-button--ghost:hover:not(:disabled) {
    background: var(--ds-color-bg-subtle, #f8f9fa);
  }

  /* Variant: Icon (Circular) */
  .ds-button--icon {
    padding: 0;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    flex-shrink: 0;
    background: transparent; 
   /* Default transparent, can be overridden or specific styles added if needed */
  }
  .ds-button--icon img, .ds-button--icon svg {
      width: 28px;
      height: 28px;
      object-fit: contain;
  }

  /* Disabled state */
  .ds-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    pointer-events: none;
  }

  @media (max-width: 639px) {
    .ds-button--md {
      padding: 0.7rem 1.5rem;
      font-size: 1rem;
    }
    .ds-button-full-mobile {
      width: 100%;
    }
  }
</style>
