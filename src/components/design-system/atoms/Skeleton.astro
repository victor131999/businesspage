---
/**
 * Atom: Skeleton
 * Placeholder animado para estados de carga.
 */
interface Props {
    width?: string;
    height?: string;
    circle?: boolean;
    class?: string;
}

const {
    width = "100%",
    height = "1rem",
    circle = false,
    class: className = "",
} = Astro.props;
---

<div
    class:list={["ds-skeleton", circle && "ds-skeleton--circle", className]}
    style={`width: ${width}; height: ${height};`}
    aria-hidden="true"
>
</div>

<style is:global>
    .ds-skeleton {
        background-color: #f3f4f6;
        border-radius: var(--ds-radius-sm, 6px);
        position: relative;
        overflow: hidden;
    }

    .ds-skeleton--circle {
        border-radius: 50%;
    }

    /* Shimmer effect */
    .ds-skeleton::after {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        transform: translateX(-100%);
        background: linear-gradient(
            90deg,
            rgba(255, 255, 255, 0) 0%,
            rgba(255, 255, 255, 0.5) 50%,
            rgba(255, 255, 255, 0) 100%
        );
        animation: ds-shimmer 2s infinite;
    }

    @keyframes ds-shimmer {
        100% {
            transform: translateX(100%);
        }
    }
</style>
