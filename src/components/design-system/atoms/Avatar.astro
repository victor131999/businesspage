---
interface Props {
    src?: string;
    alt?: string;
    initials?: string;
    size?: "sm" | "md" | "lg";
    class?: string;
}

const {
    src,
    alt = "Avatar",
    initials = "U",
    size = "md",
    class: className,
} = Astro.props;
---

<div class:list={["ds-avatar", `ds-avatar--${size}`, className]}>
    {
        src ? (
            <img src={src} alt={alt} class="ds-avatar__image" loading="lazy" />
        ) : (
            <span class="ds-avatar__initials">{initials.substring(0, 2)}</span>
        )
    }
</div>

<style>
    .ds-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        overflow: hidden;
        background-color: #e2e8f0;
        color: #475569;
        flex-shrink: 0;
        font-family: var(--font-primary, sans-serif);
        font-weight: 600;
    }

    .ds-avatar__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .ds-avatar__initials {
        text-transform: uppercase;
    }

    /* Sizes */
    .ds-avatar--sm {
        width: 2rem;
        height: 2rem;
        font-size: 0.75rem;
    }

    .ds-avatar--md {
        width: 2.5rem;
        height: 2.5rem;
        font-size: 1rem;
    }

    .ds-avatar--lg {
        width: 4rem;
        height: 4rem;
        font-size: 1.5rem;
    }
</style>
