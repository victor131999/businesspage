---
/**
 * Atom: IconButton
 * Para cerrar modal, play/pause, etc. Circular.
 * Responsive: tamaño fijo; en móvil puede reducir con clase.
 */
interface Props {
  type?: "button" | "submit";
  ariaLabel: string;
  class?: string;
}
const { type = "button", ariaLabel, class: className = "" } = Astro.props;
---
<button type={type} class:list={["ds-icon-button", className]} aria-label={ariaLabel}>
  <slot />
</button>
<style is:global>
  .ds-icon-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    border-radius: var(--ds-radius-full, 50%);
    background: transparent;
    color: var(--ds-color-text-light, #94a3b8);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .ds-icon-button:hover {
    background: var(--ds-color-bg-subtle, #f1f5f9);
    color: var(--ds-color-text);
  }
  .ds-icon-button--lg {
    width: 52px;
    height: 52px;
  }
  @media (max-width: 639px) {
    .ds-icon-button--lg {
      width: 44px;
      height: 44px;
    }
  }
</style>
