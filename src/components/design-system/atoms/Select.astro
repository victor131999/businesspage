---
/**
 * Atom: Select
 * Menú desplegable nativo estilizado.
 */
interface Props {
    name: string;
    value?: string;
    label?: string; // Optional label for internal use or aria
    disabled?: boolean;
    required?: boolean;
    invalid?: boolean;
    class?: string;
    options: { value: string; label: string; disabled?: boolean }[];
    [key: string]: unknown;
}

const {
    name,
    value,
    label,
    disabled = false,
    required = false,
    invalid = false,
    class: className = "",
    options = [],
    ...rest
} = Astro.props;
---

<div class:list={["ds-select-wrapper", className]}>
    <select
        name={name}
        disabled={disabled}
        required={required}
        class:list={["ds-select", invalid && "ds-select--invalid"]}
        aria-label={label}
        {...rest}
    >
        {
            options.map((opt) => (
                <option
                    value={opt.value}
                    selected={opt.value === value}
                    disabled={opt.disabled}
                >
                    {opt.label}
                </option>
            ))
        }
    </select>
    <div class="ds-select-arrow">
        <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
        >
            <path d="M6 9l6 6 6-6"></path>
        </svg>
    </div>
</div>

<style is:global>
    .ds-select-wrapper {
        position: relative;
        width: 100%;
    }

    .ds-select {
        width: 100%;
        appearance: none;
        -webkit-appearance: none;
        padding: 0.75rem 2.5rem 0.75rem 1.25rem; /* Space for arrow */
        font-family: var(--ds-font-family);
        font-size: var(--ds-font-size-md, 1.05rem);
        color: var(--ds-color-text, #00223e);
        background-color: #ffffff;
        border: 1px solid var(--ds-color-border-light, rgba(0, 0, 0, 0.1));
        border-radius: var(--ds-radius-md, 12px);
        outline: none;
        transition: all 0.2s ease;
        cursor: pointer;
        line-height: 1.5;
    }

    .ds-select:hover:not(:disabled) {
        border-color: rgba(0, 34, 62, 0.3);
    }

    .ds-select:focus:not(:disabled) {
        border-color: var(--ds-color-primary, #213f8c);
        box-shadow: 0 0 0 3px rgba(33, 63, 140, 0.1);
    }

    .ds-select--invalid {
        border-color: var(--ds-color-error, #d92d20);
    }

    .ds-select--invalid:focus {
        border-color: var(--ds-color-error, #d92d20);
        box-shadow: 0 0 0 3px rgba(217, 45, 32, 0.1);
    }

    .ds-select:disabled {
        background-color: var(--ds-color-bg-subtle, #f8f9fa);
        cursor: not-allowed;
        opacity: 0.7;
        color: var(--ds-color-text-light, #64748b);
    }

    .ds-select-arrow {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
        color: var(--ds-color-text-light, #64748b);
        display: flex;
        align-items: center;
    }

    .ds-select:disabled + .ds-select-arrow {
        opacity: 0.5;
    }
</style>
