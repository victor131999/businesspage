---
/**
 * Organism: QuoteModalHubSpot
 * Modal de cotización con embed de HubSpot Meetings. Cerrar con X o overlay.
 * Responsive: modal 90% ancho, body con min-height adaptativo.
 */
import Modal from "../molecules/Modal.astro";
---

<Modal id="quote-modal" ariaLabel="Solicitar cotización">
  <!-- Start of Meetings Embed Script (data-src-es: Spanish, data-src-en: English) -->
  <div
    class="meetings-iframe-container"
    data-src="https://meetings.hubspot.com/gmantilla?embed=true"
    data-src-es="https://meetings.hubspot.com/gmantilla?embed=true"
    data-src-en="https://meetings.hubspot.com/sales-zwippe?embed=true"
  ></div>
  <script
    type="text/javascript"
    src="https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js"
  ></script>
  <!-- End of Meetings Embed Script -->
</Modal>

<style is:global>
  .quote-modal-body .meetings-iframe-container {
    min-height: 400px;
    width: 100%;
  }
  .quote-modal-body .meetings-iframe-container iframe {
    width: 100%;
    min-height: 400px;
    border: none;
  }
  @media (max-width: 639px) {
    .quote-modal-body .meetings-iframe-container,
    .quote-modal-body .meetings-iframe-container iframe {
      min-height: 320px;
    }
  }
</style>
