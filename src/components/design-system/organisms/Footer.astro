---
/**
 * Organism: Footer
 * Footer unificado: logo Zelify, enlaces rápidos, disclaimer legal y copyright.
 * Responsive: grid 2 columnas → flex row → columna centrada en móvil.
 */


export interface FooterLink {
  href: string;
  label: string;
  dataI18n?: string;
  /** Si es true, abre en nueva pestaña (target="_blank" rel="noopener noreferrer") */
  openInNewTab?: boolean;
}

interface Props {
  quickLinksTitle?: string;
  links?: FooterLinkWithKey[];
  legalText?: string;
  copyrightText?: string;
  /** Claves data-i18n para traducción (ej. index) */
  dataI18n?: {
    quicklinks?: string;
    legal?: string;
    copyright?: string;
  };
}

export interface FooterLinkWithKey extends FooterLink {
  key?: string;
}

const defaultLinks: FooterLinkWithKey[] = [
  { href: "", label: "Products", key: "products" },
  { href: "https://docs.zelify.com", label: "Developers", key: "developers", openInNewTab: true },
  { href: "/blog", label: "Blog", key: "blog" },
];

/** Enlaces a productos que se muestran al expandir "Products" en el footer */
const productLinks: { href: string; labelKey: string }[] = [
  { href: "/auth", labelKey: "auth" },
  { href: "/identity", labelKey: "identity" },
  { href: "/aml", labelKey: "aml" },
  { href: "/connect", labelKey: "connect" },
  { href: "/cards", labelKey: "cards" },
  { href: "/tx", labelKey: "tx" },
  { href: "/transfers", labelKey: "paymentsTransfers" },
  { href: "/discounts", labelKey: "discounts" },
  { href: "/alaiza", labelKey: "alaiza" },
];

const defaultLegal =
  "Zelify is a technology platform currently in a development phase, not yet deployed or operational, and does not provide or process financial services directly; all financial operations are conducted exclusively through regulated third-party partners.";

const {
  quickLinksTitle = "Quick links",
  links = defaultLinks,
  legalText = defaultLegal,
  copyrightText = "© 2025 Zelify. All rights reserved.",
  dataI18n,
} = Astro.props;

const FOOTER_T = {
  es: {
    quickLinks: "Enlaces rápidos",
    products: "Productos",
    developers: "Desarrolladores",
    blog: "Blog",
    auth: "Auth",
    identity: "Identity",
    aml: "AML",
    connect: "Connect",
    cards: "Cards",
    tx: "TX",
    paymentsTransfers: "Pagos y Transferencias",
    discounts: "Descuentos y Cupones",
    alaiza: "Alaiza AI Fintech Core",
    legal:
      "Zelify es una plataforma tecnológica actualmente en fase de desarrollo, aún no desplegada u operativa, y no proporciona ni procesa servicios financieros directamente; todas las operaciones financieras se realizan exclusivamente a través de socios terceros regulados.",
    copyright: "© 2025 Zelify. Todos los derechos reservados.",
  },
  en: {
    quickLinks: "Quick links",
    products: "Products",
    developers: "Developers",
    blog: "Blog",
    auth: "Auth",
    identity: "Identity",
    aml: "AML",
    connect: "Connect",
    cards: "Cards",
    tx: "TX",
    paymentsTransfers: "Payments and Transfers",
    discounts: "Discounts & Coupons",
    alaiza: "Alaiza AI Fintech Core",
    legal: defaultLegal,
    copyright: "© 2025 Zelify. All rights reserved.",
  },
};
---

<footer class="footer-section">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-logo">
        <img
          src="/images/zelify_logo2.png"
          alt="Zelify"
        />
      </div>
      <div class="footer-quick-links">
        <h3
          class="quick-links-title"
          data-footer-i18n="quickLinks"
          {...(dataI18n?.quicklinks && { "data-i18n": dataI18n.quicklinks })}
        >
          {quickLinksTitle}
        </h3>
        <ul class="quick-links-list">
          {
            links.map((link) => {
              const isProducts = (link as FooterLinkWithKey).key === "products";
              return (
                <>
                  {isProducts && (
                    <li>
                      <button
                        type="button"
                        class="footer-link-button footer-products-trigger"
                        data-footer-key="products"
                        aria-expanded="false"
                        aria-controls="footer-products-panel"
                        {...(link.dataI18n && { "data-i18n": link.dataI18n })}
                      >
                        <span class="footer-products-trigger__text">{link.label}</span>
                        <span class="footer-products-trigger__chevron" aria-hidden="true">‹</span>
                      </button>
                    </li>
                  )}
                  {isProducts && (
                    <li class="footer-products-panel-li">
                      <div
                        id="footer-products-panel"
                        class="footer-products-panel"
                        role="region"
                        aria-label="Productos"
                        aria-hidden="true"
                      >
                        <div class="footer-products-panel__inner">
                          <div class="footer-products-panel__grid">
                            <div class="footer-products-panel__col">
                              {
                                productLinks.slice(0, 3).map((item) => (
                                  <a
                                    href={item.href}
                                    class="footer-products-panel__link"
                                    data-footer-product={item.labelKey}
                                  >
                                    {FOOTER_T.en[item.labelKey as keyof typeof FOOTER_T.en] ?? item.labelKey}
                                  </a>
                                ))
                              }
                            </div>
                            <div class="footer-products-panel__col">
                              {
                                productLinks.slice(3, 6).map((item) => (
                                  <a
                                    href={item.href}
                                    class="footer-products-panel__link"
                                    data-footer-product={item.labelKey}
                                  >
                                    {FOOTER_T.en[item.labelKey as keyof typeof FOOTER_T.en] ?? item.labelKey}
                                  </a>
                                ))
                              }
                            </div>
                            <div class="footer-products-panel__col">
                              {
                                productLinks.slice(6, 9).map((item) => (
                                  <a
                                    href={item.href}
                                    class="footer-products-panel__link"
                                    data-footer-product={item.labelKey}
                                  >
                                    {FOOTER_T.en[item.labelKey as keyof typeof FOOTER_T.en] ?? item.labelKey}
                                  </a>
                                ))
                              }
                            </div>
                          </div>
                        </div>
                      </div>
                    </li>
                  )}
                  {!isProducts && (
                    <li>
                      <a
                        href={link.href}
                        {...(link.openInNewTab && {
                          target: "_blank",
                          rel: "noopener noreferrer",
                        })}
                        {...((link as FooterLinkWithKey).key && {
                          "data-footer-key": (link as FooterLinkWithKey).key,
                        })}
                        {...(link.dataI18n && { "data-i18n": link.dataI18n })}
                      >
                        {link.label}
                      </a>
                    </li>
                  )}
                </>
              );
            })
          }
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p
        class="footer-legal"
        data-footer-i18n="legal"
        {...(dataI18n?.legal && { "data-i18n": dataI18n.legal })}
      >
        {legalText}
      </p>
      <p
        class="footer-copyright"
        data-footer-i18n="copyright"
        {...(dataI18n?.copyright && { "data-i18n": dataI18n.copyright })}
      >
        {copyrightText}
      </p>
    </div>
  </div>
</footer>

<style is:global>
  /* ---- Footer: bloque principal ---- */
  .footer-section {
    width: 100%;
    background: #0a203f;
    color: #fff;
    position: relative;
    z-index: 1;
    overflow: visible;
    padding-top: 4rem;
    padding-bottom: 3rem;
  }

  .footer-container {
    padding-left: 4.5rem;
    padding-right: 4.5rem;
  }

  /* ---- Parte superior: logo + enlaces (flex, sin columnas iguales) ---- */
  .footer-top {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2rem;
    width: 100%;
    position: relative;
  }

  .footer-logo {
    flex-shrink: 0;
  }

  .footer-logo img {
    display: block;
    height: 40px;
    width: auto;
  }

  .footer-quick-links {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .quick-links-title {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
  }

  .quick-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .quick-links-list li {
    margin: 0;
  }

  /* Panel entre Products y el siguiente enlace: en desktop se posiciona en el centro */
  .footer-products-panel-li {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 769px) {
    .footer-products-panel-li {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      width: fit-content;
      max-width: min(560px, 48vw);
      top: 0;
      overflow: hidden;
      pointer-events: none;
    }
    .footer-products-panel-li .footer-products-panel {
      pointer-events: auto;
    }
  }

  .quick-links-list a {
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .quick-links-list .footer-link-button {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0;
    margin: 0;
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1.4;
    transition: color 0.2s ease;
    cursor: pointer;
    font-family: inherit;
  }

  .quick-links-list a:hover {
    color: #93fb4d;
  }

  .quick-links-list .footer-link-button:hover {
    color: #93fb4d;
  }

  .footer-products-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .footer-products-trigger__chevron {
    font-size: 0.6em;
    opacity: 0.85;
    transition: transform 0.2s ease;
  }

  .footer-section.is-products-expanded .footer-products-trigger__chevron {
    transform: rotate(180deg);
  }

  /* Panel expandible de productos: ocupa el espacio central, se expande hacia la izquierda desde "Products" */
  .footer-products-panel {
    flex: 0 0 auto;
    max-width: 0;
    max-height: 100vh; /* no colapsar altura en desktop (solo ancho) */
    overflow: hidden;
    align-self: stretch;
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
    transition: max-width 0.35s ease-out, max-height 0.3s ease-out;
    min-width: 0;
  }

  .footer-products-panel.footer-products-panel--open {
    max-width: min(560px, 48vw);
  }

  .footer-products-panel__inner {
    width: 100%;
    min-width: 0;
    padding: 0.25rem 0 0;
    box-sizing: border-box;
  }

  .footer-products-panel--open .footer-products-panel__inner {
    padding-left: 0.5rem;
    padding-right: 1rem;
  }

  /* 3 columnas: 3 + 3 + 3 ítems; espaciado uniforme */
  .footer-products-panel__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem 1.25rem;
    align-items: start;
    justify-items: start;
  }

  .footer-products-panel__col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: flex-start;
    width: 100%;
  }

  .footer-products-panel__link {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.45;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .footer-products-panel__link:hover {
    color: #93fb4d;
  }

  /* ---- Parte inferior: legal + copyright ---- */
  .footer-bottom {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .footer-legal {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.55;
    margin: 0;
    max-width: 720px;
  }

  .footer-copyright {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
  }

  /* ---- Tablet ---- */
  @media (max-width: 1024px) {
    .footer-section {
      padding: 3rem 0 2.5rem;
    }
    .footer-container {
      padding: 0 0.75rem;
    }
    .footer-top {
      justify-content: space-between;
      gap: 1.5rem;
    }
    .footer-products-panel.footer-products-panel--open {
      max-width: min(480px, 55vw);
    }
    .footer-products-panel__grid {
      gap: 0.45rem 1rem;
    }
    .footer-products-panel__link {
      font-size: 0.875rem;
    }
  }

  /* ---- Tablet: reducir espacio y colapsar panel cerrado ---- */
  @media (max-width: 768px) {
    .footer-top {
      gap: 1rem;
    }
    .footer-products-panel:not(.footer-products-panel--open) {
      max-height: 0;
      min-height: 0;
      margin: 0;
      padding: 0;
      overflow: hidden;
    }
    .footer-products-panel.footer-products-panel--open {
      max-width: 100%;
    }
  }

  /* ---- Móvil: logo y enlaces en columna centrados ---- */
  @media (max-width: 640px) {
    .footer-section {
      padding: 2.5rem 0 2rem;
    }
    .footer-container {
      padding: 0 0.5rem;
    }
    .footer-top {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1rem;
    }
    .footer-products-panel:not(.footer-products-panel--open) {
      max-height: 0;
      min-height: 0;
      margin: 0;
      padding: 0;
      overflow: hidden;
    }
    .footer-products-panel.footer-products-panel--open {
      max-width: 100%;
    }
    .footer-quick-links {
      align-items: center;
    }
    .quick-links-list {
      align-items: center;
    }
    .footer-products-panel {
      justify-content: center;
      width: 100%;
    }
    .footer-products-panel.footer-products-panel--open {
      max-width: 100%;
    }
    .footer-products-panel__inner {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
      width: 100%;
    }
    .footer-products-panel__grid {
      grid-template-columns: 1fr;
      gap: 1rem 0;
      justify-items: center;
    }
    .footer-products-panel__col {
      align-items: center;
      width: auto;
    }
    .footer-products-panel__link {
      font-size: 0.9rem;
    }
    .footer-bottom {
      margin-top: 2rem;
      padding-top: 1.5rem;
    }
    .footer-legal {
      font-size: 0.75rem;
    }
    .footer-copyright {
      font-size: 0.75rem;
    }
  }
</style>

<script define:vars={{ FOOTER_T }}>
  function getFooterLang() {
    try {
      const stored = localStorage.getItem("ui-language");
      return (stored && stored.toUpperCase() === "ES") ? "es" : "en";
    } catch {
      return "en";
    }
  }

  function applyFooterTranslations(overrideLang) {
    const lang = overrideLang !== undefined
      ? (overrideLang === "es" || overrideLang === "ES" ? "es" : "en")
      : getFooterLang();
    const t = FOOTER_T[lang] || FOOTER_T.en;

    const titleEl = document.querySelector(".footer-section .quick-links-title");
    if (titleEl && titleEl.hasAttribute("data-footer-i18n")) {
      titleEl.textContent = t.quickLinks;
    }

    const legalEl = document.querySelector(".footer-section .footer-legal");
    if (legalEl && legalEl.hasAttribute("data-footer-i18n")) {
      legalEl.textContent = t.legal;
    }

    const copyrightEl = document.querySelector(".footer-section .footer-copyright");
    if (copyrightEl && copyrightEl.hasAttribute("data-footer-i18n")) {
      copyrightEl.textContent = t.copyright;
    }

    document.querySelectorAll(".footer-section .quick-links-list [data-footer-key]").forEach((el) => {
      const key = el.getAttribute("data-footer-key");
      if (key && t[key]) {
        const textSpan = el.querySelector(".footer-products-trigger__text");
        if (textSpan) textSpan.textContent = t[key];
        else el.textContent = t[key];
      }
    });

    document.querySelectorAll(".footer-section [data-footer-product]").forEach((el) => {
      const key = el.getAttribute("data-footer-product");
      if (key && t[key]) el.textContent = t[key];
    });
  }

  if (typeof document !== "undefined") {
    applyFooterTranslations();
    window.addEventListener("ui:languagechange", (e) => {
      const lang = e.detail?.language;
      applyFooterTranslations(lang);
    });

    const productsTrigger = document.querySelector(
      ".footer-section .footer-products-trigger",
    );
    const footerProductsPanel = document.getElementById("footer-products-panel");

    if (productsTrigger && footerProductsPanel) {
      const footerSection = document.querySelector(".footer-section");
      const toggleExpanded = (expanded) => {
        if (expanded) {
          footerProductsPanel.classList.add("footer-products-panel--open");
          footerProductsPanel.setAttribute("aria-hidden", "false");
        } else {
          footerProductsPanel.classList.remove("footer-products-panel--open");
          footerProductsPanel.setAttribute("aria-hidden", "true");
        }
        productsTrigger.setAttribute("aria-expanded", String(expanded));
        footerSection?.classList.toggle("is-products-expanded", expanded);
      };

      productsTrigger.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isOpen = footerProductsPanel.classList.contains("footer-products-panel--open");
        toggleExpanded(!isOpen);
      });

      document.addEventListener("click", (e) => {
        const target = e.target;
        if (
          target instanceof Node &&
          !footerProductsPanel.contains(target) &&
          !productsTrigger.contains(target)
        ) {
          toggleExpanded(false);
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && footerProductsPanel.classList.contains("footer-products-panel--open")) {
          toggleExpanded(false);
        }
      });
    }
  }
</script>
