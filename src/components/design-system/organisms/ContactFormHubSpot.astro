---
export interface Props {
  headline?: string;
  formTitle?: string;
  /** Título de la sección en inglés (para i18n) */
  headlineEn?: string;
  /** Título del formulario en inglés (para i18n) */
  formTitleEn?: string;
  /** Texto del botón en español */
  submitEs?: string;
  /** Texto del botón en inglés (para i18n) */
  submitEn?: string;
}

const {
  headline = "Comienza a construir el banco del futuro, hoy.",
  formTitle = "Habla con nuestro equipo",
  headlineEn = "Start building the bank of the future, today.",
  formTitleEn = "Talk to our team",
  submitEs = "Hablemos",
  submitEn = "Let's Talk",
} = Astro.props;
---

<section
  class="hubspot-contact-section"
  data-headline-es={headline}
  data-headline-en={headlineEn}
  data-formtitle-es={formTitle}
  data-formtitle-en={formTitleEn}
  data-submit-es={submitEs}
  data-submit-en={submitEn}
  data-contact-i18n
>
  <div class="hubspot-contact-container">
    <div class="hubspot-contact-content">
      <div class="hubspot-contact-text">
        <h2 class="hubspot-contact-title">{headline}</h2>
      </div>
      <div class="hubspot-contact-form-wrapper">
        <div class="hubspot-contact-form-card">
          <h3 class="hubspot-contact-form-title">{formTitle}</h3>

          <form class="hubspot-contact-form" id="contactForm" method="post" action="#">
            <div class="hubspot-form-row">
              <div class="hubspot-form-group">
                <input type="text" id="nombres" name="firstname" placeholder="Nombres" required aria-describedby="error-firstname" aria-invalid="false" />
                <span class="hubspot-field-error" id="error-firstname" data-field="firstname" role="alert"></span>
              </div>
              <div class="hubspot-form-group">
                <input type="text" id="apellidos" name="lastname" placeholder="Apellidos" required aria-describedby="error-lastname" aria-invalid="false" />
                <span class="hubspot-field-error" id="error-lastname" data-field="lastname" role="alert"></span>
              </div>
            </div>

            <div class="hubspot-form-row">
              <div class="hubspot-form-group">
                <input type="text" id="compania" name="company" placeholder="Nombre de la compañía" required aria-describedby="error-company" aria-invalid="false" />
                <span class="hubspot-field-error" id="error-company" data-field="company" role="alert"></span>
              </div>
              <div class="hubspot-form-group">
                <input type="email" id="email" name="email" placeholder="Email de la compañía" required aria-describedby="error-email" aria-invalid="false" />
                <span class="hubspot-field-error" id="error-email" data-field="email" role="alert"></span>
              </div>
            </div>

            <div class="hubspot-form-row">
              <div class="hubspot-form-group">
                <select id="pais" name="country" required aria-describedby="error-country" aria-invalid="false">
                  <option value="">País</option>
                  <option value="ec">Ecuador</option>
                  <option value="co">Colombia</option>
                  <option value="cl">Chile</option>
                  <option value="mx">México</option>
                  <option value="br">Brasil</option>
                  <option value="us">Estados Unidos</option>
                  <option value="ar">Argentina</option>
                  <option value="pe">Perú</option>
                  <option value="es">España</option>
                  <option value="uy">Uruguay</option>
                  <option value="py">Paraguay</option>
                  <option value="bo">Bolivia</option>
                  <option value="cr">Costa Rica</option>
                  <option value="pa">Panamá</option>
                  <option value="gt">Guatemala</option>
                  <option value="do">República Dominicana</option>
                  <option value="other">Otro</option>
                </select>
                <svg class="hubspot-select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                <span class="hubspot-field-error" id="error-country" data-field="country" role="alert"></span>
              </div>
              <div class="hubspot-form-group">
                <input type="tel" id="telefono" name="phone" placeholder="Teléfono" inputmode="numeric" pattern="[0-9+\s\-]*" maxlength="20" required aria-describedby="error-phone" aria-invalid="false" autocomplete="tel" />
                <span class="hubspot-field-error" id="error-phone" data-field="phone" role="alert"></span>
              </div>
            </div>

            <p class="hubspot-contact-legal">
              Al enviar este formulario, aceptas nuestros <a href="#">Términos de Servicio</a> y <a href="#">Política de Privacidad</a>.
            </p>

            <div class="hubspot-turnstile-wrap" id="contactFormTurnstileWrap">
              <div id="contactFormTurnstile" aria-label="Verificación de seguridad"></div>
              <span class="hubspot-field-error" id="error-turnstile" role="alert" aria-live="polite"></span>
            </div>

            <div id="contactFormMessage" class="hubspot-contact-form-message" role="status" aria-live="polite" hidden></div>
            <input type="submit" class="hubspot-contact-submit-btn" id="contactFormSubmit" value={submitEs} />
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style>
  .hubspot-contact-section {
    width: 100%;
    background: #ffffff;
    padding: 5rem 2rem;
  }
  .hubspot-contact-container { max-width: 1200px; margin: 0 auto; }
  .hubspot-contact-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .hubspot-contact-text { display: flex; align-items: center; }
  .hubspot-contact-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.2;
    color: #0a203f;
    margin: 0;
    font-weight: 400;
    text-align: left;
  }
  .hubspot-contact-form-wrapper { display: flex; justify-content: flex-end; }
  .hubspot-contact-form-card {
    background: #f3f4f6;
    border-radius: 24px;
    padding: 3rem;
    max-width: 600px;
    width: 100%;
  }
  .hubspot-contact-form-title {
    font-size: 1.75rem;
    font-weight: 600;
    color: #0a203f;
    margin: 0 0 2rem 0;
  }
  .hubspot-contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .hubspot-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .hubspot-form-group { position: relative; }
  .hubspot-field-error {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.8rem;
    color: #b91c1c;
    min-height: 1.25em;
  }
  .hubspot-form-group.has-error input,
  .hubspot-form-group.has-error select {
    border: 1px solid #dc2626 !important;
    box-shadow: 0 0 0 2px rgba(220, 38, 38, 0.2);
  }
  .hubspot-contact-form input,
  .hubspot-contact-form select {
    width: 100%;
    padding: 0.875rem 1rem;
    border: none;
    border-radius: 12px;
    background: #ffffff;
    font-size: 0.95rem;
    color: #0a203f;
    font-family: inherit;
    outline: none;
    transition: all 0.2s ease;
  }
  .hubspot-contact-form input::placeholder { color: #9ca3af; }
  .hubspot-contact-form input:focus,
  .hubspot-contact-form select:focus {
    box-shadow: 0 0 0 3px rgba(33, 63, 140, 0.1);
  }
  .hubspot-contact-form select {
    appearance: none;
    cursor: pointer;
    padding-right: 2.5rem;
  }
  .hubspot-select-arrow {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: #6b7280;
    pointer-events: none;
  }
  :global(.hubspot-contact-legal) {
    font-size: 0.85rem;
    color: #6b7280;
    line-height: 1.5;
    margin: 0.5rem 0 0 0;
  }
  :global(.hubspot-contact-legal a) {
    color: #6b7280;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }
  :global(.hubspot-contact-legal a:hover) { color: #213f8c; }
  .hubspot-turnstile-wrap { margin-bottom: -0.5rem; }
  .hubspot-turnstile-wrap .hubspot-field-error { margin-top: 1px; }
  .hubspot-turnstile-wrap #contactFormTurnstile,
  .hubspot-turnstile-wrap .cf-turnstile { min-height: 65px; }
  .hubspot-contact-form-message {
    margin-top: 0.5rem;
    padding: 0.4rem 0.65rem;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.35;
  }
  .hubspot-contact-form-message.success {
    background: rgba(34, 197, 94, 0.12);
    color: #15803d;
    border: 1px solid rgba(34, 197, 94, 0.35);
  }
  .hubspot-contact-form-message.error {
    background: rgba(220, 38, 38, 0.08);
    color: #b91c1c;
    border: 1px solid rgba(220, 38, 38, 0.25);
    font-size: 0.8rem;
  }
  .hubspot-contact-submit-btn {
    display: block;
    width: 100%;
    padding: 1rem 2rem;
    margin-top: 0.5rem;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    color: #082436 !important;
    background: #8dff2b !important;
    background-color: #8dff2b !important;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }
  .hubspot-contact-submit-btn:hover {
    background: #a5ff4d !important;
    background-color: #a5ff4d !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
  }
  .hubspot-contact-submit-btn:active { transform: translateY(0); }
  .hubspot-contact-submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }
  @media (max-width: 1024px) {
    .hubspot-contact-section { padding: 4rem 2rem; }
    .hubspot-contact-content { gap: 3rem; }
    .hubspot-contact-form-card { padding: 2.5rem; }
  }
  @media (max-width: 768px) {
    .hubspot-contact-section { padding: 3rem 1.5rem; }
    .hubspot-contact-content { grid-template-columns: 1fr; gap: 3rem; }
    .hubspot-contact-title { font-size: 2.5rem; text-align: center; }
    .hubspot-contact-form-wrapper { justify-content: center; }
    .hubspot-contact-form-card { padding: 2rem; }
    .hubspot-form-row { grid-template-columns: 1fr; }
    .hubspot-contact-form-title { font-size: 1.5rem; text-align: center; }
  }
</style>

<script>
  (function () {
    const PORTAL_ID = "50894304";
    const FORM_GUID = "489f3583-7545-465d-8eb5-d9cd0162e131";
    const API_URL = `https://api.hsforms.com/submissions/v3/integration/submit/${PORTAL_ID}/${FORM_GUID}`;
    const TURNSTILE_SITEKEY = "0x4AAAAAACTr8BCSls7WtvbZ";

    const REQUIRED_FIELDS = [
      { name: "firstname", label: "Nombres" },
      { name: "lastname", label: "Apellidos" },
      { name: "company", label: "Nombre de la compañía" },
      { name: "email", label: "Email de la compañía" },
      { name: "country", label: "País" },
      { name: "phone", label: "Teléfono" },
    ];

    const form = document.getElementById("contactForm");
    const submitBtn = document.getElementById("contactFormSubmit");
    const messageEl = document.getElementById("contactFormMessage");
    if (!form || !submitBtn || !messageEl) return;

    let isEnUi = false;
    const COPY = {
      ES: {
        requiredField: "Completa este campo.",
        invalidEmail: "Ingresa un email válido.",
        invalidPhone: "Solo se permiten números (y opcionalmente + al inicio).",
        turnstileRequired: "Completa la verificación de seguridad antes de enviar.",
        turnstileRequiredLong:
          "Completa la verificación de seguridad (captcha) antes de enviar.",
        requiredFieldsSummary:
          "Completa todos los campos obligatorios marcados en rojo.",
        submitting: "Enviando…",
        consent:
          "Al enviar este formulario, aceptas nuestros Términos de Servicio y Política de Privacidad.",
        success: "Gracias. Te responderemos pronto.",
        sendFailed: "No se pudo enviar. Intenta de nuevo.",
        connectionError:
          "Error de conexión. Revisa tu internet e intenta de nuevo.",
        turnstileAria: "Verificación de seguridad",
        submitFallback: "Hablemos",
      },
      EN: {
        requiredField: "Please complete this field.",
        invalidEmail: "Enter a valid email.",
        invalidPhone: "Only numbers allowed (optional + at the start).",
        turnstileRequired: "Complete the security verification before sending.",
        turnstileRequiredLong:
          "Complete the security verification (captcha) before sending.",
        requiredFieldsSummary:
          "Complete all required fields marked in red.",
        submitting: "Sending…",
        consent:
          "By submitting this form, you agree to our Terms of Service and Privacy Policy.",
        success: "Thanks. We'll get back to you soon.",
        sendFailed: "Couldn't send. Please try again.",
        connectionError:
          "Connection error. Check your internet and try again.",
        turnstileAria: "Security verification",
        submitFallback: "Let's Talk",
      },
    };
    const t = () => (isEnUi ? COPY.EN : COPY.ES);

    // i18n: headline, formTitle, submit (reacciona a ui:languagechange)
    const section = document.querySelector("[data-contact-i18n]") as HTMLElement | null;
    function applyContactI18n(lang: string | undefined) {
      const L = (lang || "").toString().toLowerCase();
      const isEn = L === "en";
      isEnUi = isEn;
      if (!section?.dataset) return;
      const titleEl = section.querySelector(".hubspot-contact-title");
      const formTitleEl = section.querySelector(".hubspot-contact-form-title");
      if (titleEl) titleEl.textContent = isEn ? (section.dataset.headlineEn || "Start building the bank of the future, today.") : (section.dataset.headlineEs || "Comienza a construir el banco del futuro, hoy.");
      if (formTitleEl) formTitleEl.textContent = isEn ? (section.dataset.formtitleEn || "Talk to our team") : (section.dataset.formtitleEs || "Habla con nuestro equipo");
      if (submitBtn && submitBtn instanceof HTMLInputElement) submitBtn.value = isEn ? (section.dataset.submitEn || "Let's Talk") : (section.dataset.submitEs || "Hablemos");
      const turnstileEl = document.getElementById("contactFormTurnstile");
      if (turnstileEl) turnstileEl.setAttribute("aria-label", t().turnstileAria);
    }
    window.addEventListener("ui:languagechange", (event: Event) => {
      const lang = (event as CustomEvent<{ language?: string }>).detail?.language;
      applyContactI18n(lang);
    });
    document.addEventListener("DOMContentLoaded", () => {
      const stored = typeof localStorage !== "undefined" ? localStorage.getItem("ui-language") : null;
      const current = (typeof window !== "undefined" && (window as any).__uiLanguage) || stored || document.documentElement.lang || "es";
      applyContactI18n(current);
    });
    // Aplicar de inmediato por si el script se ejecuta después de DOMContentLoaded
    const stored = typeof localStorage !== "undefined" ? localStorage.getItem("ui-language") : null;
    const current = (typeof window !== "undefined" && (window as any).__uiLanguage) || stored || "es";
    applyContactI18n(current);

    function getCookie(name) {
      const match = document.cookie.match(new RegExp("(?:^|; )" + name.replace(/([.$?*|{}()[\]\\/+^])/g, "\\$1") + "=([^;]*)"));
      return match ? decodeURIComponent(match[1]) : null;
    }

    function showMessage(text, isError) {
      messageEl.textContent = text;
      messageEl.className = "hubspot-contact-form-message " + (isError ? "error" : "success");
      messageEl.hidden = false;
    }
    function hideMessage() {
      messageEl.hidden = true;
      messageEl.className = "hubspot-contact-form-message";
    }

    function getFieldEl(name) {
      return form.querySelector("[name=" + CSS.escape(name) + "]");
    }
    function getErrorEl(name) {
      return form.querySelector(".hubspot-field-error[data-field=" + CSS.escape(name) + "]");
    }
    function getGroupEl(name) {
      const field = getFieldEl(name);
      return field ? field.closest(".hubspot-form-group") : null;
    }
    function setFieldError(name, message) {
      const errEl = getErrorEl(name);
      const group = getGroupEl(name);
      const field = getFieldEl(name);
      if (errEl) errEl.textContent = message;
      if (group) group.classList.add("has-error");
      if (field) field.setAttribute("aria-invalid", "true");
    }
    function clearFieldError(name) {
      const errEl = getErrorEl(name);
      const group = getGroupEl(name);
      const field = getFieldEl(name);
      if (errEl) errEl.textContent = "";
      if (group) group.classList.remove("has-error");
      if (field) field.setAttribute("aria-invalid", "false");
    }
    function clearAllFieldErrors() {
      REQUIRED_FIELDS.forEach((f) => clearFieldError(f.name));
    }
    function isValidEmail(value) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value || "");
    }
    function isValidPhone(value) {
      const v = (value || "").trim();
      return /^\+?\d+$/.test(v.replace(/[\s\-]/g, ""));
    }
    function validateField(name) {
      const field = getFieldEl(name);
      const value = (field && field.value != null ? field.value : "").trim();
      const config = REQUIRED_FIELDS.find((f) => f.name === name);
      if (!config) return true;
      if (!value) {
        setFieldError(name, t().requiredField);
        return false;
      }
      if (name === "email" && !isValidEmail(value)) {
        setFieldError(name, t().invalidEmail);
        return false;
      }
      if (name === "phone" && !isValidPhone(value)) {
        setFieldError(name, t().invalidPhone);
        return false;
      }
      clearFieldError(name);
      return true;
    }
    function validateAll() {
      let valid = true;
      clearAllFieldErrors();
      for (const config of REQUIRED_FIELDS) {
        const field = getFieldEl(config.name);
        const value = (field && field.value != null ? field.value : "").trim();
        if (!value) {
          setFieldError(config.name, t().requiredField);
          valid = false;
        } else if (config.name === "email" && !isValidEmail(value)) {
          setFieldError(config.name, t().invalidEmail);
          valid = false;
        } else if (config.name === "phone" && !isValidPhone(value)) {
          setFieldError(config.name, t().invalidPhone);
          valid = false;
        }
      }
      return valid;
    }

    const phoneInput = getFieldEl("phone");
    if (phoneInput && phoneInput instanceof HTMLInputElement) {
      phoneInput.addEventListener("input", () => {
        let v = phoneInput.value;
        const hasPlus = v.startsWith("+");
        const digits = v.replace(/\D/g, "");
        phoneInput.value = (hasPlus ? "+" : "") + digits;
        clearFieldError("phone");
        hideMessage();
      });
    }

    REQUIRED_FIELDS.forEach((config) => {
      const field = getFieldEl(config.name);
      if (!field) return;
      field.addEventListener("blur", () => validateField(config.name));
      field.addEventListener("input", () => {
        clearFieldError(config.name);
        hideMessage();
      });
    });

    function getTurnstileToken() {
      const input = form.querySelector('input[name="cf-turnstile-response"]');
      return (input && input.value ? input.value.trim() : "") || "";
    }
    function setTurnstileError(msg) {
      const el = document.getElementById("error-turnstile");
      if (el) el.textContent = msg || "";
    }
    function scrollToTurnstile() {
      document.getElementById("contactFormTurnstileWrap")?.scrollIntoView({ behavior: "smooth", block: "center" });
    }

    let turnstileWidgetId = null;
    (function loadAndRenderTurnstile() {
      const container = document.getElementById("contactFormTurnstile");
      if (!container) return;
      function doRender() {
        if (typeof window.turnstile !== "undefined") {
          try {
            turnstileWidgetId = window.turnstile.render(container, {
              sitekey: TURNSTILE_SITEKEY,
              callback: "onContactTurnstileSuccess",
              appearance: "always",
              theme: "light",
            });
          } catch (e) { console.warn("Turnstile render:", e); }
          return true;
        }
        return false;
      }
      if (doRender()) return;
      const s = document.createElement("script");
      s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
      s.async = true;
      s.onload = () => setTimeout(doRender, 50);
      document.head.appendChild(s);
    })();

    window.onContactTurnstileSuccess = function () { setTurnstileError(""); };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (submitBtn.disabled) return;
      setTurnstileError("");
      hideMessage();

      if (!getTurnstileToken()) {
        setTurnstileError(t().turnstileRequired);
        showMessage(t().turnstileRequiredLong, true);
        scrollToTurnstile();
        return;
      }
      if (!validateAll()) {
        showMessage(t().requiredFieldsSummary, true);
        const firstError = form.querySelector(".hubspot-form-group.has-error");
        if (firstError) {
          const input = firstError.querySelector("input, select");
          if (input) input.focus();
        }
        return;
      }

      submitBtn.disabled = true;
      const originalValue = submitBtn.value || t().submitFallback;
      submitBtn.value = t().submitting;
      clearAllFieldErrors();

      const firstname = (form.querySelector("[name=firstname]")?.value || "").trim();
      const lastname = (form.querySelector("[name=lastname]")?.value || "").trim();
      const email = (form.querySelector("[name=email]")?.value || "").trim();
      const company = (form.querySelector("[name=company]")?.value || "").trim();
      const country = (form.querySelector("[name=country]")?.value || "").trim();
      const phone = (form.querySelector("[name=phone]")?.value || "").trim();

      const payload = {
        fields: [
          { objectTypeId: "0-1", name: "email", value: email },
          { objectTypeId: "0-1", name: "firstname", value: firstname },
          { objectTypeId: "0-1", name: "lastname", value: lastname },
          { objectTypeId: "0-1", name: "company", value: company },
          { objectTypeId: "0-1", name: "country", value: country },
          { objectTypeId: "0-1", name: "phone", value: phone },
        ],
        context: {
          pageUri: window.location.href,
          pageName: document.title || "Zelify",
          hutk: getCookie("hubspotutk") || undefined,
        },
        legalConsentOptions: {
          consent: {
            consentToProcess: true,
            text: t().consent,
          },
        },
      };

      try {
        const res = await fetch(API_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok) {
          showMessage(t().success, false);
          form.reset();
          clearAllFieldErrors();
          REQUIRED_FIELDS.forEach((f) => {
            const field = getFieldEl(f.name);
            if (field) field.setAttribute("aria-invalid", "false");
          });
          if (typeof window.turnstile !== "undefined" && turnstileWidgetId != null) {
            try { window.turnstile.reset(turnstileWidgetId); } catch (_) {}
          }
        } else {
          const msg = data.message || data.errors?.[0]?.message || t().sendFailed;
          showMessage(msg, true);
          submitBtn.disabled = false;
          submitBtn.value = originalValue;
        }
      } catch (err) {
        showMessage(t().connectionError, true);
        submitBtn.disabled = false;
        submitBtn.value = originalValue;
      }
    });
  })();
</script>
