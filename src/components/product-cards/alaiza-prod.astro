---
import AlaizaCard from "./alaiza-components/AlaizaCard";
interface Props {
  noInteraction?: boolean;
  isDemoEnabled?: boolean;
}

const { noInteraction = true, isDemoEnabled = true } = Astro.props;
---

<div class={noInteraction ? "no-interaction" : ""}>
  <AlaizaCard client:visible isDemoEnabled={isDemoEnabled} />
</div>

<style>
  .no-interaction {
    width: 100%;
    height: 100%;
    pointer-events: none !important;
    user-select: none !important;
  }
  :global(.alaiza-card-root) {
    width: 100%;
    height: 100%;
  }
</style>
