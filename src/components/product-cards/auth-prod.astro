---
import { AuthCard } from "./auth-components/AuthCard";

interface Props {
  noInteraction?: boolean;
  isDemoEnabled?: boolean;
}

const { noInteraction = true, isDemoEnabled = true } = Astro.props;
---

<div class={noInteraction ? "no-interaction" : ""}>
  <AuthCard client:visible isDemoEnabled={isDemoEnabled} />
</div>

<style>
  .no-interaction {
    width: 100%;
    height: 100%;
    pointer-events: none !important;
    user-select: none !important;
  }
  :global(.auth-card-wrapper) {
    width: 100%;
    height: 100%;
  }
</style>
