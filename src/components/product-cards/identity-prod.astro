---
import IdentityCard from "./identity-components/IdentityCard";

interface Props {
  noInteraction?: boolean;
  isDemoEnabled?: boolean;
}

const { noInteraction = true, isDemoEnabled = true } = Astro.props;
---

<div class={noInteraction ? "no-interaction" : ""}>
  <IdentityCard client:visible isDemoEnabled={isDemoEnabled} />
</div>

<style>
  .no-interaction {
    width: 100%;
    height: 100%;
    pointer-events: none !important;
    user-select: none !important;
  }
  :global(.identity-card-root) {
    width: 100%;
    height: 100%;
  }
</style>
