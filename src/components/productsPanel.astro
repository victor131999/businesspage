  // Render del contenido según pestaña
  function render(key) {
    const section = DATA[key] ?? DATA.register;

    // Si es register (Auth), identity, aml, linking o cards, hacer el título un enlace a su página principal
    if (key === "register") {
      titleEl.innerHTML = `<a href="/auth" class="pp-title-link">${section.title} <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-left: 0.5rem;"><path d="M7 17L17 7M7 7h10v10"/></svg></a>`;
    } else if (key === "identity") {
      titleEl.innerHTML = `<a href="/identity" class="pp-title-link">${section.title} <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-left: 0.5rem;"><path d="M7 17L17 7M7 7h10v10"/></svg></a>`;
    } else if (key === "aml") {
      titleEl.innerHTML = `<a href="/amlCompliance" class="pp-title-link">${section.title} <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-left: 0.5rem;"><path d="M7 17L17 7M7 7h10v10"/></svg></a>`;
    } else if (key === "linking") {
      titleEl.innerHTML = `<a href="/openBankingConnect" class="pp-title-link">${section.title} <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-left: 0.5rem;"><path d="M7 17L17 7M7 7h10v10"/></svg></a>`;
    } else if (key === "cards") {
      titleEl.innerHTML = `<a href="/cardIssuing" class="pp-title-link">${section.title} <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-left: 0.5rem;"><path d="M7 17L17 7M7 7h10v10"/></svg></a>`;
    } else if (key === "transfers") {
      titleEl.innerHTML = `<a href="/moneyTransfers" class="pp-title-link">${section.title} <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-left: 0.5rem;"><path d="M7 17L17 7M7 7h10v10"/></svg></a>`;
    } else if (key === "international") {
      titleEl.innerHTML = `<a href="/transactions" class="pp-title-link">${section.title} <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-left: 0.5rem;"><path d="M7 17L17 7M7 7h10v10"/></svg></a>`;
    } else if (key === "payments") {
      titleEl.innerHTML = `<a href="/payments" class="pp-title-link">${section.title} <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-left: 0.5rem;"><path d="M7 17L17 7M7 7h10v10"/></svg></a>`;
    } else {
      titleEl.textContent = section.title;
    }
    subEl.textContent = section.sub;

    // Para Cards, Transfers, International (TX) y Payments, agregar clase especial para dos columnas
    if (key === "cards" || key === "transfers" || key === "international" || key === "payments") {
      listEl.classList.add("cards-grid");
    } else {
      listEl.classList.remove("cards-grid");
    }

    listEl.innerHTML = section.features
      .map((f, idx) => {
        const icon = iconSVG(f.icon);
        const card = `
        <span class="pp-icon">${icon}</span>
        <div>
          <h4 class="pp-ft-title">${f.t}</h4>
          <p class="pp-ft-desc">${f.d}</p>
        </div>
      `;

        // Para Auth (register), todas las features son enlaces a documentación
        if (key === "register" && AUTH_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${AUTH_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // Para Identity, todas las features son enlaces a documentación
        if (key === "identity" && IDENTITY_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${IDENTITY_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // Para AML, todas las features son enlaces a documentación
        if (key === "aml" && AML_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${AML_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // Para Connect (linking), todas las features son enlaces a documentación
        if (key === "linking" && CONNECT_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${CONNECT_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // Para Cards, todas las features son enlaces a documentación
        if (key === "cards" && CARDS_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${CARDS_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // Para Transfers, todas las features son enlaces a documentación
        if (key === "transfers" && TRANSFERS_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${TRANSFERS_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // Para TX (International), todas las features son enlaces a documentación
        if (key === "international" && TX_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${TX_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // Para Payments, todas las features son enlaces a documentación
        if (key === "payments" && PAYMENTS_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${PAYMENTS_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // 👉 El PRIMER feature (idx === 0) se vuelve link a la página de la sección para otros productos
        if (idx === 0 && KEY_TO_ROUTE[key]) {
          return `<a class="pp-feature" href="${KEY_TO_ROUTE[key]}">${card}</a>`;
        }
        // Los demás quedan como items normales
        return `<li class="pp-feature">${card}</li>`;
      })
      .join("");
  }

  // Click en la barra izquierda
  sidebar.addEventListener("click", (e) => {
    const btn = e.target.closest(".pp-item");
    if (!btn) return;
    sidebar.querySelector(".is-active")?.classList.remove("is-active");
    btn.classList.add("is-active");
    render(btn.dataset.key);
  });

  // Estado inicial
  render("register");
</script>
