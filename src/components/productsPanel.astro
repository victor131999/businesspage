        if (key === "register" && AUTH_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${AUTH_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // Para Identity, todas las features son enlaces a documentación
        if (key === "identity" && IDENTITY_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${IDENTITY_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // Para AML, todas las features son enlaces a documentación
        if (key === "aml" && AML_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${AML_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // Para Connect (linking), todas las features son enlaces a documentación
        if (key === "linking" && CONNECT_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${CONNECT_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // Para Cards, todas las features son enlaces a documentación
        if (key === "cards" && CARDS_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${CARDS_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // Para Transfers, todas las features son enlaces a documentación
        if (key === "transfers" && TRANSFERS_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${TRANSFERS_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // Para TX (International), todas las features son enlaces a documentación
        if (key === "international" && TX_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${TX_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // Para Payments, todas las features son enlaces a documentación
        if (key === "payments" && PAYMENTS_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${PAYMENTS_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // Para Discounts & Coupons (biz), todas las features son enlaces a documentación
        if (key === "biz" && DISCOUNTS_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${DISCOUNTS_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // Para Matilda AI, todas las features son enlaces a documentación
        if (key === "matilda" && MATILDA_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${MATILDA_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // Para Insurance, todas las features son enlaces a documentación
        if (key === "insurance" && INSURANCE_FEATURE_LINKS[f.t]) {
          return `<a class="pp-feature" href="${INSURANCE_FEATURE_LINKS[f.t]}" target="_blank" rel="noopener noreferrer">${card}</a>`;
        }
        
        // 👉 El PRIMER feature (idx === 0) se vuelve link a la página de la sección para otros productos
        if (idx === 0 && KEY_TO_ROUTE[key]) {
          return `<a class="pp-feature" href="${KEY_TO_ROUTE[key]}">${card}</a>`;
        }
        // Los demás quedan como items normales
        return `<li class="pp-feature">${card}</li>`;
      })
      .join("");
  }

  // Click en la barra izquierda
  sidebar.addEventListener("click", (e) => {
    const btn = e.target.closest(".pp-item");
    if (!btn) return;
    sidebar.querySelector(".is-active")?.classList.remove("is-active");
    btn.classList.add("is-active");
    render(btn.dataset.key);
  });

  // Estado inicial
  render("register");
</script>
