---
import "../styles/navbar.css";
---

<div id="products-panel" class="products-panel hidden">
  <aside class="pp-sidebar" role="tablist" aria-label="Products">
    <button role="tab" class="pp-item is-active" data-key="register"
      >Auth</button
    >
    <button role="tab" class="pp-item" data-key="identity">Identity</button>
    <button role="tab" class="pp-item" data-key="aml">AML</button>
    <button role="tab" class="pp-item" data-key="linking">Connect</button>
    <button role="tab" class="pp-item" data-key="cards">Cards</button>
    <button role="tab" class="pp-item" data-key="international">TX</button>
    <button role="tab" class="pp-item" data-key="paymentsTransfers"
      >Payments and Transfers</button
    >
    <button role="tab" class="pp-item" data-key="biz"
      >Discounts & Coupons</button
    >
    <button role="tab" class="pp-item" data-key="matilda"
      >Alaiza AI Fintech Core</button
    >
    <!-- Insurance comentado - ya no se ofrece este servicio
    <button role="tab" class="pp-item" data-key="insurance">Insurance</button>
    -->
  </aside>
</div>

<script type="module">
  const panel = document.getElementById("products-panel");
  const links = Array.from(panel.querySelectorAll(".pp-item"));

  const normalizePath = (path) => (path || "/").replace(/\\/+$/, "") || "/";

  const updateActive = () => {
    const current = normalizePath(window.location.pathname);
    for (const link of links) {
      const href = link.getAttribute("href") || "/";
      const hrefPath = normalizePath(
        new URL(href, window.location.origin).pathname,
      );
      link.classList.toggle("is-active", hrefPath === current);
    }
  };

  updateActive();
  window.addEventListener("popstate", updateActive);

  panel.addEventListener("click", (e) => {
    const link = e.target.closest("a.pp-item");
    if (!link) return;
    panel.classList.add("hidden");
  });
</script>
