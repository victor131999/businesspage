  // Render del contenido según pestaña
  function render(key) {
    const section = DATA[key] ?? DATA.register;

    // Crear el enlace del título principal si tiene ruta
    if (KEY_TO_ROUTE[key]) {
      titleEl.innerHTML = `<a href="${KEY_TO_ROUTE[key]}" class="pp-title-link">${section.title} <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-left: 0.5rem;"><path d="M7 17L17 7M7 7h10v10"/></svg></a>`;
    } else {
      titleEl.textContent = section.title;
    }
    subEl.textContent = section.sub;

    // Aplicar clase grid si corresponde (para la mayoría de los módulos con muchos items)
    if (section.features.length > 4) {
      listEl.classList.add("cards-grid");
    } else {
      listEl.classList.remove("cards-grid");
    }

    listEl.innerHTML = section.features
      .map((f, idx) => {
        const icon = iconSVG(f.icon);
        const cardContent = `
        <span class="pp-icon">${icon}</span>
        <div>
          <h4 class="pp-ft-title">${f.t}</h4>
          <p class="pp-ft-desc">${f.d}</p>
        </div>
      `;

        // Si tiene href, es un enlace
        if (f.href) {
          return `<a class="pp-feature" href="${f.href}" target="_blank" rel="noopener noreferrer">${cardContent}</a>`;
        } else {
          // Fallback para items sin enlace (aunque ahora todos tienen)
          return `<li class="pp-feature">${cardContent}</li>`;
        }
      })
      .join("");
  }

  // Click en la barra izquierda
  sidebar.addEventListener("click", (e) => {
    const btn = e.target.closest(".pp-item");
    if (!btn) return;
    sidebar.querySelector(".is-active")?.classList.remove("is-active");
    btn.classList.add("is-active");
    render(btn.dataset.key);
  });

  // Estado inicial
  render("register");
