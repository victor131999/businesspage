  // Variable para mantener el idioma actual y el DATA activo
  let currentLanguage = "ES";
  let DATA = DATA_ES;

  // Función para cambiar el idioma del panel
  function updateLanguage(lang) {
    currentLanguage = lang.toUpperCase() === "ES" ? "ES" : "EN";
    DATA = currentLanguage === "ES" ? DATA_ES : DATA_EN;

    // Re-renderizar el contenido actual con el nuevo idioma
    const activeBtn = panel.querySelector(".pp-item.is-active");
    if (activeBtn) {
      render(activeBtn.dataset.key);
    }
  };

  const updateActive = () => {
    const current = normalizePath(window.location.pathname);
    for (const link of links) {
      const href = link.getAttribute("href") || "/";
      const hrefPath = normalizePath(
        new URL(href, window.location.origin).pathname,
      );
      link.classList.toggle("is-active", hrefPath === current);
    }
  };

  updateActive();
  window.addEventListener("popstate", updateActive);

  panel.addEventListener("click", (e) => {
    const link = e.target.closest("a.pp-item");
    if (!link) return;
    panel.classList.add("hidden");
  });
</script>
