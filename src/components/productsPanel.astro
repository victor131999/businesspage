  // Variable para mantener el idioma actual y el DATA activo
  let currentLanguage = "ES";
  let DATA = DATA_ES;

  // Función para cambiar el idioma del panel
  function updateLanguage(lang) {
    currentLanguage = lang.toUpperCase() === "ES" ? "ES" : "EN";
    DATA = currentLanguage === "ES" ? DATA_ES : DATA_EN;
    
    // Re-renderizar el contenido actual con el nuevo idioma
    const activeBtn = sidebar.querySelector(".pp-item.is-active");
    if (activeBtn) {
      render(activeBtn.dataset.key);
    }
  }

  // Escuchar cambios de idioma desde el navbar
  window.addEventListener('ui:languagechange', ((event) => {
    const customEvent = event;
    if (customEvent.detail?.language) {
      updateLanguage(customEvent.detail.language);
    }
  }));

  // Inicializar con el idioma guardado
  document.addEventListener('DOMContentLoaded', () => {
    const storedLang = localStorage.getItem('ui-language') || 'ES';
    updateLanguage(storedLang);
  });

