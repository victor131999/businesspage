---

---

<div
  id="learn-screen-content"
  class="w-full h-full flex flex-col hidden bg-white"
>
  <!-- Top Section -->
  <div class="flex-shrink-0 px-6 pt-4">
    <!-- Back Button -->
    <button
      id="back-to-home-from-learn-btn"
      class="mb-4 text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors flex items-center gap-1"
    >
      <span>&lt;</span>
      <span>back</span>
    </button>

    <!-- Logo -->
    <div class="mb-6 flex justify-center">
      <div class="relative h-6 w-24">
        <img
          src="/images/zelify_logo.png"
          alt="Zelify"
          class="h-full w-full object-contain filter"
        />
      </div>
    </div>
  </div>

  <!-- Scrollable Content -->
  <div class="flex-1 space-y-6 overflow-y-auto px-6 pb-6">
    <!-- Performance Metrics -->
    <div class="flex justify-around">
      <!-- Metric 1: Increasing 85% -->
      <div class="flex flex-col items-center gap-2">
        <div class="relative flex h-16 w-16 items-center justify-center">
          <svg class="h-full w-full -rotate-90 transform">
            <circle
              cx="32"
              cy="32"
              r="28"
              fill="none"
              stroke="#E5E7EB"
              stroke-width="4"></circle>
            <circle
              cx="32"
              cy="32"
              r="28"
              fill="none"
              stroke="#10B981"
              stroke-width="4"
              stroke-dasharray="175.9"
              stroke-dashoffset="26.4"
              stroke-linecap="round"></circle>
          </svg>
          <span class="absolute text-xs font-bold text-gray-900">85%</span>
        </div>
        <span class="text-xs font-medium text-gray-600">increasing</span>
      </div>

      <!-- Metric 2: Spending 45% -->
      <div class="flex flex-col items-center gap-2">
        <div class="relative flex h-16 w-16 items-center justify-center">
          <svg class="h-full w-full -rotate-90 transform">
            <circle
              cx="32"
              cy="32"
              r="28"
              fill="none"
              stroke="#E5E7EB"
              stroke-width="4"></circle>
            <circle
              cx="32"
              cy="32"
              r="28"
              fill="none"
              stroke="#004492"
              stroke-width="4"
              stroke-dasharray="175.9"
              stroke-dashoffset="96.7"
              stroke-linecap="round"></circle>
          </svg>
          <span class="absolute text-xs font-bold text-gray-900">45%</span>
        </div>
        <span class="text-xs font-medium text-gray-600">spending</span>
      </div>

      <!-- Metric 3: Savings 25% -->
      <div class="flex flex-col items-center gap-2">
        <div class="relative flex h-16 w-16 items-center justify-center">
          <svg class="h-full w-full -rotate-90 transform">
            <circle
              cx="32"
              cy="32"
              r="28"
              fill="none"
              stroke="#E5E7EB"
              stroke-width="4"></circle>
            <circle
              cx="32"
              cy="32"
              r="28"
              fill="none"
              stroke="#F59E0B"
              stroke-width="4"
              stroke-dasharray="175.9"
              stroke-dashoffset="131.9"
              stroke-linecap="round"></circle>
          </svg>
          <span class="absolute text-xs font-bold text-gray-900">25%</span>
        </div>
        <span class="text-xs font-medium text-gray-600">savings</span>
      </div>
    </div>

    <!-- Weekly Summary -->
    <div>
      <h3 class="mb-3 text-sm font-semibold text-gray-900">
        Your weekly summary
      </h3>
      <div class="rounded-xl border border-gray-100 bg-white p-4 shadow-sm">
        <p class="text-sm text-gray-700">
          Your financial stability has improved by 15% this week. Great job
          maintaining your savings goals!
        </p>
      </div>
    </div>

    <!-- Tips Section -->
    <div>
      <h3 class="mb-3 text-sm font-semibold text-gray-900">Our tips for you</h3>
      <div class="grid grid-cols-2 gap-3">
        <!-- Tip 1 -->
        <div
          class="cursor-pointer overflow-hidden rounded-xl border border-gray-100 bg-white shadow-sm transition-transform active:scale-95"
        >
          <img
            src="https://images.unsplash.com/photo-1579621970563-ebec7560ff3e?w=800&q=80"
            alt="Ahorro Inteligente"
            class="h-32 w-full object-cover"
          />
          <div class="p-3">
            <p class="text-xs font-medium text-gray-900">Smart Savings</p>
          </div>
        </div>
        <!-- Tip 2 -->
        <div
          class="cursor-pointer overflow-hidden rounded-xl border border-gray-100 bg-white shadow-sm transition-transform active:scale-95"
        >
          <img
            src="https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?w=800&q=80"
            alt="Inversión Básica"
            class="h-32 w-full object-cover"
          />
          <div class="p-3">
            <p class="text-xs font-medium text-gray-900">Basic Investment</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
