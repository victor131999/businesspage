---
// src/components/connect/ConnectApp.astro
import DeviceFrame from "../design-system/organisms/device-frame/DeviceFrame.astro";
---

<div class="device-container">
  <div class="device-frame-wrapper">
    <DeviceFrame>
      <div class="device-content">
        <div class="connect-app-container">
          <!-- HEADER -->
          <div class="connect-header" id="connect-header">
            <button
              class="connect-back-btn pl-6 pt-6 text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors"
              id="btn-back"
            >
              &lt; back
            </button>
          </div>

          <!-- SCREEN 1: BANKS LIST -->
          <div
            id="screen-banks"
            class="connect-screen active"
            style="padding: 24px 24px 10px;"
          >
            <div
              class="screen-content flex flex-col h-full !p-0 !overflow-visible"
            >
              <div class="text-center mb-1">
                <h2 class="text-sm font-bold text-[#004492]">
                  Bank Account Linking
                </h2>
                <p class="text-xs text-gray-500">Let's link your account</p>
              </div>

              <!-- Search -->
              <div class="relative mb-4 mt-2">
                <div
                  class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
                >
                  <svg
                    class="h-4 w-4 text-gray-400"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </div>
                <input
                  id="bank-search-input"
                  type="text"
                  class="block w-full pl-10 pr-3 py-3 border border-gray-200 rounded-xl leading-5 bg-white placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500 text-sm"
                  placeholder="Search banks..."
                />
              </div>

              <!-- Bank Stack -->
              <div
                id="banks-stack-container"
                class="relative flex flex-col items-center justify-start w-full mt-2"
                style="isolation: isolate;"
              >
                <!-- BBVA -->
                <div
                  id="bank-0"
                  class="bank-stack-card"
                  onclick="connectSelectBank(0)"
                >
                  <div class="bank-logo-container hidden"></div>
                  <span class="bank-name">BBVA México</span>
                </div>

                <!-- Santander -->
                <div
                  id="bank-1"
                  class="bank-stack-card"
                  onclick="connectSelectBank(1)"
                >
                  <div class="bank-logo-container hidden"></div>
                  <span class="bank-name">Banco Santander</span>
                </div>

                <!-- Banamex -->
                <div
                  id="bank-2"
                  class="bank-stack-card"
                  onclick="connectSelectBank(2)"
                >
                  <div class="bank-logo-container hidden"></div>
                  <span class="bank-name">Banamex</span>
                </div>

                <!-- HSBC -->
                <div
                  id="bank-3"
                  class="bank-stack-card"
                  onclick="connectSelectBank(3)"
                >
                  <div class="bank-logo-container hidden"></div>
                  <span class="bank-name">HSBC México</span>
                </div>

                <!-- Azteca -->
                <div
                  id="bank-4"
                  class="bank-stack-card"
                  onclick="connectSelectBank(4)"
                >
                  <div class="bank-logo-container hidden"></div>
                  <span class="bank-name">Banco Azteca</span>
                </div>

                <!-- Scotiabank -->
                <div
                  id="bank-5"
                  class="bank-stack-card"
                  onclick="connectSelectBank(5)"
                >
                  <div class="bank-logo-container hidden"></div>
                  <span class="bank-name">Scotiabank México</span>
                </div>
              </div>

              <!-- Slider/Pager -->
              <div
                class="w-full flex items-center justify-between text-gray-300 text-[10px] mt-2 mb-4 px-2"
              >
                <span>&lt;</span>

                <span>&gt;</span>
              </div>

              <!-- Continue Button -->
              <div class="text-center pb-2">
                <button
                  id="btn-continue-banks"
                  class="w-full max-w-[200px] py-3 rounded-xl font-semibold text-white text-sm transition-all shadow-lg flex items-center justify-center gap-2 mx-auto"
                  style="background: #9BA2AF;"
                  disabled
                  onclick="connectProceedFromBanks()"
                >
                  Continue
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M9 18l6-6-6-6"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- SCREEN 2: CREDENTIALS -->
          <div id="screen-credentials" class="connect-screen hidden-screen">
            <div class="screen-content flex flex-col h-full pt-4">
              <!-- Animation Container (Centered, Natural Flow) -->
              <div
                class="flex-shrink-0 flex justify-center items-center mb-4 mt-2"
              >
                <img
                  src="/gift/ANIMACION%201.gif"
                  alt="Connecting Animation"
                  class="h-32 w-32 object-contain mix-blend-multiply opacity-80"
                />
              </div>

              <!-- Header Text -->
              <div class="text-center mb-6">
                <h2
                  class="text-xl font-bold text-[#004492] mb-2"
                  id="cred-bank-name"
                >
                  Scotiabank México
                </h2>
                <p class="text-[13px] text-gray-400 px-8 leading-snug">
                  Please provide your credentials to connect your bank account
                </p>
              </div>

              <!-- Form Fields -->
              <div class="w-full space-y-5 flex-grow">
                <div class="input-group">
                  <label
                    class="block text-[#000b1e] font-bold text-sm mb-2 pl-1"
                    >Username</label
                  >
                  <input
                    type="text"
                    class="w-full bg-[#dce5f2] rounded-xl px-4 py-3.5 text-sm outline-none border-none text-slate-700 placeholder-slate-400 transition-shadow focus:ring-2 focus:ring-blue-100"
                    placeholder="Enter your username"
                  />
                </div>

                <div class="input-group">
                  <label
                    class="block text-[#000b1e] font-bold text-sm mb-2 pl-1"
                    >Password</label
                  >
                  <input
                    type="password"
                    class="w-full bg-[#dce5f2] rounded-xl px-4 py-3.5 text-sm outline-none border-none text-slate-700 placeholder-slate-400 transition-shadow focus:ring-2 focus:ring-blue-100"
                    placeholder="Enter your password"
                  />
                </div>

                <!-- Login Button -->
                <div class="pt-2">
                  <button
                    class="w-full text-white font-bold py-3.5 rounded-xl flex items-center justify-center gap-2 transition-transform active:scale-95 btn-gradient shadow-lg shadow-blue-900/10"
                    id="btn-login"
                    onclick="window.connectLogin()"
                  >
                    <span>Login</span>
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                    >
                      <path d="M9 18l6-6-6-6"></path>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
          <!-- SCREEN 3: CONNECTING (LOADING) -->
          <div id="screen-loading" class="connect-screen hidden-screen">
            <!-- White background for screen -->
            <div class="absolute inset-0 bg-white z-0"></div>

            <div
              class="relative z-10 flex flex-col items-center justify-center h-full px-4"
            >
              <!-- Card Container with Gradient -->
              <div
                class="w-full rounded-[32px] overflow-hidden shadow-2xl relative"
                style="height: 80%; background: linear-gradient(to right, #004492, #000b1e);"
              >
                <!-- Optional: Gradient overlay matching reference image style -->
                <div
                  class="absolute inset-0"
                  style="background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, transparent 100%);"
                >
                </div>

                <div
                  class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center"
                >
                  <h2 class="text-2xl font-bold text-white mb-2">
                    Connecting<span class="opacity-90"> your account</span>
                  </h2>
                  <p class="text-sm text-white/70 mb-10">Please wait</p>

                  <!-- Loading Bar -->
                  <div
                    class="w-full max-w-[240px] h-1.5 bg-white/20 rounded-full overflow-hidden"
                  >
                    <div
                      id="loading-bar"
                      class="h-full bg-white w-0 transition-all duration-[3000ms] ease-out"
                    >
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- SCREEN 4: WALLET -->
          <div id="screen-wallet" class="connect-screen hidden-screen">
            <div class="screen-content pt-4">
              <div
                class="h-[120px] w-full flex justify-center items-center mb-0"
              >
                <img
                  src="/gift/ANIMACION%201.gif"
                  alt="Animation"
                  class="h-full w-auto object-contain mix-blend-multiply opacity-60"
                />
              </div>

              <h2 class="text-center text-[#000b1e] text-2xl font-bold mb-1">
                Wallet
              </h2>
              <p class="text-center text-gray-400 text-xs mb-8">
                Manage your funds
              </p>

              <div class="px-2">
                <p class="text-[#000b1e] font-semibold text-sm mb-2">
                  Total Balance
                </p>
                <div
                  class="bg-[#e2e8f0] rounded-xl px-4 py-3 flex justify-between items-center mb-6"
                >
                  <span class="text-2xl font-normal text-slate-800">$0.00</span>
                  <span
                    class="bg-[#000b1e] text-white text-xs font-bold px-3 py-1 rounded-full"
                    >MXN</span
                  >
                </div>

                <!-- Deposit Button (Connected Gradient) -->
                <button
                  class="w-full text-white py-4 rounded-xl flex items-center justify-between px-6 shadow-lg shadow-blue-900/20 mb-6 btn-gradient text-left"
                  onclick="window.connectNavigate('deposit')"
                >
                  <span class="font-bold">Deposit Funds</span>
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg
                  >
                </button>

                <!-- Connected Bank Card -->
                <div
                  class="bg-[#000b1e] rounded-xl p-6 text-center text-white relative overflow-hidden"
                >
                  <div class="absolute top-2 left-1/2 -translate-x-1/2">
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="white"
                      stroke-width="2"><path d="M18 15l-6-6-6 6"></path></svg
                    >
                  </div>
                  <h3 class="font-bold text-lg mt-4 mb-1">SCOTIABANK MÉXICO</h3>
                  <p class="text-xs text-slate-400">Connected Bank</p>
                </div>
              </div>
            </div>
          </div>

          <!-- SCREEN 5: DEPOSIT FUNDS -->
          <div id="screen-deposit" class="connect-screen hidden-screen">
            <div class="screen-content px-4">
              <div
                class="h-[100px] w-full flex justify-center items-center mb-4"
              >
                <img
                  src="/gift/ANIMACION%201.gif"
                  alt="Deposit Animation"
                  class="h-full w-auto object-contain mix-blend-multiply opacity-80"
                />
              </div>

              <h2 class="text-center text-[#000b1e] text-xl font-bold mb-1">
                Deposit Funds
              </h2>
              <p class="text-center text-gray-500 text-xs mb-6">
                Select an account and enter amount
              </p>

              <p class="text-[#000b1e] text-sm font-semibold mb-3">
                Select Account
              </p>

              <!-- Accounts Container -->
              <div id="accounts-list-container" class="mb-4 space-y-2">
                <!-- Generated by JS -->
              </div>

              <p class="text-[#000b1e] text-sm font-semibold mb-2">Amount</p>
              <div
                class="bg-[#e2e8f0] rounded-xl px-4 py-4 mb-8 text-center flex items-center justify-center"
              >
                <input
                  id="deposit-amount-input"
                  type="number"
                  placeholder="0.00"
                  class="bg-transparent text-center w-full outline-none border-none text-2xl font-normal text-[#000b1e] placeholder-slate-400"
                />
              </div>

              <!-- Slider Button -->
              <div class="w-full" id="connect-slider">
                <div
                  class="relative w-full h-[56px] rounded-[28px] flex items-center justify-center overflow-hidden cursor-pointer shadow-lg active:scale-[0.99] transition-transform"
                  style="background: linear-gradient(90deg, #1e3a8a 0%, #000080 100%);"
                >
                  <span
                    class="text-white font-semibold text-[15px] pointer-events-none z-0 tracking-wide"
                  >
                    Slide to confirm
                  </span>

                  <div
                    class="absolute left-1 w-[48px] h-[48px] bg-white rounded-full flex items-center justify-center cursor-grab active:cursor-grabbing z-10 shadow-md transition-transform"
                    id="connect-slider-thumb"
                  >
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      class="text-[#1e3a8a]"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M9 18l6-6-6-6"></path>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- SCREEN 6: TRANSFER LOADING -->
          <div
            id="screen-transfer-loading"
            class="connect-screen hidden-screen"
          >
            <!-- Using Step10Launching design -->
            <div
              class="flex-1 px-6 pb-6 pt-2 flex flex-col items-center justify-center min-h-0 h-full"
            >
              <!-- Card Container -->
              <div
                class="relative w-full h-[80%] rounded-[2.5rem] overflow-hidden shadow-xl bg-[#001a33]"
              >
                <!-- Base Layer -->
                <div
                  class="absolute inset-0 z-10 flex flex-col items-center justify-center h-full px-6 text-center w-full"
                >
                  <h2 class="text-2xl font-bold mb-2 text-[#003366]">
                    Transferring funds
                  </h2>
                  <p class="text-xs text-gray-400">Please wait</p>
                  <div
                    class="w-64 h-2 rounded-full mt-8 overflow-hidden bg-gray-200"
                  >
                    <!-- Empty bar base -->
                  </div>
                </div>

                <!-- Overlay Layer (Clipped) -->
                <div
                  id="transfer-loading-overlay"
                  class="absolute inset-0 z-20 overflow-hidden"
                  style="clip-path: inset(0 100% 0 0); transition: clip-path 3s linear;"
                >
                  <div
                    class="w-full h-full flex flex-col items-center justify-center px-6 text-center"
                    style="background: linear-gradient(to right, #004492 0%, #000b1e 100%);"
                  >
                    <h2 class="text-2xl font-bold mb-2 text-white">
                      Transferring funds
                    </h2>
                    <p class="text-xs text-white/80">Please wait</p>
                    <div
                      class="w-64 h-2 rounded-full mt-8 overflow-hidden bg-white/20"
                    >
                      <div class="h-full w-full bg-white"></div>
                    </div>
                  </div>
                </div>

                <!-- Flush Edge Effect -->
                <div
                  id="transfer-flush-effect"
                  class="absolute top-0 bottom-0 w-20 z-20 pointer-events-none"
                  style="left: 0%; background: linear-gradient(to right, transparent, rgba(255,255,255,0.5), transparent); transform: translateX(-50%); transition: left 3s linear;"
                >
                </div>
              </div>
            </div>
          </div>

          <!-- SCREEN 7: SUCCESS -->
          <div id="screen-success" class="connect-screen hidden-screen">
            <!-- Using Step11Success design -->
            <div
              class="flex-1 px-6 pb-6 pt-2 flex flex-col items-center justify-center min-h-0 h-full"
            >
              <div
                class="w-full h-[80%] rounded-[2.5rem] flex flex-col items-center justify-center p-6 text-center shadow-xl"
                style="background: linear-gradient(to bottom, #004492, #000b1e);"
              >
                <div class="mb-6">
                  <svg
                    width="64"
                    height="64"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="white"
                    stroke-width="4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <h2 class="text-2xl font-bold text-white mb-2">
                  Funds Deposited
                </h2>
                <p class="text-gray-300 text-xs">
                  Your transfer was successful
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </DeviceFrame>
  </div>
</div>

<style>
  .device-container {
    position: relative;
    width: 100%;
    max-width: 380px;
    min-height: 80vh; /* Altura mínima para el contenedor */
    margin: 0 auto;
    z-index: 10;
    padding: 1rem 0 2rem;
  }

  /* Frame del iPhone */
  div:global(.auth-background-section) .device-frame-wrapper {
    position: relative !important;
    z-index: 10 !important;
    transform: scale(1) !important;
    padding: 2.5rem 2rem !important;
    background-color: #f3f4f6 !important;
    border-radius: 2rem !important;
    margin: 3rem auto !important;
    height: 850px !important; /* Altura fija para que phone-frame__bezel pueda usar height: 100% */
    display: flex !important;
    flex-direction: column !important;
  }

  .device-content {
    flex: 1;
    min-height: 0;
    background: #ffffff;
    padding: 0;
    overflow-y: hidden;
    overflow-x: hidden;
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .device-content::-webkit-scrollbar {
    display: none;
  }

  .connect-app-container {
    width: 100%;
    height: 100%;
    position: relative;
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial,
      sans-serif;
  }

  .connect-header {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 50;
    width: 100%;
    padding-top: 4px;
  }

  .connect-back-btn {
    display: flex;
    align-items: center;
    color: #64748b;
    font-size: 14px;
    font-weight: 500;
    background: none;
    border: none;
    cursor: pointer;
  }

  .connect-screen {
    position: absolute;
    inset: 0;
    background: #ffffff;
    opacity: 0;
    pointer-events: none;
    transform: translateX(20px);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    padding-top: 40px; /* Space for header */
  }

  .connect-screen.active {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
    z-index: 10;
  }

  .connect-screen.hidden-screen {
    /* redundant but for clarity matching other apps */
  }

  /* Screen 1: Banks */
  .search-box {
    position: relative;
    margin-bottom: 24px;
  }
  .search-input {
    width: 100%;
    height: 50px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding-left: 48px;
    padding-right: 16px;
    outline: none;
    color: #1e293b;
  }
  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: #94a3b8;
  }

  /* Stacked Bank Cards */
  .bank-stack-card {
    position: relative;
    width: 100%;
    background: #e5e7eb;
    border-radius: 20px;
    padding: 16px 24px;
    cursor: pointer;
    transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    height: 65px;
    border: 5px solid #ffffff;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .bank-stack-card.active {
    background: linear-gradient(to right, #000b1e, #044a95, #000b1e);
    color: white;
    height: 60px;
    padding: 20px 24px;
    box-shadow:
      0 20px 25px -5px rgba(0, 0, 0, 0.1),
      0 10px 10px -5px rgba(0, 0, 0, 0.04);
    transform: scale(1.02);
    justify-content: flex-start;
  }

  .bank-stack-card .bank-name {
    text-align: center;
    width: 100%;
    font-size: 10px;
    font-weight: 500;
    color: #334155;
  }

  .bank-stack-card.active .bank-name {
    text-align: left;
    width: auto;
    font-size: 12px;
    font-weight: 600;
    color: white;
    margin-left: 10px;
    flex: 1;
  }

  .bank-logo-container {
    width: 36px;
    height: 36px;
    background: white;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
  }
  .bank-logo-container.hidden {
    display: none;
  }
  .bank-logo-container img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .bottom-controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
  }

  .btn-gradient {
    background: linear-gradient(to right, #000b1e, #044a95);
    color: white;
    font-weight: 600;
    width: 200px;
    height: 48px;
    border-radius: 12px;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  .slider-pager {
    width: 100%;
    height: 8px;
    background: #e2e8f0;
    border-radius: 4px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #94a3b8;
    font-size: 10px;
  }
  .pager-track {
    flex: 1;
    height: 4px;
    background: #cbd5e1;
    margin: 0 8px;
    border-radius: 2px;
  }

  /* Screen 2: Credentials */
  .logo-placeholder-large {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Screen 3: Loading */
  /* Using standard tailwind classes in HTML for now as possible */
</style>

<script is:inline>
  // State for Bank Stack
  let activeBankIndex = 3; // Default HSBC
  const bankData = [
    {
      name: "BBVA México",
      logo: "https://cdn.worldvectorlogo.com/logos/bbva-2.svg",
    },
    {
      name: "Banco Santander",
      logo: "https://cdn.worldvectorlogo.com/logos/banco-santander-logo.svg",
    },
    {
      name: "Banamex",
      logo: "https://cdn.worldvectorlogo.com/logos/banamex-1.svg",
    },
    {
      name: "HSBC México",
      logo: "https://cdn.worldvectorlogo.com/logos/hsbc-logo-2018-.svg",
    },
    {
      name: "Banco Azteca",
      logo: "https://i.pinimg.com/1200x/31/7e/06/317e06872fa113652429b22ee1702a24.jpg",
    },
    {
      name: "Scotiabank México",
      logo: "https://cdn.worldvectorlogo.com/logos/scotiabank-4.svg",
    },
  ];

  function updateBankStackVisuals() {
    const cards = document.querySelectorAll(".bank-stack-card");
    const overlap = 20;

    cards.forEach((card, index) => {
      const isActive = index === activeBankIndex;
      const dist = Math.abs(activeBankIndex - index);
      const zIndex = 50 - dist;
      const marginTop = index === 0 ? "0px" : `-${overlap}px`;

      card.style.zIndex = zIndex;
      card.style.marginTop = marginTop;

      // Active Styles
      if (isActive) {
        card.classList.add("active");
        // Update Logo visibility
        const logoContainer = card.querySelector(".bank-logo-container");
        if (logoContainer) {
          logoContainer.classList.remove("hidden");
          // Ensure img is there if empty (simple check)
          if (!logoContainer.querySelector("img")) {
            const img = document.createElement("img");
            img.src = bankData[index].logo;
            logoContainer.appendChild(img);
          }
        }
      } else {
        card.classList.remove("active");
        const logoContainer = card.querySelector(".bank-logo-container");
        if (logoContainer) logoContainer.classList.add("hidden");
      }
    });

    // Update Continue Button
    const btnContinue = document.getElementById("btn-continue-banks");
    if (btnContinue) {
      if (activeBankIndex !== null) {
        btnContinue.removeAttribute("disabled");
        btnContinue.style.background =
          "linear-gradient(to right, #000b1e, #044a95, #000b1e)";
        // Add animations classes if needed
      } else {
        btnContinue.setAttribute("disabled", "true");
        btnContinue.style.background = "#9BA2AF";
      }
    }
  }

  window.connectSelectBank = (index) => {
    activeBankIndex = index;
    updateBankStackVisuals();
  };

  window.connectProceedFromBanks = () => {
    if (activeBankIndex !== null) {
      const bank = bankData[activeBankIndex];
      window.connectNavigate("credentials", bank.name, bank.logo);
    }
  };

  // --- DEPOSIT SCREEN LOGIC ---
  let selectedDepositAccountIndex = 0;
  const depositAccounts = [
    {
      name: "Cuenta CLABE",
      number: "012345678901234567",
      balance: "$12,345.67",
      currency: "MXN",
    },
    {
      name: "Chequera",
      number: "**** **** **** 1234",
      balance: "$45,678.90",
      currency: "MXN",
    },
  ];

  function renderDepositAccounts() {
    const container = document.getElementById("accounts-list-container");
    if (!container) return;

    container.innerHTML = depositAccounts
      .map((acc, index) => {
        const isActive = index === selectedDepositAccountIndex;

        // Active: gradient classes. Inactive: light gray.
        let cardClass = isActive
          ? "relative w-full rounded-2xl p-4 text-white flex justify-between items-center shadow-lg active-deposit-card transition-all duration-300 transform scale-[1.02]"
          : "relative w-full bg-[#f1f5f9] rounded-2xl p-4 text-[#000b1e] flex justify-between items-center opacity-70 hover:opacity-100 transition-all duration-300 cursor-pointer border border-transparent hover:border-slate-200";

        const style = isActive
          ? "background: linear-gradient(to right, #000b1e, #044a95);"
          : "";

        const indicator = isActive
          ? '<div class="absolute left-0 top-0 bottom-0 w-1.5 bg-blue-500 rounded-l-2xl"></div>'
          : "";

        const textColors = isActive
          ? {
              name: "font-bold text-lg",
              number: "text-slate-300 text-xs",
              amount: "font-bold text-lg",
              currency: "text-slate-300 text-xs",
            }
          : {
              name: "font-semibold text-lg",
              number: "text-slate-500 text-xs",
              amount: "font-semibold text-lg",
              currency: "text-slate-500 text-xs",
            };

        return `
            <div 
                onclick="window.selectDepositAccount(${index})"
                class="${cardClass}"
                style="${style}"
            >
                ${indicator}
                <div class="${isActive ? "pl-2" : ""}">
                  <p class="${textColors.name}">${acc.name}</p>
                  <p class="${textColors.number}">${acc.number}</p>
                </div>
                <div class="text-right">
                  <p class="${textColors.amount}">${acc.balance}</p>
                  <p class="${textColors.currency}">${acc.currency}</p>
                </div>
            </div>
        `;
      })
      .join("");
  }

  window.selectDepositAccount = (index) => {
    selectedDepositAccountIndex = index;
    renderDepositAccounts();
  };

  // Init
  setTimeout(() => {
    updateBankStackVisuals();
    renderDepositAccounts();
    initBankSearch();
  }, 100); // Small delay to ensure DOM is ready in Astro island architecture if any

  // Bank Search Functionality
  function initBankSearch() {
    const searchInput = document.getElementById("bank-search-input");
    if (!searchInput) return;

    searchInput.addEventListener("input", (e) => {
      filterBanks(e.target.value);
    });
  }

  function filterBanks(searchTerm) {
    const cards = document.querySelectorAll(".bank-stack-card");
    const normalizedSearch = searchTerm.toLowerCase().trim();

    let firstVisibleIndex = null;
    let visibleCount = 0;

    cards.forEach((card, index) => {
      const bankName = bankData[index].name.toLowerCase();
      const isMatch = bankName.includes(normalizedSearch);

      if (isMatch) {
        card.style.display = "flex";
        visibleCount++;
        if (firstVisibleIndex === null) {
          firstVisibleIndex = index;
        }
      } else {
        card.style.display = "none";
      }
    });

    // If we're filtering and there are visible banks, auto-select the first one
    if (normalizedSearch !== "" && firstVisibleIndex !== null) {
      activeBankIndex = firstVisibleIndex;
      updateBankStackVisuals();
    } else if (normalizedSearch === "") {
      // Reset to default when search is cleared
      activeBankIndex = 3; // Default HSBC
      updateBankStackVisuals();
    } else if (visibleCount === 0) {
      // No banks match - disable continue button
      activeBankIndex = null;
      updateBankStackVisuals();
    }
  }

  // Navigation
  window.connectNavigate = (screenId, bankName = null, bankLogo = null) => {
    const screens = document.querySelectorAll(".connect-screen");
    screens.forEach((s) => {
      s.classList.remove("active");
      s.classList.add("hidden-screen");
    });

    const target = document.getElementById("screen-" + screenId);
    if (target) {
      target.classList.add("active");
      target.classList.remove("hidden-screen");
    }

    if (screenId === "credentials" && bankName) {
      document.getElementById("cred-bank-name").innerText = bankName;
    }

    const backBtn = document.getElementById("btn-back");
    if (screenId === "banks") {
      backBtn.style.opacity = "1";
      backBtn.onclick = () => {
        /* Exit */
      };
    } else if (screenId === "credentials") {
      backBtn.onclick = () => window.connectNavigate("banks");
    } else if (screenId === "wallet") {
      backBtn.onclick = () => window.connectNavigate("banks");
    } else if (screenId === "deposit") {
      backBtn.onclick = () => window.connectNavigate("wallet");
    }
  };

  // Login Flow
  window.connectLogin = () => {
    const btn = document.getElementById("btn-login");
    const originalText = btn.innerHTML;
    btn.innerHTML = "Loading...";

    setTimeout(() => {
      window.connectNavigate("loading");

      const bar = document.getElementById("loading-bar");
      if (bar) {
        bar.style.width = "0%";
        bar.style.transition = "none";
        void bar.offsetHeight;

        bar.style.transition = "width 3s ease-out";
        bar.style.width = "100%";

        setTimeout(() => {
          // Instead of going straight to wallet, maybe show success linking?
          // Re-reading user request: "realices la pantalla de carga de la segunda imagen... successful linking"
          // The image 3 says "Successful Linking". Login flow -> Successful Linking -> Wallet is logical.
          // Let's verify if user meant Transfer or Login.
          // User said: "despues de Slide to Confirm realices la pantalla de carga... mira como esta en la segunda y tercera imagen"
          // So the SLIDER triggers the Transferring (Image 2) and Successful (Image 3).
          // Login flow stays as before (Loading -> Wallet).
          window.connectNavigate("wallet");
          btn.innerHTML = originalText;
        }, 3000);
      }
    }, 500);
  };

  // Slider Logic (Deposit)
  const slider = document.getElementById("connect-slider-thumb");
  const track = document.getElementById("connect-slider");
  let isDragging = false;

  if (slider && track) {
    slider.addEventListener("mousedown", (e) => {
      isDragging = true;
      slider.style.transition = "none";
    });

    window.addEventListener("mousemove", (e) => {
      if (!isDragging) return;
      const trackRect = track.getBoundingClientRect();
      let newLeft = e.clientX - trackRect.left - 24;

      if (newLeft < 4) newLeft = 4;
      if (newLeft > trackRect.width - 52) newLeft = trackRect.width - 52;

      slider.style.left = newLeft + "px";

      if (newLeft >= trackRect.width - 60) {
        isDragging = false;

        // Success Action -> Transfer Loading
        window.connectNavigate("transfer-loading");

        // Reset slider visually
        slider.style.left = "4px";

        // Start bar animation
        setTimeout(() => {
          const tBar = document.getElementById("transfer-loading-bar");
          if (tBar) {
            tBar.style.width = "0%";
            tBar.style.transition = "none";
            void tBar.offsetHeight;
            tBar.style.transition = "width 3s ease-out";
            tBar.style.width = "100%";
          }

          // After loading -> Success Screen
          setTimeout(() => {
            window.connectNavigate("success");

            // After Success -> Wallet
            setTimeout(() => {
              window.connectNavigate("wallet");
            }, 2500);
          }, 3000);
        }, 100);
      }
    });

    window.addEventListener("mouseup", () => {
      if (!isDragging) return;
      isDragging = false;
      const trackRect = track.getBoundingClientRect();
      if (parseInt(slider.style.left || "0") < trackRect.width - 60) {
        slider.style.transition = "left 0.3s ease";
        slider.style.left = "4px";
      }
    });

    // Touch events for mobile support
    slider.addEventListener(
      "touchstart",
      (e) => {
        isDragging = true;
        slider.style.transition = "none";
      },
      { passive: false },
    );

    window.addEventListener(
      "touchmove",
      (e) => {
        if (!isDragging) return;
        const touch = e.touches[0];
        const trackRect = track.getBoundingClientRect();
        let newLeft = touch.clientX - trackRect.left - 24;

        if (newLeft < 4) newLeft = 4;
        if (newLeft > trackRect.width - 52) newLeft = trackRect.width - 52;
        slider.style.left = newLeft + "px";

        if (newLeft >= trackRect.width - 60) {
          isDragging = false;
          window.connectNavigate("transfer-loading");
          slider.style.left = "4px";
          setTimeout(() => {
            const overlay = document.getElementById("transfer-loading-overlay");
            const flush = document.getElementById("transfer-flush-effect");
            if (overlay) {
              overlay.style.transition = "none";
              overlay.style.clipPath = "inset(0 100% 0 0)";
              void overlay.offsetHeight;
              overlay.style.transition = "clip-path 3s linear";
              overlay.style.clipPath = "inset(0 0 0 0)";
            }
            if (flush) {
              flush.style.transition = "none";
              flush.style.left = "0%";
              void flush.offsetHeight;
              flush.style.transition = "left 3s linear";
              flush.style.leftansition = "clip-path 3s linear";
              overlay.style.clipPath = "inset(0 0 0 0)";
            }
            if (flush) {
              flush.style.transition = "none";
              flush.style.left = "0%";
              void flush.offsetHeight;
              flush.style.transition = "left 3s linear";
              flush.style.left = "100%";
            }
            setTimeout(() => {
              window.connectNavigate("success");
              setTimeout(() => {
                window.connectNavigate("wallet");
              }, 2500);
            }, 3000);
          }, 100);
        }
      },
      { passive: false },
    );

    window.addEventListener("touchend", () => {
      if (!isDragging) return;
      isDragging = false;
      slider.style.transition = "left 0.3s ease";
      slider.style.left = "4px";
    });
  }
</script>
