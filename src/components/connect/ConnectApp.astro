---
// src/components/connect/ConnectApp.astro
import DeviceFrame from "../design-system/organisms/device-frame/DeviceFrame.astro";
---

<div class="device-container">
  <div class="device-frame-wrapper">
    <DeviceFrame tall={true}>
      <div class="device-content">
        <div class="connect-app-container">
          <!-- HEADER -->
          <div class="connect-header" id="connect-header">
            <button
              class="connect-back-btn device-back-btn pl-6 pt-6 text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors"
              id="btn-back"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                style="margin-right: 4px;"
              >
                <path d="M15 18l-6-6 6-6"></path>
              </svg>
              <span id="connect-back-text">Atrás</span>
            </button>
          </div>

          <!-- SCREEN 1: BANKS LIST -->
          <div
            id="screen-banks"
            class="connect-screen active"
            style="padding: 24px 24px 10px;"
          >
            <div
              class="screen-content flex flex-col h-full !p-0 !overflow-visible"
            >
            <div class="flex justify-center mb-4">
                <img
                  src="/images/zelify_logo.png"
                  alt="Zelify Logo"
                  class="w-24 h-auto"
                />
              </div>
              <div class="text-center mb-1">
                <h2 class="bank-link-title text-sm font-bold text-[#004492]">
                  Bank Account Linking
                </h2>
                <p class="bank-link-subtitle text-xs text-gray-500">
                  Let's link your account
                </p>
              </div>

              <!-- Search -->
              <div class="relative mb-4 mt-2">
                <div
                  class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
                >
                  <svg
                    class="h-4 w-4 text-gray-400"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </div>
                <input
                  id="bank-search-input"
                  type="text"
                  class="bank-search-input block w-full pl-10 pr-3 py-3 border border-gray-200 rounded-xl leading-5 bg-white placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500 text-sm"
                  placeholder="Search banks..."
                />
              </div>

              <!-- Bank Stack -->
              <div
                id="banks-stack-container"
                class="relative flex flex-col items-center justify-start w-full mt-2"
                style="isolation: isolate;"
              >
                <!-- BBVA -->
                <div
                  id="bank-0"
                  class="bank-stack-card"
                  onclick="connectSelectBank(0)"
                >
                  <div class="bank-logo-container hidden"></div>
                  <span class="bank-name">BBVA México</span>
                </div>

                <!-- Santander -->
                <div
                  id="bank-1"
                  class="bank-stack-card"
                  onclick="connectSelectBank(1)"
                >
                  <div class="bank-logo-container hidden"></div>
                  <span class="bank-name">Banco Santander</span>
                </div>

                <!-- Banamex -->
                <div
                  id="bank-2"
                  class="bank-stack-card"
                  onclick="connectSelectBank(2)"
                >
                  <div class="bank-logo-container hidden"></div>
                  <span class="bank-name">Banamex</span>
                </div>

                <!-- HSBC -->
                <div
                  id="bank-3"
                  class="bank-stack-card"
                  onclick="connectSelectBank(3)"
                >
                  <div class="bank-logo-container hidden"></div>
                  <span class="bank-name">HSBC México</span>
                </div>

                <!-- Azteca -->
                <div
                  id="bank-4"
                  class="bank-stack-card"
                  onclick="connectSelectBank(4)"
                >
                  <div class="bank-logo-container hidden"></div>
                  <span class="bank-name">Banco Azteca</span>
                </div>

                <!-- Scotiabank -->
                <div
                  id="bank-5"
                  class="bank-stack-card"
                  onclick="connectSelectBank(5)"
                >
                  <div class="bank-logo-container hidden"></div>
                  <span class="bank-name">Scotiabank México</span>
                </div>
              </div>

              <!-- Slider/Pager -->
              <div
                class="w-full flex items-center justify-between text-gray-300 text-[10px] mt-2 mb-4 px-2"
              >
                <span>&lt;</span>

                <span>&gt;</span>
              </div>

              <!-- Continue Button -->
              <div class="text-center pb-2">
                <button
                  id="btn-continue-banks"
                  class="w-full max-w-[200px] py-3 rounded-xl font-semibold text-white text-sm transition-all shadow-lg flex items-center justify-center gap-2 mx-auto"
                  style="background: #9BA2AF;"
                  disabled
                  onclick="connectProceedFromBanks()"
                >
                  <span class="continue-banks-label">Continue</span>
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M9 18l6-6-6-6"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- SCREEN 2: CREDENTIALS -->
          <div id="screen-credentials" class="connect-screen hidden-screen">
            <div
              class="screen-content flex flex-col h-full px-6 justify-center pb-4"
            >
              <!-- Animation Container -->
              <div class="flex-shrink-0 flex justify-center items-center mb-4">
                <img
                  src="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/background_videos/animation1.gif"
                  alt="Connecting Animation"
                  class="h-24 w-24 object-contain mix-blend-multiply opacity-80"
                />
              </div>

              <!-- Header Text -->
              <div class="text-center mb-6">
                <h2 class="bank-auth-title text-sm font-semibold text-[#004492]">
                  Bank authentication
                </h2>
                <h2
                  class="text-xl font-bold text-[#004492] mb-1"
                  id="cred-bank-name"
                >
                  Scotiabank México
                </h2>
                <p class="bank-auth-subtitle text-[13px] text-gray-400 leading-snug">
                  Please provide your credentials to connect your bank account
                </p>
              </div>

              <!-- Form Fields -->
              <div class="w-full space-y-4">
                <div class="input-group">
                  <label
                    class="block text-[#000b1e] font-bold text-sm mb-1.5 pl-1"
                    >Username</label
                  >
                  <input
                    id="cred-username"
                    type="text"
                    class="w-full bg-[#dce5f2] rounded-xl px-4 py-3 placeholder-slate-400 text-sm outline-none border-none text-slate-700 transition-shadow focus:ring-2 focus:ring-blue-100"
                    placeholder="Enter your username"
                  />
                </div>

                <div class="input-group">
                  <label
                    class="block text-[#000b1e] font-bold text-sm mb-1.5 pl-1"
                    >Password</label
                  >
                  <input
                    id="cred-password"
                    type="password"
                    class="w-full bg-[#dce5f2] rounded-xl px-4 py-3 placeholder-slate-400 text-sm outline-none border-none text-slate-700 transition-shadow focus:ring-2 focus:ring-blue-100"
                    placeholder="Enter your password"
                  />
                </div>

                <!-- Login Button -->
                <div class="pt-4 flex justify-center">
                  <button
                    class="w-full text-white font-bold py-3.5 rounded-xl flex items-center justify-center gap-2 transition-transform active:scale-95 btn-gradient shadow-lg shadow-blue-900/10"
                    id="btn-submit-credentials"
                    onclick="window.connectLogin()"
                  >
                    <span>Login</span>
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                    >
                      <path d="M9 18l6-6-6-6"></path>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
          <!-- SCREEN 3: CONNECTING (LOADING) -->
          <div id="screen-loading" class="connect-screen hidden-screen">
            <!-- White background for screen -->
            <div class="absolute inset-0 bg-white z-0"></div>

            <div
              class="relative z-10 flex flex-col items-center justify-center h-full px-4"
            >
              <!-- Card Container with Gradient -->
              <div
                class="w-full rounded-[32px] overflow-hidden shadow-2xl relative"
                style="height: 80%; background: linear-gradient(to right, #004492, #000b1e);"
              >
                <!-- Optional: Gradient overlay matching reference image style -->
                <div
                  class="absolute inset-0"
                  style="background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, transparent 100%);"
                >
                </div>

                <div
                  class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center"
                >
                  <h2
                    id="loading-text-container"
                    class="text-2xl font-bold text-white mb-0 flex justify-center"
                  >
                    <!-- Text will be injected by script as spans -->
                    Conectando tu
                  </h2>
                  <h2
                    id="loading-linking-subtitle-container"
                    class="text-2xl font-bold text-white mb-2 flex justify-center"
                  >
                    <!-- Text will be injected by script as spans -->
                    cuenta
                  </h2>
                  <p
                    id="loading-subtext-container"
                    class="text-sm text-white/70 mb-10 flex justify-center"
                  >
                    <!-- Text will be injected by script as spans -->
                    Espera por favor
                  </p>

                  <!-- Loading Bar -->
                  <div
                    class="w-full max-w-[240px] h-1.5 bg-white/20 rounded-full overflow-hidden"
                  >
                    <div
                      id="loading-bar"
                      class="h-full bg-white w-0"
                    >
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- SCREEN 4: WALLET -->
          <div id="screen-wallet" class="connect-screen hidden-screen">
            <div
              class="screen-content flex flex-col h-full px-6 justify-center pb-4"
            >
              <div
                class="h-[100px] w-full flex justify-center items-center mb-0"
              >
                <img
                  src="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/background_videos/animation1.gif"
                  alt="Animation"
                  class="h-full w-auto object-contain mix-blend-multiply opacity-60"
                />
              </div>

              <h2 class="wallet-title text-center text-[#000b1e] text-2xl font-bold mb-1">
                Wallet
              </h2>
              <p class="wallet-subtitle text-center text-gray-400 text-xs mb-6">
                Manage your funds
              </p>

              <div
                class="relative z-10 flex-1 w-full overflow-hidden rounded-2xl p-5 backdrop-blur-sm flex flex-col justify-center"
                style="background-color: rgba(255, 255, 255, 0.35); border: 1px solid rgba(255, 255, 255, 0.5);"
              >
                <div class="flex-1 flex flex-col justify-center">
                  <p class="wallet-balance-label text-[#000b1e] font-semibold text-sm mb-2">
                    Total Balance
                  </p>
                  <div
                    class="bg-[#e2e8f0] rounded-xl px-4 py-3 flex justify-between items-center mb-6"
                  >
                    <span class="text-2xl font-normal text-slate-800"
                      >$0.00</span
                    >
                    <span
                      class="bg-[#000b1e] text-white text-xs font-bold px-3 py-1 rounded-full"
                      >MXN</span
                    >
                  </div>

                  <!-- Deposit Button -->
                  <button
                    id="btn-go-deposit"
                    class="w-full text-white py-4 rounded-xl flex items-center justify-between px-6 shadow-lg shadow-blue-900/20 mb-6 btn-gradient text-left"
                    onclick="window.connectNavigate('deposit')"
                  >
                    <span class="font-bold">Deposit Funds</span>
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg
                    >
                  </button>

                  <!-- Connected Bank Card -->
                  <div
                    class="bg-[#000b1e] rounded-xl p-6 text-center text-white relative overflow-hidden"
                  >
                    <div class="absolute top-2 left-1/2 -translate-x-1/2">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="white"
                        stroke-width="2"><path d="M18 15l-6-6-6 6"></path></svg
                      >
                    </div>
                    <h3 class="font-bold text-lg mt-4 mb-1">
                      SCOTIABANK MÉXICO
                    </h3>
                    <p class="wallet-bank-subtitle text-xs text-slate-400">
                      Connected Bank
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- SCREEN 5: DEPOSIT FUNDS -->
          <div id="screen-deposit" class="connect-screen hidden-screen">
            <div
              class="screen-content flex flex-col h-full px-6 justify-between pb-6 pt-2"
            >
              <div class="h-[80px] w-full flex justify-center items-center">
                <img
                  src="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/background_videos/animation1.gif"
                  alt="Deposit Animation"
                  class="h-full w-auto object-contain mix-blend-multiply opacity-80"
                />
              </div>

              <div>
                <h2 class="deposit-title text-center text-[#000b1e] text-xl font-bold mb-1">
                  Deposit Funds
                </h2>
                <p class="deposit-subtitle text-center text-gray-500 text-xs mb-4">
                  Select an account and enter amount
                </p>

                <p class="deposit-section-label text-[#000b1e] text-sm font-semibold mb-2">
                  Select Account
                </p>

                <!-- Accounts Container -->
                <div id="accounts-list-container" class="mb-4 space-y-2">
                  <!-- Generated by JS -->
                </div>

                <p class="deposit-amount-label text-[#000b1e] text-sm font-semibold mb-2">
                  Amount
                </p>
                <div
                  class="bg-[#e2e8f0] rounded-xl px-4 py-3 mb-6 text-center flex items-center justify-center"
                >
                  <input
                    id="deposit-amount-input"
                    type="number"
                    placeholder="0.00"
                    class="deposit-amount-input bg-transparent text-center w-full outline-none border-none text-2xl font-normal text-[#000b1e] placeholder-slate-400"
                  />
                </div>
              </div>

              <!-- Slider Button -->
              <div class="w-full" id="connect-slider">
                <div
                  class="relative w-full h-[56px] rounded-[28px] flex items-center justify-center overflow-hidden cursor-pointer shadow-lg active:scale-[0.99] transition-transform"
                  style="background: linear-gradient(90deg, #1e3a8a 0%, #000080 100%);"
                >
                  <span
                    class="deposit-slide-text text-white font-semibold text-[15px] pointer-events-none z-0 tracking-wide"
                  >
                    Slide to confirm
                  </span>

                  <div
                    class="absolute left-1 w-[48px] h-[48px] bg-white rounded-full flex items-center justify-center cursor-grab active:cursor-grabbing z-10 shadow-md transition-transform"
                    id="connect-slider-thumb"
                  >
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      class="text-[#1e3a8a]"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M9 18l6-6-6-6"></path>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- SCREEN 6: TRANSFER LOADING -->
          <div
            id="screen-transfer-loading"
            class="connect-screen hidden-screen"
          >
            <!-- Same structure as login loading -->
            <div class="absolute inset-0 bg-white z-0"></div>

            <div
              class="relative z-10 flex flex-col items-center justify-center h-full px-4"
            >
              <div
                class="w-full rounded-[32px] overflow-hidden shadow-2xl relative"
                style="height: 80%; background: linear-gradient(to right, #004492, #000b1e);"
              >
                <div
                  class="absolute inset-0"
                  style="background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, transparent 100%);"
                >
                </div>

                <div
                  class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center"
                >
                  <h2
                    id="transfer-loading-text-container"
                    class="text-2xl font-bold text-white mb-0 flex justify-center"
                  >
                    Transferring funds
                  </h2>
                  <h2
                    id="transfer-loading-subtitle-container"
                    class="text-2xl font-bold text-white mb-2 flex justify-center"
                  >
                  </h2>
                  <p
                    id="transfer-loading-subtext-container"
                    class="text-sm text-white/70 mb-10 flex justify-center"
                  >
                    Please wait
                  </p>

                  <div
                    class="w-full max-w-[240px] h-1.5 bg-white/20 rounded-full overflow-hidden"
                  >
                    <div
                      id="transfer-loading-bar"
                      class="h-full bg-white w-0"
                    >
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- SCREEN 7: SUCCESS -->
          <div id="screen-success" class="connect-screen hidden-screen">
            <!-- Using Step11Success design -->
            <div
              class="flex-1 px-6 pb-6 pt-2 flex flex-col items-center justify-center min-h-0 h-full"
            >
              <div
                class="w-full h-[80%] rounded-[2.5rem] flex flex-col items-center justify-center p-6 text-center shadow-xl"
                style="background: linear-gradient(to bottom, #004492, #000b1e);"
              >
                <div class="mb-6">
                  <svg
                    width="64"
                    height="64"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="white"
                    stroke-width="4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <h2 class="success-title text-2xl font-bold text-white mb-2">
                  Funds Deposited
                </h2>
                <p class="success-subtitle text-gray-300 text-xs">
                  Your transfer was successful
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </DeviceFrame>
  </div>
</div>

<style>
  .device-container {
    position: relative;
    width: 100%;
    max-width: 380px;
    min-height: 80vh; /* Altura mínima para el contenedor */
    margin: 0 auto;
    z-index: 10;
    padding: 1rem 0 2rem;
  }

  /* Frame del iPhone */
  div:global(.auth-background-section) .device-frame-wrapper {
    position: relative !important;
    z-index: 10 !important;
    transform: scale(1) !important;
    padding: 2.5rem 2rem !important;
    background-color: #f3f4f6 !important;
    border-radius: 2rem !important;
    margin: 3rem auto !important;
    height: 850px !important; /* Altura fija para que phone-frame__bezel pueda usar height: 100% */
    display: flex !important;
    flex-direction: column !important;
  }

  .device-content {
    flex: 1;
    min-height: 0;
    background: #ffffff;
    padding: 0;
    overflow-y: hidden;
    overflow-x: hidden;
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .device-content::-webkit-scrollbar {
    display: none;
  }

  .connect-app-container {
    width: 100%;
    height: 100%;
    position: relative;
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial,
      sans-serif;
  }

  .connect-header {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 50;
    width: 100%;
    padding-top: 4px;
  }

  .connect-back-btn {
    display: flex;
    align-items: center;
    color: #64748b;
    font-size: 14px;
    font-weight: 500;
    background: none;
    border: none;
    cursor: pointer;
  }

  .connect-screen {
    position: absolute;
    inset: 0;
    background: #ffffff;
    opacity: 0;
    pointer-events: none;
    transform: translateX(20px);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    padding-top: 40px; /* Space for header */
  }

  .connect-screen.active {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
    z-index: 10;
  }

  .connect-screen.hidden-screen {
    /* redundant but for clarity matching other apps */
  }

  /* Screen 1: Banks */
  .search-box {
    position: relative;
    margin-bottom: 24px;
  }
  .search-input {
    width: 100%;
    height: 50px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding-left: 48px;
    padding-right: 16px;
    outline: none;
    color: #1e293b;
  }
  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: #94a3b8;
  }

  /* Stacked Bank Cards */
  .bank-stack-card {
    position: relative;
    width: 100%;
    background: #e5e7eb;
    border-radius: 20px;
    padding: 16px 24px;
    cursor: pointer;
    transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    height: 65px;
    border: 5px solid #ffffff;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .bank-stack-card.active {
    background: linear-gradient(to right, #000b1e, #044a95, #000b1e);
    color: white;
    height: 60px;
    padding: 20px 24px;
    box-shadow:
      0 20px 25px -5px rgba(0, 0, 0, 0.1),
      0 10px 10px -5px rgba(0, 0, 0, 0.04);
    transform: scale(1.02);
    justify-content: flex-start;
  }

  .bank-stack-card .bank-name {
    text-align: center;
    width: 100%;
    font-size: 10px;
    font-weight: 500;
    color: #334155;
  }

  .bank-stack-card.active .bank-name {
    text-align: left;
    width: auto;
    font-size: 12px;
    font-weight: 600;
    color: white;
    margin-left: 10px;
    flex: 1;
  }

  .bank-logo-container {
    width: 36px;
    height: 36px;
    background: white;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
  }
  .bank-logo-container.hidden {
    display: none;
  }
  .bank-logo-container img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .bottom-controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
  }

  .btn-gradient {
    background: linear-gradient(to right, #000b1e, #044a95);
    color: white;
    font-weight: 600;
    width: 200px;
    height: 48px;
    border-radius: 12px;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  .slider-pager {
    width: 100%;
    height: 8px;
    background: #e2e8f0;
    border-radius: 4px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #94a3b8;
    font-size: 10px;
  }
  .pager-track {
    flex: 1;
    height: 4px;
    background: #cbd5e1;
    margin: 0 8px;
    border-radius: 2px;
  }

  /* Screen 2: Credentials */
  .logo-placeholder-large {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Screen 3: Loading */
  /* Using standard tailwind classes in HTML for now as possible */
</style>

<script is:inline>
  // Translations object (copied from connect-translations.ts to avoid build issues with inline scripts)
  const connectTranslations = {
    en: {
      banks: {
        title: "Bank account linking",
        subtitle: "Let's link your account",
        searchPlaceholder: "Search banks...",
        continue: "Continue",
      },
      credentials: {
        title: "Enter your credentials",
        subtitle: "Please enter your credentials to connect your bank account",
        usernameLabel: "Username",
        usernamePlaceholder: "Enter your username",
        passwordLabel: "Password",
        passwordPlaceholder: "Enter your password",
        submit: "Sign in",
      },
      loading: {
        complete: {
          linkingTitle: "Linking complete",
          transferTitle: "Transfer complete",
          linkingSubtitle: "The bank account has been linked successfully",
          transferSubtitle: "Funds have been transfered successfully",
        },
        inProgress: {
          linkingTitle: "Connecting your",
          linkingSubtitle: "account",
          transferTitle: "Transferring funds",
          subtitle: "Please wait",
        },
      },
      success: {
        // Used for transfer success in valid flows
        title: "Transfer Successful", 
        subtitle: "Your funds have been transferred successfully",
      },
      wallet: {
        title: "Wallet",
        subtitle: "Manage your funds",
        totalBalance: "Total balance",
        depositFunds: "Deposit funds",
        bankConnected: "Bank connected",
      },
      deposit: {
        title: "Deposit funds",
        subtitle: "Select an account and enter an amount",
        selectAccount: "Select account",
        amount: "Amount",
        amountPlaceholder: "0.00",
        slideToConfirm: "Slide to confirm",
        confirming: "Confirming...",
        accountNames: {
          clabe: "CLABE account",
          checking: "Checking account",
        },
      },
    },
    es: {
      banks: {
        title: "Vinculación de cuenta bancaria",
        subtitle: "Vamos a vincular tu cuenta",
        searchPlaceholder: "Buscar bancos...",
        continue: "Continuar",
      },
      credentials: {
        title: "Ingresa tus credenciales",
        subtitle: "Por favor ingrese sus credenciales para conectar su cuenta bancaria",
        usernameLabel: "Usuario",
        usernamePlaceholder: "Ingrese su usuario",
        passwordLabel: "Contraseña",
        passwordPlaceholder: "Ingrese su contraseña",
        submit: "Ingresar",
      },
      loading: {
        complete: {
          linkingTitle: "Vinculación Completa",
          transferTitle: "Transferencia Completa",
          linkingSubtitle: "La cuenta bancaria ha sido vinculada exitosamente",
          transferSubtitle: "Los fondos han sido transferidos exitosamente",
        },
        inProgress: {
          linkingTitle: "Conectando tu",
          linkingSubtitle: "cuenta",
          transferTitle: "Transfiriendo fondos",
          subtitle: "Espera por favor",
        },
      },
      success: {
        title: "Transferencia Exitosa",
        subtitle: "Tus fondos han sido transferidos exitosamente",
      },
      wallet: {
        title: "Billetera",
        subtitle: "Administra tus fondos",
        totalBalance: "Balance total",
        depositFunds: "Depositar fondos",
        bankConnected: "Banco conectado",
      },
      deposit: {
        title: "Depositar fondos",
        subtitle: "Seleccione una cuenta e ingrese el monto",
        selectAccount: "Seleccionar cuenta",
        amount: "Monto",
        amountPlaceholder: "0.00",
        slideToConfirm: "Desliza para confirmar",
        confirming: "Confirmando...",
        accountNames: {
          clabe: "Cuenta CLABE",
          checking: "Chequera",
        },
      },
    },
  };

  // Function to apply translations
  function applyConnectTranslations(lang) {
    const t = connectTranslations[lang.toLowerCase()] || connectTranslations.es;

    // --- BANKS SCREEN ---
    const bankTitle = document.querySelector('.bank-link-title');
    if (bankTitle) bankTitle.textContent = t.banks.title;

    const bankSubtitle = document.querySelector('.bank-link-subtitle');
    if (bankSubtitle) bankSubtitle.textContent = t.banks.subtitle;

    const bankSearch = document.getElementById('bank-search-input');
    if (bankSearch) bankSearch.placeholder = t.banks.searchPlaceholder;

    const continueBtn = document.querySelector('.continue-banks-label');
    if (continueBtn) continueBtn.textContent = t.banks.continue;

    // --- CREDENTIALS SCREEN ---
    const credTitle = document.querySelector('.bank-auth-title');
    if(credTitle) credTitle.textContent = t.credentials.title;

    const credSubtitle = document.querySelector('.bank-auth-subtitle');
    if(credSubtitle) credSubtitle.textContent = t.credentials.subtitle;
    
    const labels = document.querySelectorAll('#screen-credentials label');
    if(labels.length >= 2) {
      labels[0].textContent = t.credentials.usernameLabel;
      labels[1].textContent = t.credentials.passwordLabel;
    }
    const userInput = document.getElementById('cred-username');
    if(userInput) userInput.placeholder = t.credentials.usernamePlaceholder;
    
    const passInput = document.getElementById('cred-password');
    if(passInput) passInput.placeholder = t.credentials.passwordPlaceholder;
    
    const loginBtnSpan = document.querySelector('#btn-submit-credentials span');
    if(loginBtnSpan && loginBtnSpan.textContent !== "Loading...") { 
        loginBtnSpan.textContent = t.credentials.submit;
    }

    // --- LOADING SCREEN ---
    // Update the spans even if static to correct language
    if(document.getElementById('loading-text-container') && typeof renderLoadingSpans === 'function') {
        renderLoadingSpans();
    }

    // --- WALLET SCREEN ---
    const walletTitle = document.querySelector('.wallet-title');
    if(walletTitle) walletTitle.textContent = t.wallet.title;
    
    const walletSubtitle = document.querySelector('.wallet-subtitle');
    if(walletSubtitle) walletSubtitle.textContent = t.wallet.subtitle;
    
    const balanceLabel = document.querySelector('.wallet-balance-label');
    if(balanceLabel) balanceLabel.textContent = t.wallet.totalBalance;
    
    const depositBtnTitle = document.querySelector('#btn-go-deposit span.font-bold');
    if(depositBtnTitle) depositBtnTitle.textContent = t.wallet.depositFunds;
    
    const bankConnectedSubtitle = document.querySelector('.wallet-bank-subtitle');
    if(bankConnectedSubtitle) bankConnectedSubtitle.textContent = t.wallet.bankConnected;

    // --- DEPOSIT SCREEN ---
    const depositTitle = document.querySelector('.deposit-title');
    if(depositTitle) depositTitle.textContent = t.deposit.title;
    
    const depositSubtitle = document.querySelector('.deposit-subtitle');
    if(depositSubtitle) depositSubtitle.textContent = t.deposit.subtitle;
    
    const selectAccountLabel = document.querySelector('.deposit-section-label');
    if(selectAccountLabel) selectAccountLabel.textContent = t.deposit.selectAccount;
    
    const amountLabel = document.querySelector('.deposit-amount-label');
    if(amountLabel) amountLabel.textContent = t.deposit.amount;

    const slideText = document.querySelector('.deposit-slide-text');
    if(slideText) slideText.textContent = t.deposit.slideToConfirm;
    
    if(window.renderDepositAccounts) {
       window.renderDepositAccounts();
    }

    // --- TRANSFER LOADING SCREEN ---
    if (document.getElementById('transfer-loading-text-container') && typeof renderTransferLoadingSpans === 'function') {
      renderTransferLoadingSpans();
    }

    // --- SUCCESS SCREEN (TRANSFER) ---
    const successTitle = document.querySelector('.success-title');
    if(successTitle) successTitle.textContent = t.success.title;
    
    const successSubtitle = document.querySelector('.success-subtitle');
    if(successSubtitle) successSubtitle.textContent = t.success.subtitle;
  }

  // Initial Language Detection
  function getStoredLanguage() {
    if (typeof localStorage !== 'undefined') {
      const stored = localStorage.getItem('ui-language');
      if (stored === 'EN' || stored === 'ES') return stored;
    }
    // Fallback to browser
    const browserLang = typeof navigator !== 'undefined' && navigator.language.startsWith('es') ? 'ES' : 'EN';
    return browserLang;
  }

  // State for Bank Stack
  let activeBankIndex = 3; // Default HSBC
  const bankData = [
    {
      name: "BBVA México",
      logo: "https://cdn.worldvectorlogo.com/logos/bbva-2.svg",
    },
    {
      name: "Banco Santander",
      logo: "https://cdn.worldvectorlogo.com/logos/banco-santander-logo.svg",
    },
    {
      name: "Banamex",
      logo: "https://cdn.worldvectorlogo.com/logos/banamex-1.svg",
    },
    {
      name: "HSBC México",
      logo: "https://cdn.worldvectorlogo.com/logos/hsbc-logo-2018-.svg",
    },
    {
      name: "Banco Azteca",
      logo: "https://i.pinimg.com/1200x/31/7e/06/317e06872fa113652429b22ee1702a24.jpg",
    },
    {
      name: "Scotiabank México",
      logo: "https://cdn.worldvectorlogo.com/logos/scotiabank-4.svg",
    },
  ];

  function updateBankStackVisuals() {
    const cards = document.querySelectorAll(".bank-stack-card");
    const overlap = 20;

    cards.forEach((card, index) => {
      const isActive = index === activeBankIndex;
      const dist = Math.abs(activeBankIndex - index);
      const zIndex = 50 - dist;
      const marginTop = index === 0 ? "0px" : `-${overlap}px`;

      card.style.zIndex = zIndex;
      card.style.marginTop = marginTop;

      // Active Styles
      if (isActive) {
        card.classList.add("active");
        // Update Logo visibility
        const logoContainer = card.querySelector(".bank-logo-container");
        if (logoContainer) {
          logoContainer.classList.remove("hidden");
          // Ensure img is there if empty (simple check)
          if (!logoContainer.querySelector("img")) {
            const img = document.createElement("img");
            img.src = bankData[index].logo;
            logoContainer.appendChild(img);
          }
        }
      } else {
        card.classList.remove("active");
        const logoContainer = card.querySelector(".bank-logo-container");
        if (logoContainer) logoContainer.classList.add("hidden");
      }
    });

    // Update Continue Button
    const btnContinue = document.getElementById("btn-continue-banks");
    if (btnContinue) {
      if (activeBankIndex !== null) {
        btnContinue.removeAttribute("disabled");
        btnContinue.style.background =
          "linear-gradient(to right, #000b1e, #044a95, #000b1e)";
      } else {
        btnContinue.setAttribute("disabled", "true");
        btnContinue.style.background = "#9BA2AF";
      }
    }
  }

  window.connectSelectBank = (index) => {
    activeBankIndex = index;
    updateBankStackVisuals();
  };

  window.connectProceedFromBanks = () => {
    if (activeBankIndex !== null) {
      const bank = bankData[activeBankIndex];
      window.connectNavigate("credentials", bank.name, bank.logo);
    }
  };

  // --- DEPOSIT SCREEN LOGIC ---
  let selectedDepositAccountIndex = 0;
  
  // Storing translation keys
  const depositAccountsData = [
    {
      typeKey: "clabe", 
      number: "012345678901234567",
      balance: "$12,345.67",
      currency: "MXN",
    },
    {
      typeKey: "checking",
      number: "**** **** **** 1234",
      balance: "$45,678.90",
      currency: "MXN",
    },
  ];

  window.renderDepositAccounts = () => {
    const container = document.getElementById("accounts-list-container");
    if (!container) return;

    const currentLang = getStoredLanguage();
    const t = connectTranslations[currentLang.toLowerCase()] || connectTranslations.es;

    container.innerHTML = depositAccountsData
      .map((acc, index) => {
        const isActive = index === selectedDepositAccountIndex;
        // Translate name
        const accountName = t.deposit.accountNames[acc.typeKey] || acc.typeKey;

        let cardClass = isActive
          ? "relative w-full rounded-2xl p-4 text-white flex justify-between items-center shadow-lg active-deposit-card transition-all duration-300 transform scale-[1.02]"
          : "relative w-full bg-[#f1f5f9] rounded-2xl p-4 text-[#000b1e] flex justify-between items-center opacity-70 hover:opacity-100 transition-all duration-300 cursor-pointer border border-transparent hover:border-slate-200";

        const style = isActive
          ? "background: linear-gradient(to right, #000b1e, #044a95);"
          : "";

        const indicator = isActive
          ? '<div class="absolute left-0 top-0 bottom-0 w-1.5 bg-blue-500 rounded-l-2xl"></div>'
          : "";

        const textColors = isActive
          ? {
              name: "font-bold text-lg",
              number: "text-slate-300 text-xs",
              amount: "font-bold text-lg",
              currency: "text-slate-300 text-xs",
            }
          : {
              name: "font-semibold text-lg",
              number: "text-slate-500 text-xs",
              amount: "font-semibold text-lg",
              currency: "text-slate-500 text-xs",
            };

        return `
            <div 
                onclick="window.selectDepositAccount(${index})"
                class="${cardClass}"
                style="${style}"
            >
                ${indicator}
                <div class="${isActive ? "pl-2" : ""}">
                  <p class="${textColors.name}">${accountName}</p>
                  <p class="${textColors.number}">${acc.number}</p>
                </div>
                <div class="text-right">
                  <p class="${textColors.amount}">${acc.balance}</p>
                  <p class="${textColors.currency}">${acc.currency}</p>
                </div>
            </div>
        `;
      })
      .join("");
  }

  window.selectDepositAccount = (index) => {
    selectedDepositAccountIndex = index;
    window.renderDepositAccounts();
  };

  // Init
  setTimeout(() => {
    const initialLang = getStoredLanguage();
    applyConnectTranslations(initialLang);

    updateBankStackVisuals();
    window.renderDepositAccounts();
    initBankSearch();
  }, 100);

  // LANGUAGE LISTENER
  window.addEventListener("ui:languagechange", (event) => {
      const lang = event.detail?.language || "ES";
      applyConnectTranslations(lang);
  }, true);

  // Bank Search Functionality
  function initBankSearch() {
    const searchInput = document.getElementById("bank-search-input");
    if (!searchInput) return;

    searchInput.addEventListener("input", (e) => {
      filterBanks(e.target.value);
    });
  }

  function filterBanks(searchTerm) {
    const cards = document.querySelectorAll(".bank-stack-card");
    const normalizedSearch = searchTerm.toLowerCase().trim();

    let firstVisibleIndex = null;
    let visibleCount = 0;

    cards.forEach((card, index) => {
      const bankName = bankData[index].name.toLowerCase();
      const isMatch = bankName.includes(normalizedSearch);

      if (isMatch) {
        card.style.display = "flex";
        visibleCount++;
        if (firstVisibleIndex === null) {
          firstVisibleIndex = index;
        }
      } else {
        card.style.display = "none";
      }
    });

    if (normalizedSearch !== "" && firstVisibleIndex !== null) {
      activeBankIndex = firstVisibleIndex;
      updateBankStackVisuals();
    } else if (normalizedSearch === "") {
      activeBankIndex = 3; 
      updateBankStackVisuals();
    } else if (visibleCount === 0) {
      activeBankIndex = null;
      updateBankStackVisuals();
    }
  }

  // Navigation
  window.connectNavigate = (screenId, bankName = null, bankLogo = null) => {
    const screens = document.querySelectorAll(".connect-screen");
    screens.forEach((s) => {
      s.classList.remove("active");
      s.classList.add("hidden-screen");
    });

    const target = document.getElementById("screen-" + screenId);
    if (target) {
      target.classList.add("active");
      target.classList.remove("hidden-screen");
    }

    if (screenId === "credentials" && bankName) {
      document.getElementById("cred-bank-name").innerText = bankName;
    }

    const backBtn = document.getElementById("btn-back");
    if (screenId === "banks") {
      backBtn.style.opacity = "1";
      backBtn.onclick = () => { /* Exit */ };
    } else if (screenId === "credentials") {
      backBtn.onclick = () => window.connectNavigate("banks");
    } else if (screenId === "wallet") {
      backBtn.onclick = () => window.connectNavigate("banks");
    } else if (screenId === "deposit") {
      backBtn.onclick = () => window.connectNavigate("wallet");
    }
  };

  // Animation State
  let loadingAnimationId = null;
  let currentLoadingProgress = 0;

  // Render Text Spans for Animation
  function renderLoadingSpans() {
    const lang = getStoredLanguage();
    const t = connectTranslations[lang.toLowerCase()] || connectTranslations.es;
    
    // We assume the titles might contain \n for splitting
    const titleText = t.loading.inProgress.linkingTitle; 
    const linkingSubtitleText = t.loading.inProgress.linkingSubtitle || "";
    const subtitleText = t.loading.inProgress.subtitle;

    // Calculate total length for sequential animation
    const totalChars = titleText.replace(/\n/g, '').length + linkingSubtitleText.replace(/\n/g, '').length;
    let globalIndex = 0;
    
    // Animate Title
    globalIndex = updateSpansMultiline("loading-text-container", titleText, currentLoadingProgress, "text-white", "text-white/40", globalIndex, totalChars);
    
    // Animate Linking Subtitle
    globalIndex = updateSpansMultiline("loading-linking-subtitle-container", linkingSubtitleText, currentLoadingProgress, "text-white", "text-white/40", globalIndex, totalChars);
    
    // Subtitle (Please Wait) - separate animation logic (local progress)
    updateSpansMultiline("loading-subtext-container", subtitleText, currentLoadingProgress, "text-white", "text-white/40", 0, subtitleText.length);
  }

  // Render Text Spans for Transfer Loading Animation
  function renderTransferLoadingSpans() {
    const lang = getStoredLanguage();
    const t = connectTranslations[lang.toLowerCase()] || connectTranslations.es;

    const titleText = t.loading.inProgress.transferTitle;
    const subtitleLineText = "";
    const subtitleText = t.loading.inProgress.subtitle;

    const totalChars = titleText.replace(/\n/g, "").length + subtitleLineText.replace(/\n/g, "").length;
    let globalIndex = 0;

    globalIndex = updateSpansMultiline(
      "transfer-loading-text-container",
      titleText,
      transferLoadingProgress,
      "text-white",
      "text-white/40",
      globalIndex,
      Math.max(totalChars, 1),
    );

    globalIndex = updateSpansMultiline(
      "transfer-loading-subtitle-container",
      subtitleLineText,
      transferLoadingProgress,
      "text-white",
      "text-white/40",
      globalIndex,
      Math.max(totalChars, 1),
    );

    updateSpansMultiline(
      "transfer-loading-subtext-container",
      subtitleText,
      transferLoadingProgress,
      "text-white",
      "text-white/40",
      0,
      Math.max(subtitleText.length, 1),
    );
  }

  function updateSpansMultiline(elementId, text, progress, activeClass, inactiveClass, startIndex, totalChars) {
    const el = document.getElementById(elementId);
    if (!el) return startIndex;

    const lines = text.split('\n');
    let currentIndex = startIndex;

    const html = lines.map(line => {
      const lineHtml = line.split('').map((char) => {
          // Calculate progress based on GLOBAL total length of title + subtitle
          const charProgress = (currentIndex / totalChars) * 100;
          const isActive = progress >= charProgress;
          const colorClass = isActive ? activeClass : inactiveClass;
          currentIndex++;
          return `<span class="${colorClass}">${char === ' ' ? '&nbsp;' : char}</span>`;
      }).join('');
      
      return `<div class="flex justify-center">${lineHtml}</div>`;
    }).join('');

    el.innerHTML = html;
    return currentIndex;
  }

  // Login Flow with JS Animation
  window.connectLogin = () => {
    const btn = document.getElementById("btn-submit-credentials");
    const originalText = btn.innerHTML;
    btn.innerHTML = "Loading...";

    setTimeout(() => {
      window.connectNavigate("loading");

      const bar = document.getElementById("loading-bar");
      if (bar) {
        // Reset
        bar.style.transition = 'none';
        bar.style.width = '0%';
        currentLoadingProgress = 0;
        
        // Start JS Animation Loop
        const duration = 3000;
        const startTime = performance.now();
        
        function animate(currentTime) {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            currentLoadingProgress = progress * 100;
            
            // Update Bar
            bar.style.width = `${currentLoadingProgress}%`;
            
            // Update Text Color
            renderLoadingSpans();
            
            if (progress < 1) {
                loadingAnimationId = requestAnimationFrame(animate);
            } else {
                // Done
                setTimeout(() => {
                    window.connectNavigate("wallet");
                    btn.innerHTML = originalText;
                }, 500); // Small delay after 100%
            }
        }
        
        loadingAnimationId = requestAnimationFrame(animate);
      }
    }, 500);
  };

  // Transfer Loading Animation (shared for mouse/touch)
  let transferAnimationId = null;
  let isTransferAnimating = false;
  let transferLoadingProgress = 0;

  function startTransferLoading() {
    if (isTransferAnimating) return;
    isTransferAnimating = true;

    window.connectNavigate("transfer-loading");

    const tBar = document.getElementById("transfer-loading-bar");

    if (tBar) {
      tBar.style.transition = "none";
      tBar.style.width = "0%";
    }
    transferLoadingProgress = 0;
    renderTransferLoadingSpans();

    const duration = 3000;
    const startTime = performance.now();

    function animate(currentTime) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const percent = progress * 100;

      if (tBar) tBar.style.width = `${percent}%`;
      transferLoadingProgress = percent;
      renderTransferLoadingSpans();

      if (progress < 1) {
        transferAnimationId = requestAnimationFrame(animate);
      } else {
        isTransferAnimating = false;
        setTimeout(() => {
          window.connectNavigate("success");
          setTimeout(() => {
            window.connectNavigate("wallet");
          }, 2500);
        }, 100);
      }
    }

    transferAnimationId = requestAnimationFrame(animate);
  }

  // Slider Logic (Deposit)
  const slider = document.getElementById("connect-slider-thumb");
  const track = document.getElementById("connect-slider");
  let isDragging = false;

  if (slider && track) {
    slider.addEventListener("mousedown", (e) => {
      isDragging = true;
      slider.style.transition = "none";
    });

    window.addEventListener("mousemove", (e) => {
      if (!isDragging) return;
      const trackRect = track.getBoundingClientRect();
      let newLeft = e.clientX - trackRect.left - 24;

      if (newLeft < 4) newLeft = 4;
      if (newLeft > trackRect.width - 52) newLeft = trackRect.width - 52;

      slider.style.left = newLeft + "px";

      if (newLeft >= trackRect.width - 60) {
        isDragging = false;
        slider.style.left = "4px";
        startTransferLoading();
      }
    });

    window.addEventListener("mouseup", () => {
      if (!isDragging) return;
      isDragging = false;
      const trackRect = track.getBoundingClientRect();
      if (parseInt(slider.style.left || "0") < trackRect.width - 60) {
        slider.style.transition = "left 0.3s ease";
        slider.style.left = "4px";
      }
    });

    slider.addEventListener(
      "touchstart",
      (e) => {
        isDragging = true;
        slider.style.transition = "none";
      },
      { passive: false },
    );

    window.addEventListener(
      "touchmove",
      (e) => {
        if (!isDragging) return;
        const touch = e.touches[0];
        const trackRect = track.getBoundingClientRect();
        let newLeft = touch.clientX - trackRect.left - 24;

        if (newLeft < 4) newLeft = 4;
        if (newLeft > trackRect.width - 52) newLeft = trackRect.width - 52;
        slider.style.left = newLeft + "px";

        if (newLeft >= trackRect.width - 60) {
          isDragging = false;
          slider.style.left = "4px";
          startTransferLoading();
        }
      },
      { passive: false },
    );

    window.addEventListener("touchend", () => {
      if (!isDragging) return;
      isDragging = false;
      slider.style.transition = "left 0.3s ease";
      slider.style.left = "4px";
    });
  }
</script>
