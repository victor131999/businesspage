---
import TokensDashboard from "./TokensDashboard";
---

<TokensDashboard client:visible />

<style>
  :global(.tokens-dashboard) {
    width: 100%;
    height: 100%;
    max-height: 100%;
  }

  /* Animaciones de entrada para tarjetas */
  :global(.card-animate) {
    opacity: 0;
    transform: translateY(20px);
    animation: slideInUp 0.6s ease-out forwards;
  }

  @keyframes slideInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Animación para barras de progreso */
  :global(.bar-progress) {
    position: relative;
    overflow: hidden;
  }

  :global(.bar-progress::after) {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.3),
      transparent
    );
    animation: shimmer 2s infinite;
  }

  @keyframes shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  /* Animación para items de barras */
  :global(.bar-item) {
    opacity: 0;
    transform: translateX(-10px);
    animation: fadeInLeft 0.5s ease-out forwards;
  }

  @keyframes fadeInLeft {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Animación para servicios activos */
  :global(.service-item) {
    opacity: 0;
    transform: translateX(-15px);
    animation: slideInLeft 0.4s ease-out forwards;
  }

  @keyframes slideInLeft {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Animación para filas de logs */
  :global(.log-row) {
    opacity: 0;
    animation: fadeIn 0.3s ease-out forwards;
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  /* Efecto de pulso sutil en números */
  :global(.tokens-dashboard .text-xl) {
    transition: transform 0.2s ease;
  }

  :global(.tokens-dashboard .text-xl:hover) {
    transform: scale(1.05);
  }
</style>
