---
import DiscountHeader from "../DiscountHeader.astro";
const customColor = "#004492";
---

<div
  class="step-content hidden bg-white h-full relative overflow-hidden font-sans"
  id="step-11"
>
  <DiscountHeader showBack={true} />

  <div
    class="flex-1 px-6 pb-6 pt-2 flex flex-col items-center justify-center min-h-0"
  >
    <div
      class="w-full h-full rounded-[2.5rem] flex flex-col items-center justify-center p-6 text-center shadow-xl"
      style={`background: linear-gradient(to bottom, ${customColor}, #000b1e);`}
    >
      <div class="mb-6">
        <svg
          width="64"
          height="64"
          viewBox="0 0 24 24"
          fill="none"
          stroke="white"
          stroke-width="4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <h2 class="text-2xl font-bold text-white mb-2">
        Tu Promoción está activa
      </h2>
      <p class="text-gray-300 text-xs">Revisa tus promociones en tu panel</p>

      <!-- Reset Button (Optional, for demo loop) -->
      <button
        class="mt-8 text-white/50 text-xs hover:text-white transition-colors step-reset-btn"
        id="finish-btn"
      >
        Volver al Inicio
      </button>
    </div>
  </div>
</div>
