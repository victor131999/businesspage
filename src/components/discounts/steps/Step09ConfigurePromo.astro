---
import DiscountHeader from "../DiscountHeader.astro";
const customColor = "#004492";

const dateParts = ["Día", "Mes", "Año"];
---

<div
  class="step-content hidden bg-white h-full relative overflow-hidden font-sans"
  id="step-09"
>
  <div
    class="absolute inset-0 pointer-events-none z-0"
    style="background: linear-gradient(to bottom, transparent 0%, rgba(255, 255, 255, 0.35) 100%)"
  >
  </div>

  <DiscountHeader showBack={true} />

  <div
    class="flex-1 flex flex-col items-center justify-center px-6 pt-2 pb-6 z-10 min-h-0"
  >
    <!-- Main Card Container -->
    <div
      class="w-full relative flex flex-col rounded-[2.5rem] px-5 py-8 overflow-hidden max-h-full"
      style="background-color: #f8f9fc;"
    >
      <!-- Content Scrollable -->
      <div
        class="flex-1 overflow-y-auto flex flex-col [&::-webkit-scrollbar]:hidden"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        <!-- Title Section -->
        <div class="text-center mb-6 shrink-0">
          <h2 class="text-xl text-[#003366] mb-1">
            <span class="discounts-configure-title-light">Configura tu</span>
            <span class="discounts-configure-title-bold font-bold"
              >Promoción</span
            >
          </h2>
          <p
            class="discounts-configure-subtitle text-gray-400 text-[11px] leading-tight"
          >
            Define la duración de tu promoción
          </p>
        </div>

        <!-- Promo Preview Card -->
        <div
          class="w-full rounded-[1.5rem] p-5 flex items-center justify-center gap-4 mb-6 shadow-md relative overflow-hidden shrink-0"
          style="background: linear-gradient(to right, #044a95, #000b1e);"
        >
          <div
            class="w-10 h-10 rounded-full bg-white flex items-center justify-center shrink-0"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#003366"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"></path>
              <path d="M7 2v20"></path>
              <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3zm0 0v7"
              ></path>
            </svg>
          </div>
          <div class="text-center">
            <p class="discounts-promo-brand text-gray-300 text-[10px] uppercase mb-0.5">
              Go Green
            </p>
            <p class="discounts-promo-offer text-white text-xs font-bold leading-tight">
              2x1 en Veggie Bowls
            </p>
          </div>
        </div>

        <!-- Inputs -->
        <div class="space-y-5">
          <div>
            <label
              class="discounts-start-date-label text-gray-500 text-[10px] font-bold ml-1 mb-2 block text-left"
            >
              Fecha de Inicio
            </label>
            <div class="flex gap-2">
              {
                dateParts.map((part) => (
                  <div class="flex-1 bg-gray-200/80 rounded-xl px-3 py-2.5 flex items-center justify-between cursor-pointer hover:bg-gray-300/80 transition-colors">
                    <span class="discounts-date-part text-xs text-gray-500">{part}</span>
                    <svg
                      width="10"
                      height="6"
                      viewBox="0 0 10 6"
                      fill="none"
                      stroke="#6b7280"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M1 1L5 5L9 1" />
                    </svg>
                  </div>
                ))
              }
            </div>
            <div class="flex mt-2">
              <div class="w-1/3 pr-1">
                <div
                  class="bg-gray-200/80 rounded-xl px-3 py-2.5 flex items-center justify-between cursor-pointer hover:bg-gray-300/80 transition-colors"
                >
                  <span class="discounts-hour-label text-xs text-gray-500"> Hora </span>
                  <svg
                    width="10"
                    height="6"
                    viewBox="0 0 10 6"
                    fill="none"
                    stroke="#6b7280"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M1 1L5 5L9 1"></path>
                  </svg>
                </div>
              </div>
            </div>
          </div>

          <div>
            <label
              class="discounts-end-date-label text-gray-500 text-[10px] font-bold ml-1 mb-2 block text-left"
            >
              Fecha de Fin
            </label>
            <div class="flex gap-2">
              {
                dateParts.map((part) => (
                  <div class="flex-1 bg-gray-200/80 rounded-xl px-3 py-2.5 flex items-center justify-between cursor-pointer hover:bg-gray-300/80 transition-colors">
                    <span class="discounts-date-part text-xs text-gray-500">{part}</span>
                    <svg
                      width="10"
                      height="6"
                      viewBox="0 0 10 6"
                      fill="none"
                      stroke="#6b7280"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M1 1L5 5L9 1" />
                    </svg>
                  </div>
                ))
              }
            </div>
            <div class="flex mt-2">
              <div class="w-1/3 pr-1">
                <div
                  class="bg-gray-200/80 rounded-xl px-3 py-2.5 flex items-center justify-between cursor-pointer hover:bg-gray-300/80 transition-colors"
                >
                  <span class="discounts-hour-label text-xs text-gray-500"> Hora </span>
                  <svg
                    width="10"
                    height="6"
                    viewBox="0 0 10 6"
                    fill="none"
                    stroke="#6b7280"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M1 1L5 5L9 1"></path>
                  </svg>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA Button -->
      <div class="mt-6 shrink-0">
        <button
          class="w-full text-white rounded-2xl py-3.5 font-bold text-sm flex items-center justify-between px-6 shadow-lg relative overflow-hidden group transition-transform active:scale-[0.98] step-next-btn"
          style={`background: linear-gradient(to right, ${customColor}, #000b1e);`}
          data-next="10"
        >
          <div class="flex-1 flex items-center justify-center">
            <span class="discounts-launch-label">Lanzar</span>
          </div>
          <span
            class="absolute right-6 transition-transform group-hover:translate-x-1"
          >
            &gt;
          </span>
        </button>
      </div>
    </div>
  </div>
</div>
