---
import DiscountHeader from "../DiscountHeader.astro";
const customColor = "#004492";
---

<div
  class="step-content hidden bg-white h-full relative overflow-hidden font-sans"
  id="step-04"
>
  <DiscountHeader showBack={true} />

  <div class="flex-1 px-4 pt-2 pb-6 flex items-center justify-center min-h-0">
    <div
      class="relative w-full h-[95%] rounded-[2.5rem] overflow-hidden shadow-2xl flex flex-col"
    >
      <!-- Background Layer: Map + Gradient -->
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-[#1a2333] overflow-hidden">
          <!-- Simulated Map Streets -->
          <div class="absolute inset-0 opacity-10">
            <svg class="w-full h-full" width="100%" height="100%">
              <pattern
                id="street-pattern-2"
                x="0"
                y="0"
                width="50"
                height="50"
                patternUnits="userSpaceOnUse"
              >
                <path
                  d="M50 0 L50 50 M0 50 L50 50"
                  stroke="white"
                  stroke-width="1"
                  fill="none"></path>
              </pattern>
              <rect width="100%" height="100%" fill="url(#street-pattern-2)"
              ></rect>
            </svg>
          </div>
        </div>
        <div
          class="absolute inset-0"
          style="background: linear-gradient(to bottom, #000b1e 0%, #044a95 100%); opacity: 0.9;"
        >
        </div>
      </div>

      <!-- Content Layer -->
      <div
        class="relative z-10 w-full h-full px-6 flex flex-col text-white pt-14"
      >
        <h2
          class="text-sm font-normal mb-8 text-center text-white shrink-0 tracking-wide"
        >
          Confirmar Detalles
        </h2>

        <div
          class="flex-1 flex flex-col overflow-y-auto [&::-webkit-scrollbar]:hidden"
          style="scrollbar-width: none; -ms-overflow-style: none;"
        >
          <div class="mb-6">
            <label class="text-white/70 text-xs block mb-1"> Teléfono </label>
            <div
              class="w-full bg-transparent border-b border-white/20 py-2 flex justify-between items-center cursor-pointer"
            >
              <span class="text-sm text-white font-medium">+52</span>
              <span class="text-[10px] text-white/50">▼</span>
            </div>
          </div>

          <div class="flex gap-3 items-start mb-6">
            <div class="text-white shrink-0 mt-0.5">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div>
              <p class="font-medium text-sm text-white leading-tight">
                Oficina Matriz
              </p>
              <p class="text-[10px] text-white/60 mt-0.5">
                Av. De Los Shyris 1154, Quito
              </p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4 mb-5">
            <div>
              <label class="text-white/70 text-xs block mb-2"> Edificio </label>
              <input
                type="text"
                placeholder="Nombre"
                class="w-full bg-black/20 rounded-lg p-3 text-xs placeholder:text-white/30 text-white focus:ring-0 transition-colors outline-none backdrop-blur-sm h-10"
              />
            </div>
            <div>
              <label class="text-white/70 text-xs block mb-2"> Piso </label>
              <input
                type="text"
                placeholder="Número"
                class="w-full bg-black/20 rounded-lg p-3 text-xs placeholder:text-white/30 text-white focus:ring-0 transition-colors outline-none backdrop-blur-sm h-10"
              />
            </div>
          </div>

          <div class="mb-4">
            <label class="text-white/70 text-xs block mb-2"> Referencia </label>
            <textarea
              placeholder="Cerca del parque..."
              class="w-full bg-black/20 rounded-lg p-3 text-xs placeholder:text-white/30 text-white resize-none focus:ring-0 transition-colors outline-none backdrop-blur-sm h-32"
            ></textarea>
          </div>
        </div>

        <div class="pt-4 shrink-0 pb-8 mt-auto">
          <button
            class="w-full bg-white text-[#003366] rounded-xl py-3.5 font-bold text-sm shadow-lg hover:bg-gray-50 transition-colors step-next-btn"
            data-next="5"
          >
            Continuar
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
