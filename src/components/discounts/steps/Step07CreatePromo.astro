---
import DiscountHeader from "../DiscountHeader.astro";
const customColor = "#004492";
---

<div
  class="step-content hidden bg-white h-full relative overflow-hidden font-sans"
  id="step-07"
>
  <DiscountHeader showBack={true} />

  <!-- Animation Layer -->
  <div class="absolute top-10 left-0 right-0 flex justify-center z-0">
    <div class="w-64 h-64 flex items-center justify-center">
      <div
        class="relative w-48 h-48 flex items-center justify-center mb-0 shrink-0 z-10"
      >
        <img
          src="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/background_videos/animation1.gif"
          alt="Graphic"
          class="w-full h-full object-contain opacity-80"
        />
      </div>
    </div>
  </div>

  <!-- Gradient Layer -->
  <div
    class="absolute top-[30%] left-0 right-0 bottom-0 pointer-events-none z-0"
  >
    <div
      class="relative z-10 w-full h-full overflow-hidden rounded-2xl p-5 backdrop-blur-sm flex flex-col pt-4"
      style="background: linear-gradient(to bottom, rgba(255, 255, 255, 0.35) 20%, rgba(255,255,255,0.9) 45%, #ffffff 60%);"
    >
    </div>
  </div>

  <div class="flex-1 flex flex-col items-center px-6 z-20 pt-24 overflow-y-auto min-h-0 w-full [&::-webkit-scrollbar]:hidden" style="scrollbar-width: none;">
    <h2 class="discounts-step07-title text-2xl font-bold text-[#003366] mb-1">Crear Promoción</h2>
    <p class="discounts-step07-subtitle text-gray-400 text-xs text-center mb-8">
      Define los detalles de tu promoción
    </p>

    <div class="w-full space-y-4 flex-1">
      <div class="space-y-2">
        <label class="discounts-step07-product-label text-[#003366] text-sm font-medium ml-1">
          Nombre del Producto
        </label>
        <input
          type="text"
          placeholder="Ej. Promo Veggie"
          class="discounts-step07-product-placeholder w-full p-3 rounded-xl bg-gray-100 border-none text-sm placeholder:text-gray-400 focus:ring-1 focus:ring-[#003366] outline-none shadow-sm text-gray-700"
        />
      </div>

      <div class="space-y-2">
        <label class="discounts-step07-price-label text-[#003366] text-sm font-medium ml-1">
          Precio
        </label>
        <input
          type="text"
          placeholder="$0.00"
          class="discounts-step07-price-placeholder w-full p-3 rounded-xl bg-gray-100 border-none text-sm placeholder:text-gray-400 focus:ring-1 focus:ring-[#003366] outline-none shadow-sm text-gray-700"
        />
      </div>

      <div class="space-y-2">
        <label class="discounts-step07-profile-label text-[#003366] text-sm font-medium ml-1">
          Perfil del Cliente
        </label>
        <input
          type="text"
          placeholder="Ej. Estudiantes, Familias"
          class="discounts-step07-profile-placeholder w-full p-3 rounded-xl bg-gray-100 border-none text-sm placeholder:text-gray-400 focus:ring-1 focus:ring-[#003366] outline-none shadow-sm text-gray-700"
        />
      </div>
    </div>
  </div>

  <div class="px-6 pb-8 pt-2 shrink-0 z-30">
    <button
      class="w-[80%] mx-auto text-white rounded-2xl py-3.5 text-sm flex items-center pl-6 shadow-lg relative overflow-hidden group transition-transform active:scale-[0.98] step-next-btn"
      style={`background: linear-gradient(to right, ${customColor}, #000b1e);`}
      data-next="8"
    >
      <span class="discounts-continue-label mr-0">Continuar</span>
      <span
        class="absolute right-6 transition-transform group-hover:translate-x-1"
      >
        &gt;
      </span>
    </button>
  </div>
</div>
