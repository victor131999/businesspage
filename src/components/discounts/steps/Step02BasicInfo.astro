---
import DiscountHeader from "../DiscountHeader.astro";
const customColor = "#004492";
---

<div
  class="step-content hidden bg-white h-full relative overflow-hidden font-sans"
  id="step-02"
>
  <div
    class="absolute inset-0 pointer-events-none z-0"
    style="background: linear-gradient(to bottom, transparent 0%, rgba(255, 255, 255, 0.35) 100%)"
  >
  </div>

  <DiscountHeader showBack={true} />

  <div class="flex-1 flex flex-col items-center pt-2 px-2 pb-6 z-10">
    <div
      class="relative w-24 h-24 flex items-center justify-center min-h-[50px] mb-2 mt-2 shrink z-20"
    >
      <div
        class="relative w-36 h-36 flex items-center justify-center mb-0 shrink-0 z-10"
      >
        <img
          src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/video/animation1.gif"
          alt="Graphic"
          class="w-full h-full object-contain opacity-80"
        />
      </div>
    </div>

    <div
      class="relative z-10 flex-1 w-full overflow-hidden rounded-2xl p-4 backdrop-blur-sm flex flex-col pt-6 min-h-0"
      style="background-color: rgba(255, 255, 255, 0.35);"
    >
      <div class="flex flex-col items-center justify-center text-center w-full">
        <h2 class="text-xl font-bold text-black mb-1">Información Básica</h2>
        <p class="text-gray-400 text-xs mb-3">Cuéntanos sobre tu negocio</p>
      </div>

      <div
        class="w-full flex-1 flex flex-col bg-gray-50/50 p-4 rounded-2xl overflow-y-auto [&::-webkit-scrollbar]:hidden"
      >
        <div class="space-y-4">
          <div class="space-y-2">
            <label class="text-[#003366] text-sm font-medium">
              Nombre del Negocio
            </label>
            <input
              type="text"
              placeholder="ej. Mi Gran Negocio"
              class="w-full p-2.5 rounded-xl bg-gray-200/80 border-none text-sm placeholder:text-gray-400 focus:ring-1 focus:ring-[#003366] outline-none"
            />
          </div>
          <div class="space-y-2">
            <label class="text-[#003366] text-sm font-medium"> RUC o ID </label>
            <input
              type="text"
              placeholder="ej. 123-456-789"
              class="w-full p-2.5 rounded-xl bg-gray-200/80 border-none text-sm placeholder:text-gray-400 focus:ring-1 focus:ring-[#003366] outline-none"
            />
          </div>
        </div>

        <div class="mt-auto pt-3 shrink-0">
          <button
            class="w-[80%] mx-auto text-white rounded-2xl py-3 text-sm flex items-center pl-5 shadow-lg relative overflow-hidden group transition-transform active:scale-[0.98] z-20 step-next-btn"
            style={`background: linear-gradient(to right, ${customColor}, #000b1e);`}
            data-next="3"
          >
            <span class="discounts-continue-label mr-0">Continuar</span>
            <span
              class="absolute right-6 transition-transform group-hover:translate-x-1"
            >
              &gt;
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
