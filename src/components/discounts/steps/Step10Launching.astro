---
import DiscountHeader from "../DiscountHeader.astro";
const customColor = "#004492";
---

<div
  class="step-content hidden bg-white h-full relative overflow-hidden font-sans"
  id="step-10"
>
  <DiscountHeader showBack={true} />

  <div
    class="flex-1 px-6 pb-6 pt-2 flex flex-col items-center justify-center min-h-0"
  >
    <!-- Card Container -->
    <div
      class="relative w-full h-full rounded-[2.5rem] overflow-hidden shadow-xl bg-[#001a33]"
    >
      <!-- Base Layer -->
      <div
        class="absolute inset-0 z-10 flex flex-col items-center justify-center h-full px-6 text-center w-full"
      >
        <h2 class="text-2xl font-bold mb-2 text-[#003366]">
          Launching your promo
        </h2>
        <p class="text-xs text-gray-400">
          This will only take a couple of seconds
        </p>
        <div class="w-64 h-2 rounded-full mt-8 overflow-hidden bg-gray-200">
          <!-- Empty bar base -->
        </div>
      </div>

      <!-- Overlay Layer (Clipped) - Animated via CSS/JS -->
      <div
        class="absolute inset-0 z-20 overflow-hidden progress-layer"
        style={`clip-path: inset(0 100% 0 0); transition: clip-path 3s linear;`}
      >
        <div
          class="w-full h-full flex flex-col items-center justify-center px-6 text-center"
          style={`background: linear-gradient(to right, ${customColor} 0%, #000b1e 100%);`}
        >
          <h2 class="text-2xl font-bold mb-2 text-white">
            Launching your promo
          </h2>
          <p class="text-xs text-white/80">
            This will only take a couple of seconds
          </p>
          <div class="w-64 h-2 rounded-full mt-8 overflow-hidden bg-white/20">
            <div class="h-full w-full bg-white"></div>
          </div>
        </div>
      </div>

      <!-- Flush Edge Effect -->
      <div
        class="absolute top-0 bottom-0 w-20 z-20 pointer-events-none flush-effect"
        style="left: 0%; background: linear-gradient(to right, transparent, rgba(255,255,255,0.5), transparent); transform: translateX(-50%); transition: left 3s linear;"
      >
      </div>
    </div>
  </div>
</div>
