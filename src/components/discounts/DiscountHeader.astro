---
interface Props {
  showBack?: boolean;
}

const { showBack = false } = Astro.props;
---

<div
  class="pt-6 px-6 text-center shrink-0 relative flex items-center justify-center z-50"
>
  {
    showBack && (
      <button
        class="absolute left-6 text-xs text-gray-500 hover:text-dark flex items-center back-btn"
        id="header-back-btn"
      >
        &lt; Atrás
      </button>
    )
  }
  <div class="flex items-center justify-center">
    <img
      src="/images/zelify_logo.png"
      alt="Zelify Logo"
      width="100"
      height="30"
      class="h-8 w-auto object-contain"
    />
  </div>
</div>

<style>
  .back-btn {
    background: none;
    border: none;
    cursor: pointer;
  }
</style>
