---

---

<div
  class="device-frame-wrapper w-full h-full flex justify-center items-center"
>
  <div class="device-frame">
    <!-- Pantalla del dispositivo -->
    <div class="device-screen relative bg-white overflow-hidden flex flex-col">
      <!-- Status Bar -->
      <div class="device-status-bar relative z-20 shrink-0">
        <div class="status-time text-black">9:41</div>
        <div class="dynamic-island bg-black">
          <div class="island-shape"></div>
          <div class="island-speaker"></div>
        </div>
        <div class="status-icons text-black">
          <svg class="signal-icon" fill="none" viewBox="0 0 20 12">
            <path
              d="M1 8h2v2H1V8zm3-2h2v4H4V6zm3-2h2v6H7V4zm3-1h2v7h-2V3z"
              fill="currentColor"></path>
          </svg>
          <div class="battery-icon border-black/40">
            <div class="battery-level bg-black"></div>
          </div>
        </div>
      </div>

      <!-- Content Container -->
      <div class="relative z-10 flex flex-col h-full overflow-hidden">
        <!-- Header -->
        <div
          class="relative px-6 py-2 flex shrink-0 items-center justify-between z-20"
        >
          <button
            id="back-btn"
            class="text-sm text-gray-500 font-medium flex items-center gap-1 transition-opacity hover:text-gray-900 cursor-pointer"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg
            >
            back
          </button>
          <!-- Logo centered absolutely -->
          <div
            class="absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 w-20 flex justify-center"
          >
            <img
              src="/images/zelify_logo.png"
              alt="Zelify"
              class="h-6 object-contain"
            />
          </div>
          <div class="w-10"></div>
          <!-- Spacer -->
        </div>

        <!-- SCREEN: WELCOME -->
        <div
          id="screen-welcome"
          class="flex-1 flex flex-col relative transition-all duration-500 overflow-hidden"
        >
          <div class="h-[35%] flex items-center justify-center mt-4">
            <div class="w-48 h-48 relative flex items-center justify-center">
              <img
                src="/gift/ANIMACION 1.gif"
                alt="Animation"
                class="w-full h-full object-contain mix-blend-multiply opacity-90"
              />
            </div>
          </div>

          <div class="px-6 text-center mb-6 relative z-10">
            <h2 class="text-2xl leading-tight text-[#004492]">
              <span class="font-bold">Identity</span>
              <span class="font-light">Verification</span>
            </h2>
            <p class="text-[11px] text-gray-500 mt-2">
              We will verify your identity securely and quickly
            </p>
          </div>

          <div
            class="mx-4 mb-6 mt-auto rounded-[32px] bg-[#F3F4F6] p-6 flex flex-col gap-8 relative z-20 overflow-hidden shadow-sm"
          >
            <div
              class="relative w-full h-[60px] flex justify-center items-center"
              id="welcome-carousel-root"
            >
              <!-- Cards injected by JS -->
              <div
                id="w-card-0"
                class="welcome-card absolute top-0 h-[60px] rounded-xl cursor-pointer border-2 border-white overflow-hidden transition-all duration-500 ease-out shadow-sm bg-[#9BA2AF] flex items-center"
                data-index="0"
              >
                <div
                  class="icon-container flex items-center justify-center w-[32px] h-[32px] shrink-0 text-white ml-2"
                >
                  <svg
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                    ></path></svg
                  >
                </div>
                <div
                  class="text-content ml-2 text-white overflow-hidden whitespace-nowrap opacity-0 max-w-0 transition-opacity duration-300"
                >
                  <p class="text-[11px] font-bold leading-tight">
                    Fast and secure process
                  </p>
                  <p class="text-[9px] leading-tight opacity-90">
                    Completed in less than 2 minute
                  </p>
                </div>
              </div>

              <div
                id="w-card-1"
                class="welcome-card absolute top-0 h-[60px] rounded-xl cursor-pointer border-2 border-white overflow-hidden transition-all duration-500 ease-out shadow-sm bg-[#9BA2AF] flex items-center"
                data-index="1"
              >
                <div
                  class="icon-container flex items-center justify-center w-[32px] h-[32px] shrink-0 text-white ml-2"
                >
                  <svg
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                    ></path></svg
                  >
                </div>
                <div
                  class="text-content ml-2 text-white overflow-hidden whitespace-nowrap opacity-0 max-w-0 transition-opacity duration-300"
                >
                  <p class="text-[11px] font-bold leading-tight">
                    Protected data
                  </p>
                  <p class="text-[9px] leading-tight opacity-90">
                    End-to-end encryption
                  </p>
                </div>
              </div>

              <div
                id="w-card-2"
                class="welcome-card absolute top-0 h-[60px] rounded-xl cursor-pointer border-2 border-white overflow-hidden transition-all duration-500 ease-out shadow-sm bg-[#9BA2AF] flex items-center"
                data-index="2"
              >
                <div
                  class="icon-container flex items-center justify-center w-[32px] h-[32px] shrink-0 text-white ml-2"
                >
                  <svg
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path></svg
                  >
                </div>
                <div
                  class="text-content ml-2 text-white overflow-hidden whitespace-nowrap opacity-0 max-w-0 transition-opacity duration-300"
                >
                  <p class="text-[11px] font-bold leading-tight">
                    Real-time check
                  </p>
                  <p class="text-[9px] leading-tight opacity-90">
                    Global database verification
                  </p>
                </div>
              </div>
            </div>

            <div class="flex justify-center mt-auto">
              <button
                id="start-btn"
                class="group relative flex items-center justify-between overflow-hidden rounded-xl border border-[#004492] px-6 py-3 text-xs font-semibold text-white shadow-lg transition-transform active:scale-[0.98] w-full max-w-[240px]"
                style="background: linear-gradient(to right, #004492 0%, #002D62 40%, #001529 70%, #000000 100%);"
              >
                <span
                  class="absolute inset-0 bg-[#004492] opacity-20 blur-md pointer-events-none"
                ></span>
                <span
                  class="relative z-10 flex items-center justify-center gap-2 w-full"
                >
                  <span>Start Verification</span>
                  <svg
                    class="h-3.5 w-3.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 5l7 7-7 7"></path>
                  </svg>
                </span>
              </button>
            </div>

            <p class="text-center text-[9px] text-gray-500 leading-tight px-4">
              Al iniciar la verificación aceptas las <span
                class="font-bold text-gray-700">políticas de privacidad</span
              > y <span class="font-bold text-gray-700"
                >términos de servicio</span
              >
            </p>

            <div class="flex justify-center mt-1">
              <div class="w-32 h-1 bg-black/20 rounded-full"></div>
            </div>
          </div>
        </div>

        <!-- SCREEN: DOCUMENT SELECTION -->
        <div
          id="screen-document"
          class="hidden flex-1 flex flex-col relative transition-all duration-500"
        >
          <!-- Animation -->
          <div
            class="h-[30%] flex items-center justify-center mt-4 -mb-24 relative z-0"
          >
            <div class="w-48 h-48 relative flex items-center justify-center">
              <img
                src="/gift/ANIMACION 1.gif"
                alt="Animation"
                class="w-full h-full object-contain mix-blend-multiply opacity-90"
              />
            </div>
          </div>

          <!-- Glass Container -->
          <div
            class="relative z-10 flex-1 overflow-hidden backdrop-blur-sm flex flex-col shadow-sm"
            style="background-color: rgba(255, 255, 255, 0.35); padding: 10px; margin: 10px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.5);"
          >
            <div class="px-6 text-center mb-6 relative z-10 pt-4">
              <h2 class="text-xl font-bold text-[#004492] mb-1">
                Select your document
              </h2>
              <p class="text-[11px] text-gray-500">
                Choose the type of document you want to use for verification
              </p>
            </div>

            <div class="flex-1 px-4 relative flex flex-col items-center w-full">
              <div class="relative w-full h-[240px]">
                <!-- License Card (Active) -->
                <button
                  id="doc-license"
                  class="doc-card absolute top-0 w-full rounded-2xl bg-[#001529] border border-[#004492] shadow-lg flex items-center px-4 z-30 transition-all duration-300 transform translate-y-0"
                  style="background: linear-gradient(to right, #004492 0%, #001529 100%); left: 50%; transform: translateX(-50%); height: 90px;"
                >
                  <div
                    class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-white shrink-0"
                  >
                    <svg
                      width="20"
                      height="20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"
                      ></path><polyline points="17 21 17 13 7 13 7 21"
                      ></polyline><polyline points="7 3 7 8 15 8"
                      ></polyline></svg
                    >
                  </div>
                  <div class="ml-3 text-left">
                    <p class="text-sm font-bold text-white">Driver's License</p>
                    <p class="text-[10px] text-white/80">
                      Valid driver's license
                    </p>
                  </div>
                </button>

                <!-- ID Card (Inactive) -->
                <button
                  id="doc-identity"
                  class="doc-card absolute w-[95%] rounded-2xl bg-[#9BA2AF] border border-white shadow flex items-center px-4 z-20 transition-all duration-300"
                  style="left: 50%; transform: translateX(-50%); top: 85px; height: 60px;"
                >
                  <div
                    class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-white shrink-0"
                  >
                    <svg
                      width="20"
                      height="20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><rect x="3" y="4" width="18" height="16" rx="2"
                      ></rect><circle cx="9" cy="10" r="2"></circle><line
                        x1="15"
                        y1="8"
                        x2="17"
                        y2="8"></line><line x1="15" y1="12" x2="17" y2="12"
                      ></line><line x1="7" y1="16" x2="17" y2="16"></line></svg
                    >
                  </div>
                  <div class="ml-3 text-left">
                    <p class="text-sm font-bold text-white">Identity Card</p>
                    <p class="text-[10px] text-white/80 hidden">
                      Official identity document
                    </p>
                  </div>
                </button>

                <!-- Passport (Inactive) -->
                <button
                  id="doc-passport"
                  class="doc-card absolute w-[90%] rounded-2xl bg-[#9BA2AF] border border-white shadow flex items-center px-4 z-10 transition-all duration-300"
                  style="left: 50%; transform: translateX(-50%); top: 140px; height: 60px;"
                >
                  <div
                    class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-white shrink-0"
                  >
                    <svg
                      width="20"
                      height="20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><rect x="3" y="4" width="18" height="16" rx="2"
                      ></rect><line x1="16" y1="2" x2="16" y2="6"></line><line
                        x1="8"
                        y1="2"
                        x2="8"
                        y2="6"></line><line x1="3" y1="10" x2="21" y2="10"
                      ></line></svg
                    >
                  </div>
                  <div class="ml-3 text-left">
                    <p class="text-sm font-bold text-white">Passport</p>
                    <p class="text-[10px] text-white/80 hidden">
                      Valid passport
                    </p>
                  </div>
                </button>
              </div>
            </div>

            <div class="flex justify-center mb-4 px-6 mt-auto">
              <button
                id="doc-next-btn"
                class="w-full max-w-[200px] h-10 rounded-full flex items-center justify-center gap-2 transition-transform active:scale-95 shadow-lg border border-[#004492] text-white font-medium text-sm"
                style="background: linear-gradient(to right, #004492 0%, #002D62 40%, #001529 70%, #000000 100%);"
              >
                Siguiente <svg
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"></path></svg
                >
              </button>
            </div>
          </div>
        </div>

        <!-- SCREEN: CAPTURE FRONT -->
        <div
          id="screen-capture-front"
          class="hidden flex-1 flex flex-col relative transition-all duration-500 bg-white"
        >
          <!-- Main Content Wrapper -->
          <div
            class="relative flex-1 flex flex-col w-full h-full z-10 px-6 justify-center"
          >
            <!-- Gradient Card -->
            <div
              class="relative mx-auto w-full max-w-sm rounded-3xl px-6 py-8 mb-20 flex flex-col"
              style="background: linear-gradient(to top, #000000 0%, #001529 20%, #002D62 30%, rgba(0, 68, 146, 0.4) 40%, transparent 50%, transparent 100%); min-height: 400px;"
            >
              <!-- Title -->
              <div class="mb-4 text-center relative z-20">
                <h2 class="text-2xl leading-tight text-[#004492]">
                  Capture <span class="font-bold">Driver's<br />License</span>
                </h2>
                <p class="text-[11px] text-gray-500 mt-2">
                  Take a photo of the front of your document
                </p>
              </div>

              <!-- Viewfinder -->
              <div class="relative mx-auto mb-6 w-full max-w-[260px] h-[160px]">
                <div
                  class="w-full h-full rounded-2xl border-2 border-dashed border-[#004492] bg-white overflow-hidden shadow-sm relative"
                >
                  <!-- Document Graphic Simulation -->
                  <div
                    class="absolute inset-4 rounded-lg bg-white shadow-sm border border-gray-100 p-4 flex flex-col"
                  >
                    <div class="mb-2 h-2 w-16 rounded bg-gray-200"></div>
                    <div class="mb-4 h-2 w-24 rounded bg-gray-200"></div>
                    <div class="mb-2 h-1 w-full rounded bg-gray-100"></div>
                    <div class="mb-2 h-1 w-3/4 rounded bg-gray-100"></div>
                    <div class="mb-2 h-1 w-5/6 rounded bg-gray-100"></div>
                    <div class="mt-auto flex gap-2">
                      <div class="h-12 w-12 rounded bg-gray-100"></div>
                      <div class="flex-1 space-y-2">
                        <div class="h-2 w-full rounded bg-gray-200"></div>
                        <div class="h-2 w-2/3 rounded bg-gray-200"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Bottom Text -->
              <div class="text-center mt-auto">
                <p class="text-base font-bold text-white mb-1">
                  Document front
                </p>
                <p class="text-[10px] text-white/90 leading-tight">
                  Make sure the document is well lit and fully visible
                </p>
              </div>
            </div>

            <!-- Floating Button -->
            <div
              class="absolute bottom-8 left-0 right-0 flex justify-center z-30"
            >
              <button
                id="capture-front-btn"
                class="group relative flex items-center justify-center w-16 h-16 rounded-full shadow-lg transition-transform active:scale-95 hover:scale-105"
                style="background: linear-gradient(to right, #004492 0%, #002D62 40%, #001529 70%, #000000 100%);"
              >
                <div
                  class="absolute inset-0 rounded-full border-[4px] border-white/20"
                >
                </div>
                <svg
                  width="28"
                  height="28"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="white"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"
                  ></path>
                  <circle cx="12" cy="13" r="4"></circle>
                </svg>
              </button>
              <!-- Home Indicator if needed, but usually screen bottom -->
            </div>
          </div>
        </div>

        <!-- SCREEN: CAPTURE BACK -->
        <div
          id="screen-capture-back"
          class="hidden flex-1 flex flex-col relative transition-all duration-500 bg-white"
        >
          <div
            class="relative flex-1 flex flex-col w-full h-full z-10 px-6 justify-center"
          >
            <!-- Progress Indicator for Back -->
            <div
              class="mb-4 flex items-center justify-center gap-2 relative z-20"
            >
              <div
                class="relative flex items-center gap-2 rounded-full bg-gray-100 px-3 py-1.5"
              >
                <svg
                  class="h-4 w-4 text-gray-600"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"
                  ></path>
                </svg>
                <span class="text-xs font-medium text-gray-700"
                  >Document front</span
                >
                <div
                  class="absolute -right-1 -top-1 flex h-5 w-5 items-center justify-center rounded-full bg-[#004492]"
                >
                  <svg
                    class="h-3 w-3 text-white"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="3"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 13l4 4L19 7"></path>
                  </svg>
                </div>
              </div>
            </div>

            <!-- Gradient Card -->
            <div
              class="relative mx-auto w-full max-w-sm rounded-3xl px-6 py-8 mb-20 flex flex-col"
              style="background: linear-gradient(to top, #000000 0%, #001529 20%, #002D62 30%, rgba(0, 68, 146, 0.4) 40%, transparent 50%, transparent 100%); min-height: 400px;"
            >
              <div class="mb-4 text-center relative z-20">
                <h2 class="text-2xl leading-tight text-[#004492]">
                  Capture <span class="font-bold">Driver's<br />License</span>
                </h2>
                <p class="text-[11px] text-gray-500 mt-2">
                  Take a photo of the back of your document
                </p>
              </div>

              <div class="relative mx-auto mb-6 w-full max-w-[260px] h-[160px]">
                <div
                  class="w-full h-full rounded-2xl border-2 border-dashed border-[#004492] bg-white overflow-hidden shadow-sm relative"
                >
                  <!-- Document Graphic Simulation (Back) -->
                  <div
                    class="absolute inset-4 rounded-lg bg-white shadow-sm border border-gray-100 p-4 flex flex-col"
                  >
                    <!-- Different layout for back -->
                    <div class="mb-2 h-8 w-full rounded bg-gray-100"></div>
                    <div class="mb-2 h-1 w-full rounded bg-gray-100"></div>
                    <div class="flex-1"></div>
                    <div class="flex gap-2 items-end">
                      <div class="h-8 w-16 rounded bg-gray-200"></div>
                      <div class="flex-1 h-8 rounded bg-gray-100"></div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="text-center mt-auto">
                <p class="text-base font-bold text-white mb-1">Document back</p>
                <p class="text-[10px] text-white/90 leading-tight">
                  Make sure the document is well lit and fully visible
                </p>
              </div>
            </div>

            <div
              class="absolute bottom-8 left-0 right-0 flex justify-center z-30"
            >
              <button
                id="capture-back-btn"
                class="group relative flex items-center justify-center w-16 h-16 rounded-full shadow-lg transition-transform active:scale-95 hover:scale-105"
                style="background: linear-gradient(to right, #004492 0%, #002D62 40%, #001529 70%, #000000 100%);"
              >
                <div
                  class="absolute inset-0 rounded-full border-[4px] border-white/20"
                >
                </div>
                <svg
                  width="28"
                  height="28"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="white"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"
                  ></path>
                  <circle cx="12" cy="13" r="4"></circle>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- SCREEN: SELFIE CHECK -->
        <div
          id="screen-selfie-check"
          class="hidden flex-1 flex flex-col relative transition-all duration-500"
        >
          <!-- Animation with negative margin to overlap -->
          <div
            class="h-[30%] flex items-center justify-center mt-4 -mb-24 relative z-0"
          >
            <div
              class="w-48 h-48 relative flex items-center justify-center rounded-full overflow-hidden"
            >
              <img
                src="/gift/ANIMACION 1.gif"
                alt="Animation"
                class="w-full h-full object-contain mix-blend-multiply opacity-90"
              />
            </div>
          </div>

          <!-- Glass Container -->
          <div
            class="relative z-10 flex-1 overflow-hidden backdrop-blur-sm flex flex-col shadow-sm"
            style="background-color: rgba(255, 255, 255, 0.35); padding: 10px; margin: 10px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.5);"
          >
            <div class="px-6 text-center mb-6 relative z-10 pt-4">
              <h2 class="text-xl font-bold text-[#004492] mb-1">
                Selfie Check
              </h2>
              <p class="text-[11px] text-gray-500">
                Select the facial verification method
              </p>
            </div>

            <div class="flex-1 px-4 relative flex flex-col items-center w-full">
              <div class="relative w-full h-[160px]">
                <!-- Option 1: Photo (Active) -->
                <button
                  id="selfie-opt-photo"
                  class="selfie-card absolute top-0 w-full rounded-xl bg-[#001529] border border-[#004492] shadow-lg flex items-center px-4 transition-all duration-300 z-30"
