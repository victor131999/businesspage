</style>

<script>
  // --- Navigation & State ---
  const screens = {
    welcome: document.getElementById("screen-welcome"),
    document: document.getElementById("screen-document"),
    captureFront: document.getElementById("screen-capture-front"),
    captureBack: document.getElementById("screen-capture-back"),
    selfieCheck: document.getElementById("screen-selfie-check"),
    scanning: document.getElementById("screen-scanning"),
    rejected: document.getElementById("screen-rejected"),
  };

  const btns = {
    start: document.getElementById("start-btn"),
    back: document.getElementById("back-btn"),
    docNext: document.getElementById("doc-next-btn"),
    captureFront: document.getElementById("capture-front-btn"),
    captureBack: document.getElementById("capture-back-btn"),
    startSelfie: document.getElementById("start-selfie-btn"),
    scanningTrigger: document.getElementById("scanning-trigger-btn"),
    retry: document.getElementById("retry-btn"),
  };

  let currentScreen = "welcome";

  function showScreen(screenId) {
    // Hide all
    Object.values(screens).forEach((el) => {
      if (el) el.classList.add("hidden");
    });
    // Show target
    const target = screens[screenId];
    if (target) target.classList.remove("hidden");
    currentScreen = screenId;
  }

  // Event Listeners
  if (btns.start) {
    btns.start.addEventListener("click", () => {
      showScreen("document");
    });
  }

  if (btns.docNext) {
    btns.docNext.addEventListener("click", () => {
      // Update Capture Screens with selected Doc Type
      const docNames = {
        license: "Driver's<br>License",
        identity: "Identity<br>Card",
        passport: "Passport",
      };

      const docLabel = docNames[selectedDoc] || "Document";

      // Update Front Screen
      const frontTitle = document.querySelector("#screen-capture-front h2");
      if (frontTitle)
        frontTitle.innerHTML = `Capture <span class="font-bold">${docLabel}</span>`;

      // Update Back Screen
      const backTitle = document.querySelector("#screen-capture-back h2");
      // Back screen title usually just says the doc name in bold
      if (backTitle)
        backTitle.innerHTML = `<span class="font-bold">${docLabel}</span>`;

      // Special case: Passport usually doesn't have a back side capture in some flows,
      // but assuming standard flow for now.

      showScreen("captureFront");
    });
  }

  if (btns.captureFront) {
    btns.captureFront.addEventListener("click", () => {
      // If passport, maybe skip back? For now, standard flow.
      showScreen("captureBack");
    });
  }

  if (btns.captureBack) {
    btns.captureBack.addEventListener("click", () => {
      showScreen("selfieCheck");
    });
  }

  if (btns.startSelfie) {
    btns.startSelfie.addEventListener("click", () => {
      showScreen("scanning");
      // Animation handled in the specific button listener below
    });
  }

  if (btns.scanningTrigger) {
    btns.scanningTrigger.addEventListener("click", () => {
      showScreen("rejected");
    });
  }

  if (btns.retry) {
    btns.retry.addEventListener("click", () => {
      showScreen("welcome");
    });
  }

  if (btns.back) {
    btns.back.addEventListener("click", () => {
      if (currentScreen === "document") showScreen("welcome");
      else if (currentScreen === "captureFront") showScreen("document");
      else if (currentScreen === "captureBack") showScreen("captureFront");
      else if (currentScreen === "selfieCheck") showScreen("captureBack");
      else if (currentScreen === "scanning") showScreen("selfieCheck");
      else if (currentScreen === "rejected") showScreen("welcome");
    });
  }

  // --- Document Selection Logic ---
  let selectedDoc = "license";

  function updateDocumentSelection(docType) {
    selectedDoc = docType;

    // Visual Order: Selected is Top (index 0), then others follow
    // We want the selected one to expand significantly and others to stack below compacted

    let visualOrder = [];
    if (docType === "license") {
      visualOrder = ["doc-license", "doc-identity", "doc-passport"];
    } else if (docType === "identity") {
      visualOrder = ["doc-identity", "doc-license", "doc-passport"];
    } else {
      visualOrder = ["doc-passport", "doc-license", "doc-identity"];
    }

    const activeId = visualOrder[0];
    const middleId = visualOrder[1];
    const bottomId = visualOrder[2];

    const activeEl = document.getElementById(activeId);
    const middleEl = document.getElementById(middleId);
    const bottomEl = document.getElementById(bottomId);

    // Styling constants
    const activeBg = "linear-gradient(to right, #004492 0%, #001529 100%)";
    const inactiveBg = "#9BA2AF";

    if (activeEl) {
      // Active card - Expanded size and top position
      activeEl.style.top = "0px";
      activeEl.style.width = "100%";
      activeEl.style.left = "50%";
      activeEl.style.transform = "translateX(-50%)";
      activeEl.style.height = "90px"; // Increased height for "bigger proportion"
      activeEl.style.zIndex = "30";
      activeEl.style.background = activeBg;
      activeEl.style.borderColor = "#004492";
      activeEl.classList.add("shadow-lg");

      const sub = activeEl.querySelector("p:nth-child(2)"); // Description text
      if (sub) sub.classList.remove("hidden");
    }

    if (middleEl) {
      // Middle card - Compacted and stacked
      middleEl.style.top = "85px"; // Overlap slightly with active (90px)
      middleEl.style.width = "95%";
      middleEl.style.left = "50%";
      middleEl.style.transform = "translateX(-50%)";
      middleEl.style.height = "60px"; // Reduced height
      middleEl.style.zIndex = "20";
      middleEl.style.background = inactiveBg;
      middleEl.style.borderColor = "white";
      middleEl.classList.remove("shadow-lg");

      const sub = middleEl.querySelector("p:nth-child(2)");
      if (sub) sub.classList.add("hidden");
    }

    if (bottomEl) {
      // Bottom card - Compacted and stacked further down
      bottomEl.style.top = "140px"; // Stacked below middle (85 + 55 approx)
      bottomEl.style.width = "90%";
      bottomEl.style.left = "50%";
      bottomEl.style.transform = "translateX(-50%)";
      bottomEl.style.height = "60px"; // Reduced height
      bottomEl.style.zIndex = "10";
      bottomEl.style.background = inactiveBg;
      bottomEl.style.borderColor = "white";
      bottomEl.classList.remove("shadow-lg");

      const sub = bottomEl.querySelector("p:nth-child(2)");
      if (sub) sub.classList.add("hidden");
    }
  }

  // Initialize Doc Listeners
  const docIds = ["doc-license", "doc-identity", "doc-passport"];
  docIds.forEach((id) => {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener("click", () => {
        const type = id.replace("doc-", "");
        updateDocumentSelection(type);
      });
    }
  });

  // --- Welcome Carousel Logic ---
  let activeCardIndex = 1;

  function updateWelcomeCarousel(activeIndex) {
    const cards = [
      document.getElementById("w-card-0"),
      document.getElementById("w-card-1"),
      document.getElementById("w-card-2"),
    ];

    if (!cards[0]) return;

    const activeCardWidth = 220;
    const inactiveCardWidth = 60;
    const visiblePart = 40;
    const overlapAmount = inactiveCardWidth - visiblePart;

    cards.forEach((cardEl, index) => {
      // Cast explicitly to HTMLElement
      const card = cardEl as HTMLElement | null;
      if (!card) return;

      const isActive = index === activeIndex;
      const textContent = card.querySelector(
        ".text-content",
      ) as HTMLElement | null;
      const iconContainer = card.querySelector(
        ".icon-container",
      ) as HTMLElement | null;

      // 1. Calculate Left Offset
      let leftOffset = "0px";

      if (isActive) {
        if (activeIndex === 0) leftOffset = "0px";
        else if (activeIndex === 1)
          leftOffset = `calc((100% - ${activeCardWidth}px) / 2)`;
        else if (activeIndex === 2)
          leftOffset = `calc(100% - ${activeCardWidth}px)`;
      } else if (index < activeIndex) {
        // Left of active
        const cardsBefore = activeIndex - index;
        if (activeIndex === 1) {
          const centerX = `calc((100% - ${activeCardWidth}px) / 2)`;
          leftOffset = `calc(${centerX} - ${(inactiveCardWidth - visiblePart) * cardsBefore}px)`;
        } else if (activeIndex === 2) {
          const rightX = `calc(100% - ${activeCardWidth}px)`;
          leftOffset = `calc(${rightX} - ${(inactiveCardWidth - visiblePart) * cardsBefore}px)`;
        }
      } else {
        // Right of active
        const cardsAfter = index - activeIndex;
        if (activeIndex === 0) {
          leftOffset = `${activeCardWidth + (inactiveCardWidth - visiblePart) * (cardsAfter - 1) - (cardsAfter === 1 ? 20 : 0)}px`;
          if (cardsAfter === 1)
            leftOffset = `${activeCardWidth - visiblePart}px`;
          else if (cardsAfter === 2)
            leftOffset = `${activeCardWidth + inactiveCardWidth - visiblePart * 2}px`;
        } else if (activeIndex === 1) {
          const centerX = `calc((100% - ${activeCardWidth}px) / 2)`;
          leftOffset = `calc(${centerX} + ${activeCardWidth}px - ${overlapAmount * cardsAfter}px)`;
        }
      }

      // 2. Z-Index
      let zIndex = 10;
      if (isActive) zIndex = 30;
      else {
        if (activeIndex === 0) zIndex = 20 - index;
        else if (activeIndex === 1)
          zIndex = index === 0 || index === 2 ? 15 : 30;
        else if (activeIndex === 2) zIndex = 20 + index;
      }

      // 3. Apply Styles
      card.style.left = leftOffset;
      card.style.zIndex = zIndex.toString();
      card.style.width = isActive
        ? `${activeCardWidth}px`
        : `${inactiveCardWidth}px`;

      // Gradients
      if (isActive) {
        card.style.background =
          "linear-gradient(to right, #004492 0%, #002D62 40%, #001529 70%, #000000 100%)";
        card.style.border = "2px solid white";
        card.classList.add("shadow-lg");
      } else {
        card.style.background = "#9BA2AF";
        card.style.border = "2px solid white";
        card.classList.remove("shadow-lg");
      }

      // Padding / Align
      card.style.paddingLeft = isActive ? "16px" : "0px";
      if (!isActive) {
        if (index < activeIndex) {
          card.style.justifyContent = "center";
          card.style.paddingRight = "0";
        } else if (index > activeIndex) {
          if (activeIndex === 1) {
            card.style.justifyContent = "flex-end";
            card.style.paddingRight = "12px";
          } else {
            card.style.justifyContent = "center";
            card.style.paddingRight = "0";
          }
        }
      } else {
        card.style.justifyContent = "flex-start";
        card.style.paddingRight = "16px";
      }

      // Content Opacity
      if (textContent) {
        textContent.style.opacity = isActive ? "1" : "0";
        textContent.style.maxWidth = isActive ? "160px" : "0px";
      }
      if (iconContainer) {
        iconContainer.style.marginLeft =
          !isActive && index > activeIndex && activeIndex === 1 ? "auto" : "0";
      }
    });
  }

  // Initialize
  document.addEventListener("DOMContentLoaded", () => {
    const docBtns = document.querySelectorAll(".welcome-card");
    docBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const index = parseInt(target.dataset.index || "1");
        updateWelcomeCarousel(index);
      });
    });

    // Initial state
    updateWelcomeCarousel(1);
  });

  // Selfie Selection Logic
  // Selfie Selection Logic
  function updateSelfieSelection(type) {
    const btnPhoto = document.getElementById("selfie-opt-photo");
    const btnVideo = document.getElementById("selfie-opt-video");

    // Visual Order logic
    // We want the selected one to expanded and top-most (z-index 30, top 0)
    // The other one compact and below (z-index 20, top 85px)

    let visualOrder = [];
    if (type === "photo") {
      visualOrder = ["selfie-opt-photo", "selfie-opt-video"];
    } else {
      visualOrder = ["selfie-opt-video", "selfie-opt-photo"];
    }

    const activeId = visualOrder[0];
    const middleId = visualOrder[1];

    const activeEl = document.getElementById(activeId);
    const middleEl = document.getElementById(middleId);

    // Styling constants
    const activeBg = "linear-gradient(to right, #004492 0%, #001529 100%)";
    const inactiveBg = "#9BA2AF";

    // Active Card
    if (activeEl) {
      activeEl.style.top = "0px";
      activeEl.style.width = "100%";
      activeEl.style.left = "50%";
      activeEl.style.transform = "translateX(-50%)";
      activeEl.style.height = "90px";
      activeEl.style.zIndex = "30";
      activeEl.style.background = activeBg;
      activeEl.style.borderColor = "#004492";
      activeEl.classList.add("shadow-lg");

      const sub = activeEl.querySelector("p:nth-child(2)"); // Description text
      if (sub) sub.classList.remove("hidden");
    }

    // Inactive Card (Stacked Below)
    if (middleEl) {
      middleEl.style.top = "85px";
      middleEl.style.width = "95%";
      middleEl.style.left = "50%";
      middleEl.style.transform = "translateX(-50%)";
      middleEl.style.height = "60px";
      middleEl.style.zIndex = "20";
      middleEl.style.background = inactiveBg;
      middleEl.style.borderColor = "white";
      middleEl.classList.remove("shadow-lg");

      const sub = middleEl.querySelector("p:nth-child(2)");
      if (sub) sub.classList.add("hidden");
    }
  }

  // Event Listeners for Selfie
  const btnSelfiePhoto = document.getElementById("selfie-opt-photo");
  const btnSelfieVideo = document.getElementById("selfie-opt-video");
  const btnStartSelfie = document.getElementById("start-selfie-btn");

  if (btnSelfiePhoto)
    btnSelfiePhoto.addEventListener("click", () =>
      updateSelfieSelection("photo"),
    );
  if (btnSelfieVideo)
    btnSelfieVideo.addEventListener("click", () =>
      updateSelfieSelection("video"),
    );

  if (btnStartSelfie) {
    btnStartSelfie.addEventListener("click", () => {
      showScreen("scanning");

      // Animation Logic
      const duration = 4000;
      const startTime = Date.now();
      const circle = document.getElementById("scan-circle-progress");
      const bar = document.getElementById("scan-horizontal-bar");

      // Reset
      if (circle) circle.style.strokeDashoffset = "628";
      if (bar) bar.style.width = "0%";

      const interval = setInterval(() => {
        const elapsed = Date.now() - startTime;
        const progress = Math.min(elapsed / duration, 1);

        if (bar) bar.style.width = `${progress * 100}%`;
        if (circle) circle.style.strokeDashoffset = `${628 - 628 * progress}`;

        if (progress >= 1) {
          clearInterval(interval);
          setTimeout(() => {
            if (currentScreen === "scanning") showScreen("rejected");
          }, 500);
        }
      }, 30);
    });
  }

  // Initialize
  updateSelfieSelection("photo");

  // Also run inline for hot reload
  setTimeout(() => updateWelcomeCarousel(1), 100);
</script>
