---
import AlaizaApp from "@/components/alaiza/AlaizaApp.astro";
import AlaizaBehaviorAnalysisApp from "@/components/alaiza/AlaizaBehaviorAnalysisApp.astro";
import AlaizaChatApp from "@/components/alaiza/AlaizaChatApp.astro";
import Navbar3 from "../components/NavbarSimple.astro";
import ProductsPanel from "../components/productsPanel.astro";
import { AlaizaAssistant } from "../components/AlaizaAssistant";
import EmailQuoteForm from "../components/design-system/molecules/EmailQuoteForm.astro";
import CtaGroup from "../components/design-system/molecules/CtaGroup.astro";
import Button from "../components/design-system/atoms/Button.astro";
import ContactFormHubSpot from "../components/design-system/organisms/ContactFormHubSpot.astro";
import QuoteModalHubSpot from "../components/design-system/organisms/QuoteModalHubSpot.astro";
import Footer from "../components/design-system/organisms/Footer.astro";
import "../components/design-system/tokens.css";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/png"
      href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png"
    />
    <title>Zelify — Alaiza</title>
  </head>

  <body>
    <header class="auth-header">
      <Navbar3 />
      <ProductsPanel />
    </header>

    <main class="auth-main">
      <section class="auth-hero">
        <h1 class="auth-title">Todos los productos<br />con IA</h1>
        <p class="auth-description">
          Plataforma de inteligencia artificial enfocada en finanzas que analiza<br/>
          el comportamiento de los usuarios para identificar hábitos y anticiparse<br/>
          a sus necesidades, ofrenciendo herramientas de eduación financiera<br/>
          Todo orientado a brindar un soporte continuo del cliente.<br/>
        </p>
        <CtaGroup class="auth-cta">
          <EmailQuoteForm
            dataI18nPlaceholder="home.welcome.email.placeholder"
            dataI18nAria="home.welcome.email.aria"
            buttonLabel="Let's talk"
          />
          <Button
            href="https://demo.zelify.com"
            variant="secondary"
            class="welcome-demo-button"
            target="_blank"
            rel="noopener noreferrer"
          >
            Demo
          </Button>
        </CtaGroup>
      </section>
    </main>

    <div class="auth-background-section">
      <div class="auth-background-overlay"></div>
      <div class="auth-background-image">
        <video class="auth-video" autoplay loop muted playsinline>
          <source
            src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/videos/alaiza.mp4"
            type="video/mp4"
          />
        </video>
      </div>

      <!-- Botones de Navegación (Transparentes) -->
      <div class="view-switcher">
        <button class="view-btn" data-target="alaiza">Alaiza</button>
        <button class="view-btn" data-target="behaviour"
          >Behaviour Analysis</button
        >
        <button class="view-btn active" data-target="education"
          >Financial education</button
        >
      </div>

      <!-- Contenedor de Vistas -->
      <div class="views-container">
        <!-- View 1: Alaiza Chat -->
        <div id="view-alaiza" class="view-content hidden">
          <AlaizaChatApp />
        </div>

        <!-- View 2: Behaviour Analysis -->
        <div id="view-behaviour" class="view-content hidden">
          <AlaizaBehaviorAnalysisApp />
        </div>

        <!-- View 3: Financial Education (AlaizaApp) -->
        <div id="view-education" class="view-content">
          <AlaizaApp />
        </div>
      </div>
    </div>

    <!-- Sección de Seguridad Inteligente -->
    <section class="security-section">
      <div class="security-container">
        <h2 class="security-title">
          Capacidades Nucleares<br />
          de Inteligencia Artificial
        </h2>

        <div class="security-features">
          <!-- Feature 1: Predicción de Comportamiento -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icon: Chart/Prediction -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
              </svg>
            </div>
            <h3 class="feature-title">Predicción de Comportamiento</h3>
            <p class="feature-description">
              Anticipa necesidades y detecta hábitos futuros de los usuarios.
            </p>
          </div>

          <!-- Feature 2: Evaluación de Riesgo -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icon: Shield/Risk -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="M12 8v4"></path>
                <path d="M12 16h.01"></path>
              </svg>
            </div>
            <h3 class="feature-title">Evaluación de Riesgo</h3>
            <p class="feature-description">
              Previene endeudamiento y fraude mediante análisis en tiempo real.
            </p>
          </div>

          <!-- Feature 3: Soporte Conversacional -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icon: Message/Chat -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                ></path>
              </svg>
            </div>
            <h3 class="feature-title">Soporte Conversacional</h3>
            <p class="feature-description">
              Resuelve dudas complejas sobre productos y transacciones con IA.
            </p>
          </div>

          <!-- Feature 4: Gestión de Conocimiento -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icon: Book/Base -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path
                  d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
                ></path>
              </svg>
            </div>
            <h3 class="feature-title">Gestión de Conocimiento</h3>
            <p class="feature-description">
              Acceso dinámico a base de FAQs y artículos de soporte
              actualizados.
            </p>
          </div>

          <!-- Feature 5: Presupuestos Inteligentes -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icon: Wallet/Budget -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="12" y1="12" x2="12" y2="12"></line>
                <line x1="2" y1="10" x2="22" y2="10"></line>
              </svg>
            </div>
            <h3 class="feature-title">Presupuestos Inteligentes</h3>
            <p class="feature-description">
              Sugerencias automáticas de ahorro y categorización de gastos.
            </p>
          </div>

          <!-- Feature 6: Scoring de Salud -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icon: Activity/Score -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <h3 class="feature-title">Scoring de Salud</h3>
            <p class="feature-description">
              Evaluación continua del bienestar financiero y progreso de metas a través del Zelify Score.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="control-section">
      <div class="control-container">
        <div class="control-divider"></div>
        <h2 class="control-title">Inteligencia Artificial para Finanzas</h2>

        <div class="control-features">
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/image-products/alaiza/img-1.png"
                    alt="Análisis de Comportamiento"
                  />
                </div>
                <h3 class="control-feature-title">
                  Análisis de comportamiento
                </h3>
                <p class="control-feature-description">
                  Analiza patrones de gasto, ahorro e interacción financiera
                  mediante IA ayudando prevenir riesgos de endeudamiento o fraude.
                </p>
                <button class="control-feature-btn" data-feature="behavior">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Análisis de patrones</h3>
                <ul class="control-feature-benefits">
                  <li>Predicción de comportamiento financiero</li>
                  <li>Evaluación de riesgo financiero</li>
                  <li>Análisis de patrones de gasto</li>
                  <li>Análisis de comportamiento de ahorro</li>
                  <li>Recomendaciones financieras personalizadas</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="behavior"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/image-products/alaiza/img-2.png"
                    alt="Smart Support AI"
                  />
                </div>
                <h3 class="control-feature-title">
                  Chat de soporte - Smart Support
                </h3>
                <p class="control-feature-description">
                  Asistencia automatizada para servicios financieros, a través de un SDK.
                </p>
                <button class="control-feature-btn" data-feature="support">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Capacidades del Chat</h3>
                <ul class="control-feature-benefits">
                  <li>Iniciar sesión de chat</li>
                  <li>Enviar mensajes al chat</li>
                  <li>Obtener detalles de la sesión</li>
                  <li>Obtener historial de mensajes</li>
                  <li>Finalizar sesión de chat</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="support"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/image-products/alaiza/img-3.png"
                    alt="Salud Financiera"
                  />
                </div>
                <h3 class="control-feature-title">Educación Financiera</h3>
                <p class="control-feature-description">
                  Ofrece a los usuarios una visión integral de sus ingresos,
                  gastos, deudas y metas financieras. Alaiza sugiere presupuestos, recordatorios de
                  pagos y estrategias de ahorro inteligentes.
                </p>
                <button class="control-feature-btn" data-feature="finance">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Educación financiera</h3>
                <ul class="control-feature-benefits">
                  <li>Recomendaciones presupuestarias IA</li>
                  <li>Creación de plan presupuestario</li>
                  <li>Análisis de categorización de gastos</li>
                  <li>Proyección de ingresos</li>
                  <li>Puntuación de salud financiera</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="finance"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Contacto -->
    <ContactFormHubSpot headline="Comienza a construir el banco del futuro, hoy." formTitle="Habla con nuestro equipo" />

    <!-- Sección de FAQ -->
    <section class="faq-section">
      <div class="faq-container">
        <h2 class="faq-title">Preguntas frecuentes</h2>

        <div class="faq-list">
          <div class="faq-item">
            <button class="faq-question" data-faq="1">
              <span>¿Qué funcionalidades incluye Alaiza AI Core?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Alaiza ofrece una solución integral de IA que incluye análisis
                de comportamiento financiero, un sistema de Smart Support
                conversacional, herramientas de educación financiera y la
                capacidad de generar reportes detallados mediante lenguaje
                natural.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="2">
              <span
                >¿Cómo ayuda el análisis de comportamiento a prevenir riesgos?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Nuestra IA analiza patrones de gasto, ahorro e interacción en
                tiempo real. Esto permite detectar hábitos atípicos, anticipar
                necesidades de liquidez y alertar preventivamente sobre riesgos
                de sobreendeudamiento o posibles actividades fraudulentas antes
                de que afecten al usuario.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="3">
              <span
                >¿Qué diferencia al Smart Support de un chatbot tradicional?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                A diferencia de los flujos rígidos, Smart Support utiliza IA
                conversacional avanzada para resolver dudas complejas sobre
                productos y transacciones. Está integrado con una base de
                conocimiento dinámica y permite analizar la satisfacción del
                cliente y el historial de mensajes para una asistencia continua.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="4">
              <span
                >¿Cómo se generan las recomendaciones financieras
                personalizadas?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Alaiza utiliza algoritmos de predicción para evaluar ingresos,
                deudas y metas. Con estos datos, genera automáticamente
                presupuestos sugeridos, proyecciones de ahorro y estrategias de
                pago de deuda, entregando además una puntuación (score) de salud
                financiera al usuario.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="5">
              <span
                >¿Puedo obtener informes de negocio sin conocimientos técnicos?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Sí. Alaiza permite producir reportes complejos a partir de
                instrucciones simples en lenguaje natural. La plataforma
                interpreta tus solicitudes y extrae insights de comportamiento y
                tendencias de uso para facilitar la toma de decisiones
                estratégicas.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="6">
              <span
                >¿Qué tan difícil es integrar el SDK de Alaiza en mi aplicación?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                El SDK de Alaiza está diseñado para una integración nativa
                rápida tanto en plataformas web como móviles. Permite desplegar
                todas las capacidades de IA y el chat de soporte sin añadir
                fricción a los flujos de usuario existentes, asegurando una
                experiencia fluida desde el primer día.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- Sección CTA Final -->
    <section class="cta-section">
      <div class="cta-container">
        <h2 class="cta-title">
          Comienza hoy y<br />
          asegura cada acceso.
        </h2>
        <button type="button" class="cta-button" data-open-quote-modal>
          Hablemos
        </button>
      </div>
    </section>

    <!-- Footer (mismo que index) -->
    <Footer
      quickLinksTitle="Quick links"
      links={[
        { href: "", label: "Products", key: "products", dataI18n: "footer.products" },
        { href: "https://docs.zelify.com", label: "Developers", key: "developers", dataI18n: "footer.developers", openInNewTab: true },
        { href: "/blog", label: "Blog", key: "blog", dataI18n: "footer.blog" },
      ]}
      legalText="Zelify is a technology platform currently in a development phase, not yet deployed or operational, and does not provide or process financial services directly; all financial operations are conducted exclusively through regulated third-party partners."
      copyrightText="© 2025 Zelify. All rights reserved."
      dataI18n={{ quicklinks: "footer.quicklinks", legal: "footer.legal", copyright: "footer.copyright" }}
    />
    <AlaizaAssistant client:load />
    <QuoteModalHubSpot />
    <script is:inline>
      function initQuoteModal() {
        var form = document.querySelector(".welcome-input-group");
        var quoteModal = document.querySelector("#quote-modal");
        var closeQuoteBtn = document.querySelector("#close-quote-modal");
        var quoteModalOverlay = document.querySelector("[data-close-quote-modal]");
        var MEETINGS_BASE_URL = "https://meetings.hubspot.com/gmantilla?embed=true";
        function openQuoteModal() {
          if (!quoteModal) return;
          var emailInput = document.querySelector(".welcome-input");
          var email = emailInput && emailInput.value ? emailInput.value.trim() : "";
          var embedUrl = email ? MEETINGS_BASE_URL + "&email=" + encodeURIComponent(email) : MEETINGS_BASE_URL;
          var container = document.querySelector(".meetings-iframe-container");
          if (container) {
            container.setAttribute("data-src", embedUrl);
            var iframe = container.querySelector("iframe");
            if (iframe) iframe.src = embedUrl;
            else setTimeout(function() { var iframeLater = container.querySelector("iframe"); if (iframeLater) iframeLater.src = embedUrl; }, 500);
          }
          quoteModal.classList.add("is-active");
          quoteModal.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
        }
        function closeQuoteModal() {
          if (!quoteModal) return;
          quoteModal.classList.remove("is-active");
          quoteModal.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
        }
        if (closeQuoteBtn) closeQuoteBtn.addEventListener("click", closeQuoteModal);
        if (quoteModalOverlay) quoteModalOverlay.addEventListener("click", closeQuoteModal);
        if (form) form.addEventListener("submit", function(e) { e.preventDefault(); openQuoteModal(); });
        var openBtns = document.querySelectorAll("[data-open-quote-modal]");
        for (var i = 0; i < openBtns.length; i++) {
          openBtns[i].addEventListener("click", function(e) { e.preventDefault(); openQuoteModal(); });
        }
      }
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initQuoteModal);
      } else {
        initQuoteModal();
      }
    </script>
    <!-- Start of HubSpot Embed Code -->
    <script type="text/javascript" id="hs-script-loader" async defer src="//js.hs-scripts.com/50894304.js"></script>
    <!-- End of HubSpot Embed Code -->
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    width: 100%;
  }

  body {
    font-family:
      "NataSans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    background-color: #ffffff;
    color: #0a203f;
  }

  .auth-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 3rem;
    position: sticky;
    top: 0;
    z-index: 1000;
    max-width: 1400px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .welcome-input-group {
    display: flex;
    align-items: center;
    border: 2px solid #00223e;
    border-radius: 10px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 1px;
    padding-right: 3px;
    background: #ffffff;
    min-width: min(560px, 100%);
    max-width: 620px;
  }

  .welcome-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 1.05rem;
    padding: 0.75rem 1.25rem;
    color: #00223e;
    background: transparent;
  }

  .welcome-input::placeholder {
    color: #213f8c;
    opacity: 0.9;
  }

  .welcome-quote-button {
    border: none;
    background: #213f8c;
    color: #ffffff;
    padding: 0.7rem 2.9rem;
    border-radius: 9px;
    font-size: 1.1rem;
    font-weight: 400;
    cursor: pointer;
    width: 170px;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .welcome-demo-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #93fb4d;
    color: #00223e;
    padding-top: 10px;
    padding-bottom: 10px;
    border-radius: 9px;
    width: 20%;
    text-decoration: none;
    font-weight: 400;
    font-size: 1.1rem;
    box-shadow: 0 10px 22px rgba(147, 251, 77, 0.35);
    margin-left: 1rem;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .welcome-demo-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 26px rgba(147, 251, 77, 0.4);
  }

  .auth-main {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 2rem 2rem;
    margin-top: 30px;
  }

  .auth-hero {
    max-width: 800px;
    width: 100%;
    text-align: center;
  }

  .auth-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.2;
    color: #0a203f;
    margin: 0 0 2rem 0;
    font-weight: 400;
  }

  .auth-title br {
    display: block;
  }

  .auth-description {
    font-size: clamp(1rem, 2vw, 1.1rem);
    line-height: 1.6;
    color: #213f8c;
    margin: 0 0 3rem 0;
  }

  .auth-description br {
    display: block;
  }

  .auth-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-cotizar {
    border: none;
    background: #0a203f;
    color: #ffffff;
    border-radius: 999px;
    padding: 0.65rem 1.75rem;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    text-transform: lowercase;
    transition: all 0.2s ease;
    text-decoration: none;
    display: inline-block;
  }

  .btn-cotizar:hover {
    background: #0d2a4f;
    transform: translateY(-1px);
  }

  .btn-demo-hero {
    border: none;
    background: #8dff2b;
    color: #082436;
    text-transform: lowercase;
    padding: 0.65rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    box-shadow: 0 10px 20px rgba(141, 255, 43, 0.45);
    transition: all 0.2s ease;
  }

  .btn-demo-hero:hover {
    background: #a5ff4d;
    transform: translateY(-1px);
    box-shadow: 0 12px 24px rgba(141, 255, 43, 0.5);
  }

  .auth-background-section {
    position: relative;
    width: 100%;
    /* background: #ffffff; */
    padding: 4rem 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    overflow: hidden;
  }

  .auth-background-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      #ffffff 0%,
      transparent 15%,
      transparent 85%,
      #ffffff 100%
    );
    pointer-events: none;
  }

  .auth-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .view-switcher {
    display: flex;
    gap: 0.75rem;
    z-index: 20;
    background: rgba(230, 230, 230, 0.3);
    padding: 0.25rem;
    border-radius: 999px;
    backdrop-filter: blur(8px);
  }

  .view-btn {
    background: transparent;
    border: none;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    color: #6b7280;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .view-btn:hover {
    color: #374151;
    background: rgba(255, 255, 255, 0.5);
  }

  .view-btn.active {
    background: #ffffff;
    color: #004492;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .views-container {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .view-content {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
  }

  .view-content.hidden {
    display: none;
  }

  .auth-background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  /* Contenedor del dispositivo */
  .device-container {
    position: relative;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    z-index: 10;
    padding: 1rem 0 2rem;
  }

  /* Frame del iPhone */
  .device-frame-wrapper {
    position: relative;
    z-index: 10;
    transform: scale(1.5);
    padding: 6rem;
    background-color: #f3f4f6;
    border-radius: 4rem;
    margin: 3rem auto;
  }

  .device-frame {
    position: relative;
    overflow: hidden;
    border-radius: 3rem;
    border: none;
    background: transparent;
    box-shadow: none;
  }

  /* Pantalla del dispositivo */
  .device-screen {
    position: relative;
    height: 750px;
    overflow: hidden;
    border-radius: 2.5rem;
    background: #ffffff;
    margin: 0;
    display: flex;
    flex-direction: column;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.05),
      0 20px 60px rgba(0, 0, 0, 0.15);
  }

  /* Status Bar */
  .device-status-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    padding: 2.5rem 1.5rem 0.5rem;
    flex-shrink: 0;
  }

  .status-time {
    position: absolute;
    left: 1.5rem;
    top: 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #000000;
  }

  .dynamic-island {
    position: absolute;
    left: 50%;
    top: 0.75rem;
    transform: translateX(-50%);
  }

  .island-shape {
    width: 96px;
    height: 20px;
    border-radius: 999px;
    background: #000000;
  }

  .island-speaker {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 48px;
    height: 2px;
    border-radius: 999px;
    background: rgba(31, 41, 55, 0.3);
  }

  .status-icons {
    position: absolute;
    right: 1.5rem;
    top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .signal-icon {
    width: 20px;
    height: 12px;
    color: #000000;
  }

  .battery-icon {
    width: 24px;
    height: 10px;
    border: 1px solid #000000;
    border-radius: 2px;
    padding: 1px;
  }

  .battery-level {
    width: 80%;
    height: 100%;
    background: #000000;
    border-radius: 1px;
  }

  /* Contenido del dispositivo */
  .device-content {
    flex: 1;
    min-height: 0;
    background: #ffffff;
    padding: 1rem 1.25rem;
    overflow-y: auto;
    overflow-x: hidden;
  }

  /* Header del dispositivo */
  .device-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    flex-shrink: 0;
  }

  .device-back-btn {
    font-size: 0.875rem;
    font-weight: 500;
    color: #6b7280;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .device-logo {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .device-logo img {
    height: 32px;
    width: auto;
  }

  .device-header-spacer {
    width: 48px;
  }

  /* Animación GIF */
  .device-animation {
    position: relative;
    margin-bottom: -3.5rem;
    z-index: 0;
    display: flex;
    justify-content: center;
    flex-shrink: 0;
  }

  .device-animation img {
    width: 180px;
    height: 180px;
    object-fit: contain;
    opacity: 0.9;
  }

  /* Tarjeta translúcida */
  .device-card {
    position: relative;
    z-index: 10;
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    border-radius: 1rem;
    padding: 1rem 1.25rem;
    backdrop-filter: blur(4px);
    background: rgba(255, 255, 255, 0.35);
    min-height: 0;
  }

  .auth-phone-card {
    width: 100%;
    background: transparent;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
    position: relative;
  }

  /* Home Indicator */
  .device-home-indicator {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    width: 128px;
    height: 4px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.3);
    flex-shrink: 0;
  }

  .phone-card-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .phone-card-dots .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d0d0d0;
    transition: background 0.3s ease;
  }

  .phone-card-dots .dot.active {
    background: #213f8c;
  }

  .phone-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0a203f;
    margin: 0 0 0.5rem 0;
    text-align: center;
  }

  .phone-card-description {
    font-size: 0.75rem;
    color: #6b7280;
    margin: 0 0 1rem 0;
    text-align: center;
    line-height: 1.4;
  }

  .btn-google {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border: 1px solid #e5e7eb;
    background: #f9fafb;
    border-radius: 12px;
    padding: 0.75rem 1.25rem;
    font-weight: 500;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-bottom: 1rem;
    color: #0a203f;
  }

  .btn-google:hover {
    background: #f3f4f6;
    border-color: #d1d5db;
  }

  .phone-card-divider {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: #e5e7eb;
  }

  .divider-text {
    font-size: 0.75rem;
    color: #6b7280;
    font-weight: 500;
    white-space: nowrap;
  }

  .phone-card-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-field label {
    font-size: 0.75rem;
    font-weight: 500;
    color: #374151;
  }

  .form-field .required {
    color: #ef4444;
    margin-left: 2px;
  }

  .form-field input {
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 0.625rem 0.875rem;
    font-size: 0.875rem;
    outline: none;
    background: #f9fafb;
    color: #0a203f;
    font-family: inherit;
    transition: border-color 0.2s ease;
  }

  .form-field input:focus {
    border-color: #213f8c;
    background: #ffffff;
  }

  .form-field input.field-error {
    border-color: #ef4444;
    background: #fef2f2;
  }

  .form-field input.field-error:focus {
    border-color: #ef4444;
    background: #fef2f2;
  }

  .field-error-message {
    display: none;
    margin-top: 0.25rem;
    font-size: 0.7rem;
    color: #ef4444;
  }

  .form-field input::placeholder {
    color: #9ca3af;
  }

  .otp-input.otp-verifying {
    border-color: #213f8c;
    animation: otp-pulse 1s ease-in-out infinite;
  }

  .otp-input.otp-success {
    border-color: #10b981;
    background: #f0fdf4;
  }

  .otp-input.otp-error {
    border-color: #ef4444;
    background: #fef2f2;
    animation: otp-shake 0.5s ease-in-out;
  }

  @keyframes otp-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.6;
    }
  }

  @keyframes otp-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-4px);
    }
    75% {
      transform: translateX(4px);
    }
  }

  .btn-continuar {
    position: relative;
    border: none;
    background: linear-gradient(
      to right,
      #213f8c 0%,
      #1a2f6b 40%,
      #0f1f4d 70%,
      #0a203f 100%
    );
    color: #ffffff;
    border-radius: 12px;
    padding: 0.85rem 1.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
    margin-top: 0.5rem;
    overflow: hidden;
    box-shadow: 0 4px 14px 0 rgba(33, 63, 140, 0.4);
    animation:
      cta-pulse-glow 2s ease-in-out infinite,
      cta-button-pulse 2.5s ease-in-out infinite;
  }

  .btn-continuar::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 12px;
    opacity: 0.6;
    background: #213f8c;
    filter: blur(8px);
    z-index: -1;
    animation: cta-pulse-ring 2s ease-in-out infinite;
  }

  .btn-continuar::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      transparent,
      rgba(255, 255, 255, 0.4),
      transparent
    );
    transform: translateX(-100%);
    animation: cta-shine-sweep 2.5s linear infinite;
    z-index: 1;
  }

  .btn-continuar:hover {
    transform: translateY(-1px);
  }

  .btn-continuar:active {
    transform: scale(0.98);
  }

  @keyframes cta-pulse-glow {
    0%,
    100% {
      box-shadow: 0 4px 14px 0 rgba(33, 63, 140, 0.4);
    }
    50% {
      box-shadow:
        0 4px 20px 0 rgba(33, 63, 140, 0.8),
        0 0 30px 0 rgba(33, 63, 140, 0.4);
    }
  }

  @keyframes cta-button-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.02);
    }
  }

  @keyframes cta-pulse-ring {
    0%,
    100% {
      opacity: 0.4;
      transform: scale(1);
    }
    50% {
      opacity: 0.7;
      transform: scale(1.05);
    }
  }

  @keyframes cta-shine-sweep {
    0% {
      transform: translateX(-100%) skewX(-15deg);
    }
    100% {
      transform: translateX(200%) skewX(-15deg);
    }
  }

  .phone-card-login {
    text-align: center;
    font-size: 0.75rem;
    color: #6b7280;
    margin: 0.5rem 0 0 0;
  }

  .phone-card-login a {
    color: #213f8c;
    text-decoration: none;
    font-weight: 500;
  }

  .phone-card-login a:hover {
    text-decoration: underline;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .auth-header {
      padding: 1.25rem 2rem;
    }

    .auth-nav {
      gap: clamp(1.5rem, 2vw, 2.5rem);
      font-size: 0.95rem;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .auth-header {
      flex-direction: column;
      gap: 1rem;
      padding: 1.25rem 1.5rem;
    }

    .auth-nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
      font-size: 0.9rem;
    }

    .auth-actions {
      width: 100%;
      justify-content: center;
    }

    .auth-main {
      padding: 2rem 1.5rem;
    }

    .auth-title {
      font-size: 2rem;
      margin-bottom: 1.5rem;
    }

    .auth-description {
      font-size: 0.95rem;
      margin-bottom: 2rem;
    }

    .auth-cta {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-cotizar,
    .btn-demo-hero {
      width: 100%;
    }

    .auth-phone-card {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      margin: 2rem auto;
      max-width: 100%;
      width: calc(100% - 2rem);
    }

    .auth-background-section {
      padding: 2rem 0;
    }

    .otp-inputs {
      gap: 0.5rem;
    }

    .otp-input {
      width: 42px;
      height: 42px;
      font-size: 1.1rem;
    }
  }

  /* Sección de Seguridad Inteligente */
  .security-section {
    width: 100%;
    background: #ffffff;
    padding: 5rem 2rem;
  }

  .security-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .security-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1.2;
    color: #0a203f;
    text-align: center;
    margin: 0 0 4rem 0;
    font-weight: 400;
  }

  .security-title br {
    display: block;
  }

  .security-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem 2rem;
    margin-top: 3rem;
  }

  .security-feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .feature-icon {
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border-radius: 18px;
    margin-bottom: 1.5rem;
    color: #213f8c;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .security-feature:hover .feature-icon {
    transform: translateY(-2px);
  }

  .feature-icon svg {
    width: 36px;
    height: 36px;
  }

  .feature-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #0a203f;
    margin: 0 0 0.75rem 0;
    line-height: 1.3;
  }

  .feature-description {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #6b7280;
    margin: 0;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .security-section {
      padding: 4rem 2rem;
    }

    .security-features {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 2rem;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .security-section {
      padding: 3rem 1.5rem;
    }

    .security-title {
      font-size: 2rem;
      margin-bottom: 3rem;
    }

    .security-features {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .feature-icon {
      width: 56px;
      height: 56px;
      margin-bottom: 1.25rem;
    }

    .feature-icon svg {
      width: 28px;
      height: 28px;
    }

    .feature-title {
      font-size: 1.1rem;
    }

    .feature-description {
      font-size: 0.9rem;
    }
  }

  /* Sección de Control Total */
  .control-section {
    width: 100%;
    background: #ffffff;
    padding: 5rem 2rem;
  }

  .control-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .control-divider {
    width: 100%;
    max-width: 200px;
    height: 2px;
    background: #1488fe;
    margin: 0 auto 3rem;
  }

  .control-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1.2;
    color: #0a203f;
    text-align: center;
    margin: 0 0 4rem 0;
    font-weight: 400;
  }

  .control-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 2rem;
  }

  .control-feature {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    perspective: 1000px;
  }

  .control-feature-card {
    width: 100%;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.6s ease;
  }

  .control-feature-card.flipped {
    transform: rotateY(180deg);
  }

