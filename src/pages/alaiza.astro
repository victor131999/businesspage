---
import AlaizaApp from "@/components/alaiza/AlaizaApp.astro";
import AlaizaBehaviorAnalysisApp from "@/components/alaiza/AlaizaBehaviorAnalysisApp.astro";
import AlaizaChatApp from "@/components/alaiza/AlaizaChatApp.astro";
import DeviceFrame from "@/components/DeviceFrame.astro";
import Navbar3 from "../components/NavbarSimple.astro";
---

<html lang="es">
  <head>
    <Navbar3 />
  </head>

  <body>
    <header class="auth-header">
      <a class="auth-logo" href="/">
        <img src="/images/zelify_logo.png" alt="Zelify" />
      </a>
      <nav class="auth-nav" aria-label="Main navigation">
        <a href="/products">Productos</a>
        <a href="/nosotros">Nosotros</a>
        <a href="/desarrollo">Desarrollo</a>
        <a href="/otros">Otros</a>
      </nav>
      <div class="auth-actions">
        <a
          href="https://www.zelify.com/clips"
          class="btn-demo"
          target="_blank"
          rel="noopener noreferrer">demo</a
        >
        <button class="lang-pill" aria-label="Idioma actual español">ES</button>
      </div>
    </header>

    <main class="auth-main">
      <section class="auth-hero">
        <h1 class="auth-title">Alaiza AI Core for Fintech</h1>
        <p class="auth-description">
          Plataforma de inteligencia artificial enfocada en finanzas que analiza<br
          />
          el comportamiento de los usuarios para detectar hábitos y anticipar<br
          />
          necesidades, ofrece soporte conversacional integrado, genera contenido<br
          />
          alineado a la marca, entrega herramientas de finanzas personales con<br
          />
          recomendaciones y produce reportes a partir de instrucciones en lenguaje<br
          />
          natural. Todo orientado a mejorar la experiencia del cliente y la toma<br
          />
          de decisiones sin añadir fricción a los flujos existentes.
        </p>
        <div class="auth-cta">
          <input
            type="email"
            placeholder="ingresa tu correo"
            aria-label="Correo electrónico"
          />
          <a
            href="https://alaiza.zelify.com"
            class="btn-cotizar"
            target="_blank"
            rel="noopener noreferrer">cotizar</a
          >
          <a
            href="https://www.zelify.com/clips"
            class="btn-demo-hero"
            target="_blank"
            rel="noopener noreferrer">demo</a
          >
        </div>
      </section>
    </main>

    <div class="auth-background-section">
      <div class="auth-background-image">
        <img src="/background.jpeg" alt="Background pattern" />
      </div>

      <!-- Botones de Navegación (Transparentes) -->
      <div class="view-switcher">
        <button class="view-btn" data-target="alaiza">Alaiza</button>
        <button class="view-btn" data-target="behaviour"
          >Behaviour Analysis</button
        >
        <button class="view-btn active" data-target="education"
          >Educación financiera</button
        >
      </div>

      <!-- Contenedor del dispositivo móvil -->
      <DeviceFrame class="device-container">
        <!-- View 1: Alaiza (Placeholder) -->
        <div id="view-alaiza" class="view-content hidden">
          <AlaizaChatApp />
        </div>

        <!-- View 2: Behaviour Analysis (Placeholder) -->
        <div id="view-behaviour" class="view-content hidden">
          <AlaizaBehaviorAnalysisApp />
        </div>

        <!-- View 3: Financial Education (AlaizaApp) -->
        <div id="view-education" class="view-content">
          <AlaizaApp />
        </div>
      </DeviceFrame>
    </div>

    <!-- Sección de Seguridad Inteligente -->
    <section class="security-section">
      <div class="security-container">
        <h2 class="security-title">
          Capacidades Nucleares<br />
          de Inteligencia Artificial
        </h2>

        <div class="security-features">
          <!-- Feature 1: Predicción de Comportamiento -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icon: Chart/Prediction -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
              </svg>
            </div>
            <h3 class="feature-title">Predicción de Comportamiento</h3>
            <p class="feature-description">
              Anticipa necesidades y detecta hábitos futuros de los usuarios.
            </p>
          </div>

          <!-- Feature 2: Evaluación de Riesgo -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icon: Shield/Risk -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="M12 8v4"></path>
                <path d="M12 16h.01"></path>
              </svg>
            </div>
            <h3 class="feature-title">Evaluación de Riesgo</h3>
            <p class="feature-description">
              Previene endeudamiento y fraude mediante análisis en tiempo real.
            </p>
          </div>

          <!-- Feature 3: Soporte Conversacional -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icon: Message/Chat -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                ></path>
              </svg>
            </div>
            <h3 class="feature-title">Soporte Conversacional</h3>
            <p class="feature-description">
              Resuelve dudas complejas sobre productos y transacciones con IA.
            </p>
          </div>

          <!-- Feature 4: Gestión de Conocimiento -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icon: Book/Base -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path
                  d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
                ></path>
              </svg>
            </div>
            <h3 class="feature-title">Gestión de Conocimiento</h3>
            <p class="feature-description">
              Acceso dinámico a base de FAQs y artículos de soporte
              actualizados.
            </p>
          </div>

          <!-- Feature 5: Presupuestos Inteligentes -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icon: Wallet/Budget -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="12" y1="12" x2="12" y2="12"></line>
                <line x1="2" y1="10" x2="22" y2="10"></line>
              </svg>
            </div>
            <h3 class="feature-title">Presupuestos Inteligentes</h3>
            <p class="feature-description">
              Sugerencias automáticas de ahorro y categorización de gastos.
            </p>
          </div>

          <!-- Feature 6: Scoring de Salud -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icon: Activity/Score -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <h3 class="feature-title">Scoring de Salud</h3>
            <p class="feature-description">
              Evaluación continua del bienestar financiero y progreso de metas.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="control-section">
      <div class="control-container">
        <div class="control-divider"></div>
        <h2 class="control-title">Inteligencia Artificial para Finanzas</h2>

        <div class="control-features">
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&h=500&fit=crop&q=80"
                    alt="Análisis de Comportamiento"
                  />
                </div>
                <h3 class="control-feature-title">
                  Análisis de comportamiento
                </h3>
                <p class="control-feature-description">
                  Analiza patrones de gasto, ahorro e interacción financiera
                  mediante IA. Detecta hábitos, anticipa necesidades y ayuda a
                  prevenir riesgos de endeudamiento o fraude.
                </p>
                <button class="control-feature-btn" data-feature="behavior">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Análisis de patrones</h3>
                <ul class="control-feature-benefits">
                  <li>Predicción de comportamiento financiero</li>
                  <li>Evaluación de riesgo financiero</li>
                  <li>Análisis de patrones de gasto</li>
                  <li>Análisis de comportamiento de ahorro</li>
                  <li>Recomendaciones financieras personalizadas</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="behavior"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1531746790731-6c087fecd65a?w=800&h=500&fit=crop&q=80"
                    alt="Smart Support AI"
                  />
                </div>
                <h3 class="control-feature-title">
                  Chat de soporte - Smart Support
                </h3>
                <p class="control-feature-description">
                  Sistema de asistencia automática basado en IA conversacional
                  que resuelve dudas sobre productos financieros, transacciones
                  o servicios a través de un SDK.
                </p>
                <button class="control-feature-btn" data-feature="support">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Capacidades del Chat</h3>
                <ul class="control-feature-benefits">
                  <li>Iniciar sesión de chat</li>
                  <li>Enviar mensajes al chat</li>
                  <li>Obtener detalles de la sesión</li>
                  <li>Obtener historial de mensajes</li>
                  <li>Finalizar sesión de chat</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="support"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1702306946700-4cae9f2dfe82?q=80&w=1301&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                    alt="Salud Financiera"
                  />
                </div>
                <h3 class="control-feature-title">Finanzas Personales</h3>
                <p class="control-feature-description">
                  Ofrece a los usuarios una visión integral de sus ingresos,
                  gastos, deudas y metas financieras. A través de algoritmos de
                  predicción, Alaiza sugiere presupuestos, recordatorios de
                  pagos y estrategias de ahorro inteligentes.
                </p>
                <button class="control-feature-btn" data-feature="finance">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Educación financiera</h3>
                <ul class="control-feature-benefits">
                  <li>Recomendaciones presupuestarias IA</li>
                  <li>Creación de plan presupuestario</li>
                  <li>Análisis de categorización de gastos</li>
                  <li>Proyección de ingresos</li>
                  <li>Puntuación de salud financiera</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="finance"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=800&h=500&fit=crop&q=80"
                    alt="SDK Alaiza"
                  />
                </div>
                <h3 class="control-feature-title">SDK de Alaiza</h3>
                <p class="control-feature-description">
                  SDK diseñado para integrar de manera nativa las capacidades de
                  inteligencia artificial conversacional y análisis financiero
                  avanzado de Alaiza en aplicaciones móviles y web.
                </p>
                <button class="control-feature-btn" data-feature="sdk">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Integración SDK</h3>
                <ul class="control-feature-benefits">
                  <li>Integración nativa sin fricción</li>
                  <li>Soporte inteligente en-app</li>
                  <li>Despliegue en Web y Móvil</li>
                  <li>Experiencias personalizadas</li>
                  <li>Análisis financiero avanzado</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="sdk"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Contacto -->
    <section class="contact-section">
      <div class="contact-container">
        <div class="contact-content">
          <!-- Texto izquierdo -->
          <div class="contact-text">
            <h2 class="contact-title">
              Empieza hoy<br />
              y protege tu<br />
              plataforma.
            </h2>
          </div>

          <!-- Formulario derecho -->
          <div class="contact-form-wrapper">
            <div class="contact-form-card">
              <h3 class="contact-form-title">Habla con nuestro equipo</h3>

              <form class="contact-form" id="contactForm">
                <div class="form-row">
                  <div class="form-group">
                    <input
                      type="text"
                      id="nombres"
                      placeholder="Nombres"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <input
                      type="text"
                      id="apellidos"
                      placeholder="Apellidos"
                      required
                    />
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <input
                      type="text"
                      id="compania"
                      placeholder="Nombre de la compañía"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <input
                      type="email"
                      id="email"
                      placeholder="Email de la compañía"
                      required
                    />
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <select id="pais" required>
                      <option value="">País</option>
                      <option value="mx">México</option>
                      <option value="co">Colombia</option>
                      <option value="ar">Argentina</option>
                      <option value="cl">Chile</option>
                      <option value="pe">Perú</option>
                      <option value="es">España</option>
                      <option value="us">Estados Unidos</option>
                    </select>
                    <svg
                      class="select-arrow"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </div>
                  <div class="form-group">
                    <input
                      type="tel"
                      id="telefono"
                      placeholder="Teléfono (opcional)"
                    />
                  </div>
                </div>

                <p class="contact-legal">
                  Al enviar este formulario, aceptas nuestros <a href="#"
                    >Términos de Servicio</a
                  > y <a href="#">Política de Privacidad</a>.
                </p>

                <button type="submit" class="contact-submit-btn">
                  Hablemos
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de FAQ -->
    <section class="faq-section">
      <div class="faq-container">
        <h2 class="faq-title">Preguntas frecuentes</h2>

        <div class="faq-list">
          <div class="faq-item">
            <button class="faq-question" data-faq="1">
              <span>¿Qué funcionalidades incluye Alaiza AI Core?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Alaiza ofrece una solución integral de IA que incluye análisis
                de comportamiento financiero, un sistema de Smart Support
                conversacional, herramientas de finanzas personales con
                educación financiera y la capacidad de generar reportes
                detallados mediante lenguaje natural.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="2">
              <span
                >¿Cómo ayuda el análisis de comportamiento a prevenir riesgos?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Nuestra IA analiza patrones de gasto, ahorro e interacción en
                tiempo real. Esto permite detectar hábitos atípicos, anticipar
                necesidades de liquidez y alertar preventivamente sobre riesgos
                de sobreendeudamiento o posibles actividades fraudulentas antes
                de que afecten al usuario.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="3">
              <span
                >¿Qué diferencia al Smart Support de un chatbot tradicional?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                A diferencia de los flujos rígidos, Smart Support utiliza IA
                conversacional avanzada para resolver dudas complejas sobre
                productos y transacciones. Está integrado con una base de
                conocimiento dinámica y permite analizar la satisfacción del
                cliente y el historial de mensajes para una asistencia continua.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="4">
              <span
                >¿Cómo se generan las recomendaciones financieras
                personalizadas?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Alaiza utiliza algoritmos de predicción para evaluar ingresos,
                deudas y metas. Con estos datos, genera automáticamente
                presupuestos sugeridos, proyecciones de ahorro y estrategias de
                pago de deuda, entregando además una puntuación (score) de salud
                financiera al usuario.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="5">
              <span
                >¿Puedo obtener informes de negocio sin conocimientos técnicos?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
