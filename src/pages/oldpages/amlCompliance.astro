---
import Navbar from "../components/navbar.astro";
import ProductsPanel from "../components/productsPanel.astro";
import "../styles/navbar.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png" />
    <title>Zelify Page 3 — AML</title>
  </head>

  <body
    style="
      background-color: #0e1510;
      background-image: url('/images/FONDO 4.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      min-height: 100vh;
      margin: 0;
    "
  >
    <Navbar
      logoSrc="/images/zelify_logo.png"
      colors={{
        text: "#054F8B",
        textHover: "#ffffff",
        highlightBg: "#00223E",
        highlightText: "#6AFF00",
        btnLightBg: "#00223E",
        btnLightHoverBg: "#003d6b",
        btnLightText: "#6AFF00",
        btnLightIconFilter: "brightness(0) saturate(100%) invert(77%) sepia(97%) saturate(1352%) hue-rotate(47deg) brightness(107%) contrast(107%)",
        btnOutline: "#00223E",
        btnOutlineHover: "#ffffff",
        dropdownBg: "#ffffff",
        dropdownLink: "#1e2b3a",
        dropdownHoverBg: "#EEF3F9",
        radius: "22px",
      }}
      buttons={{
        first: { label: "Work with us", href: "/jobs" },
        second: { label: "Business access", href: "https://www.zelify.io/" },
        third: { label: "EN", href: "/" },
      }}
    />
<ProductsPanel />
    <section class="hero">
      <div class="content">
        <span class="band" data-i18n="aml.badge">AML</span>

        <h1 class="title" data-i18n="aml.title" data-i18n-html="true">
          Smart Risk.<br />
          Zero Blind Spots.
        </h1>

        <p class="description" data-i18n="aml.description" data-i18n-html="true">
          Automated PEP, sanctions, and media screening built<br/>
          to expose financial risk before it strikes.<br/>
          Stay compliant, fight crime, and keep every<br/>
          transaction under control.
        </p>

        <div class="cta">
          <a href="/hablemos" class="btn" data-i18n="aml.ctaPrimary">Let's talk</a>
          <a href="https://docs.zelify.com/servicios-financieros/aml" target="_blank" rel="noopener noreferrer" class="btn" data-i18n="aml.ctaSecondary">View API Docs</a>
        </div>
      </div>
    </section>
    <script is:inline>
      (() => {
        const translations = {
          EN: {
            "aml.badge": "AML",
            "aml.title": "Smart Risk.<br />Zero Blind Spots.",
            "aml.description":
              "Automated PEP, sanctions, and media screening built to expose financial risk before it strikes.<br />Stay compliant, fight crime, and keep every transaction under control.",
            "aml.descriptionDesktop":
              "Automated PEP, sanctions, and media screening built<br/>to expose financial risk before it strikes.<br/>Stay compliant, fight crime, and keep every<br/>transaction under control.",
            "aml.ctaPrimary": "Let's talk",
            "aml.ctaSecondary": "View API Docs",
          },
          ES: {
            "aml.badge": "AML",
            "aml.title": "Riesgo inteligente.<br />Sin puntos ciegos.",
            "aml.description":
              "Screening automatizado de PEP, sanciones y medios que revela el riesgo financiero antes de que ocurra.<br />Mantente en cumplimiento, combate el fraude y mantiene cada transacción bajo control.",
            "aml.descriptionDesktop":
              "Screening automatizado de PEP, sanciones y medios que revela el riesgo financiero antes de que ocurra.<br />Mantente en cumplimiento, combate el fraude y mantiene cada transacción bajo control.",
            "aml.ctaPrimary": "Hablemos",
            "aml.ctaSecondary": "Ver documentación API",
          },
        };

        function updateDescription(lang) {
          const dictionary = translations[lang] ?? translations.EN;
          const descriptionElement = document.querySelector('[data-i18n="aml.description"]');
          if (descriptionElement) {
            const isMobile = window.matchMedia('(max-width: 768px)').matches;
            if (isMobile) {
              descriptionElement.innerHTML = dictionary["aml.description"];
            } else {
              descriptionElement.innerHTML = dictionary["aml.descriptionDesktop"];
            }
          }
        }

        let currentLang = "EN";

        const applyTranslations = (lang) => {
          currentLang = lang;
          const dictionary = translations[lang] ?? translations.EN;
          document.querySelectorAll("[data-i18n]").forEach((node) => {
            const key = node.dataset.i18n;
            if (!key) return;
            // Skip description as it's handled by updateDescription
            if (key === "aml.description") return;
            const value = dictionary[key];
            if (!value) return;
            if (node.dataset.i18nHtml === "true") {
              node.innerHTML = value;
            } else {
              node.textContent = value;
            }
          });
          // Update description separately with responsive logic
          updateDescription(lang);
        };

        const initialLang =
          window.__uiLanguage ??
          (document.documentElement.lang ? document.documentElement.lang.toUpperCase() : "EN");
        applyTranslations(initialLang);

        window.addEventListener("ui:languagechange", (event) => {
          applyTranslations(event.detail?.language === "ES" ? "ES" : "EN");
        });

        // Handle window resize to update description
        window.addEventListener("resize", () => {
          updateDescription(currentLang);
        });
      })();
    </script>
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  body {
    font-family: "NataSans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #0b132b;
  }

  .hero {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    padding: 4rem 8% 6rem;
  }

  .content {
    max-width: 640px;
    text-align: left;
    margin-left: 200px;    
    margin-right: 6%;     
  }

  .band {
    display: inline-block;
    background: #183b86;
    color: #e9eef7;
    padding: 0.85rem 2rem;
    border-radius: 40px;
    font-weight: 800;
    letter-spacing: 0.3px;
    margin-bottom: 2rem;
    max-width: 350px;
  }

  .title {
    color: #0b132b;
    font-weight: 400;
    line-height: 1.1;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin: 0 0 1rem 0;
  }

  .description {
    color: #223547;
    font-size: 1.05rem;
    line-height: 1.65;
    max-width: 520px;
    margin: 0 0 1.8rem 0;
  }

  .cta {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .cta .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: linear-gradient(145deg, #f1f3f6 0%, #dfe3ea 100%);
    color: #172a45;
    text-decoration: none;
    font-weight: 600;
    padding: 0.55rem 1.65rem;
    border-radius: 6px;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    box-shadow: 0 10px 26px rgba(15, 28, 46, 0.22);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .cta .btn::before {
    content: "";
    width: 18px;
    height: 18px;
    background: url("/icons/maletin.svg") no-repeat center / contain;
    filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.2));
    display: inline-block;
  }

  .cta .btn + .btn::before {
    background: url("/icons/acceso.svg") no-repeat center / contain;
  }

  .cta .btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 30px rgba(15, 28, 46, 0.3);
  }

  @media (max-width: 960px) {
    .hero { padding: 4rem 6%; }
    .content {
      max-width: 100%;
      margin: 0 auto;
      text-align: center;
    }
    .title { font-size: clamp(2rem, 6vw, 3rem); }
    .band { max-width: 100%; text-align: center; }
  }
</style>
