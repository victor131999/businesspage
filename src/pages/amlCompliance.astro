---
import Navbar from "../components/navbar.astro";
import ProductsPanel from "../components/productsPanel.astro";
import "../styles/navbar.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Zelify Page 3 — AML</title>
  </head>

  <body
    style="
      background-color: #0e1510;
      background-image: url('/images/FONDO 4.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      min-height: 100vh;
      margin: 0;
    "
  >
    <Navbar
      logoSrc="/images/zelify_logo.png"
      colors={{
        text: "#054F8B",
        textHover: "#ffffff",
        highlightBg: "#00223E",
        highlightText: "#6AFF00",
        btnLightBg: "#E7EDF6",
        btnLightHoverBg: "#DAE4F1",
        btnLightText: "#004195",
        btnOutline: "#00223E",
        btnOutlineHover: "#ffffff",
        dropdownBg: "#ffffff",
        dropdownLink: "#1e2b3a",
        dropdownHoverBg: "#EEF3F9",
        radius: "22px",
      }}
      buttons={{
        first: { label: "Work with us", href: "/" },
        second: { label: "Bank access", href: "/" },
        third: { label: "EN", href: "/" },
      }}
    />
<ProductsPanel />
    <section class="hero">
      <div class="content">
        <span class="band">AML</span>

        <h1 class="title">
          Smart Risk.<br />
          Zero Blind Spots.
        </h1>

        <p class="description">
          Automated PEP, sanctions, and media screening built to expose financial risk
          before it strikes. Stay compliant, fight crime, and keep every transaction
          under control.
        </p>

        <div class="cta">
          <a href="/" class="btn">Let’s talk</a>
          <a href="/" class="btn">View API Docs</a>
        </div>
      </div>
    </section>
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  body {
    font-family: "NataSans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #0b132b;
  }

  .hero {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    padding: 6rem 8%;
  }

  .content {
    max-width: 640px;
    text-align: left;
    margin-left: 200px;    
    margin-right: 6%;     
  }

  .band {
    display: block;
    background: #183b86;
    color: #e9eef7;
    padding: 0.85rem 2rem;
    border-radius: 40px;
    font-weight: 800;
    letter-spacing: 0.3px;
    margin-bottom: 2rem;
    max-width: 550px;
  }

  .title {
    color: #0b132b;
    font-weight: 800;
    line-height: 1.1;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin: 0 0 1rem 0;
  }

  .description {
    color: #223547;
    font-size: 1.05rem;
    line-height: 1.65;
    max-width: 520px;
    margin: 0 0 1.8rem 0;
  }

  .cta {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .btn {
    background: #0f2236;
    color: #e7edf6;
    text-decoration: none;
    font-weight: 700;
    padding: 0.7rem 1.2rem;
    border-radius: 10px;
    font-size: 0.98rem;
    transition: background-color 0.2s ease, transform 0.15s ease;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
  }

  .btn:hover {
    background: #132c46;
    transform: translateY(-1px);
  }

  @media (max-width: 960px) {
    .hero { padding: 4rem 6%; }
    .content {
      max-width: 100%;
      margin: 0 auto;
      text-align: center;
    }
    .title { font-size: clamp(2rem, 6vw, 3rem); }
    .band { max-width: 100%; text-align: center; }
  }
</style>