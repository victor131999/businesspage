---
import Navbar from "../components/navbar.astro";
import ProductsPanel from "../components/productsPanel.astro";
import { AlaizaAssistant } from "../components/AlaizaAssistant";
import Footer from "../components/design-system/organisms/Footer.astro";
import "../styles/navbar.css";
---

<script>
  type Translation = {
    badge: string;
    title: string;
    description: string;
    ctaTalk: string;
    ctaDocs: string;
  };

  type Translations = {
    en: Translation;
    es: Translation;
  };

  const translations: Translations = {
    en: {
      badge: "Payments",
      title: "Unified Payment<br />Processing, Simplified.",
      description: "A unified payment processor that accepts multiple methods: cards, custom keys, or contactless options. Includes advanced features like recurring payments, express checkout, tokenization, and custom APIs for seamless integration.",
      ctaTalk: "Let's talk",
      ctaDocs: "View API Docs"
    },
    es: {
      badge: "Payments",
      title: "Procesamiento de Pagos<br />Unificado, Simplificado.",
      description: "Procesador de pagos unificado que acepta múltiples métodos: tarjetas, llaves personalizadas u opciones sin contacto. Incluye características avanzadas como pagos recurrentes, checkout express, tokenización y APIs personalizadas para integración sin problemas.",
      ctaTalk: "Hablemos",
      ctaDocs: "Ver documentación API"
    }
  };

  function updateContent(rawLang: string) {
    const lang = rawLang.toLowerCase() as keyof Translations;
    const content = translations[lang] || translations.en;
    
    const elements = {
      badge: document.querySelector('.band-text'),
      title: document.querySelector('.title'),
      description: document.querySelector('.description'),
      ctaTalk: document.querySelector('.cta a:first-child'),
      ctaDocs: document.querySelector('.cta a:last-child')
    };

    if (elements.badge) elements.badge.textContent = content.badge;
    if (elements.title) elements.title.innerHTML = content.title.replace(/\n/g, '<br>');
    if (elements.description) elements.description.textContent = content.description;
    if (elements.ctaTalk) elements.ctaTalk.textContent = content.ctaTalk;
    if (elements.ctaDocs) elements.ctaDocs.textContent = content.ctaDocs;
  }

  // Escuchar cambios de idioma desde el navbar
  window.addEventListener('ui:languagechange', ((event: Event) => {
    const customEvent = event as CustomEvent<{language: string}>;
    if (customEvent.detail?.language) {
      updateContent(customEvent.detail.language);
    }
  }) as EventListener);

  // Aplicar traducciones iniciales
  document.addEventListener('DOMContentLoaded', () => {
    const storedLang = localStorage.getItem('ui-language') || 'EN';
    updateContent(storedLang);
  });
</script>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png" />
    <title>Zelify Page 8 — Payments</title>
  </head>

  <body
    style="
      background-color: #081525;
      background-image: url('/images/FONDO 10.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      min-height: 100vh;
      margin: 0;
    "
  >
   <Navbar
      logoSrc="/images/zelify_logo2.png"
      colors={{
        text: "#ffffff",
        textHover: "#ffffff",
        highlightBg: "#6AFF00",
        highlightText: "#0b132b",
        btnLightBg: "#E7EDF6",
        btnLightHoverBg: "#DAE4F1",
        btnLightText: "#004195",
        btnOutline: "#E7EDF6",
        btnOutlineHover: "#ffffff",
        dropdownBg: "#ffffff",
        dropdownLink: "#1e2b3a",
        dropdownHoverBg: "#EEF3F9",
        radius: "22px",
      }}
      buttons={{
        first: { label: "Work with us", href: "/jobs" },
        second: { label: "Business access", href: "https://www.zelify.io/" },
        third: { label: "EN", href: "/" },
      }}
    />
    <ProductsPanel />

    <section class="hero">
      <div class="content">
        <div class="band">
          <span class="band-text">Payments</span>
        </div>

        <h1 class="title">
          Unified Payment<br />
          Processing, Simplified.
        </h1>

        <p class="description">
          A unified payment processor that accepts multiple methods: cards,
          custom keys, or contactless options. Includes advanced features like
          recurring payments, express checkout, tokenization, and custom APIs
          for seamless integration.
        </p>

        <div class="cta">
          <a href="/hablemos" class="btn">Let's talk</a>
          <a href="https://docs.zelify.com/servicios-financieros/payments" target="_blank" rel="noopener noreferrer" class="btn">View API Docs</a>
        </div>
      </div>
    </section>

    <!-- Footer (mismo que index) -->
    <Footer
      quickLinksTitle="Quick links"
      links={[
        { href: "", label: "Products", key: "products", dataI18n: "footer.products" },
        { href: "https://docs.zelify.com", label: "Developers", key: "developers", dataI18n: "footer.developers", openInNewTab: true },
        { href: "/blog", label: "Blog", key: "blog", dataI18n: "footer.blog" },
        { href: "/jobs", label: "Work with us", key: "workWithUs", dataI18n: "footer.workWithUs" },
        { href: "/about", label: "About us", key: "aboutUs", dataI18n: "footer.aboutUs" },
        { href: "/privacy", label: "Privacy policy", key: "privacyPolicy", dataI18n: "footer.privacyPolicy" },
      ]}
      legalText="Zelify is a technology platform currently in a development phase, not yet deployed or operational, and does not provide or process financial services directly; all financial operations are conducted exclusively through regulated third-party partners."
      copyrightText="© 2025 Zelify. All rights reserved."
      dataI18n={{ quicklinks: "footer.quicklinks", legal: "footer.legal", copyright: "footer.copyright" }}
    />
  </body>
  <AlaizaAssistant client:load />
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  body {
    font-family: "NataSans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #ffffff;
  }

  .hero {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: flex-start; 
    padding: 6rem 8%;
  }

  .content {
    text-align: left; 
    max-width: 600px;
    margin-left: clamp(5%, 8vw, 10%);
  }

  /* Banda (agrandada y más visible) */
  /* Banda (más grande y horizontalmente extendida) */
  .band {
  display: inline-block;
  background-color: #d9e0eb;
  padding: 0.8rem 2rem;
  border-radius: 25px;
  margin-bottom: 0.5rem;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
}



  .band-text {
    font-weight: 700;
    font-size: 1.1rem;
    color: #0b132b;
    letter-spacing: 0.3px;
  }

  .title {
    color: #6aff00;
    font-weight: 400;
    line-height: 1.15;
    font-size: clamp(2.4rem, 3.8vw, 3rem);
    margin: 1rem 0 1.2rem 0;
    letter-spacing: -0.3px;
    text-align: left;
  }

  .description {
    color: #bcd0e6;
    font-size: 1.15rem;
    line-height: 1.65;
    font-weight: 400;
    margin: 0 0 2rem 0;
    text-align: left;
  }

  .cta {
    display: flex;
    gap: 1rem;
    justify-content: flex-start;
    flex-wrap: wrap;
  }

  .btn {
    background: #6aff00;
    color: #0b132b;
    text-decoration: none;
    font-weight: 500;
    padding: 0.75rem 1.4rem;
    border-radius: 12px;
    font-size: 1rem;
    transition: background-color 0.2s ease, transform 0.15s ease;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
  }

  .btn:hover {
    background: #87ff4b;
    transform: translateY(-1px);
  }
</style>