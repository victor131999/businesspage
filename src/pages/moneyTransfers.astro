---
import Navbar from "../components/navbar.astro";
import ProductsPanel from "../components/productsPanel.astro";
import "../styles/navbar.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Zelify Page 6 — Transfers</title>
  </head>

  <body
    style="
      background-color: #0b2a15;
      background-image: url('/images/FONDO 8.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      min-height: 100vh;
      margin: 0;
    "
  >
    <Navbar
      logoSrc="/images/zelify_logo.png"
      colors={{
        text: "#0b132b",
        textHover: "#ffffff",
        highlightBg: "#D5DAE1",
        highlightText: "#0b132b",
        btnLightBg: "#00223E",
        btnLightHoverBg: "#DAE4F1",
        btnLightText: "#66FF00",
        btnOutline: "#00223E",
        btnOutlineHover: "#ffffff",
        dropdownBg: "#ffffff",
        dropdownLink: "#1e2b3a",
        dropdownHoverBg: "#EEF3F9",
        radius: "22px",
      }}
      buttons={{
        first: { label: "Work with us", href: "/" },
        second: { label: "Bank access", href: "/" },
        third: { label: "EN", href: "/" },
      }}
    />
    <ProductsPanel />

    <section class="hero">
      <div class="content">
        <h2 class="band-text">Transfers</h2>

        <h1 class="title">
          Instant Transfers<br />
          Within the Zelify<br />
          Ecosystem.
        </h1>

        <p class="description">
          Zelify Transfers enables real-time money movement between digital
          accounts, ensuring speed, security, and seamless integration across
          the entire platform.
        </p>

        <div class="cta">
          <a href="/" class="btn">Let’s talk</a>
          <a href="/" class="btn">View API Docs</a>
        </div>
      </div>
    </section>
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  body {
    font-family: "NataSans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #0b132b;
  }

  .hero {
    display: flex;
    align-items: center;
    justify-content: flex-end; /* 👈 contenido hacia la derecha */
    min-height: calc(100vh - 80px);
    padding: 6rem 6% 4rem 8%;
  }

  .content {
    max-width: 640px;
    text-align: left;
    position: relative;
    margin-right: 8%;
  }

 .band-text {
  display: inline-block;
  position: relative;
  transform: translate(0, 5.8rem); /* 👈 baja el texto a la mitad de la barra */
  left: 16.5rem; /* 👈 posición exacta a la derecha */
  font-weight: 800;
  font-size: 1.1rem;
  color: #ffffff;
  background: transparent;
  letter-spacing: 0.3px;
  margin-bottom: 2.8rem; /* 👈 separa bien del título */
}

.title {
  color: #0b132b;
  font-weight: 700;
  line-height: 1.22;
  font-size: clamp(2rem, 4vw, 3.1rem);
  margin-top: 4.5rem; /* 👈 más separación del band-text */
  margin-bottom: 1.4rem;
}

.description {
  color: #00223E;
  font-size: 1.05rem;
  line-height: 1.65;
  max-width: 540px;
  margin: 0 0 2.8rem 0;
}
  .cta {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .btn {
    background: #e7edf6;
    color: #0b2a15;
    font-weight: 700;
    text-decoration: none;
    padding: 0.8rem 1.4rem;
    border-radius: 10px;
    font-size: 1rem;
    transition: all 0.2s ease;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
  }

  .btn:hover {
    background: #d9e2ef;
    transform: translateY(-1px);
  }

  @media (max-width: 960px) {
    .hero {
      justify-content: center;
      padding: 4rem 2rem;
      text-align: center;
    }

    .content {
      margin: 0;
      text-align: center;
    }

    .cta {
      justify-content: center;
    }
  }
</style>