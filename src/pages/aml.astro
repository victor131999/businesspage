---
import Navbar3 from "../components/NavbarSimple.astro";
import ProductsPanel from "../components/productsPanel.astro";
import { AlaizaAssistant } from "../components/AlaizaAssistant";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/png"
      href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png"
    />
    <title>Zelify — Aml</title>
  </head>

  <body>
    <header class="auth-header">
      <Navbar3 />
      <ProductsPanel />
    </header>

    <main class="auth-main">
      <section class="auth-hero">
        <h1 class="auth-title">
          Cumplimiento AML<br />
          claro, ágil y efectivo.
        </h1>
        <p class="auth-description">
          Evalúa riesgo automáticamente con listas globales, PEP y medios
          adversos,<br />
          monitorea transacciones en tiempo real y aplica reglas dinámicas<br />
          para prevenir actividades ilícitas sin fricción operativa.
        </p>
        <div class="auth-cta">
          <form
            class="welcome-input-group"
            action="#"
            aria-label="Solicitar cotización"
            novalidate
          >
            <input
              class="welcome-input"
              type="email"
              name="email"
              placeholder="ingresa tu correo"
              aria-label="Ingresa tu correo"
              data-i18n-placeholder="home.welcome.email.placeholder"
              data-i18n-aria="home.welcome.email.aria"
            />
            <button class="welcome-quote-button" type="submit">cotizar</button>
          </form>
          <a
            href="https://www.zelify.com/clips"
            class="welcome-demo-button"
            target="_blank"
            rel="noopener noreferrer">demo</a
          >
        </div>
      </section>
    </main>

    <div class="auth-background-section">
      <div class="auth-background-overlay"></div>
      <div class="auth-background-image">
        <video class="auth-video" autoplay loop muted playsinline>
          <source
            src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/video/circlesmov.mp4"
            type="video/mp4"
          />
        </video>
      </div>

      <!-- Contenedor del dispositivo móvil -->
      <div class="device-container">
        <!-- Frame del iPhone -->
        <div class="device-frame-wrapper">
          <div class="device-frame">
            <!-- Pantalla del dispositivo -->
            <div class="device-screen">
              <!-- Status Bar con Dynamic Island -->
              <div class="device-status-bar">
                <div class="status-time">9:41</div>
                <div class="dynamic-island">
                  <div class="island-shape"></div>
                  <div class="island-speaker"></div>
                </div>
                <div class="status-icons">
                  <svg class="signal-icon" fill="none" viewBox="0 0 20 12">
                    <path
                      d="M1 8h2v2H1V8zm3-2h2v4H4V6zm3-2h2v6H7V4zm3-1h2v7h-2V3z"
                      fill="currentColor"></path>
                  </svg>
                  <div class="battery-icon">
                    <div class="battery-level"></div>
                  </div>
                </div>
              </div>

              <div class="device-content scan-mode">
                <!-- Header -->
                <div class="device-header">
                  <button class="device-back-btn">
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                    Atrás
                  </button>
                </div>

                <!-- Main Content -->
                <div class="scan-container">
                  <h2 class="scan-title">
                    <span class="highlight">Escaneando</span> tu rostro
                  </h2>

                  <div class="scanner-visual">
                    <div class="scanner-circle-border"></div>
                    <div class="scanner-face-container">
                      <video
                        src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/video/faceverification.mp4"
                        autoplay
                        playsinline
                        muted
                        loop
                        class="scan-face-img"
                        style="display: block; position: relative; z-index: 1; background-color: #ffffff;"
                      ></video>

                      <div class="scan-beam"></div>
                      <div class="scan-particle p1"></div>
                      <div class="scan-particle p2"></div>
                    </div>
                  </div>

                  <div class="scan-status-container">
                    <div class="status-gradient-overlay"></div>
                    <h3 class="status-title">Completando verificación</h3>
                    <p class="status-text">Validando en listas globales...</p>
                    <div class="status-progress-track">
                      <div class="status-progress-bar"></div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Home Indicator -->
              <div class="device-home-indicator"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sección de Seguridad Inteligente -->
    <section class="security-section">
      <div class="security-container">
        <h2 class="security-title">
          Zelify AML<br />
          detección temprana de riesgo.
        </h2>

        <div class="security-features">
          <!-- Feature 1: Evaluación de listas globales -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                ></path>
                <path d="M14 2v6h6"></path>
                <path d="M16 13H8"></path>
                <path d="M16 17H8"></path>
                <path d="M10 9H8"></path>
                <circle cx="19" cy="5" r="1.5" fill="currentColor"></circle>
                <path d="M19 4v2M19 6h-1M19 6h1" stroke-width="1"></path>
              </svg>
            </div>
            <h3 class="feature-title">Evaluación de listas globales</h3>
            <p class="feature-description">
              Verificaciones automáticas contra sanciones, PEP y listas de
              observación internacionales.
            </p>
          </div>

          <!-- Feature 2: Verificación de listas globales -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M12 1v4M12 19v4M1 12h4M19 12h4"></path>
              </svg>
            </div>
            <h3 class="feature-title">Verificación de listas globales</h3>
            <p class="feature-description">
              Cruce continuo con OFAC, ONU, UE, Interpol y FinCEN para detección
              temprana.
            </p>
          </div>

          <!-- Feature 3: Verificación de listas nacionales PEP -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <circle cx="12" cy="12" r="3" fill="currentColor" opacity="0.3"
                ></circle>
                <path d="M9 12l2 2 4-4" stroke-width="2"></path>
              </svg>
            </div>
            <h3 class="feature-title">Verificación de listas nacionales PEP</h3>
            <p class="feature-description">
              Identifica personas políticamente expuestas según normativas
              locales.
            </p>
          </div>

          <!-- Feature 4: Monitoreo y operaciones -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="12" r="6"></circle>
                <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
                <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
                <path
                  d="M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"
                ></path>
              </svg>
            </div>
            <h3 class="feature-title">Monitoreo y operaciones</h3>
            <p class="feature-description">
              Supervisa transacciones sospechosas con reglas dinámicas y
              perfiles de riesgo.
            </p>
          </div>

          <!-- Feature 5: Medios adversos e inteligencia de riesgo -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
                <path d="M12 11v6M9 14h6"></path>
                <path
                  d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                  opacity="0.3"></path>
                <path d="M9 12l2 2 4-4" stroke-width="2"></path>
              </svg>
            </div>
            <h3 class="feature-title">
              Medios adversos e inteligencia de riesgo
            </h3>
            <p class="feature-description">
              Analiza noticias y reportes públicos para riesgos reputacionales o
              legales.
            </p>
          </div>

          <!-- Feature 6: Evaluación de listas internas -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="12" r="6"></circle>
                <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
                <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
                <path d="M8 8l8 8M16 8l-8 8" stroke-width="2"></path>
              </svg>
            </div>
            <h3 class="feature-title">Evaluación de listas internas</h3>
            <p class="feature-description">
              Integra tus listas de control y políticas internas dentro del
              flujo AML.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Control Total -->
    <section class="control-section">
      <div class="control-container">
        <div class="control-divider"></div>
        <h2 class="control-title">Control total de cumplimiento AML</h2>

        <div class="control-features">
          <!-- Feature 1: Evaluación de listas globales -->
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1563013544-824ae1b704d3?w=800&h=500&fit=crop&q=80"
                    alt="Evaluación de listas globales"
                  />
                </div>
                <h3 class="control-feature-title">
                  Evaluación de listas globales
                </h3>
                <p class="control-feature-description">
                  Cruce automático contra listas internacionales para detectar
                  alertas relevantes.
                </p>
                <button class="control-feature-btn" data-feature="global-lists">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">
                  Beneficios de listas globales
                </h3>
                <ul class="control-feature-benefits">
                  <li>Detección temprana de coincidencias</li>
                  <li>Alertas por riesgo regulatorio</li>
                  <li>Historial de evaluaciones</li>
                  <li>Filtros y reglas por país</li>
                  <li>Reducción de falsos positivos</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="global-lists"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Feature 2: Monitoreo y operaciones -->
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?w=800&h=500&fit=crop&q=80"
                    alt="Monitoreo y operaciones"
                  />
                </div>
                <h3 class="control-feature-title">Monitoreo y operaciones</h3>
                <p class="control-feature-description">
                  Supervisión continua de alertas y casos con trazabilidad
                  operativa.
                </p>
                <button class="control-feature-btn" data-feature="monitoring">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Beneficios de monitoreo</h3>
                <ul class="control-feature-benefits">
                  <li>Alertas en tiempo real</li>
                  <li>Gestión de casos centralizada</li>
                  <li>Flujos de aprobación</li>
                  <li>Historial de decisiones</li>
                  <li>Panel operativo unificado</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="monitoring"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Feature 3: Medios adversos e inteligencia de riesgo -->
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1524661135-423995f22d0b?w=800&h=500&fit=crop&q=80"
                    alt="Medios adversos e inteligencia de riesgo"
                  />
                </div>
                <h3 class="control-feature-title">
                  Medios adversos e inteligencia de riesgo
                </h3>
                <p class="control-feature-description">
                  Análisis de señales públicas para identificar riesgo
                  reputacional.
                </p>
                <button
                  class="control-feature-btn"
                  data-feature="adverse-media"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">
                  Beneficios de inteligencia
                </h3>
                <ul class="control-feature-benefits">
                  <li>Detección de noticias de riesgo</li>
                  <li>Clasificación por severidad</li>
                  <li>Contexto y trazabilidad</li>
                  <li>Alertas configurables</li>
                  <li>Reducción de exposición reputacional</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="adverse-media"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Feature 4: Evaluación de listas internas -->
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=800&h=500&fit=crop&q=80"
                    alt="Evaluación de listas internas"
                  />
                </div>
                <h3 class="control-feature-title">
                  Evaluación de listas internas
                </h3>
                <p class="control-feature-description">
                  Comparación contra listas propias para mayor control y
                  cumplimiento.
                </p>
                <button
                  class="control-feature-btn"
                  data-feature="internal-lists"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">
                  Beneficios de listas internas
                </h3>
                <ul class="control-feature-benefits">
                  <li>Bloqueos y whitelists</li>
                  <li>Reglas por segmento</li>
                  <li>Actualización inmediata</li>
                  <li>Auditoría interna</li>
                  <li>Control total del riesgo</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="internal-lists"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Contacto -->
    <section class="contact-section">
      <div class="contact-container">
        <div class="contact-content">
          <!-- Texto izquierdo -->
          <div class="contact-text">
            <h2 class="contact-title">
              Empieza hoy<br />
              y protege tu<br />
              plataforma.
            </h2>
          </div>

          <!-- Formulario derecho -->
          <div class="contact-form-wrapper">
            <div class="contact-form-card">
              <h3 class="contact-form-title">Habla con nuestro equipo</h3>

              <form class="contact-form" id="contactForm">
                <div class="form-row">
                  <div class="form-group">
                    <input
                      type="text"
                      id="nombres"
                      placeholder="Nombres"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <input
                      type="text"
                      id="apellidos"
                      placeholder="Apellidos"
                      required
                    />
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <input
                      type="text"
                      id="compania"
                      placeholder="Nombre de la compañía"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <input
                      type="email"
                      id="email"
                      placeholder="Email de la compañía"
                      required
                    />
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <select id="pais" required>
                      <option value="">País</option>
                      <option value="mx">México</option>
                      <option value="co">Colombia</option>
                      <option value="ar">Argentina</option>
                      <option value="cl">Chile</option>
                      <option value="pe">Perú</option>
                      <option value="es">España</option>
                      <option value="us">Estados Unidos</option>
                    </select>
                    <svg
                      class="select-arrow"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </div>
                  <div class="form-group">
                    <input
                      type="tel"
                      id="telefono"
                      placeholder="Teléfono (opcional)"
                    />
                  </div>
                </div>

                <p class="contact-legal">
                  Al enviar este formulario, aceptas nuestros <a href="#"
                    >Términos de Servicio</a
                  > y <a href="#">Política de Privacidad</a>.
                </p>

                <button type="submit" class="contact-submit-btn">
                  Hablemos
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de FAQ -->
    <section class="faq-section">
      <div class="faq-container">
        <h2 class="faq-title">Preguntas frecuentes</h2>

        <div class="faq-list">
          <!-- FAQ 1 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="1">
              <span>¿Qué funcionalidades incluye el producto?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Nuestro producto incluye autenticación avanzada con biometría,
                registro personalizable de usuarios, validación de email y
                teléfono, información detallada del dispositivo, geolocalización
                estratégica, detección temprana de fraudes, y un SDK de
                integración sencillo para incorporar todas estas funcionalidades
                en una sola línea de código.
              </p>
            </div>
          </div>

          <!-- FAQ 2 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="2">
              <span>¿Es seguro usar biometría y doble factor?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
