---
import Navbar3 from "../components/NavbarSimple.astro";
import ProductsPanel from "../components/productsPanel.astro";
import { AlaizaAssistant } from "../components/AlaizaAssistant";
import DeviceFrame from "../components/design-system/organisms/device-frame/DeviceFrame.astro";
import EmailQuoteForm from "../components/design-system/molecules/EmailQuoteForm.astro";
import CtaGroup from "../components/design-system/molecules/CtaGroup.astro";
import Button from "../components/design-system/atoms/Button.astro";
import ContactFormHubSpot from "../components/design-system/organisms/ContactFormHubSpot.astro";
import QuoteModalHubSpot from "../components/design-system/organisms/QuoteModalHubSpot.astro";
import Footer from "../components/design-system/organisms/Footer.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/png"
      href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png"
    />
    <title>Zelify — Aml</title>
  </head>

  <body>
    <header class="auth-header">
      <Navbar3 />
      <ProductsPanel />
    </header>

    <main class="auth-main">
      <section class="auth-hero">
        <h1 class="auth-title">
          Prevención del lavado<br />
          para un mayor cumplimiento
        </h1>
        <p class="auth-description">
          Evalúa riesgo automáticamente con listas globales, PEP y medios
          adversos,<br />
          monitorea transacciones en tiempo real y aplica reglas dinámicas<br />
          para prevenir actividades ilícitas.
        </p>
        <CtaGroup class="auth-cta">
          <EmailQuoteForm
            dataI18nPlaceholder="home.welcome.email.placeholder"
            dataI18nAria="home.welcome.email.aria"
            buttonLabel="Let's talk"
          />
          <Button
            href="https://demo.zelify.com"
            variant="secondary"
            class="welcome-demo-button"
            target="_blank"
            rel="noopener noreferrer"
          >
            Demo
          </Button>
        </CtaGroup>
      </section>
    </main>

    <div class="auth-background-section">
      <div class="auth-background-overlay"></div>
      <div class="auth-background-image">
        <video class="auth-video" autoplay loop muted playsinline>
          <source
            src="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/background_videos/aml.mp4"
            type="video/mp4"
          />
        </video>
      </div>

      <!-- Contenedor del dispositivo móvil -->
      <!-- Contenedor del dispositivo móvil -->
      <div class="device-container">
        <DeviceFrame tall={true}>
          <div class="device-content scan-mode">
            <!-- Header -->
            <div class="device-header">
              <button class="device-back-btn">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                <span id="aml-back-text">Atrás</span>
              </button>
            </div>

            <!-- Main Content -->
            <div class="scan-container">
              <h2 class="scan-title" id="aml-scan-title">
                <span class="highlight" id="aml-scan-highlight">Escaneando</span
                >
                <span id="aml-scan-suffix">tu rostro</span>
              </h2>

              <div class="scanner-visual">
                <div class="scanner-circle-border"></div>
                <div class="scanner-face-container">
                  <video
                    src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/video/faceverification.mp4"
                    autoplay
                    playsinline
                    muted
                    loop
                    class="scan-face-img"
                    style="display: block; position: relative; z-index: 1; background-color: #ffffff;"
                  ></video>

                  <div class="scan-beam"></div>
                  <div class="scan-particle p1"></div>
                  <div class="scan-particle p2"></div>
                </div>
              </div>

              <div class="scan-status-container">
                <div class="status-gradient-overlay"></div>
                <h3 class="status-title" id="aml-status-title">
                  Completando verificación
                </h3>
                <p class="status-text" id="aml-status-text">
                  Validando en listas globales...
                </p>
                <div class="status-progress-track">
                  <div class="status-progress-bar"></div>
                </div>
              </div>
            </div>
          </div>
        </DeviceFrame>
      </div>
    </div>

    <!-- Sección de Seguridad Inteligente -->
    <section class="security-section">
      <div class="security-container">
        <h2 class="security-title">
          Zelify AML<br />
          detección temprana de riesgo.
        </h2>

        <div class="security-features">
          <!-- Feature 1: Evaluación de listas globales -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                ></path>
                <path d="M14 2v6h6"></path>
                <path d="M16 13H8"></path>
                <path d="M16 17H8"></path>
                <path d="M10 9H8"></path>
                <circle cx="19" cy="5" r="1.5" fill="currentColor"></circle>
                <path d="M19 4v2M19 6h-1M19 6h1" stroke-width="1"></path>
              </svg>
            </div>
            <h3 class="feature-title">Evaluación de listas globales</h3>
            <p class="feature-description">
              Verificaciones automáticas contra sanciones, PEP y listas de
              observación internacionales.
            </p>
          </div>

          <!-- Feature 2: Verificación de listas globales -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M12 1v4M12 19v4M1 12h4M19 12h4"></path>
              </svg>
            </div>
            <h3 class="feature-title">Verificación de listas globales</h3>
            <p class="feature-description">
              Cruce continuo con OFAC, ONU, UE, Interpol y FinCEN para detección
              temprana.
            </p>
          </div>

          <!-- Feature 3: Verificación de listas nacionales PEP -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <circle cx="12" cy="12" r="3" fill="currentColor" opacity="0.3"
                ></circle>
                <path d="M9 12l2 2 4-4" stroke-width="2"></path>
              </svg>
            </div>
            <h3 class="feature-title">Verificación de listas nacionales PEP</h3>
            <p class="feature-description">
              Identifica personas políticamente expuestas según normativas
              locales.
            </p>
          </div>

          <!-- Feature 4: Monitoreo y operaciones -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="12" r="6"></circle>
                <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
                <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
                <path
                  d="M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"
                ></path>
              </svg>
            </div>
            <h3 class="feature-title">Monitoreo y operaciones</h3>
            <p class="feature-description">
              Supervisa transacciones sospechosas con reglas dinámicas y
              perfiles de riesgo.
            </p>
          </div>

          <!-- Feature 5: Medios adversos e inteligencia de riesgo -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
                <path d="M12 11v6M9 14h6"></path>
                <path
                  d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                  opacity="0.3"></path>
                <path d="M9 12l2 2 4-4" stroke-width="2"></path>
              </svg>
            </div>
            <h3 class="feature-title">
              Medios adversos e inteligencia de riesgo
            </h3>
            <p class="feature-description">
              Analiza noticias y reportes públicos para riesgos reputacionales o
              legales.
            </p>
          </div>

          <!-- Feature 6: Evaluación de listas internas -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="12" r="6"></circle>
                <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
                <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
                <path d="M8 8l8 8M16 8l-8 8" stroke-width="2"></path>
              </svg>
            </div>
            <h3 class="feature-title">Evaluación de listas internas</h3>
            <p class="feature-description">
              Integra tus listas de control y políticas internas dentro del
              flujo AML.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Control Total -->
    <section class="control-section">
      <div class="control-container">
        <div class="control-divider"></div>
        <h2 class="control-title">Control total de cumplimiento AML</h2>

        <div class="control-features">
          <!-- Feature 1: Evaluación de listas globales -->
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <video
                    src="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/image-products/aml/AML+01.mp4"
                    alt="Evaluación de listas globales"
                    autoplay
                    loop
                    muted
                    playsinline
                    style="width: 100%; height: 100%; object-fit: cover; display: block;"
                  ></video>
                </div>
                <h3 class="control-feature-title">
                  Evaluación de listas globales
                </h3>
                <p class="control-feature-description">
                  Cruce automático contra listas internacionales para detectar
                  alertas relevantes.
                </p>
                <button class="control-feature-btn" data-feature="global-lists">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">
                  Beneficios de listas globales
                </h3>
                <ul class="control-feature-benefits">
                  <li>Detección temprana de coincidencias</li>
                  <li>Alertas por riesgo regulatorio</li>
                  <li>Historial de evaluaciones</li>
                  <li>Filtros y reglas por país</li>
                  <li>Reducción de falsos positivos</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="global-lists"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Feature 2: Monitoreo y operaciones -->
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <video
                    src="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/image-products/aml/AML+02.mp4"
                    alt="Monitoreo y operaciones"
                    autoplay
                    loop
                    muted
                    playsinline
                    style="width: 100%; height: 100%; object-fit: cover; display: block;"
                  ></video>
                </div>
                <h3 class="control-feature-title">Monitoreo y operaciones</h3>
                <p class="control-feature-description">
                  Supervisión continua de alertas y casos con trazabilidad
                  operativa.
                </p>
                <button class="control-feature-btn" data-feature="monitoring">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Beneficios de monitoreo</h3>
                <ul class="control-feature-benefits">
                  <li>Alertas en tiempo real</li>
                  <li>Gestión de casos centralizada</li>
                  <li>Flujos de aprobación</li>
                  <li>Historial de decisiones</li>
                  <li>Panel operativo unificado</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="monitoring"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Feature 3: Medios adversos e inteligencia de riesgo -->
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <video
                    src="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/image-products/aml/AML+03.mp4"
                    alt="Medios adversos e inteligencia de riesgo"
                    autoplay
                    loop
                    muted
                    playsinline
                    style="width: 100%; height: 100%; object-fit: cover; display: block;"
                  ></video>
                </div>
                <h3 class="control-feature-title">
                  Medios adversos e inteligencia de riesgo
                </h3>
                <p class="control-feature-description">
                  Análisis de señales públicas para identificar riesgo
                  reputacional.
                </p>
                <button
                  class="control-feature-btn"
                  data-feature="adverse-media"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">
                  Beneficios de inteligencia
                </h3>
                <ul class="control-feature-benefits">
                  <li>Detección de noticias de riesgo</li>
                  <li>Clasificación por severidad</li>
                  <li>Contexto y trazabilidad</li>
                  <li>Alertas configurables</li>
                  <li>Reducción de exposición reputacional</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="adverse-media"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Feature 4: Evaluación de listas internas -->
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <video
                    src="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/image-products/aml/AML+04.mp4"
                    alt="Evaluación de listas internas"
                    autoplay
                    loop
                    muted
                    playsinline
                    style="width: 100%; height: 100%; object-fit: cover; display: block;"
                  ></video>
                </div>
                <h3 class="control-feature-title">
                  Evaluación de listas internas
                </h3>
                <p class="control-feature-description">
                  Comparación contra listas propias para mayor control y
                  cumplimiento.
                </p>
                <button
                  class="control-feature-btn"
                  data-feature="internal-lists"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">
                  Beneficios de listas internas
                </h3>
                <ul class="control-feature-benefits">
                  <li>Bloqueos y whitelists</li>
                  <li>Reglas por segmento</li>
                  <li>Actualización inmediata</li>
                  <li>Auditoría interna</li>
                  <li>Control total del riesgo</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="internal-lists"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Contacto -->
    <ContactFormHubSpot headline="Comienza a construir el banco del futuro, hoy." formTitle="Habla con nuestro equipo" />

    <!-- Sección de FAQ -->
    <section class="faq-section">
      <div class="faq-container">
        <h2 class="faq-title">Preguntas frecuentes</h2>

        <div class="faq-list">
          <!-- FAQ 1 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="1">
              <span>¿Qué es la evaluación de listas globales?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Detecta riesgos de forma temprana mediante verificaciones
                automáticas contra listas internacionales de sanciones,
                personas políticamente expuestas (PEP) y observación (OFAC,
                ONU, UE, Interpol, FinCEN, entre otras), ayudando a prevenir
                relaciones con usuarios o entidades de alto riesgo antes de que
                impacten al negocio.
              </p>
            </div>
          </div>

          <!-- FAQ 2 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="2">
              <span>¿Qué incluye el monitoreo y operaciones?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Supervisa transacciones y comportamientos financieros
                sospechosos en tiempo real, aplicando reglas dinámicas y
                puntuaciones de riesgo automatizadas según el perfil del
                usuario. Incluye monitoreo de transacciones, obtención de
                alertas, actualización y consulta del perfil de riesgo.
              </p>
            </div>
          </div>

          <!-- FAQ 3 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="3">
              <span>¿Qué son los medios adversos e inteligencia de riesgo?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Analiza noticias, reportes y menciones públicas relevantes para
                identificar posibles riesgos reputacionales, legales o
                regulatorios asociados a usuarios o entidades. Incluye
                verificación de medios adversos, inteligencia de riesgo,
                monitoreo de reputación y consulta de estado de reputación e
                inteligencia de riesgo.
              </p>
            </div>
          </div>

          <!-- FAQ 4 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="4">
              <span>¿Puedo usar mis propias listas de control?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Sí. La evaluación de listas internas permite a las
                organizaciones incorporar sus propias listas de control y
                políticas internas dentro del proceso AML, agregando una capa
                adicional de seguridad y validación sobre sus operaciones.
              </p>
            </div>
          </div>

          <!-- FAQ 5 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="5">
              <span>¿Cómo se integra el SDK de AML?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
