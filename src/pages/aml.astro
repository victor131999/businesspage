      Object.entries(t.contact.countries).forEach(([code, country]) => {
        const option = document.createElement("option");
        option.value = code;
        option.textContent = country;
        paisSelect.appendChild(option);
      });
      paisSelect.value = currentValue;
    }
    if (telefonoInput)
      telefonoInput.placeholder = t.contact.placeholders.telefono;

    if (contactLegal) {
      contactLegal.innerHTML = `
        ${t.contact.legal} <a href="#">${t.contact.terms}</a> y <a href="#">${t.contact.privacy}</a>.
      `;
    }
    if (submitBtn instanceof HTMLInputElement) {
      submitBtn.value = t.contact.submit;
    } else if (submitBtn) {
      submitBtn.textContent = t.contact.submit;
    }

    // CTA section
    const ctaTitle = document.querySelector(".cta-title");
    const ctaBtn = document.querySelector(".cta-button");
    if (ctaTitle) ctaTitle.innerHTML = t.cta.title;
    if (ctaBtn) ctaBtn.textContent = t.cta.button;

    // FAQ section
    const faqTitle = document.querySelector(".faq-title");
    if (faqTitle) faqTitle.textContent = t.faqTitle;

    const faqItems = document.querySelectorAll(".faq-item");
    faqItems.forEach((item, index) => {
      const questionSpan = item.querySelector(".faq-question span");
      const answerP = item.querySelector(".faq-answer p");
      if (questionSpan && t.faqItems[index])
        questionSpan.textContent = t.faqItems[index].question;
      if (answerP && t.faqItems[index])
        answerP.textContent = t.faqItems[index].answer;
    });
  }

  const detectBrowserLanguage = () => {
    const locale =
      (navigator.languages && navigator.languages[0]) ||
      navigator.language ||
      "";
    return locale.toLowerCase().startsWith("es") ? "ES" : "EN";
  };

  // Event listeners
  window.addEventListener("ui:languagechange", (e) => {
    updateAmlContent(e.detail.language);
  });

  document.addEventListener("DOMContentLoaded", () => {
    const storedLanguage = localStorage.getItem("ui-language");
    const initialLang =
      window.__uiLanguage || storedLanguage || detectBrowserLanguage();
    updateAmlContent(initialLang);
  });

  // FAQ Accordion
  document.querySelectorAll(".faq-question").forEach((question) => {
    question.addEventListener("click", () => {
      const faqItem = question.closest(".faq-item");
      if (!faqItem) return;
      const isActive = faqItem.classList.contains("active");

      // Cerrar todos los demás items
      document.querySelectorAll(".faq-item").forEach((item) => {
        item.classList.remove("active");
      });
      // Abrir el item clickeado si no estaba activo

      if (!isActive) {
        faqItem.classList.add("active");
      }
    });
  });
</script>
