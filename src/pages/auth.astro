---
import Navbar from "../components/navbar.astro";
import ProductsPanel from "../components/productsPanel.astro";
import "../styles/navbar.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Zelify — Auth</title>
  </head>

  <body
    style="
      background-color: #e8ecf3;
      background-image: url('/images/FONDO 2.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      min-height: 100vh;
      margin: 0;
    "
  >
    <Navbar
      logoSrc="/images/zelify_logo.png"
      colors={{
        text: "#004195",
        textHover: "#002B62",
        highlightBg: "#6AFF00",
        highlightText: "#0b132b",
        btnLightBg: "#E7EDF6",
        btnLightHoverBg: "#DAE4F1",
        btnLightText: "#004195",
        btnOutline: "#E7EDF6",
        btnOutlineHover: "#ffffff",
        dropdownBg: "#ffffff",
        dropdownLink: "#1e2b3a",
        dropdownHoverBg: "#EEF3F9",
        radius: "22px",
      }}
      buttons={{
        first: { label: "Work with us", href: "/" },
        second: { label: "Bank access", href: "/" },
        third: { label: "EN", href: "/" },
      }}
    />
    <ProductsPanel />
    <section class="hero">
      <div class="content">
        <span class="badge">Auth</span>

        <h1 class="title">
          Allows secure user registration, authentication, and authorization in
          web and mobile applications.
        </h1>

        <p class="description">
          managing login with proprietary or third-party credentials (Google,
          Apple, Facebook, etc.).
        </p>

        <div class="cta">
          <a href="/" class="btn btn-solid">Let’s talk</a>
          <a href="/" class="btn btn-solid">View API Docs</a>
        </div>
      </div>
    </section>
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  body {
    font-family:
      "NataSans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    color: #0b132b;
  }

  .hero {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-height: 100vh;
    padding: 6rem 8%;
    position: relative;
  }

  .content {
    max-width: 620px;
    background: transparent;
  }
  .badge {
    display: block;
    width: 100%;
    max-width: 920px;
    background: #6aff00;
    color: #0b132b;
    padding: 0.8rem 2rem;
    border-radius: 25px;
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 2rem;
    text-align: left;
    box-shadow: 0 0 12px rgba(184, 255, 42, 0.4);
  }

  .title {
    font-size: clamp(2rem, 2.5vw, 2.9rem);
    line-height: 1;
    color: #004195;
    margin: 0 0 1.5rem 0;
    font-weight: 400;
    text-align: left;
    max-width: 750px;
  }

  .description {
    color: #004195;
    font-size: 1.1rem;
    line-height: 1.65;
    max-width: 600px;
    margin: 0 0 2.5rem 0;
    text-align: left;
  }

  .cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.4rem;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.95rem;
    transition:
      transform 0.15s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-solid {
    background: #6aff00;
    color: #0b132b;
  }

  .btn-solid:hover {
    background: #caff4a;
  }

  .btn-ghost:hover {
    background: rgba(184, 255, 42, 0.15);
  }

  @media (max-width: 900px) {
    .hero {
      justify-content: center;
      text-align: center;
      padding: 4rem 2rem;
    }

    .content {
      max-width: 90%;
    }

    .cta {
      justify-content: center;
    }
  }
</style>
