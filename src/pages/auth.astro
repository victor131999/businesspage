---
import Navbar from "../components/navbar.astro";
import ProductsPanel from "../components/productsPanel.astro";
import "../styles/navbar.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Zelify — Auth</title>
  </head>

  <body>
    <Navbar
      logoSrc="/images/zelify_logo.png"
      colors={{
        text: "#004195",
        textHover: "#002B62",
        highlightBg: "#6AFF00",
        highlightText: "#0b132b",
        btnLightBg: "#E7EDF6",
        btnLightHoverBg: "#DAE4F1",
        btnLightText: "#004195",
        btnOutline: "#E7EDF6",
        btnOutlineHover: "#ffffff",
        dropdownBg: "#ffffff",
        dropdownLink: "#1e2b3a",
        dropdownHoverBg: "#EEF3F9",
        radius: "22px",
      }}
      buttons={{
        first: { label: "Work with us", href: "/" },
        second: { label: "Bank access", href: "/" },
        third: { label: "EN", href: "/" },
      }}
    />
    <ProductsPanel />
    <section class="hero">
      <div class="content">
        <span class="badge">Auth</span>

        <h1 class="title">
          Allows secure user registration,<br />authentication, and authorization<br />in web and mobile applications.
        </h1>

        <p class="description">
          managing login with proprietary or third-party credentials (Google,
          Apple, Facebook, etc.).
        </p>

        <div class="cta">
          <a href="/hablemos" class="btn btn-solid">Let's talk</a>
          <a href="https://documentations.zelify.com/zelify-servicios-financieros/zelify-auth" target="_blank" rel="noopener noreferrer" class="btn btn-solid">View API Docs</a>
        </div>
      </div>
    </section>
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    width: 100%;
    overflow: hidden;
  }

  body {
    font-family:
      "NataSans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    color: #0b132b;
    background-color: #e8ecf3;
    background-image: url('/images/FONDO 2.jpg');
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    background-attachment: fixed;
    height: 100vh;
    width: 100vw;
    overflow-x: hidden;
    overflow-y: hidden;
  }

  .hero {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    height: calc(100vh - 80px);
    max-height: calc(100vh - 80px);
    padding: 0 8% 0 15%;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  .content {
    max-width: 900px;
    width: 100%;
    background: transparent;
  }
  .badge {
    display: inline-block;
    max-width: 500px;
    background: #6aff00;
    color: #0b132b;
    padding: 0.8rem 2rem;
    border-radius: 25px;
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 2rem;
    text-align: left;
    box-shadow: 0 0 12px rgba(184, 255, 42, 0.4);
  }

  .title {
    font-size: clamp(2rem, 2.5vw, 2.9rem);
    line-height: 1.4;
    color: #004195;
    margin: 0 0 1.5rem 0;
    font-weight: 400;
    text-align: left;
    max-width: 900px;
    width: 100%;
  }

  .description {
    color: #004195;
    font-size: 1.1rem;
    line-height: 1.65;
    max-width: 600px;
    margin: 0 0 2.5rem 0;
    text-align: left;
  }

  .cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.4rem;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.95rem;
    transition:
      transform 0.15s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-solid {
    background: #6aff00;
    color: #0b132b;
  }

  .btn-solid:hover {
    background: #caff4a;
  }

  .btn-ghost:hover {
    background: rgba(184, 255, 42, 0.15);
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .hero {
      padding: 0 10% 0 12%;
    }

    .content {
      max-width: 85%;
    }

    .title {
      font-size: clamp(1.8rem, 2.2vw, 2.5rem);
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    html,
    body {
      overflow: auto;
      height: auto;
      min-height: 100vh;
    }

    body {
      overflow-y: auto;
      background-attachment: scroll;
    }

    .hero {
      min-height: calc(100vh - 80px);
      height: auto;
      justify-content: center;
      text-align: center;
      padding: 2rem 1.5rem;
      align-items: flex-start;
    }

    .content {
      max-width: 100%;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .badge {
      max-width: 280px;
      margin: 0 auto 2rem;
      text-align: center;
    }

    .title {
      font-size: 2rem;
      line-height: 1.3;
      margin-bottom: 1.5rem;
      text-align: center;
      max-width: 100%;
    }

    .description {
      font-size: 1rem;
      line-height: 1.6;
      margin-bottom: 2rem;
      max-width: 100%;
      text-align: center;
      padding: 0 1rem;
    }

    .cta {
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .btn {
      font-size: 0.9rem;
      padding: 0.75rem 1.5rem;
      width: fit-content;
    }
  }

  /* Small mobile */
  @media (max-width: 480px) {
    .hero {
      padding: 1rem 1rem;
      padding-top: 1rem;
    }

    .content {
      padding: 0;
    }

    .badge {
      max-width: 200px;
      padding: 0.7rem 1.5rem;
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }

    .title {
      font-size: 1.75rem;
      line-height: 1.25;
      margin-bottom: 1rem;
      padding: 0 0.5rem;
    }

    .description {
      font-size: 0.95rem;
      padding: 0 0.5rem;
      margin-bottom: 1.5rem;
    }

    .btn {
      font-size: 0.85rem;
      padding: 0.65rem 1.3rem;
      width: 100%;
      max-width: 280px;
    }

    .cta {
      width: 100%;
      align-items: center;
    }
  }
</style>
