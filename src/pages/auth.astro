    min-height: 0;
  }

  .device-card::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
  }

  .auth-phone-card {
    width: 100%;
    background: transparent;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
    position: relative;
  }

  /* Home Indicator */
  .device-home-indicator {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    width: 128px;
    height: 4px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.3);
    flex-shrink: 0;
  }

  .phone-card-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .phone-card-dots .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d0d0d0;
    transition: background 0.3s ease;
  }

  .phone-card-dots .dot.active {
    background: #213f8c;
  }

  .phone-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0a203f;
    margin: 0 0 0.5rem 0;
    text-align: center;
  }

  .phone-card-description {
    font-size: 0.75rem;
    color: #6b7280;
    margin: 0 0 1rem 0;
    text-align: center;
    line-height: 1.4;
  }

  .btn-google {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border: 1px solid #e5e7eb;
    background: #f9fafb;
    border-radius: 12px;
    padding: 0.75rem 1.25rem;
    font-weight: 500;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-bottom: 1rem;
    color: #0a203f;
  }

  .btn-google:hover {
    background: #f3f4f6;
    border-color: #d1d5db;
  }

  .phone-card-divider {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: #e5e7eb;
  }

  .divider-text {
    font-size: 0.75rem;
    color: #6b7280;
    font-weight: 500;
    white-space: nowrap;
  }

  .phone-card-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-field label {
    font-size: 0.75rem;
    font-weight: 500;
    color: #374151;
  }

  .form-field .required {
    color: #ef4444;
    margin-left: 2px;
  }

  .form-field input {
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 0.625rem 0.875rem;
    font-size: 0.875rem;
    outline: none;
    background: #f9fafb;
    color: #0a203f;
    font-family: inherit;
    transition: border-color 0.2s ease;
  }

  .form-field input:focus {
    border-color: #213f8c;
    background: #ffffff;
  }

  .form-field input.field-error {
    border-color: #ef4444;
    background: #fef2f2;
  }

  .form-field input.field-error:focus {
    border-color: #ef4444;
    background: #fef2f2;
  }

  .field-error-message {
    display: none;
    margin-top: 0.25rem;
    font-size: 0.7rem;
    color: #ef4444;
  }

  .form-field input::placeholder {
    color: #9ca3af;
  }

  .otp-input.otp-verifying {
    border-color: #213f8c;
    animation: otp-pulse 1s ease-in-out infinite;
  }

  .otp-input.otp-success {
    border-color: #10b981;
    background: #f0fdf4;
  }

  .otp-input.otp-error {
    border-color: #ef4444;
    background: #fef2f2;
    animation: otp-shake 0.5s ease-in-out;
  }

  @keyframes otp-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.6;
    }
  }

  @keyframes otp-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-4px);
    }
    75% {
      transform: translateX(4px);
    }
  }

  .btn-continuar {
    position: relative;
    border: none;
    background: linear-gradient(
      to right,
      #213f8c 0%,
      #1a2f6b 40%,
      #0f1f4d 70%,
      #0a203f 100%
    );
    color: #ffffff;
    border-radius: 12px;
    padding: 0.85rem 1.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
    margin-top: 0.5rem;
    overflow: hidden;
    box-shadow: 0 4px 14px 0 rgba(33, 63, 140, 0.4);
    animation:
      cta-pulse-glow 2s ease-in-out infinite,
      cta-button-pulse 2.5s ease-in-out infinite;
  }

  .btn-continuar::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 12px;
    opacity: 0.6;
    background: #213f8c;
    filter: blur(8px);
    z-index: -1;
    animation: cta-pulse-ring 2s ease-in-out infinite;
  }

  .btn-continuar::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      transparent,
      rgba(255, 255, 255, 0.4),
      transparent
    );
    transform: translateX(-100%);
    animation: cta-shine-sweep 2.5s linear infinite;
    z-index: 1;
  }

  .btn-continuar:hover {
    transform: translateY(-1px);
  }

  .btn-continuar:active {
    transform: scale(0.98);
  }

  @keyframes cta-pulse-glow {
    0%,
    100% {
      box-shadow: 0 4px 14px 0 rgba(33, 63, 140, 0.4);
    }
    50% {
      box-shadow:
        0 4px 20px 0 rgba(33, 63, 140, 0.8),
        0 0 30px 0 rgba(33, 63, 140, 0.4);
    }
  }

  @keyframes cta-button-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.02);
    }
  }

  @keyframes cta-pulse-ring {
    0%,
    100% {
      opacity: 0.4;
      transform: scale(1);
    }
    50% {
      opacity: 0.7;
      transform: scale(1.05);
    }
  }

  @keyframes cta-shine-sweep {
    0% {
      transform: translateX(-100%) skewX(-15deg);
    }
    100% {
      transform: translateX(200%) skewX(-15deg);
    }
  }

  .phone-card-login {
    text-align: center;
    font-size: 0.75rem;
    color: #6b7280;
    margin: 0.5rem 0 0 0;
  }

  .phone-card-login a {
    color: #213f8c;
    text-decoration: none;
    font-weight: 500;
  }

  .phone-card-login a:hover {
