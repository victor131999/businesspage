  /* Sección de Control Total */
  .control-section {
    width: 100%;
    background: #ffffff;
    padding: 5rem 2rem;
  }

  .control-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .control-divider {
    width: 100%;
    max-width: 200px;
    height: 2px;
    background: #1488fe;
    margin: 0 auto 3rem;
  }

  .control-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1.2;
    color: #0a203f;
    text-align: center;
    margin: 0 0 4rem 0;
    font-weight: 400;
  }

  .control-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 2rem;
  }

  .control-feature {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    perspective: 1000px;
  }

  .control-feature-card {
    width: 100%;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.6s ease;
  }

  .control-feature-card.flipped {
    transform: rotateY(180deg);
  }

  .control-feature-front,
  .control-feature-back {
    width: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .control-feature-back {
    position: absolute;
    top: 0;
    left: 0;
    transform: rotateY(180deg);
    background: #ffffff;
    border-radius: 16px;
    padding: 2rem;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .control-feature-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 1.5rem;
    background: #f3f4f6;
    position: relative;
  }

  .control-feature-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .control-feature:hover .control-feature-image img {
    transform: scale(1.05);
  }

  .control-feature-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #0a203f;
    margin: 0 0 0.75rem 0;
    line-height: 1.3;
  }

  .control-feature-description {
    font-size: 1rem;
    line-height: 1.6;
    color: #6b7280;
    margin: 0 0 1.5rem 0;
  }

  .control-feature-btn {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: #8dff2b;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    color: #ffffff;
    flex-shrink: 0;
  }

  .control-feature-btn svg {
    width: 20px;
    height: 20px;
  }

  .control-feature-btn:hover {
    background: #a5ff4d;
    transform: scale(1.1);
  }

  .control-feature-benefits {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    flex: 1;
  }

  .control-feature-benefits li {
    padding: 0.75rem 0;
    padding-left: 1.5rem;
