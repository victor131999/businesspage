---
import Navbar from "../components/navbar.astro";
import ProductsPanel from "../components/productsPanel.astro";
import "../styles/navbar.css";
---

<script>
  import { updateContent } from '../scripts/authTranslations.js';

  function handleLanguageChange(lang: string) {
    // Convertir ES/EN a es/en
    const normalizedLang = lang.toLowerCase();
    updateContent(normalizedLang);
  }

  // Escuchar cambios de idioma desde el navbar
  window.addEventListener('ui:languagechange', ((event: Event) => {
    const customEvent = event as CustomEvent<{language: string}>;
    if (customEvent.detail?.language) {
      handleLanguageChange(customEvent.detail.language);
    }
  }) as EventListener);

  // Aplicar traducciones iniciales
  document.addEventListener('DOMContentLoaded', () => {
    // Intentar obtener el idioma actual del localStorage (que usa el navbar)
    const storedLang = localStorage.getItem('ui-language') || 'EN';
    handleLanguageChange(storedLang);
  });
</script>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png" />
    <title>Zelify — Auth</title>
  </head>

  <body>
    <Navbar
      logoSrc="/images/zelify_logo.png"
      colors={{
        text: "#004195",
        textHover: "#002B62",
        highlightBg: "#6AFF00",
        highlightText: "#0b132b",
        btnLightBg: "#E7EDF6",
        btnLightHoverBg: "#DAE4F1",
        btnLightText: "#004195",
        btnOutline: "#E7EDF6",
        btnOutlineHover: "#ffffff",
        dropdownBg: "#ffffff",
        dropdownLink: "#1e2b3a",
        dropdownHoverBg: "#EEF3F9",
        radius: "22px",
      }}
      buttons={{
        first: { label: "Work with us", href: "/jobs" },
        second: { label: "Business access", href: "https://www.zelify.io/" },
        third: { label: "EN", href: "/" },
      }}
    />
    <ProductsPanel />
    <section class="hero">
      <div class="content">
        <span class="badge">Auth</span>

        <h1 class="title">
          Allows secure user registration,<br/>
          authentication, and authorization<br/>
          in web and mobile applications.
        </h1>

        <p class="description">
          Managing login with proprietary or third-party credentials<br/>
          (Google, Apple, Facebook, etc.).
        </p>

        <div class="cta">
          <a href="/hablemos" class="btn btn-solid">Let's talk</a>
          <a href="https://docs.zelify.com/servicios-financieros/auth" target="_blank" rel="noopener noreferrer" class="btn btn-solid">View API Docs</a>
        </div>
      </div>
    </section>
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    width: 100%;
    overflow-x: hidden;
    overflow-y: auto;
  }

  body {
    font-family:
      "NataSans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    color: #0b132b;
    background-color: #e8ecf3;
    background-image: url('/images/FONDO 2.jpg');
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    background-attachment: fixed;
    min-height: 100vh;
    width: 100%;
    overflow-x: hidden;
    overflow-y: auto;
  }

  .hero {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-height: calc(100vh - 80px);
    padding: 0 clamp(4%, 8vw, 8%) 0 clamp(6%, 15vw, 15%);
    position: relative;
    overflow-x: hidden;
    overflow-y: auto;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
  }

  .content {
    max-width: min(900px, 90%);
    width: 100%;
    background: transparent;
    box-sizing: border-box;
  }
  .badge {
    display: inline-block;
    max-width: min(500px, 100%);
    background: #6aff00;
    color: #0b132b;
    padding: 0.8rem 2rem;
    border-radius: 25px;
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 2rem;
    text-align: left;
    box-shadow: 0 0 12px rgba(184, 255, 42, 0.4);
    word-wrap: break-word;
    overflow-wrap: break-word;
    box-sizing: border-box;
  }

  .title {
    font-size: clamp(2rem, 2.5vw, 2.9rem);
    line-height: 1;
    color: #004195;
    margin: 0 0 1.5rem 0;
    font-weight: 400;
    text-align: left;
    max-width: min(900px, 100%);
    width: 100%;
    word-wrap: break-word;
    overflow-wrap: break-word;
    box-sizing: border-box;
  }

  .description {
    color: #004195;
    font-size: 1.1rem;
    line-height: 1.65;
    max-width: min(600px, 100%);
    margin: 0 0 2.5rem 0;
    text-align: left;
    word-wrap: break-word;
    overflow-wrap: break-word;
    box-sizing: border-box;
  }

  .cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.4rem;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.95rem;
    transition:
      transform 0.15s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-solid {
    background: #6aff00;
    color: #0b132b;
  }

  .btn-solid:hover {
    background: #caff4a;
  }

  .btn-ghost:hover {
    background: rgba(184, 255, 42, 0.15);
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .hero {
      padding: 2rem clamp(4%, 10vw, 10%) 2rem clamp(5%, 12vw, 12%);
      min-height: auto;
      overflow-x: hidden;
      overflow-y: auto;
    }

    .content {
      max-width: 100%;
      width: 100%;
      padding-right: 0;
    }

    .title {
      font-size: clamp(1.8rem, 2.2vw, 2.5rem);
      word-wrap: break-word;
      overflow-wrap: break-word;
    }

    .description {
      word-wrap: break-word;
      overflow-wrap: break-word;
    }

    .badge {
      max-width: 100%;
      word-wrap: break-word;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    html,
    body {
      overflow: auto;
      height: auto;
      min-height: 100vh;
    }

    body {
      overflow-y: auto;
      background-attachment: scroll;
    }

    .hero {
      min-height: calc(100vh - 80px);
      height: auto;
      justify-content: center;
      text-align: center;
      padding: 2rem 1.5rem;
      align-items: flex-start;
    }

    .content {
      max-width: 100%;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .badge {
      max-width: 280px;
      margin: 0 auto 2rem;
      text-align: center;
    }

    .title {
      font-size: 2rem;
      line-height: 0.85;
      margin-bottom: 1.5rem;
      text-align: center;
      max-width: 100%;
    }

    .description {
      font-size: 1rem;
      line-height: 1.6;
      margin-bottom: 2rem;
      max-width: 100%;
      text-align: center;
      padding: 0 1rem;
    }

    .cta {
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .btn {
      font-size: 0.9rem;
      padding: 0.75rem 1.5rem;
      width: fit-content;
    }
  }

  /* Prevent text from colliding with the phone image at desktop zoom levels */
  @media (max-width: 1600px) {
    .hero .content {
      max-width: 52%;
      padding-right: 3rem;
    }
  }

  @media (max-width: 1400px) {
    .hero .content {
      max-width: 50%;
      padding-right: 2rem;
    }
  }
</style>
