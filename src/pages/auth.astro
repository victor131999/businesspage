  }

  .control-feature-benefits li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #8dff2b;
    font-weight: bold;
    font-size: 1.1rem;
  }

  .control-feature-btn-close {
    align-self: flex-end;
    margin-top: auto;
  }

  /* Tablet */
