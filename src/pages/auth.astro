  function updateAuthContent(lang) {
    const t = authTranslations[lang.toLowerCase()] || authTranslations.es;
    currentLang = lang;
    document.documentElement.lang = currentLang.toLowerCase();

    // Hero
    const heroTitle = document.querySelector(".auth-title");
    if (heroTitle) heroTitle.innerHTML = t.hero.title;

    const heroDesc = document.querySelector(".auth-description");
    if (heroDesc) heroDesc.innerHTML = t.hero.description;

    const heroEmail = document.querySelector(".welcome-input");
    if (heroEmail) {
      heroEmail.placeholder = t.hero.ctaInputPlaceholder;
      heroEmail.ariaLabel = t.hero.ctaInputPlaceholder;
    }
    const heroBtn = document.querySelector(".welcome-quote-button");
    if (heroBtn) heroBtn.textContent = t.hero.ctaButton;

    const demoBtn = document.querySelector(".welcome-demo-button");
    if (demoBtn) demoBtn.textContent = t.hero.demoButton;

    // Device static texts
    const deviceBack = document.querySelector(".device-back-btn");
    if (deviceBack) deviceBack.textContent = t.device.back;

    const googleBtn = document.querySelector(".btn-google");
    if (googleBtn) {
      const googleText = googleBtn.childNodes[googleBtn.childNodes.length - 1];
      if (googleText && googleText.nodeType === Node.TEXT_NODE) {
        googleText.textContent = " " + t.device.buttons.google;
      }
    }

    const dividerText = document.querySelector(".divider-text");
    if (dividerText) dividerText.textContent = t.device.buttons.divider;

    // Field labels and placeholders (Device Demo)
    const fieldMap = {
      fullName: { label: t.device.labels.name, ph: t.device.placeholders.name },
      email: { label: t.device.labels.email, ph: t.device.placeholders.email },
      phone: { label: t.device.labels.phone, ph: t.device.placeholders.phone },
      password: {
        label: t.device.labels.password,
        ph: t.device.placeholders.password,
      },
      confirmPassword: {
        label: t.device.labels.confirm,
        ph: t.device.placeholders.confirm,
      },
    };

    for (const [id, texts] of Object.entries(fieldMap)) {
      const input = document.getElementById(id);
      if (input) {
        input.placeholder = texts.ph;
        const label = input.closest(".form-field")?.querySelector("label");
        if (label) {
          const span = label.querySelector("span");
          label.textContent = texts.label;
          if (span) label.appendChild(span);
        }
      }
    }

    // Demo flow buttons
    document.querySelectorAll(".btn-continuar").forEach((btn) => {
      if (btn.closest("#step-1") || btn.closest("#step-3")) {
        btn.textContent = t.device.buttons.continue;
      } else if (btn.closest("#step-2") || btn.closest("#step-4")) {
        btn.textContent = t.device.buttons.verify;
      } else if (btn.closest("#step-5")) {
        btn.textContent = t.device.buttons.create;
      }
    });

    // Resend links
    document.querySelectorAll(".resend-code").forEach((p) => {
      const link = p.querySelector("a");
      if (link) {
        const id = link.id;
        p.innerHTML = t.device.buttons.resend.replace(
          "class='resend-link'",
          `id='${id}'`,
        );
      }
    });

    // Security Section
    const secTitle = document.querySelector(".security-title");
    if (secTitle) secTitle.innerHTML = t.security.title;

    const secFeatures = document.querySelectorAll(".security-feature");
    secFeatures.forEach((el, idx) => {
      if (t.security.features[idx]) {
        el.querySelector(".feature-title").textContent =
          t.security.features[idx].title;
        el.querySelector(".feature-description").textContent =
          t.security.features[idx].desc;
      }
    });

    // Control Section
    const ctrlTitle = document.querySelector(".control-title");
    if (ctrlTitle) ctrlTitle.textContent = t.control.title;

    const ctrlFeatures = document.querySelectorAll(".control-feature");
    ctrlFeatures.forEach((el, idx) => {
      if (t.control.features[idx]) {
        const data = t.control.features[idx];
        el.querySelector(
          ".control-feature-front .control-feature-title",
        ).textContent = data.title;
        el.querySelector(
          ".control-feature-front .control-feature-description",
        ).textContent = data.desc;
        el.querySelector(
          ".control-feature-back .control-feature-title",
        ).textContent = data.backTitle;
        const ul = el.querySelector(".control-feature-benefits");
        ul.innerHTML = data.benefits.map((b) => `<li>${b}</li>`).join("");
      }
    });

    // Contact Section
    const contactTitle = document.querySelector(".contact-title");
    if (contactTitle) contactTitle.innerHTML = t.contact.title;

    const contactFormTitle = document.querySelector(".contact-form-title");
    if (contactFormTitle) contactFormTitle.textContent = t.contact.formTitle;

    const contactForm = document.getElementById("contactForm");
    if (contactForm) {
      contactForm.querySelector("#nombres").placeholder =
        t.contact.placeholders.names;
      contactForm.querySelector("#apellidos").placeholder =
        t.contact.placeholders.surnames;
      contactForm.querySelector("#compania").placeholder =
        t.contact.placeholders.company;
      contactForm.querySelector("#email").placeholder =
        t.contact.placeholders.email;
      contactForm.querySelector("#telefono").placeholder =
        t.contact.placeholders.phone;
      const submitBtn = contactForm.querySelector(".hubspot-contact-submit-btn");
      if (submitBtn) submitBtn.value = t.contact.submit;
      contactForm.querySelector(".hubspot-contact-legal").innerHTML = t.contact.legal;

      const countrySelect = contactForm.querySelector("#pais");
      if (countrySelect && countrySelect.options.length > 0) {
        countrySelect.options[0].textContent = t.contact.countryDefault;
      }
    }

    // FAQ Section
    const faqTitle = document.querySelector(".faq-title");
    if (faqTitle) faqTitle.textContent = t.faq.title;

    const faqItems = document.querySelectorAll(".faq-item");
    faqItems.forEach((el, idx) => {
      if (t.faq.items[idx]) {
        el.querySelector(".faq-question span").textContent = t.faq.items[idx].q;
        el.querySelector(".faq-answer p").textContent = t.faq.items[idx].a;
      }
    });

    // CTA Section
    const ctaTitle = document.querySelector(".cta-title");
    if (ctaTitle) ctaTitle.innerHTML = t.cta.title;

    const ctaBtn = document.querySelector(".cta-button");
    if (ctaBtn) ctaBtn.textContent = t.cta.button;

    // Footer
    const footerTitle = document.querySelector(".footer-links-title");
    if (footerTitle) footerTitle.textContent = t.footer.quickLinks;

    const footerNav = document.querySelectorAll(".footer-nav a");
    const footerKeys = ["products", "about", "developers", "others"];
    footerNav.forEach((link, idx) => {
      if (footerKeys[idx]) link.textContent = t.footer[footerKeys[idx]];
    });

    const footerDisclaimer = document.querySelector(".footer-disclaimer");
    if (footerDisclaimer) footerDisclaimer.textContent = t.footer.disclaimer;

    const footerCopyright = document.querySelector(".footer-copyright");
    if (footerCopyright) footerCopyright.textContent = t.footer.copyright;

    showStep(currentStep);
  }

  // Inicializar OTP inputs
  function initOTPInputs(containerId) {
    const container = document.getElementById(containerId);
    if (!container) return;

    const inputs = container.querySelectorAll(".otp-input");

    inputs.forEach((input, index) => {
      input.addEventListener("input", (e) => {
        const value = e.target.value.replace(/[^0-9]/g, "");
        e.target.value = value;

        if (value && index < inputs.length - 1) {
          inputs[index + 1].focus();
        }
      });

      input.addEventListener("keydown", (e) => {
        if (e.key === "Backspace" && !e.target.value && index > 0) {
          inputs[index - 1].focus();
        }
      });

      input.addEventListener("paste", (e) => {
        e.preventDefault();
        const pasted = e.clipboardData
          .getData("text")
          .replace(/[^0-9]/g, "")
          .slice(0, 6);
        pasted.split("").forEach((char, i) => {
          if (inputs[i]) {
            inputs[i].value = char;
          }
        });
        if (pasted.length === 6) {
          inputs[5].focus();
        }
      });
    });
  }

  // Actualizar dots de progreso
  function updateProgressDots(step) {
    const dots = document.querySelectorAll(".phone-card-dots .dot");
    dots.forEach((dot, index) => {
      if (index < step) {
        dot.classList.add("active");
      } else {
        dot.classList.remove("active");
      }
    });
  }

  // Mostrar paso
  function showStep(step) {
    const t =
      authTranslations[currentLang.toLowerCase()] || authTranslations.es;
    const stepData = t.device.steps[step];

    document.querySelectorAll(".auth-step").forEach((el, index) => {
      el.style.display = index + 1 === step ? "block" : "none";
    });

    const titleEl = document.getElementById("step-title");
    const descEl = document.getElementById("step-description");
    const loginLink = document.getElementById("login-link");

    if (!titleEl || !descEl) return;

    titleEl.textContent = stepData.title;

    if (step === 2) {
      descEl.innerHTML = stepData.descPrefix + formData.email + "</strong>";
      loginLink.style.display = "none";
    } else if (step === 4) {
      descEl.innerHTML = stepData.descPrefix + formData.phone + "</strong>";
      loginLink.style.display = "none";
    } else {
      descEl.innerHTML = stepData.desc;
      loginLink.style.display = step === 5 ? "block" : "none";
    }

    if (step === 5) {
      loginLink.innerHTML = t.device.buttons.login;
    }

    updateProgressDots(step);
    currentStep = step;
  }

  // Funciones de validación
  function validateFullName(name) {
    return name.trim().length >= 2;
  }

  function validateEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function validatePhone(phone) {
    return phone.trim().length >= 10;
  }

  function validatePassword(password) {
    return password.length >= 8;
  }

  function showFieldError(fieldId, message) {
    validationErrors[fieldId] = message;
    const field = document.getElementById(fieldId);
    if (field) {
      field.classList.add("field-error");
      const errorEl = field.parentElement.querySelector(".field-error-message");
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.style.display = "block";
      }
    }
  }

  function clearFieldError(fieldId) {
    delete validationErrors[fieldId];
    const field = document.getElementById(fieldId);
    if (field) {
      field.classList.remove("field-error");
      const errorEl = field.parentElement.querySelector(".field-error-message");
      if (errorEl) {
        errorEl.style.display = "none";
      }
    }
  }

  function clearAllErrors() {
    Object.keys(validationErrors).forEach((key) => clearFieldError(key));
  }

  // Paso 1: Crear cuenta
  document.getElementById("form-step-1")?.addEventListener("submit", (e) => {
    e.preventDefault();
    clearAllErrors();

    const fullName = document.getElementById("fullName").value.trim();
    const email = document.getElementById("email").value.trim();

    let hasErrors = false;

    if (!validateFullName(fullName)) {
      showFieldError(
        "fullName",
        currentLang === "EN"
          ? "Name must be at least 2 characters"
          : "El nombre debe tener al menos 2 caracteres",
      );
      hasErrors = true;
    }

    if (!validateEmail(email)) {
      showFieldError(
        "email",
        currentLang === "EN" ? "Invalid email" : "Correo electrónico inválido",
      );
      hasErrors = true;
    }

    if (hasErrors) {
      return;
    }

    formData.fullName = fullName;
    formData.email = email;

    showStep(2);
    initOTPInputs("otp-email");
  });

  document.getElementById("fullName")?.addEventListener("input", () => {
    clearFieldError("fullName");
  });

  document.getElementById("email")?.addEventListener("input", () => {
    clearFieldError("email");
  });

  // Paso 2: Verificar email
  document.getElementById("form-step-2")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const inputs = document.querySelectorAll("#otp-email .otp-input");
    const otp = Array.from(inputs)
      .map((input) => input.value)
      .join("");

    if (otp.length !== 6) {
      return;
    }

    emailOTPStatus = "verifying";
    updateOTPStatus("otp-email", "verifying");

    const isValid = otp === "202601";

    setTimeout(() => {
      if (isValid) {
        emailOTPStatus = "success";
        updateOTPStatus("otp-email", "success");
        formData.emailOTP = otp;

        setTimeout(() => {
          emailOTPStatus = "idle";
          showStep(3);
        }, 3000);
      } else {
        emailOTPStatus = "error";
        updateOTPStatus("otp-email", "error");

        setTimeout(() => {
          emailOTPStatus = "idle";
          updateOTPStatus("otp-email", "idle");
          inputs.forEach((input) => (input.value = ""));
          inputs[0].focus();
        }, 2000);
      }
    }, 1000);
  });

  function updateOTPStatus(containerId, status) {
    const container = document.getElementById(containerId);
    if (!container) return;

    const inputs = container.querySelectorAll(".otp-input");
    inputs.forEach((input) => {
      input.classList.remove("otp-verifying", "otp-success", "otp-error");
      if (status !== "idle") {
        input.classList.add(`otp-${status}`);
      }
    });
  }

  // Paso 3: Agregar teléfono
  document.getElementById("form-step-3")?.addEventListener("submit", (e) => {
    e.preventDefault();
    clearAllErrors();

    const phone = document.getElementById("phone").value.trim();

    if (!validatePhone(phone)) {
      showFieldError(
        "phone",
        currentLang === "EN"
          ? "Invalid phone number"
          : "Número de teléfono inválido",
      );
      return;
    }

    formData.phone = phone;
    showStep(4);
    initOTPInputs("otp-phone");
  });

  document.getElementById("phone")?.addEventListener("input", () => {
    clearFieldError("phone");
  });

  // Paso 4: Verificar teléfono
  document.getElementById("form-step-4")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const inputs = document.querySelectorAll("#otp-phone .otp-input");
    const otp = Array.from(inputs)
      .map((input) => input.value)
      .join("");

    if (otp.length !== 6) {
      return;
    }

    phoneOTPStatus = "verifying";
    updateOTPStatus("otp-phone", "verifying");

    const isValid = otp === "202601";

    setTimeout(() => {
      if (isValid) {
        phoneOTPStatus = "success";
        updateOTPStatus("otp-phone", "success");
        formData.phoneOTP = otp;

        setTimeout(() => {
          phoneOTPStatus = "idle";
          showStep(5);
        }, 3000);
      } else {
        phoneOTPStatus = "error";
        updateOTPStatus("otp-phone", "error");

        setTimeout(() => {
          phoneOTPStatus = "idle";
          updateOTPStatus("otp-phone", "idle");
          inputs.forEach((input) => (input.value = ""));
          inputs[0].focus();
        }, 2000);
      }
    }, 1000);
  });

  // Paso 5: Completar perfil
  document.getElementById("form-step-5")?.addEventListener("submit", (e) => {
    e.preventDefault();
    clearAllErrors();

    const password = document.getElementById("password").value;
    const confirmPassword = document.getElementById("confirmPassword").value;

    let hasErrors = false;

    if (!validatePassword(password)) {
      showFieldError(
        "password",
        currentLang === "EN"
          ? "Password must be at least 8 characters"
          : "La contraseña debe tener al menos 8 caracteres",
      );
      hasErrors = true;
    }

    if (password !== confirmPassword) {
      showFieldError(
        "confirmPassword",
        currentLang === "EN"
          ? "Passwords do not match"
          : "Las contraseñas no coinciden",
      );
      hasErrors = true;
    }

    if (hasErrors) {
      return;
    }

    formData.password = password;
    formData.confirmPassword = confirmPassword;

    console.log("Registro completado", formData);
  });

  document.getElementById("password")?.addEventListener("input", () => {
    clearFieldError("password");
  });

  document.getElementById("confirmPassword")?.addEventListener("input", () => {
    clearFieldError("confirmPassword");
  });

  // Delegated listeners for resend links
  document.addEventListener("click", (e) => {
    if (e.target && e.target.id === "resend-email") {
      e.preventDefault();
      console.log("Código reenviado a", formData.email);
    }
    if (e.target && e.target.id === "resend-phone") {
      e.preventDefault();
      console.log("Código reenviado a", formData.phone);
    }
  });

  // Inicializar
  updateProgressDots(1);

  // Control de flip cards
  document.querySelectorAll(".control-feature-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const card = btn.closest(".control-feature-card");

      if (card) {
        card.classList.toggle("flipped");
      }
    });
  });

  // Formulario de contacto
  document.getElementById("contactForm")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const form = e.target;

    const formData = {
      nombres: form.querySelector("#nombres").value,
      apellidos: form.querySelector("#apellidos").value,
      compania: form.querySelector("#compania").value,
      email: form.querySelector("#email").value,
      pais: form.querySelector("#pais").value,
      telefono: form.querySelector("#telefono").value,
    };

    console.log("Formulario enviado:", formData);
  });

  // FAQ Accordion
  document.querySelectorAll(".faq-question").forEach((question) => {
    question.addEventListener("click", () => {
      const faqItem = question.closest(".faq-item");
      const isActive = faqItem.classList.contains("active");

      document.querySelectorAll(".faq-item").forEach((item) => {
        item.classList.remove("active");
      });

      if (!isActive) {
        faqItem.classList.add("active");
      }
    });
  });

  // Event Listeners for Language Change
  window.addEventListener("ui:languagechange", (event) => {
    const lang = event.detail?.language || "ES";
    updateAuthContent(lang);
  });

  const detectBrowserLanguage = () => {
    const locale =
      (navigator.languages && navigator.languages[0]) ||
      navigator.language ||
      "";
    return locale.toLowerCase().startsWith("es") ? "ES" : "EN";
  };

  document.addEventListener("DOMContentLoaded", () => {
    const stored = localStorage.getItem("ui-language");
    const initialLang =
      window.__uiLanguage || stored || detectBrowserLanguage();
    updateAuthContent(initialLang);
  });
</script>
