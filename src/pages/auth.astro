---
import Navbar3 from "../components/NavbarSimple.astro";
import ProductsPanel from "../components/productsPanel.astro";
import { AlaizaAssistant } from "../components/AlaizaAssistant";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/png"
      href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png"
    />
    <title>Zelify — Auth</title>
  </head>

  <body>
    <header class="auth-header">
      <Navbar3 />
      <ProductsPanel />
    </header>

    <main class="auth-main">
      <section class="auth-hero">
        <h1 class="auth-title">
          Entrada simple, control<br />
          total, cero fricción.
        </h1>
        <p class="auth-description">
          Autenticación avanzada con biometría y doble factor,<br />
          captura inteligente de datos del dispositivo y detección<br />
          temprana de tráfico inusual para prevenir fraudes<br />
          y garantizar usuarios confiables.
        </p>
        <div class="auth-cta">
          <form
            class="welcome-input-group"
            action="#"
            aria-label="Solicitar cotización"
            novalidate
          >
            <input
              class="welcome-input"
              type="email"
              name="email"
              placeholder="ingresa tu correo"
              aria-label="Ingresa tu correo"
              data-i18n-placeholder="home.welcome.email.placeholder"
              data-i18n-aria="home.welcome.email.aria"
            />
            <button class="welcome-quote-button" type="submit">cotizar</button>
          </form>
          <a
            href="https://www.zelify.com/clips"
            class="welcome-demo-button"
            target="_blank"
            rel="noopener noreferrer">demo</a
          >
        </div>
      </section>
    </main>

    <div class="auth-background-section">
      <div class="auth-background-overlay"></div>
      <div class="auth-background-image">
        <video class="auth-video" autoplay loop muted playsinline>
          <source
            src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/video/circlesmov.mp4"
            type="video/mp4"
          />
        </video>
      </div>

      <!-- Contenedor del dispositivo móvil -->
      <div class="device-container">
        <!-- Frame del iPhone -->
        <div class="device-frame-wrapper">
          <div class="device-frame">
            <!-- Pantalla del dispositivo -->
            <div class="device-screen">
              <!-- Status Bar con Dynamic Island -->
              <div class="device-status-bar">
                <div class="status-time">9:41</div>
                <div class="dynamic-island">
                  <div class="island-shape"></div>
                  <div class="island-speaker"></div>
                </div>
                <div class="status-icons">
                  <svg class="signal-icon" fill="none" viewBox="0 0 20 12">
                    <path
                      d="M1 8h2v2H1V8zm3-2h2v4H4V6zm3-2h2v6H7V4zm3-1h2v7h-2V3z"
                      fill="currentColor"></path>
                  </svg>
                  <div class="battery-icon">
                    <div class="battery-level"></div>
                  </div>
                </div>
              </div>

              <!-- Contenido del dispositivo -->
              <div class="device-content">
                <!-- Header con back y logo -->
                <div class="device-header">
                  <button class="device-back-btn">&lt; back</button>
                  <div class="device-logo">
                    <img src="/images/zelify_logo.png" alt="Zelify" />
                  </div>
                  <div class="device-header-spacer"></div>
                </div>

                <!-- Animación GIF -->
                <div class="device-animation">
                  <img src="/gift/ANIMACION 1.gif" alt="Auth animation" />
                </div>

                <!-- Tarjeta con fondo translúcido -->
                <div class="device-card">
                  <div class="auth-phone-card">
                    <!-- Indicador de progreso -->
                    <div class="phone-card-dots">
                      <span class="dot active"></span>
                      <span class="dot"></span>
                      <span class="dot"></span>
                      <span class="dot"></span>
                      <span class="dot"></span>
                    </div>

                    <h2 class="phone-card-title" id="step-title">
                      Crear Cuenta
                    </h2>
                    <p class="phone-card-description" id="step-description">
                      Ingresa tu nombre y correo electrónico para empezar. Te
                      enviaremos un código de verificación.
                    </p>

                    <button class="btn-google">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 20 20"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M19.6 10.2273C19.6 9.51818 19.5364 8.83636 19.4182 8.18182H10V12.05H15.3818C15.15 13.3 14.4455 14.3591 13.3864 15.0682V17.5773H16.6182C18.5091 15.8364 19.6 13.2727 19.6 10.2273Z"
                          fill="#4285F4"></path>
                        <path
                          d="M10 20C12.7 20 14.9636 19.1045 16.6182 17.5773L13.3864 15.0682C12.4909 15.6682 11.3455 16.0227 10 16.0227C7.39545 16.0227 5.19091 14.2636 4.40455 11.9H1.06364V14.4909C2.70909 17.7591 6.09091 20 10 20Z"
                          fill="#34A853"></path>
                        <path
                          d="M4.40455 11.9C4.20455 11.3 4.09091 10.6591 4.09091 10C4.09091 9.34091 4.20455 8.7 4.40455 8.1V5.50909H1.06364C0.386364 6.85909 0 8.38636 0 10C0 11.6136 0.386364 13.1409 1.06364 14.4909L4.40455 11.9Z"
                          fill="#FBBC05"></path>
                        <path
                          d="M10 3.97727C11.4682 3.97727 12.7864 4.46818 13.8227 5.42273L16.6909 2.55455C14.9591 0.940909 12.6955 0 10 0C6.09091 0 2.70909 2.24091 1.06364 5.50909L4.40455 8.1C5.19091 5.73636 7.39545 3.97727 10 3.97727Z"
                          fill="#EA4335"></path>
                      </svg>
                      Crear cuenta con Google
                    </button>

                    <div class="phone-card-divider">
                      <span class="divider-line"></span>
                      <span class="divider-text">O crea cuenta con correo</span>
                      <span class="divider-line"></span>
                    </div>

                    <!-- Paso 1: Crear Cuenta -->
                    <div id="step-1" class="auth-step">
                      <form class="phone-card-form" id="form-step-1">
                        <div class="form-field">
                          <label
                            >Nombre Completo<span class="required">*</span
                            ></label
                          >
                          <input
                            type="text"
                            id="fullName"
                            placeholder="John Doe"
                            required
                          />
                          <span class="field-error-message"></span>
                        </div>
                        <div class="form-field">
                          <label>Correo<span class="required">*</span></label>
                          <input
                            type="email"
                            id="email"
                            placeholder="email@example.com"
                            required
                          />
                          <span class="field-error-message"></span>
                        </div>
                        <button type="submit" class="btn-continuar">
                          Continuar →
                        </button>
                      </form>
                    </div>

                    <!-- Paso 2: Verificar Email -->
                    <div id="step-2" class="auth-step" style="display: none;">
                      <form class="phone-card-form" id="form-step-2">
                        <div class="otp-container">
                          <div class="otp-inputs" id="otp-email">
                            <input
                              type="text"
                              class="otp-input"
                              maxlength="1"
                              inputmode="numeric"
                            />
                            <input
                              type="text"
                              class="otp-input"
                              maxlength="1"
                              inputmode="numeric"
                            />
                            <input
                              type="text"
                              class="otp-input"
                              maxlength="1"
                              inputmode="numeric"
                            />
                            <input
                              type="text"
                              class="otp-input"
                              maxlength="1"
                              inputmode="numeric"
                            />
                            <input
                              type="text"
                              class="otp-input"
                              maxlength="1"
                              inputmode="numeric"
                            />
                            <input
                              type="text"
                              class="otp-input"
                              maxlength="1"
                              inputmode="numeric"
                            />
                          </div>
                        </div>
                        <button type="submit" class="btn-continuar">
                          Verificar →
                        </button>
                        <p class="resend-code">
                          ¿No recibiste el código? <a href="#" id="resend-email"
                            >Reenviar</a
                          >
                        </p>
                      </form>
                    </div>

                    <!-- Paso 3: Agregar Teléfono -->
                    <div id="step-3" class="auth-step" style="display: none;">
                      <form class="phone-card-form" id="form-step-3">
                        <div class="form-field">
                          <label
                            >Número de Teléfono<span class="required">*</span
                            ></label
                          >
                          <input
                            type="tel"
                            id="phone"
                            placeholder="+1 234 567 8900"
                            required
                          />
                          <span class="field-error-message"></span>
                        </div>
                        <button type="submit" class="btn-continuar">
                          Continuar →
                        </button>
                      </form>
                    </div>

                    <!-- Paso 4: Verificar Teléfono -->
                    <div id="step-4" class="auth-step" style="display: none;">
                      <form class="phone-card-form" id="form-step-4">
                        <div class="otp-container">
                          <div class="otp-inputs" id="otp-phone">
                            <input
                              type="text"
                              class="otp-input"
                              maxlength="1"
                              inputmode="numeric"
                            />
                            <input
                              type="text"
                              class="otp-input"
                              maxlength="1"
                              inputmode="numeric"
                            />
                            <input
                              type="text"
                              class="otp-input"
                              maxlength="1"
                              inputmode="numeric"
                            />
                            <input
                              type="text"
                              class="otp-input"
                              maxlength="1"
                              inputmode="numeric"
                            />
                            <input
                              type="text"
                              class="otp-input"
                              maxlength="1"
                              inputmode="numeric"
                            />
                            <input
                              type="text"
                              class="otp-input"
                              maxlength="1"
                              inputmode="numeric"
                            />
                          </div>
                        </div>
                        <button type="submit" class="btn-continuar">
                          Verificar →
                        </button>
                        <p class="resend-code">
                          ¿No recibiste el código? <a href="#" id="resend-phone"
                            >Reenviar</a
                          >
                        </p>
                      </form>
                    </div>

                    <!-- Paso 5: Completar Perfil -->
                    <div id="step-5" class="auth-step" style="display: none;">
                      <form class="phone-card-form" id="form-step-5">
                        <div class="form-field">
                          <label
                            >Contraseña<span class="required">*</span></label
                          >
                          <input
                            type="password"
                            id="password"
                            placeholder="Mínimo 8 caracteres"
                            required
                          />
                          <span class="field-error-message"></span>
                        </div>
                        <div class="form-field">
                          <label
                            >Confirmar Contraseña<span class="required">*</span
                            ></label
                          >
                          <input
                            type="password"
                            id="confirmPassword"
                            placeholder="Confirma tu contraseña"
                            required
                          />
                          <span class="field-error-message"></span>
                        </div>
                        <button type="submit" class="btn-continuar">
                          Crear Cuenta →
                        </button>
                      </form>
                    </div>

                    <p
                      class="phone-card-login"
                      id="login-link"
                      style="display: none;"
                    >
                      ¿Ya tienes una cuenta? <a href="#">Ingresa</a>
                    </p>
                  </div>
                </div>
              </div>

              <!-- Home Indicator -->
              <div class="device-home-indicator"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sección de Seguridad Inteligente -->
    <section class="security-section">
      <div class="security-container">
        <h2 class="security-title">
          Seguridad inteligente<br />
          desde el primer acceso.
        </h2>

        <div class="security-features">
          <!-- Feature 1: Registro a tu medida -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                ></path>
                <path d="M14 2v6h6"></path>
                <path d="M16 13H8"></path>
                <path d="M16 17H8"></path>
                <path d="M10 9H8"></path>
                <circle cx="19" cy="5" r="1.5" fill="currentColor"></circle>
                <path d="M19 4v2M19 6h-1M19 6h1" stroke-width="1"></path>
              </svg>
            </div>
            <h3 class="feature-title">Registro a tu medida</h3>
            <p class="feature-description">
              Campos personalizados que se adaptan a tu negocio y a tus
              usuarios.
            </p>
          </div>

          <!-- Feature 2: Acceso rápido y seguro -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M12 1v4M12 19v4M1 12h4M19 12h4"></path>
              </svg>
            </div>
            <h3 class="feature-title">Acceso rápido y seguro</h3>
            <p class="feature-description">
              Biometría y autenticación multifactor sin fricciones.
            </p>
          </div>

          <!-- Feature 3: Seguridad desde el primer clic -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <circle cx="12" cy="12" r="3" fill="currentColor" opacity="0.3"
                ></circle>
                <path d="M9 12l2 2 4-4" stroke-width="2"></path>
              </svg>
            </div>
            <h3 class="feature-title">Seguridad desde el primer clic</h3>
            <p class="feature-description">
              Protección avanzada en cada inicio de sesión.
            </p>
          </div>

          <!-- Feature 4: Inteligencia del dispositivo -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="12" r="6"></circle>
                <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
                <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
                <path
                  d="M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"
                ></path>
              </svg>
            </div>
            <h3 class="feature-title">Inteligencia del dispositivo</h3>
            <p class="feature-description">
              Validación automática del entorno desde donde se conecta el
              usuario.
            </p>
          </div>

          <!-- Feature 5: Usuarios verificados -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
                <path d="M12 11v6M9 14h6"></path>
                <path
                  d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                  opacity="0.3"></path>
                <path d="M9 12l2 2 4-4" stroke-width="2"></path>
              </svg>
            </div>
            <h3 class="feature-title">Usuarios verificados</h3>
            <p class="feature-description">
              Cada usuario vinculado a un entorno confiable y trazable.
            </p>
          </div>

          <!-- Feature 6: Detección temprana de fraude -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="12" r="6"></circle>
                <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
                <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
                <path d="M8 8l8 8M16 8l-8 8" stroke-width="2"></path>
              </svg>
            </div>
            <h3 class="feature-title">Detección temprana de fraude</h3>
            <p class="feature-description">
              Identifica tráfico inusual, VPNs y accesos sospechosos en tiempo
              real.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Control Total -->
    <section class="control-section">
      <div class="control-container">
        <div class="control-divider"></div>
        <h2 class="control-title">Control total del acceso a tu plataforma</h2>

        <div class="control-features">
          <!-- Feature 1: Autenticación -->
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1563013544-824ae1b704d3?w=800&h=500&fit=crop&q=80"
                    alt="Autenticación"
                  />
                </div>
                <h3 class="control-feature-title">Autenticación</h3>
                <p class="control-feature-description">
                  Registro de usuarios, inicios de sesión seguros y validación
                  de correo y número de teléfono.
                </p>
                <button class="control-feature-btn" data-feature="auth">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">
                  Beneficios de Autenticación
                </h3>
                <ul class="control-feature-benefits">
                  <li>Registro personalizado con campos adaptables</li>
                  <li>Verificación de email y teléfono en tiempo real</li>
                  <li>Autenticación multifactor sin fricciones</li>
                  <li>Biometría integrada para acceso rápido</li>
                  <li>Gestión segura de sesiones</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="auth"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Feature 2: Información de dispositivo -->
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?w=800&h=500&fit=crop&q=80"
                    alt="Información de dispositivo"
                  />
                </div>
                <h3 class="control-feature-title">
                  Información de dispositivo
                </h3>
                <p class="control-feature-description">
                  Servicio de inteligencia para identificar información del
                  dispositivo desde básica hasta avanzada.
                </p>
                <button class="control-feature-btn" data-feature="device">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">
                  Beneficios de Información de Dispositivo
                </h3>
                <ul class="control-feature-benefits">
                  <li>Identificación automática del dispositivo</li>
                  <li>Detección de características avanzadas</li>
                  <li>Análisis de entorno y configuración</li>
                  <li>Validación de seguridad del dispositivo</li>
                  <li>Información detallada en tiempo real</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="device"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Feature 3: Geolocalización -->
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1524661135-423995f22d0b?w=800&h=500&fit=crop&q=80"
                    alt="Geolocalización"
                  />
                </div>
                <h3 class="control-feature-title">Geolocalización</h3>
                <p class="control-feature-description">
                  Convierte coordenadas en información estratégica y de valor.
                </p>
                <button class="control-feature-btn" data-feature="geo">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">
                  Beneficios de Geolocalización
                </h3>
                <ul class="control-feature-benefits">
                  <li>Análisis de ubicación en tiempo real</li>
                  <li>Detección de accesos sospechosos</li>
