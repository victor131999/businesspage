---
import "../styles/navbar.css";
import "../components/design-system/tokens.css";
import Navbar3 from "../components/NavbarSimple.astro";
import DeviceFrame from "../components/design-system/organisms/device-frame/DeviceFrame.astro";
import ProductsPanel from "../components/productsPanel.astro";
import { AlaizaAssistant } from "../components/AlaizaAssistant";
import AuthApp from "../components/auth/AuthApp.astro";
import EmailQuoteForm from "../components/design-system/molecules/EmailQuoteForm.astro";
import CtaGroup from "../components/design-system/molecules/CtaGroup.astro";
import Button from "../components/design-system/atoms/Button.astro";
import ContactFormHubSpot from "../components/design-system/organisms/ContactFormHubSpot.astro";
import QuoteModalHubSpot from "../components/design-system/organisms/QuoteModalHubSpot.astro";
import Footer from "../components/design-system/organisms/Footer.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/png"
      href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png"
    />
    <title>Zelify — Auth</title>
    <script src="https://js.hsforms.net/forms/embed/50894304.js" defer></script>
  </head>

  <body class="demo-page">
    <header class="auth-header">
      <Navbar3 />
      <ProductsPanel />
    </header>

    <main class="auth-main">
      <section class="auth-hero">
        <h1 class="auth-title">
          Acceso seguro, registro<br />
          total, cero fricción.
        </h1>
  <p class="auth-description">
    Seguridad inteligente: autenticación + doble factor,<br />
    detección de dispositivos y riesgos en tiempo real<br />
    para prevenir fraudes y asegurar usuarios confiables.
  </p>
        <CtaGroup class="auth-cta">
          <EmailQuoteForm
            dataI18nPlaceholder="home.welcome.email.placeholder"
            dataI18nAria="home.welcome.email.aria"
            buttonLabel="Let's talk"
            dataI18nButton="lsdj"
          />
          <Button
            href="https://www.zelify.com/clips"
            variant="secondary"
            class="welcome-demo-button"
            target="_blank"
            rel="noopener noreferrer"
          >
            Demo
          </Button>
        </CtaGroup>
      </section>
    </main>

    <div class="auth-background-section">
      <div class="auth-background-overlay"></div>
      <div class="auth-background-image">
        <video class="auth-video" autoplay loop muted playsinline>
          <source
            src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/videos/auth.mp4"
            type="video/mp4"
          />
        </video>
      </div>

      <!-- Contenedor del dispositivo móvil -->
      <AuthApp />
    </div>

    <!-- Sección de Seguridad Inteligente -->
    <section class="security-section">
      <div class="security-container">
        <h2 class="security-title">
          Seguridad inteligente<br />
          desde el primer acceso.
        </h2>

        <div class="security-features">
          <!-- Feature 1: Registro a tu medida -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                ></path>
                <path d="M14 2v6h6"></path>
                <path d="M16 13H8"></path>
                <path d="M16 17H8"></path>
                <path d="M10 9H8"></path>
                <circle cx="19" cy="5" r="1.5" fill="currentColor"></circle>
                <path d="M19 4v2M19 6h-1M19 6h1" stroke-width="1"></path>
              </svg>
            </div>
            <h3 class="feature-title">Registro a tu medida</h3>
            <p class="feature-description">
              Campos personalizados de registro que se adaptan a tu negocio y sus reglas.
            </p>
          </div>

          <!-- Feature 2: Acceso rápido y seguro -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M12 1v4M12 19v4M1 12h4M19 12h4"></path>
              </svg>
            </div>
            <h3 class="feature-title">Acceso rápido y seguro</h3>
            <p class="feature-description">
              Inicio de sesión biométrico y autenticación doble factor.
            </p>
          </div>

          <!-- Feature 3: Seguridad desde el primer clic -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <circle cx="12" cy="12" r="3" fill="currentColor" opacity="0.3"
                ></circle>
                <path d="M9 12l2 2 4-4" stroke-width="2"></path>
              </svg>
            </div>
            <h3 class="feature-title">Seguridad desde el primer clic</h3>
            <p class="feature-description">
              Utilizamos los protocolos de encriptación más avanzados para un mejor cumplimiento.
            </p>
          </div>

          <!-- Feature 4: Inteligencia del dispositivo -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="12" r="6"></circle>
                <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
                <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
                <path
                  d="M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"
                ></path>
              </svg>
            </div>
            <h3 class="feature-title">Inteligencia del dispositivo</h3>
            <p class="feature-description">
              Validación automática del entorno desde donde se conecta el
              usuario.
            </p>
          </div>

          <!-- Feature 5: Usuarios verificados -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
                <path d="M12 11v6M9 14h6"></path>
                <path
                  d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                  opacity="0.3"></path>
                <path d="M9 12l2 2 4-4" stroke-width="2"></path>
              </svg>
            </div>
            <h3 class="feature-title">Usuarios verificados</h3>
            <p class="feature-description">
              Este producto se integra con el sistema de validación de identidad para un registro completo.
            </p>
          </div>

          <!-- Feature 6: Detección temprana de fraude -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="12" r="6"></circle>
                <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
                <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
                <path d="M8 8l8 8M16 8l-8 8" stroke-width="2"></path>
              </svg>
            </div>
            <h3 class="feature-title">Detección temprana de fraude</h3>
            <p class="feature-description">
              Identifica tráfico inusual, VPNs y accesos sospechosos en tiempo
              real.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Control Total -->
    <section class="control-section">
      <div class="control-container">
        <div class="control-divider"></div>
        <h2 class="control-title">Control total del acceso a tu plataforma</h2>

        <div class="control-features">
          <!-- Feature 1: Autenticación -->
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/image-products/auth/img-1.png"
                    alt="Autenticación"
                  />
                </div>
                <h3 class="control-feature-title">Autenticación</h3>
                <p class="control-feature-description">
                  Registro de usuarios, inicios de sesión seguros y validación
                  de correo y número de teléfono.
                </p>
                <button class="control-feature-btn" data-feature="auth">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">
                  Beneficios de Autenticación
                </h3>
                <ul class="control-feature-benefits">
                  <li>Registro personalizado con campos adaptables</li>
                  <li>Verificación de email y teléfono en tiempo real</li>
                  <li>Autenticación multifactor sin fricciones</li>
                  <li>Biometría integrada para acceso rápido</li>
                  <li>Gestión segura de sesiones</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="auth"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Feature 2: Información de dispositivo -->
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/image-products/auth/img-2.png"
                    alt="Información de dispositivo"
                  />
                </div>
                <h3 class="control-feature-title">
                  Información de dispositivo
                </h3>
                <p class="control-feature-description">
                  Servicio de inteligencia para identificar información del
                  dispositivo desde básica hasta avanzada.
                </p>
                <button class="control-feature-btn" data-feature="device">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">
                  Beneficios de Información de Dispositivo
                </h3>
                <ul class="control-feature-benefits">
                  <li>Identificación automática del dispositivo</li>
                  <li>Detección de características avanzadas</li>
                  <li>Análisis de entorno y configuración</li>
                  <li>Validación de seguridad del dispositivo</li>
                  <li>Información detallada en tiempo real</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="device"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Feature 3: Geolocalización -->
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/image-products/auth/img-3.png"
                    alt="Geolocalización"
                  />
                </div>
                <h3 class="control-feature-title">Geolocalización</h3>
                <p class="control-feature-description">
                  Permite rastrear y validar la ubicación exacta de coordenadas de un dispositivo.
                </p>
                <button class="control-feature-btn" data-feature="geo">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">
                  Beneficios de Geolocalización
                </h3>
                <ul class="control-feature-benefits">
                  <li>Análisis de ubicación en tiempo real</li>
                  <li>Detección de accesos sospechosos</li>
                  <li>Información estratégica de coordenadas</li>
                  <li>Validación de entorno geográfico</li>
                  <li>Prevención de fraudes por ubicación</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="geo"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Contacto -->
    <ContactFormHubSpot headline="Empieza hoy y protege tu plataforma." formTitle="Habla con nuestro equipo" />

    <!-- Sección de FAQ -->
    <section class="faq-section">
      <div class="faq-container">
        <h2 class="faq-title">Preguntas frecuentes</h2>

        <div class="faq-list">
          <!-- FAQ 1 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="1">
              <span>¿Qué funcionalidades incluye el producto?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Nuestro producto incluye autenticación avanzada con biometría,
                registro personalizable de usuarios, validación de email y
                teléfono, información detallada del dispositivo, geolocalización
                estratégica, detección temprana de fraudes, y un SDK de
                integración sencillo para incorporar todas estas funcionalidades
                en una sola línea de código.
              </p>
            </div>
          </div>

          <!-- FAQ 2 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="2">
              <span>¿Es seguro usar biometría y doble factor?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Sí, es completamente seguro. La biometría y la autenticación de
                doble factor (2FA) son estándares de la industria que
                proporcionan capas adicionales de seguridad. Nuestro sistema
                utiliza encriptación de extremo a extremo y cumple con los más
                altos estándares de seguridad para proteger los datos
                biométricos y las credenciales de tus usuarios.
              </p>
            </div>
          </div>

          <!-- FAQ 3 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="3">
              <span
                >¿Puedo personalizar los campos de registro para mis usuarios?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Absolutamente. Nuestro sistema de registro es completamente
                personalizable. Puedes agregar, eliminar o modificar campos
                según las necesidades de tu negocio. Los campos se adaptan
                dinámicamente a tus usuarios, permitiéndote crear experiencias
                de registro únicas y relevantes para tu plataforma.
              </p>
            </div>
          </div>

          <!-- FAQ 4 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="4">
              <span>¿Cómo detecta fraudes y accesos sospechosos?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Nuestro sistema utiliza inteligencia artificial y machine
                learning para analizar patrones de comportamiento, detectar
                tráfico inusual, identificar el uso de VPNs, analizar la
                geolocalización de accesos, y monitorear información del
                dispositivo en tiempo real. Todo esto permite identificar y
                prevenir accesos sospechosos antes de que representen una
                amenaza.
              </p>
            </div>
          </div>

          <!-- FAQ 5 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="5">
              <span>¿Funciona en cualquier dispositivo?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Sí, nuestro producto es multiplataforma y funciona en cualquier
                dispositivo: smartphones (iOS y Android), tablets, computadoras
                de escritorio y laptops. La interfaz se adapta automáticamente a
                cada dispositivo, proporcionando una experiencia óptima sin
                importar desde dónde accedan tus usuarios.
              </p>
            </div>
          </div>

          <!-- FAQ 6 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="6">
              <span>¿Es fácil de integrar a mi sistema actual?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Muy fácil. Nuestro SDK de integración está diseñado para ser
                implementado con una sola línea de código. Proporcionamos
                documentación completa, ejemplos de código, y soporte técnico
                especializado para ayudarte en el proceso de integración. La
                mayoría de nuestros clientes completan la integración en menos
                de una hora.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección CTA Final -->
    <section class="cta-section">
      <div class="cta-container">
        <h2 class="cta-title">
          Comienza hoy y<br />
          asegura cada acceso.
        </h2>
        <button type="button" class="cta-button" data-open-quote-modal>
          Let's talk
        </button>
      </div>
    </section>

    <!-- Footer (mismo que index) -->
    <Footer
      quickLinksTitle="Quick links"
      links={[
        { href: "", label: "Products", key: "products", dataI18n: "footer.products" },
        { href: "https://docs.zelify.com", label: "Developers", key: "developers", dataI18n: "footer.developers", openInNewTab: true },
        { href: "/blog", label: "Blog", key: "blog", dataI18n: "footer.blog" },
      ]}
      legalText="Zelify is a technology platform currently in a development phase, not yet deployed or operational, and does not provide or process financial services directly; all financial operations are conducted exclusively through regulated third-party partners."
      copyrightText="© 2025 Zelify. All rights reserved."
      dataI18n={{ quicklinks: "footer.quicklinks", legal: "footer.legal", copyright: "footer.copyright" }}
    />
    <QuoteModalHubSpot />
    <script is:inline>
      function initQuoteModal() {
        var form = document.querySelector(".welcome-input-group");
        var quoteModal = document.querySelector("#quote-modal");
        var closeQuoteBtn = document.querySelector("#close-quote-modal");
        var quoteModalOverlay = document.querySelector("[data-close-quote-modal]");
        var MEETINGS_BASE_URL = "https://meetings.hubspot.com/gmantilla?embed=true";
        function openQuoteModal() {
          if (!quoteModal) return;
          var emailInput = document.querySelector(".welcome-input");
          var email = emailInput && emailInput.value ? emailInput.value.trim() : "";
          var embedUrl = email ? MEETINGS_BASE_URL + "&email=" + encodeURIComponent(email) : MEETINGS_BASE_URL;
          var container = document.querySelector(".meetings-iframe-container");
          if (container) {
            container.setAttribute("data-src", embedUrl);
            var iframe = container.querySelector("iframe");
            if (iframe) iframe.src = embedUrl;
            else setTimeout(function() { var iframeLater = container.querySelector("iframe"); if (iframeLater) iframeLater.src = embedUrl; }, 500);
          }
          quoteModal.classList.add("is-active");
          quoteModal.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
        }
        function closeQuoteModal() {
          if (!quoteModal) return;
          quoteModal.classList.remove("is-active");
          quoteModal.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
        }
        if (closeQuoteBtn) closeQuoteBtn.addEventListener("click", closeQuoteModal);
        if (quoteModalOverlay) quoteModalOverlay.addEventListener("click", closeQuoteModal);
        if (form) form.addEventListener("submit", function(e) { e.preventDefault(); openQuoteModal(); });
        var openBtns = document.querySelectorAll("[data-open-quote-modal]");
