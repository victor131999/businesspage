---
import Navbar from "../components/navbar.astro";
import ProductsPanel from "../components/productsPanel.astro";
import "../styles/navbar.css";
---

<script>
  type Translation = {
    title: string;
    subtitle: string;
    email: string;
    phone: string;
    interest: string;
    send: string;
    success: string;
  };

  type Translations = {
    en: Translation;
    es: Translation;
  };

  const translations: Translations = {
    en: {
      title: "Let's talk!",
      subtitle: "Tell us about your project<br/>and we'll get in touch with you",
      email: "email",
      phone: "phone number",
      interest: "What are you interested in?",
      send: "send",
      success: "Thank you for contacting us! We'll get in touch with you soon."
    },
    es: {
      title: "¡Hablemos!",
      subtitle: "Cuéntanos sobre tu proyecto<br/>y nos pondremos en contacto contigo",
      email: "correo electrónico",
      phone: "número de teléfono",
      interest: "¿En qué estás interesado?",
      send: "enviar",
      success: "¡Gracias por contactarnos! Nos pondremos en contacto contigo pronto."
    }
  };

  function updateContent(rawLang: string) {
    const lang = rawLang.toLowerCase() as keyof Translations;
    const content = translations[lang] || translations.en;
    
    const elements = {
      title: document.querySelector('.form-title'),
      subtitle: document.querySelector('.form-subtitle'),
      emailLabel: document.querySelector('label[for="email"]'),
      phoneLabel: document.querySelector('label[for="phone"]'),
      interestLabel: document.querySelector('label[for="description"]'),
      sendBtn: document.querySelector('.submit-btn span')
    };

    if (elements.title) elements.title.textContent = content.title;
    if (elements.subtitle) elements.subtitle.innerHTML = content.subtitle;
    if (elements.emailLabel) elements.emailLabel.textContent = content.email;
    if (elements.phoneLabel) elements.phoneLabel.textContent = content.phone;
    if (elements.interestLabel) elements.interestLabel.textContent = content.interest;
    if (elements.sendBtn) elements.sendBtn.textContent = content.send;
  }

  // Escuchar cambios de idioma desde el navbar
  window.addEventListener('ui:languagechange', ((event: Event) => {
    const customEvent = event as CustomEvent<{language: string}>;
    if (customEvent.detail?.language) {
      updateContent(customEvent.detail.language);
    }
  }) as EventListener);

  // Aplicar traducciones iniciales
  document.addEventListener('DOMContentLoaded', () => {
    const storedLang = localStorage.getItem('ui-language') || 'EN';
    updateContent(storedLang);
  });
</script>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png" />
    <title>Zelify — Let's Talk</title>
  </head>

  <body>
    <Navbar
      logoSrc="/images/zelify_logo.png"
      colors={{
        text: "#004195",
        textHover: "#002B62",
        highlightBg: "#6AFF00",
        highlightText: "#0b132b",
        btnLightBg: "#E7EDF6",
        btnLightHoverBg: "#DAE4F1",
        btnLightText: "#004195",
        btnOutline: "#E7EDF6",
        btnOutlineHover: "#ffffff",
        dropdownBg: "#ffffff",
        dropdownLink: "#1e2b3a",
        dropdownHoverBg: "#EEF3F9",
        radius: "22px",
      }}
      buttons={{
        first: { label: "Work with us", href: "/jobs" },
        second: { label: "Business access", href: "https://www.zelify.io/" },
        third: { label: "EN", href: "/" },
      }}
    />
    <ProductsPanel />
    
    <section class="contact-section">
      <div class="form-container">
        <h1 class="form-title">Let's Talk!</h1>
        <p class="form-subtitle">Tell us about your project<br/>and we'll get in touch with you</p>
        
        <form id="contact-form" class="contact-form">
          <div class="form-row">
            <div class="form-group">
              <label for="email" class="form-label">Email</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                class="form-input" 
                placeholder="your@email.com"
                required
              />
            </div>

            <div class="form-group">
              <label for="phone" class="form-label">Phone number</label>
              <input 
                type="tel" 
                id="phone" 
                name="phone" 
                class="form-input" 
                placeholder="+1 234 567 8900"
                required
              />
            </div>
          </div>

          <div class="form-group">
            <label for="description" class="form-label">What are you interested in?</label>
            <textarea 
              id="description" 
              name="description" 
              class="form-textarea" 
              placeholder="Describe your project or what you need..."
              rows="5"
              required
            ></textarea>
          </div>

          <div class="form-actions">
            <button type="submit" class="submit-btn">
              <span>send</span>
            </button>
          </div>
        </form>
      </div>
    </section>
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    width: 100%;
    font-family: "NataSans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: #E7EDF6;
    color: #0b132b;
  }

  .contact-section {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
  }

  .form-container {
    width: 100%;
    max-width: 600px;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .form-title {
    font-size: 3rem;
    font-weight: 700;
    color: #004195;
    margin: 0 0 0.5rem 0;
    text-align: left;
    line-height: 1.2;
  }

  .form-subtitle {
    font-size: 1rem;
    color: #6B7280;
    margin: 0 0 2.5rem 0;
    text-align: left;
    font-weight: 400;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 400;
    color: #4B5563;
    margin-bottom: 0.5rem;
    text-transform: capitalize;
    font-family: inherit;
  }

  .form-input,
  .form-textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    font-family: inherit;
    border: 1px solid #004195;
    border-radius: 6px;
    background-color: #E7EDF6;
    color: #0b132b;
    transition: border-color 0.2s ease;
    box-sizing: border-box;
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: #9CA3AF;
    font-weight: 400;
  }

  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: #004195;
  }

  .form-input:hover,
  .form-textarea:hover {
    border-color: #004195;
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
    font-family: inherit;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.5rem;
  }

  .submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    font-size: 1rem;
    font-weight: 400;
    color: #0b132b;
    background-color: #6aff00;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.2s ease;
    font-family: inherit;
    text-transform: lowercase;
  }

  .submit-btn:hover {
    background-color: #85ef00;
  }

  .submit-btn span {
    text-transform: lowercase;
  }

  @media (max-width: 768px) {
    .contact-section {
      padding: 3rem 1.5rem;
    }

    .form-title {
      font-size: 2.25rem;
    }

    .form-row {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .form-actions {
      justify-content: stretch;
    }

    .submit-btn {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .form-title {
      font-size: 1.875rem;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    
    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        
        const formData = new FormData(form);
        const data = {
          email: formData.get("email"),
          phone: formData.get("phone"),
          description: formData.get("description"),
        };

        // Aquí puedes agregar la lógica para enviar el formulario
        console.log("Form data:", data);
        
        // Obtener el idioma actual para el mensaje
        const currentLang = localStorage.getItem('ui-language') || 'EN';
        const lang = currentLang.toLowerCase() === 'es' ? 'es' : 'en';
        const translations: Record<'en' | 'es', string> = {
          en: "Thank you for contacting us! We'll get in touch with you soon.",
          es: "¡Gracias por contactarnos! Nos pondremos en contacto contigo pronto."
        };
        
        // Mensaje de confirmación
        alert(translations[lang] || translations.en);
        
        // Resetear formulario
        form.reset();
      });
    }
  });
</script>
