---
import Navbar from "../components/navbar.astro";
import ProductsPanel from "../components/productsPanel.astro";
import "../styles/navbar.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Zelify — Let's Talk</title>
  </head>

  <body>
    <Navbar
      logoSrc="/images/zelify_logo.png"
      colors={{
        text: "#004195",
        textHover: "#002B62",
        highlightBg: "#6AFF00",
        highlightText: "#0b132b",
        btnLightBg: "#E7EDF6",
        btnLightHoverBg: "#DAE4F1",
        btnLightText: "#004195",
        btnOutline: "#E7EDF6",
        btnOutlineHover: "#ffffff",
        dropdownBg: "#ffffff",
        dropdownLink: "#1e2b3a",
        dropdownHoverBg: "#EEF3F9",
        radius: "22px",
      }}
      buttons={{
        first: { label: "Work with us", href: "/" },
        second: { label: "Bank access", href: "https://www.zelify.io/" },
        third: { label: "EN", href: "/" },
      }}
    />
    <ProductsPanel />
    
    <section class="contact-section">
      <div class="form-container">
        <h1 class="form-title">Let's Talk</h1>
        <p class="form-subtitle">Tell us about your project and we'll get in touch with you</p>
        
        <form id="contact-form" class="contact-form">
          <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              class="form-input" 
              placeholder="your@email.com"
              required
            />
          </div>

          <div class="form-group">
            <label for="phone" class="form-label">Phone number</label>
            <input 
              type="tel" 
              id="phone" 
              name="phone" 
              class="form-input" 
              placeholder="+1 234 567 8900"
              required
            />
          </div>

          <div class="form-group">
            <label for="description" class="form-label">What are you interested in?</label>
            <textarea 
              id="description" 
              name="description" 
              class="form-textarea" 
              placeholder="Describe your project or what you need..."
              rows="5"
              required
            ></textarea>
          </div>

          <button type="submit" class="submit-btn">
            <span>Send</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
            </svg>
          </button>
        </form>
      </div>
    </section>
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    width: 100%;
    font-family: "NataSans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: #f8f9fa;
    color: #0b132b;
  }

  .contact-section {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    background-color: #ffffff;
  }

  .form-container {
    width: 100%;
    max-width: 600px;
    animation: fadeInUp 0.6s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .form-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #004195;
    margin: 0 0 0.5rem 0;
    text-align: center;
  }

  .form-subtitle {
    font-size: 1.1rem;
    color: #666;
    margin: 0 0 3rem 0;
    text-align: center;
    font-weight: 400;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .form-label {
    font-size: 1rem;
    font-weight: 600;
    color: #004195;
    margin-bottom: 0.25rem;
  }

  .form-input,
  .form-textarea {
    width: 100%;
    padding: 1rem 1.25rem;
    font-size: 1rem;
    font-family: inherit;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    background-color: #ffffff;
    color: #0b132b;
    transition: all 0.3s ease;
    box-sizing: border-box;
  }

  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: #6aff00;
    box-shadow: 0 0 0 4px rgba(106, 255, 0, 0.1);
    transform: translateY(-2px);
  }

  .form-input:hover,
  .form-textarea:hover {
    border-color: #004195;
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
    font-family: inherit;
  }

  .submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.25rem 2.5rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: #0b132b;
    background-color: #6aff00;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 1rem;
    font-family: inherit;
  }

  .submit-btn:hover {
    background-color: #85ef00;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(106, 255, 0, 0.3);
  }

  .submit-btn:active {
    transform: translateY(0);
  }

  .submit-btn svg {
    transition: transform 0.3s ease;
  }

  .submit-btn:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .contact-section {
      padding: 2rem 1rem;
    }

    .form-title {
      font-size: 2rem;
    }

    .form-subtitle {
      font-size: 1rem;
    }

    .form-input,
    .form-textarea {
      padding: 0.9rem 1rem;
    }

    .submit-btn {
      padding: 1rem 2rem;
      font-size: 1rem;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form");
    
    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        
        const formData = new FormData(form);
        const data = {
          email: formData.get("email"),
          phone: formData.get("phone"),
          description: formData.get("description"),
        };

        // Aquí puedes agregar la lógica para enviar el formulario
        console.log("Form data:", data);
        
        // Mensaje de confirmación (puedes personalizarlo)
        alert("Thank you for contacting us! We'll get in touch with you soon.");
        
        // Resetear formulario
        form.reset();
      });
    }
  });
</script>

