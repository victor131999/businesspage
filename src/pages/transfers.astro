---
import DeviceFrame from "@/components/DeviceFrame.astro";
import BasicServiceApp from "@/components/transfers_payments/BasicServiceApp.astro";
import CustomKeys from "@/components/transfers_payments/CustomKeys.astro";
import TransfersViewApp from "@/components/transfers_payments/TransfersViewApp.astro";
import { BASIC_SERVICES_TRANSLATIONS } from "@/components/transfers_payments/use-basic-services-translations";
import Navbar3 from "../components/NavbarSimple.astro";
import ProductsPanel from "../components/productsPanel.astro";
import { AlaizaAssistant } from "../components/AlaizaAssistant";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/png"
      href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png"
    />
    <title>Zelify | Transfers</title>
  </head>

  <body>
    <header class="auth-header">
      <Navbar3 />
      <ProductsPanel />
    </header>

    <main class="auth-main">
      <section class="auth-hero">
        <h1 class="auth-title">
          Movimientos instantáneos,<br />
          control total.
        </h1>
        <p class="auth-description">
          Gestión unificada de transferencias nacionales e internacionales,<br
          />
          pagos de servicios y cobros QR. Validación en tiempo real,<br />
          conciliación automática y máxima seguridad en cada<br />
          operación financiera.
        </p>
        <div class="auth-cta">
          <form
            class="welcome-input-group"
            action="#"
            aria-label="Solicitar cotización"
            novalidate
          >
            <input
              class="welcome-input"
              type="email"
              name="email"
              placeholder="Ingresa tu correo"
              aria-label="Ingresa tu correo"
              data-i18n-placeholder="home.welcome.email.placeholder"
              data-i18n-aria="home.welcome.email.aria"
            />
            <button class="welcome-quote-button" type="submit">Cotizar</button>
          </form>
          <a
            href="https://www.zelify.com/clips"
            class="welcome-demo-button"
            target="_blank"
            rel="noopener noreferrer">Demo</a
          >
        </div>
      </section>
    </main>

    <div class="auth-background-section">
      <div class="auth-background-image">
        <video class="auth-video" autoplay loop muted playsinline>
          <source
            src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/videos/transferspayments.mp4"
            type="video/mp4"
          />
        </video>
      </div>

      <!-- Botones de Navegación (Transparentes) -->
      <div class="view-switcher">
        <button class="view-btn active" data-target="basic-service"
          >Basic Service</button
        >
        <button class="view-btn" data-target="transfers">Transfers</button>
        <button class="view-btn" data-target="custom-keys">Custom Keys</button>
      </div>

      <!-- Contenedor del dispositivo móvil -->
      <DeviceFrame class="device-container">
        <!-- View 1: Basic Service (TransferApp / BasicServicesView) -->
        <div id="view-basic-service" class="view-content">
          <BasicServiceApp />
        </div>

        <!-- View 2: Transfers (Generic) -->
        <div id="view-transfers" class="view-content hidden">
          <TransfersViewApp />
        </div>

        <!-- View 3: Custom Keys (Generic) -->
        <div id="view-custom-keys" class="view-content hidden">
          <CustomKeys />
        </div>
      </DeviceFrame>
    </div>

    <!-- Sección de Seguridad Inteligente -->
    <section class="security-section">
      <div class="security-container">
        <h2 class="security-title">
          Infraestructura de pagos<br />
          robusta e inteligente.
        </h2>

        <div class="security-features">
          <!-- Feature 1: Cotización y validación -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icono: Doc/Calc -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                ></path>
                <path d="M14 2v6h6"></path>
                <path d="M16 13H8"></path>
                <path d="M16 17H8"></path>
                <path d="M10 9H8"></path>
              </svg>
            </div>
            <h3 class="feature-title">Cotización y validación</h3>
            <p class="feature-description">
              Simulación previa con cálculo de comisiones, tasas de cambio y
              validación de saldo en tiempo real.
            </p>
          </div>

          <!-- Feature 2: Transferencias internas -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icono: Arrows/Exchange -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"
                ></path>
              </svg>
            </div>
            <h3 class="feature-title">Transferencias internas</h3>
            <p class="feature-description">
              Envíos instantáneos y seguros entre cuentas del ecosistema Zelify
              con liquidación inmediata.
            </p>
          </div>

          <!-- Feature 3: Conectividad Global -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icono: Globe -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path
                  d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                ></path>
              </svg>
            </div>
            <h3 class="feature-title">Conectividad Global</h3>
            <p class="feature-description">
              Integración con SWIFT, ACH, SEPA y redes locales para
              transferencias internacionales eficientes.
            </p>
          </div>

          <!-- Feature 4: Pagos de Servicios -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icono: Credit Card/Bill -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
              </svg>
            </div>
            <h3 class="feature-title">Pagos de Servicios</h3>
            <p class="feature-description">
              Gestión integral de servicios básicos, recargas, deudas y
              suscripciones recurrentes.
            </p>
          </div>

          <!-- Feature 5: Pagos con QR -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icono: QR Code generic -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
            </div>
            <h3 class="feature-title">Pagos con QR</h3>
            <p class="feature-description">
              Generaci?n y cobro inmediato mediante est?ndares QR est?ticos y
              din?micos (EMV).
            </p>
          </div>

          <!-- Feature 6: Control y Seguridad -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icono: Shield/Radar -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h3 class="feature-title">Control y Seguridad</h3>
            <p class="feature-description">
              Límites transaccionales configurables, tokenización de llaves y
              notificaciones automáticas.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Control Total -->
    <section class="control-section">
      <div class="control-container">
        <div class="control-divider"></div>
        <h2 class="control-title">Infraestructura de Pagos y Transferencias</h2>

        <div class="control-features">
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://plus.unsplash.com/premium_photo-1740533182118-f181023d0021?q=80&w=1267&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                    alt="Transferencias Globales"
                  />
                </div>
                <h3 class="control-feature-title">Transferencias Globales</h3>
                <p class="control-feature-description">
                  Movimiento de dinero instantáneo entre cuentas internas e
                  instituciones financieras nacionales e internacionales.
                </p>
                <button class="control-feature-btn" data-feature="transfers">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">
                  Beneficios de Transferencias
                </h3>
                <ul class="control-feature-benefits">
                  <li>Cotización y tasas en tiempo real</li>
                  <li>Conexión SWIFT, ACH, SEPA y local</li>
                  <li>Liquidación instantánea interna</li>
                  <li>Validación previa de fondos (Quote)</li>
                  <li>Conciliación automática</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="transfers"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1559526324-4b87b5e36e44?w=800&h=500&fit=crop&q=80"
                    alt="Pagos y Servicios"
                  />
                </div>
                <h3 class="control-feature-title">Ecosistema de Pagos</h3>
                <p class="control-feature-description">
                  Plataforma unificada para pago de servicios básicos, cobros
                  con QR dinámicos y gestión de suscripciones recurrentes.
                </p>
                <button class="control-feature-btn" data-feature="payments">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Beneficios de Pagos</h3>
                <ul class="control-feature-benefits">
                  <li>Pago de servicios y deudas pendientes</li>
                  <li>QR estáticos y dinámicos (EMV)</li>
                  <li>Débitos automáticos y recurrentes</li>
                  <li>Catálogo de empresas por país</li>
                  <li>Gestión de servicios favoritos</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="payments"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1563986768609-322da13575f3?w=800&h=500&fit=crop&q=80"
                    alt="Control y Seguridad"
                  />
                </div>
                <h3 class="control-feature-title">Control y Seguridad</h3>
                <p class="control-feature-description">
                  Gestión avanzada de riesgos con límites transaccionales
                  flexibles, tokenización de llaves y validación de cuentas.
                </p>
                <button class="control-feature-btn" data-feature="security">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Beneficios de Seguridad</h3>
                <ul class="control-feature-benefits">
                  <li>Límites transaccionales multinivel</li>
                  <li>Llaves personalizadas (Alias/Tokenización)</li>
                  <li>Validación de cuenta y saldo</li>
                  <li>Notificaciones multicanal (SMS/WhatsApp)</li>
                  <li>Pistas de auditoría completas</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="security"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1555099962-4199c345e5dd?w=800&h=500&fit=crop&q=80"
                    alt="SDK de Pagos"
                  />
                </div>
                <h3 class="control-feature-title">SDK de Pagos</h3>
                <p class="control-feature-description">
                  Componentes nativos listos para usar que aceleran la
                  integración de flujos de pago y transferencias en tu app.
                </p>
                <button class="control-feature-btn" data-feature="sdk">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Beneficios del SDK</h3>
                <ul class="control-feature-benefits">
                  <li>Componentes UI/UX pre-construidos</li>
                  <li>Manejo de errores y reintentos</li>
                  <li>Soporte para iOS, Android y Web</li>
                  <li>Personalización de marca (White-label)</li>
                  <li>Entornos Sandbox seguros</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="sdk"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Contacto -->
    <section class="contact-section">
      <div class="contact-container">
        <div class="contact-content">
          <!-- Texto izquierdo -->
          <div class="contact-text">
            <h2 class="contact-title">
              Comienza a construir el banco del futuro, hoy.
            </h2>
          </div>

          <!-- Formulario derecho -->
          <div class="contact-form-wrapper">
            <div class="contact-form-card">
              <h3 class="contact-form-title">Habla con nuestro equipo</h3>

              <form class="contact-form" id="contactForm">
                <div class="form-row">
                  <div class="form-group">
                    <input
                      type="text"
                      id="nombres"
                      placeholder="Nombres"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <input
                      type="text"
                      id="apellidos"
                      placeholder="Apellidos"
                      required
                    />
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <input
                      type="text"
                      id="compania"
                      placeholder="Nombre de la compañía"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <input
                      type="email"
                      id="email"
                      placeholder="Email de la compañía"
                      required
                    />
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <select id="pais" required>
                      <option value="">País</option>
                      <option value="mx">México</option>
                      <option value="co">Colombia</option>
                      <option value="ar">Argentina</option>
                      <option value="cl">Chile</option>
                      <option value="pe">Perú</option>
                      <option value="es">España</option>
                      <option value="us">Estados Unidos</option>
                    </select>
                    <svg
                      class="select-arrow"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </div>
                  <div class="form-group">
                    <input
                      type="tel"
                      id="telefono"
                      placeholder="Teléfono (opcional)"
                    />
                  </div>
                </div>

                <p class="contact-legal">
                  Al enviar este formulario, aceptas nuestros <a href="#"
                    >Términos de Servicio</a
                  > y <a href="#">Política de Privacidad</a>.
                </p>

                <button type="submit" class="contact-submit-btn">
                  Hablemos
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de FAQ -->
    <section class="faq-section">
      <div class="faq-container">
        <h2 class="faq-title">Preguntas frecuentes</h2>

        <div class="faq-list">
          <div class="faq-item">
            <button class="faq-question" data-faq="1">
              <span>¿Qué tipos de movimientos financieros puedo realizar?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Zelify Transfers & Payments permite realizar transferencias
                internas instantáneas, envíos interbancarios nacionales e
                internacionales (SWIFT, ACH, SEPA), pagos de servicios básicos y
                digitales, cobros mediante códigos QR dinámicos y la
                automatización de pagos recurrentes para suscripciones.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="2">
              <span>¿Cómo se aseguran de que una transferencia no falle?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Antes de procesar cualquier movimiento, el sistema realiza una
                validación en tiempo real (quote) que verifica la existencia de
                la cuenta, la disponibilidad de saldo suficiente y el
                cumplimiento de límites. Esto incluye el cálculo preciso de
                comisiones y tasas de cambio para garantizar transparencia total
                antes de confirmar la operación.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="3">
              <span
                >¿Es necesario ingresar siempre los datos bancarios del
                receptor?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                No es estrictamente necesario. Gracias a nuestro sistema de
                "Llaves Personalizadas" y tokenización PCI-DSS, los usuarios
                pueden enviar dinero utilizando alias como el correo electrónico
                o número de teléfono. Esto agiliza la experiencia sin exponer
                datos sensibles de la cuenta en cada transacción.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="4">
              <span
                >¿Cómo se gestionan los límites y la seguridad transaccional?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Contamos con un motor de límites multi-dimensionales que permite
                establecer umbrales diarios, semanales o mensuales por usuario u
                organización. Además, el módulo integra detección de fraude
                automática y notificaciones en tiempo real por SMS, Email o
                WhatsApp para cada movimiento (Pay-in/Pay-out).
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="5">
              <span
