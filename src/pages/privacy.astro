<script>
  const PRIVACY_HERO = {
    es: {
      title: "Política de privacidad",
      lead: "Protección de datos de carácter personal según la LOPD-GDD",
    },
    en: {
      title: "Privacy policy",
      lead: "Personal data protection under applicable law (GDPR / LOPD-GDD)",
    },
  };
  function getLang() {
    try {
      const stored = localStorage.getItem("ui-language");
      return (stored && stored.toUpperCase() === "ES") ? "es" : "en";
    } catch { return "en"; }
  }
  function applyPrivacyLang() {
    const lang = getLang();
    const hero = PRIVACY_HERO[lang] || PRIVACY_HERO.en;
    const titleEl = document.getElementById("privacy-hero-title");
    const leadEl = document.getElementById("privacy-hero-lead");
    if (titleEl) titleEl.textContent = hero.title;
    if (leadEl) leadEl.textContent = hero.lead;
    const esBlock = document.getElementById("privacy-es");
    const enBlock = document.getElementById("privacy-en");
    if (esBlock) esBlock.hidden = lang !== "es";
    if (enBlock) enBlock.hidden = lang !== "en";
    document.documentElement.lang = lang === "es" ? "es" : "en";
  }
  if (typeof document !== "undefined") {
    document.addEventListener("DOMContentLoaded", applyPrivacyLang);
    window.addEventListener("ui:languagechange", () => applyPrivacyLang());
  }
</script>

