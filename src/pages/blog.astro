---
import Navbar from "../components/NavbarSimple.astro";
import ProductsPanel from "../components/productsPanel.astro";
import "../styles/navbar.css";
---

<script>
    const blogTranslations = {
      en: {
        // Meta / Head
        pageTitle: "Zelify — Business Blog",
  
        // Img alts
        heroImgAlt: "Blog image: person facing camera",
        fingerprintAlt: "Fingerprint",
        securityFingerprintAlt: "Security fingerprint",
  
        // Section 1: Hero
        blogTitle1: "How\nZelify Auth\nReinvents\nSecure\nOnboarding\nfor Fintechs.",
        blogDate: "27 October 2025",
        blogAuthor: " ",
  
        // Section 2: Intro
        blogIntro:
          "Authentication is the pillar of the fintech ecosystem, where security and user experience must coexist. Modern financial platforms rely on advanced methods such as OAuth, biometric validation, and OTP codes to ensure secure access, prevent fraud, and maintain compliance with international regulations, all while keeping the customer journey frictionless.",
  
        // Section 3: Challenge
        blogTitle3: "The Challenge of\nAuthentication\nin Fintech",
        blogText3:
          "Traditional authentication methods like passwords or simple PINs are no longer enough. Fintechs now face advanced threats such as account takeover, phishing, synthetic identities, and remote fraud. To protect both users and compliance integrity, authentication systems must evolve with smarter and layered protection.",
  
        // Section 4: Building trust
        blogTitle4: "Building trust through secure innovation",
        blogDesc4:
          "Zelify Auth integrates multiple authentication technologies to deliver a secure and scalable identity experience:",
        featureOAuth: "OAuth Integration:",
        featureOAuthDesc:
          "Connect and authenticate users through trusted providers like Google, Apple, or Facebook, reducing login friction.",
        featureOTP: "OTP Validation:",
        featureOTPDesc:
          "Confirm transactions or critical actions with one-time passcodes sent securely via email or SMS.",
        featureGeolocation: "Geolocation:",
        featureGeolocationDesc:
          "Detects login anomalies or high-risk areas to trigger adaptive verification.",
        featureDevice: "Device Intelligence:",
        featureDeviceDesc:
          "Collects secure device data (IP, OS version, permissions) to identify suspicious devices.",
  
        // Section 5: Benefits
        blogTitle5: "Benefits for\nFinancial\nPlatforms",
        benefit1: "Reduced fraud and identity theft through multi-factor verification.",
        benefit2: "Frictionless user experience with one-click or biometric login.",
        benefit3: "Regulatory compliance (ISO 30107-3, PCI DSS, LOPDP).",
        benefit4: "Easy integration via APIs and SDKs for web or mobile apps.",
        trustTitle: "Why Trust Zelify?",
        trustDesc:
          "Zelify Auth is designed with a \"security by design\" mindset, combining encryption, behavioral analysis, and regional compliance for fintechs across Latin America. With flexible APIs and SDKs, businesses can quickly integrate strong authentication without sacrificing agility or user experience.",
        btnDemo: "Request a Demo",
        btnIntegration: "Start Integration",
      },
      es: {
        // Meta / Head
        pageTitle: "Zelify — Blog de Negocios",
  
        // Img alts
        heroImgAlt: "Imagen del blog: persona de frente",
        fingerprintAlt: "Huella dactilar",
        securityFingerprintAlt: "Huella de seguridad",
  
        // Sección 1: Hero
        blogTitle1: "Cómo\nZelify Auth\nReinventa\nEl Onboarding\nSeguro\npara Fintechs.",
        blogDate: "27 de Octubre 2025",
        blogAuthor: " ",
  
        // Sección 2: Intro
        blogIntro:
          "La autenticación es el pilar del ecosistema fintech, donde la seguridad y la experiencia del usuario deben coexistir. Las plataformas financieras modernas dependen de métodos avanzados como OAuth, validación biométrica y códigos OTP para asegurar el acceso, prevenir fraudes y mantener el cumplimiento con regulaciones internacionales, todo mientras mantienen el recorrido del cliente sin fricciones.",
  
        // Sección 3: Desafío
        blogTitle3: "El Desafío de la\nAutenticación\nen Fintech",
        blogText3:
          "Los métodos tradicionales de autenticación como contraseñas o PINs simples ya no son suficientes. Las fintechs ahora enfrentan amenazas avanzadas como la toma de cuentas, phishing, identidades sintéticas y fraude remoto. Para proteger tanto a los usuarios como la integridad del cumplimiento, los sistemas de autenticación deben evolucionar con protección más inteligente y en capas.",
  
        // Sección 4: Confianza
        blogTitle4: "Generando confianza a través de la innovación segura",
        blogDesc4:
          "Zelify Auth integra múltiples tecnologías de autenticación para ofrecer una experiencia de identidad escalable y segura:",
        featureOAuth: "Integración OAuth:",
        featureOAuthDesc:
          "Conecta y autentica usuarios mediante proveedores confiables como Google, Apple o Facebook, reduciendo la fricción de inicio de sesión.",
        featureOTP: "Validación OTP:",
        featureOTPDesc:
          "Confirma transacciones o acciones críticas con códigos de un solo uso enviados de forma segura por email o SMS.",
        featureGeolocation: "Geolocalización:",
        featureGeolocationDesc:
          "Detecta anomalías de inicio de sesión o áreas de alto riesgo para activar verificación adaptativa.",
        featureDevice: "Inteligencia de Dispositivo:",
        featureDeviceDesc:
          "Recopila datos seguros del dispositivo (IP, versión del SO, permisos) para identificar posibles amenazas.",
  
        // Sección 5: Beneficios
        blogTitle5: "Beneficios para\nPlataformas\nFinancieras",
        benefit1: "Menos fraude e identidad protegida mediante verificación multifactorial.",
        benefit2: "Experiencia de usuario sin fricción: acceso con un clic o login biométrico.",
        benefit3: "Cumplimiento regulatorio (ISO 30107-3, PCI DSS, LOPDP).",
        benefit4: "Fácil integración vía API o SDK para web y apps móviles.",
        trustTitle: "¿Por qué confiar en Zelify?",
        trustDesc:
          "Zelify Auth está diseñado con una mentalidad \"security by design\", combinando cifrado, análisis de comportamiento y cumplimiento regulatorio para fintechs de Latinoamérica. Con APIs y SDK flexibles, integra autenticación fuerte sin sacrificar agilidad ni experiencia del usuario.",
        btnDemo: "Solicitar Demo",
        btnIntegration: "Empezar Integración",
      },
    };
  
    function updateBlogContent(rawLang: string | undefined) {
      const lang = String(rawLang || "en").toLowerCase() === "es" ? "es" : "en";
      const content = blogTranslations[lang];

      // Helpers
      const updateWithBreaks = (el: Element | null, text: string) => {
        if (el) el.innerHTML = String(text).replace(/\n/g, "<br />");
      };
      const updateText = (el: Element | null, text: string) => {
        if (el) el.textContent = String(text);
      };
      const updateAlt = (selector: string, text: string) => {
        const img = document.querySelector(selector);
        if (img) img.setAttribute("alt", String(text));
      };
  
      // Head title
      document.title = content.pageTitle;
  
      // Section 1: Hero
      updateWithBreaks(document.querySelector(".blog-title1"), content.blogTitle1);
      updateText(document.querySelector(".blog-date"), content.blogDate);
      updateText(document.querySelector(".blog-author"), content.blogAuthor);
  
      // Section 2: Intro (bold first sentence)
      const introElement = document.querySelector(".blog-intro");
      if (introElement) {
        const firstSentence = content.blogIntro.split(".")[0] + ".";
        const restOfText = content.blogIntro.substring(firstSentence.length);
        introElement.innerHTML = `<strong>${firstSentence}</strong>${restOfText}`;
      }
  
      // Section 3: Challenge
      updateWithBreaks(document.querySelector(".blog-title3"), content.blogTitle3);
      updateText(document.querySelector(".blog-text3-p"), content.blogText3);
  
      // Section 4: Building trust
      updateText(document.querySelector(".blog-title4"), content.blogTitle4);
      updateText(document.querySelector(".blog-desc4"), content.blogDesc4);
      updateText(document.querySelector(".feature-oauth-title"), content.featureOAuth);
      updateText(document.querySelector(".feature-oauth-desc"), content.featureOAuthDesc);
      updateText(document.querySelector(".feature-otp-title"), content.featureOTP);
      updateText(document.querySelector(".feature-otp-desc"), content.featureOTPDesc);
      updateText(document.querySelector(".feature-geolocation-title"), content.featureGeolocation);
      updateText(document.querySelector(".feature-geolocation-desc"), content.featureGeolocationDesc);
      updateText(document.querySelector(".feature-device-title"), content.featureDevice);
      updateText(document.querySelector(".feature-device-desc"), content.featureDeviceDesc);
  
      // Section 5: Benefits + Trust (fix selector names in markup)
      updateWithBreaks(document.querySelector(".blog-title5"), content.blogTitle5);
      updateText(document.querySelector(".benefit-1"), content.benefit1);
      updateText(document.querySelector(".benefit-2"), content.benefit2);
      updateText(document.querySelector(".benefit-3"), content.benefit3);
      updateText(document.querySelector(".benefit-4"), content.benefit4);
      updateText(document.querySelector(".trust-title5"), content.trustTitle); // was .trust-title
      updateText(document.querySelector(".trust-desc5"), content.trustDesc);   // was .trust-desc
      updateText(document.querySelector(".btn-demo"), content.btnDemo);
      updateText(document.querySelector(".btn-integration"), content.btnIntegration);
  
      // Img alts
      updateAlt("img.blog-img", content.heroImgAlt);
      updateAlt("img.blog-img3", content.fingerprintAlt);
      updateAlt("img.blog-img5", content.securityFingerprintAlt);
    }
  
    // Listen for language changes from Navbar
    window.addEventListener("ui:languagechange", ((event: Event) => {
      const customEvent = event as CustomEvent<{ language: string }>;
      if (customEvent.detail?.language) {
        updateBlogContent(customEvent.detail.language);
      }
    }) as EventListener);
  
    // Initial translations
    document.addEventListener("DOMContentLoaded", () => {
      const storedLang = localStorage.getItem("ui-language") || "EN";
      updateBlogContent(storedLang);
    });
  </script>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png" />
    <title>Zelify — Business Blog</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/hover.css/2.3.1/css/hover-min.css"
    />
  </head>

  <body>
    <Navbar />
    <ProductsPanel />
    <!-- Contenido del blog para la pagina -->
    <main>
      <section class="blog-content">
        <div class="blog-container1">
          <!-- Left column with image -->
          <div class="blog-image">
            <img
              src="/images/img-blog-face.png"
              alt="Blog Image"
              class="blog-img"
            />
          </div>

          <!-- Right column with text -->
          <div class="blog-text">
            <h1 class="blog-title1">
              How <br /> Zelify Auth <br /> Reinvents<br /> Secure<br /> Onboarding<br
              />for Fintechs.
            </h1>

            <!-- Información adicional debajo del título -->
            <div class="meta-info">
              <span class="blog-date">27 October 2025</span>
              <span class="blog-author"> </span>
            </div>
          </div>
        </div>

        <div class="blog-container2">
          <!-- Columna izquierda con imagen (removido, solo se usa texto ahora) -->
          <div class="blog-text2">
            <p class="blog-intro">
              <strong
                >Authentication is the pillar of the fintech ecosystem</strong
              >, where security and user experience must coexist. Modern
              financial platforms rely on advanced methods such as OAuth,
              biometric validation, and OTP codes to ensure secure access,
              prevent fraud, and maintain compliance with international
              regulations, all while keeping the customer journey frictionless.
            </p>
          </div>
        </div>
        <div class="blog-container3">
          <!-- Columna de texto alineada a la izquierda -->
          <div class="blog-text3">
            <h1 class="blog-title3">
              The Challenge of<br />
              Authentication<br />
              in Fintech
            </h1>
            <p class="blog-text3-p">
              Traditional authentication methods like passwords or simple PINs
              are no longer enough. Fintechs now face advanced threats such as
              account takeover, phishing, synthetic identities, and remote
              fraud. To protect both users and compliance integrity,
              authentication systems must evolve with smarter and layered
              protection.
            </p>
          </div>

          <!-- Columna de la imagen -->
          <div class="blog-image3">
            <img
              src="/images/img-blog-fingerprint.png"
              alt="Fingerprint"
              class="blog-img3"
            />
          </div>
        </div>
        <!-- SECCION: Building trust through secure innovation -->
        <div class="blog-container4">
          <div class="blog-text4">
            <h1 class="blog-title4">Building trust through secure innovation</h1>
            <p class="blog-desc4">
              Zelify Auth integrates multiple authentication technologies to
              deliver a secure and scalable identity experience:
            </p>
            <div class="blog-features">
              <div class="blog-feature">
                <span class="feature-icon"></span>
                <div class="feature-content">
                  <h3 class="feature-oauth-title">OAuth Integration:</h3>
                  <p class="feature-oauth-desc">
                    Connect and authenticate users through trusted providers like
                    Google, Apple, or Facebook, reducing login friction.
                  </p>
                </div>
              </div>
              <div class="blog-feature">
                <span class="feature-icon"></span>
                <div class="feature-content">
                  <h3 class="feature-otp-title">OTP Validation:</h3>
                  <p class="feature-otp-desc">
                    Confirm transactions or critical actions with one-time
                    passcodes sent securely via email or SMS.
                  </p>
                </div>
              </div>
              <div class="blog-feature">
                <span class="feature-icon"></span>
                <div class="feature-content">
                  <h3 class="feature-geolocation-title">Geolocation:</h3>
                  <p class="feature-geolocation-desc">
                    Detects login anomalies or high-risk areas to trigger adaptive
                    verification.
                  </p>
                </div>
              </div>
              <div class="blog-feature">
                <span class="feature-icon"></span>
                <div class="feature-content">
                  <h3 class="feature-device-title">Device Intelligence:</h3>
                  <p class="feature-device-desc">
                    Collects secure device data (IP, OS version, permissions) to
                    identify suspicious devices.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- SECCION: Beneficios y confianza -->
        <div class="blog-container5">
          <!-- Parte superior: Imagen y beneficios -->
          <div class="blog-container5-top">
            <!-- Imagen a la izquierda -->
            <div class="blog-image5">
              <img
                src="/images/img-blog-sec.png"
                alt="Security Fingerprint"
                class="blog-img5"
              />
            </div>
            <!-- Texto y beneficios a la derecha -->
            <div class="blog-text5">
              <h2 class="benefits-title5 blog-title5">
                Benefits for<br />
                Financial<br />
                Platforms
              </h2>
              <ul class="benefits-list5">
                <li>
                  <span class="benefit-square5"></span>
                  <span class="benefit-1">Reduced fraud and identity theft through multi-factor
                  verification.</span>
                </li>
                <li>
                  <span class="benefit-square5"></span>
                  <span class="benefit-2">Frictionless user experience with one-click or biometric login.</span>
                </li>
                <li>
                  <span class="benefit-square5"></span>
                  <span class="benefit-3">Regulatory compliance (ISO 30107-3, PCI DSS, LOPDP).</span>
                </li>
                <li>
                  <span class="benefit-square5"></span>
                  <span class="benefit-4">Easy integration via APIs and SDKs for web or mobile apps.</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- Parte inferior: Why Trust Zelify -->
          <div class="blog-container5-bottom">
            <div class="trust-content5">
              <h2 class="trust-title5">Why Trust Zelify?</h2>
              <p class="trust-desc5">
                Zelify Auth is designed with a "security by design" mindset,
                combining encryption, behavioral analysis, and regional
                compliance for fintechs across Latin America. With flexible APIs
                and SDKs, businesses can quickly integrate strong authentication
                without sacrificing agility or user experience.
              </p>
              <div class="trust-buttons5">
                <a href="https://business.zelify.com/hablemos/" class="btn-primary5 btn-demo">Request a Demo</a>
                <a href="https://docs.zelify.com/api-reference" class="btn-primary5 btn-integration">Start Integration</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Products Panel Component -->
      <ProductsPanel />
    </main>
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  body {
    font-family:
      "NataSans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    color: #ffffff;
    background-color: #ffffff;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    height: auto; /* Cambio: altura automática */
    width: 100vw;
    margin: 0;
    overflow-y: auto; /* Permite el desplazamiento vertical */
    overflow-x: hidden; /* Opcional: previene el desplazamiento horizontal */
  }

  .hero {
    display: flex;
    align-items: flex-start; /* puedes cambiar a center o flex-end */
    justify-content: flex-start; /* puedes cambiar a center o flex-end */
    height: 100vh; /* ocupa toda la ventana */
    width: 100vw;
    position: relative;
    overflow: hidden;
  }

  /* Aquí controlas la posición manual del contenido */
  .hero-content {
    position: absolute;
    top: 15%; /* mueve hacia abajo */
    left: 20%; /* mueve hacia la derecha */
    transform: translate(0, 0); /* puedes ajustar manualmente con translate */
    max-width: 600px;
  }

  .subtitle {
    font-size: 2.5rem;
    font-weight: normal;
    color: #95ff0b;
    margin-bottom: -0.2rem;
  }

  .title {
    font-size: 6.5rem;
    font-weight: 800;
    line-height: 0.85;
    color: #f8f9fa;
    margin-bottom: 1.5rem;
  }

  .description {
    font-size: 1.25rem;
    line-height: 1.4;
    color: #ced4da;
    margin-bottom: 2rem;
    max-width: 520px;
    text-align: left;
    text-wrap: balance;
  }

  .btn-primary {
    background-color: #95ff0b;
    color: #0d1117;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.25rem;
    padding: 0.3rem 1.5rem;
    border-radius: 8px;
    display: inline-block;
    cursor: pointer;
    box-shadow:
      0 6px 16px rgba(80, 220, 0, 0.35),
      0 0 20px rgba(149, 255, 11, 0.35);
    transition: all 0.25s ease-in-out;
  }

  .btn-primary:hover {
    background: linear-gradient(
      145deg,
      rgba(128, 255, 0, 0.95),
      rgba(88, 220, 0, 0.88)
    );
    color: #10220a;
    transform: translateY(-1px);
    box-shadow: 0 16px 32px rgba(80, 220, 0, 0.38);
    transition: all 0.25s ease-in-out;
  }

  /* Tablet/iPad */
  @media (max-width: 1024px) {
    .hero-content {
      top: 18%;
      left: 10%;
      max-width: 500px;
    }

    .subtitle {
      font-size: 2rem;
    }

    .title {
      font-size: 4.5rem;
      line-height: 0.85;
      margin-bottom: 1rem;
    }

    .description {
      font-size: 1.1rem;
      max-width: 450px;
    }

    .btn-primary {
      font-size: 1.1rem;
      padding: 0.4rem 1.3rem;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    body {
      overflow: auto;
      min-height: 100vh;
      background-size: cover;
      background-position: 60% bottom;
      background-attachment: scroll;
    }

    .hero {
      overflow: auto;
      min-height: 100vh;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 0;
      padding-top: 1rem;
    }

    .hero-content {
      position: relative;
      top: auto;
      left: auto;
      padding: 1rem 1.5rem 2rem;
      margin: 0 auto;
      max-width: 100%;
      width: 100%;
      transform: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .subtitle {
      font-size: 1.5rem;
      margin-bottom: -0.2rem;
      text-align: center;
      width: 100%;
    }

    .title {
      font-size: 3rem;
      line-height: 0.85;
      margin-bottom: 1rem;
      text-align: center;
      width: 100%;
    }

    .description {
      font-size: 1rem;
      line-height: 1.5;
      margin-bottom: 1.5rem;
      max-width: 100%;
      width: 100%;
      text-align: center;
      padding: 0 1rem;
    }

    .btn-primary {
      font-size: 1rem;
      padding: 0.75rem 2rem;
      display: block;
      text-align: center;
      width: fit-content;
      margin: 0 auto;
    }
  }

  /* Small mobile */
  @media (max-width: 480px) {
    body {
      background-size: cover;
      background-position: 60% bottom;
    }

    .hero {
      padding: 0;
      padding-top: 0.5rem;
    }

    .hero-content {
      padding: 0.5rem 1rem 1.5rem;
      width: 100%;
    }

    .subtitle {
      font-size: 1.25rem;
      width: 100%;
    }

    .title {
      font-size: 2.5rem;
      width: 100%;
    }

    .description {
      font-size: 0.95rem;
      width: 100%;
      padding: 0 0.5rem;
    }

    .btn-primary {
      font-size: 0.95rem;
      padding: 0.65rem 1.8rem;
      width: fit-content;
    }
  }

  /* ------------------------------- */
  /* Inicio de la Section 1: Blog     */
  /* ------------------------------- */

  /* Estilos generales para el contenido del blog */
  .blog-content {
    padding: 0; /* Eliminar padding general alrededor de la sección */
    background-color: #ffffff; /* Fondo gris claro para la sección del blog */
    margin-top: 0; /* Asegurar que no haya margen arriba, pegado al navbar */
    min-height: 100vh; /* Altura mínima de la pantalla */
  }

  /* Contenedor que agrupa la imagen y el texto */
  .blog-container1 {
    display: flex; /* Usamos Flexbox para alinear la imagen y el texto */
    flex-direction: row; /* Coloca la imagen y el texto en fila */
    gap: 0; /* No hay espacio entre la imagen y el texto */
    min-height: 100vh; /* Altura mínima de la pantalla */
    align-items: stretch; /* Asegura que los elementos ocupen el mismo alto */
  }

  /* Estilos para la columna de la izquierda con la imagen */
  .blog-image {
    flex: 0 0 42%; /* La imagen ocupa aproximadamente 42% del espacio (40-45%) */
    height: 100%; /* Asegura que la imagen ocupe todo el alto del div */
    min-height: 100vh; /* Altura mínima de la pantalla */
    margin: 0; /* Eliminar margen alrededor de la imagen */
    overflow: hidden; /* Evitar que la imagen se desborde */
    position: relative; /* Para posicionar elementos internos */
  }

  .blog-img {
    width: 100%; /* La imagen ocupa todo el ancho del contenedor */
    height: 100%; /* La imagen ocupa todo el alto del contenedor */
    object-fit: cover; /* Hace que la imagen cubra todo el espacio disponible sin distorsionarse */
    box-shadow: none; /* Eliminamos la sombra de la imagen */
    display: block; /* Elimina espacio debajo de la imagen */
  }

  /* Estilos para la columna de la derecha con el texto */
  .blog-text {
    flex: 0 0 58%; /* El texto ocupa aproximadamente 58% del espacio (55-60%) */
    display: flex;
    flex-direction: column; /* Coloca los elementos en columna */
    gap: 1.5rem; /* Espacio entre los elementos del texto */
    padding: 5% 8%; /* Padding generoso alrededor del texto */
    background-color: #ffffff; /* Fondo gris claro */
    justify-content: center; /* Centra el contenido verticalmente */
    align-items: flex-start; /* Alinea el contenido a la izquierda */
    text-align: left; /* Alinea el texto a la izquierda */
  }

  /* Título principal */
  .blog-text h1 {
    font-family: "NataSans", sans-serif; /* Usamos la fuente NataSans */
    font-size: 5.5rem; /* Tamaño del título */
    font-weight: 800; /* Negrita */
