<!-- 
  Insurance ya no se ofrece como servicio.
  Todo el contenido ha sido comentado.
  
  Si necesitas restaurar este servicio, descomenta el código a continuación.
-->
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Insurance - Servicio no disponible</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      @font-face {
        font-family: "NataSans";
        src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
        font-weight: 100 900;
        font-display: swap;
      }

      body {
        font-family: "NataSans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: linear-gradient(135deg, #081525 0%, #0b132b 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        color: #ffffff;
        position: relative;
        overflow: hidden;
      }

      body::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: url('/images/FONDO 13.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        opacity: 0.3;
        z-index: 0;
      }

      .container {
        text-align: center;
        z-index: 1;
        position: relative;
        max-width: 600px;
        animation: fadeInUp 0.6s ease-out;
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .icon {
        font-size: 4rem;
        margin-bottom: 1.5rem;
        opacity: 0.8;
        animation: pulse 2s ease-in-out infinite;
      }

      @keyframes pulse {
        0%, 100% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.05);
        }
      }

      h1 {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 400;
        color: #84ff11;
        line-height: 1.2;
        letter-spacing: 0.5px;
      }

      @media (max-width: 640px) {
        .icon {
          font-size: 3rem;
        }

        h1 {
          font-size: 2rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="icon">⚠️</div>
      <h1>Redirigiendo a la página principal...</h1>
    </div>
    <script>
      // Redirigir automáticamente después de 1.5 segundos
      setTimeout(() => {
        window.location.href = '/';
      }, 500);
    </script>
  </body>
</html>

