---
import Navbar3 from "../components/NavbarSimple.astro";
import ProductsPanel from "../components/productsPanel.astro";
import CardsApp from "../components/cards/CardsApp.astro";
import { AlaizaAssistant } from "../components/AlaizaAssistant";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/png"
      href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png"
    />
    <title>Zelify — Cards</title>
  </head>

  <body>
    <header class="auth-header">
      <Navbar3 />
      <ProductsPanel />
    </header>

    <main class="auth-main">
      <section class="auth-hero">
        <h1 class="auth-title">
          Zelify Cards<br />
          Emisión sin fronteras.
        </h1>
        <p class="auth-description">
          Solución completa para la emisión y administración de tarjetas físicas
          y virtuales, personales y corporativas, que centraliza tokenización,
          3D Secure, procesamiento, disputas, wallets, control de riesgo,
          suscripciones, cashback y reportes en tiempo real con altos estándares
          de seguridad y trazabilidad.
        </p>
        <div class="auth-cta">
          <form
            class="welcome-input-group"
            action="#"
            aria-label="Solicitar cotización"
            novalidate
          >
            <input
              class="welcome-input"
              type="email"
              name="email"
              placeholder="ingresa tu correo"
              aria-label="Ingresa tu correo"
              data-i18n-placeholder="home.welcome.email.placeholder"
              data-i18n-aria="home.welcome.email.aria"
            />
            <button class="welcome-quote-button" type="submit">cotizar</button>
          </form>
          <a
            href="https://www.zelify.com/clips"
            class="welcome-demo-button"
            target="_blank"
            rel="noopener noreferrer">demo</a
          >
        </div>
      </section>
    </main>

    <div class="auth-background-section">
      <div class="auth-background-overlay"></div>
      <div class="auth-background-image">
        <video class="auth-video" autoplay loop muted playsinline>
          <source
            src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/video/circlesmov.mp4"
            type="video/mp4"
          />
        </video>
      </div>

      <!-- Contenedor del dispositivo móvil -->
      <CardsApp />
    </div>

    <!-- Sección de Soluciones Principales -->
    <section class="security-section">
      <div class="security-container">
        <h2 class="security-title">
          Infraestructura integral<br />
          para tu programa de tarjetas.
        </h2>

        <div class="security-features">
          <!-- Feature 1: Patrocinio BIN -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icono de Tarjeta/Banco -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
              </svg>
            </div>
            <h3 class="feature-title">Patrocinio BIN</h3>
            <p class="feature-description">
              Tu programa de tarjetas bajo un BIN patrocinado, con una
              estructura de access fee que te permite operar sin ser banco
              emisor, gestionando la relación regulatoria y operativa.
            </p>
          </div>

          <!-- Feature 2: Procesamiento -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icono de Procesamiento -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
              </svg>
            </div>
            <h3 class="feature-title">Procesamiento</h3>
            <p class="feature-description">
              Procesa cada transacción aprobada y gestiona el ciclo de vida de
              cada tarjeta activa a través de un motor que garantiza
              trazabilidad, estabilidad operativa y control total.
            </p>
          </div>

          <!-- Feature 3: Procesamiento Corporativo -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icono Corporativo -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 21h18"></path>
                <path d="M5 21V7l8-4 8 4v14"></path>
                <path d="M17 21v-8H7v8"></path>
              </svg>
            </div>
            <h3 class="feature-title">Procesamiento Corporativo</h3>
            <p class="feature-description">
              Administra programas de tarjetas empresariales con reglas y
              control en transacciones, otorgando visibilidad completa sobre
              cada tarjeta activa dentro de la operación.
            </p>
          </div>

          <!-- Feature 4: SDK de Cards -->
          <div class="security-feature">
            <div class="feature-icon">
              <!-- Icono SDK/Código -->
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            </div>
            <h3 class="feature-title">SDK de Cards</h3>
            <p class="feature-description">
              Librerías de desarrollo que facilitan la integración ágil y
              sencilla para acelerar tu implementación técnica.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Módulos y Colaterales -->
    <section class="control-section">
      <div class="control-container">
        <div class="control-divider"></div>
        <h2 class="control-title">
          Solución integral para tu programa de tarjetas
        </h2>

        <div class="control-features">
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1563013544-824ae1b704d3?w=800&h=500&fit=crop&q=80"
                    alt="Patrocinio BIN"
                  />
                </div>
                <h3 class="control-feature-title">Patrocinio BIN</h3>
                <p class="control-feature-description">
                  Opera tu programa de tarjetas sin ser un banco emisor.
                  Gestionamos la relación regulatoria para acelerar tu salida al
                  mercado.
                </p>
                <button class="control-feature-btn" data-feature="bin">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Beneficios de Patrocinio</h3>
                <ul class="control-feature-benefits">
                  <li>Estructura eficiente de Access Fee</li>
                  <li>Gestión operativa y regulatoria</li>
                  <li>Rápido Time-to-Market</li>
                  <li>Emisión de tarjetas físicas y virtuales</li>
                  <li>Cumplimiento normativo incluido</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="bin"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1556742044-3c52d6e88c62?w=800&h=500&fit=crop&q=80"
                    alt="Procesamiento de Tarjetas"
                  />
                </div>
                <h3 class="control-feature-title">Motor de Procesamiento</h3>
                <p class="control-feature-description">
                  Gestión total del ciclo de vida de la tarjeta y procesamiento
                  de transacciones aprobadas con máxima estabilidad.
                </p>
                <button class="control-feature-btn" data-feature="processing">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Control Operativo</h3>
                <ul class="control-feature-benefits">
                  <li>Trazabilidad total de transacciones</li>
                  <li>Gestión de tarjetas corporativas</li>
                  <li>Control de reglas transaccionales</li>
                  <li>Visibilidad en tiempo real</li>
                  <li>Gestión de disputas y reportes</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="processing"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1563986768609-322da13575f3?w=800&h=500&fit=crop&q=80"
                    alt="Seguridad y Capacidades Premium"
                  />
                </div>
                <h3 class="control-feature-title">Seguridad y Módulos</h3>
                <p class="control-feature-description">
                  Potencia tu programa con tokenización, CVV dinámico y
                  herramientas contra el fraude como 3DS y Falcon.
                </p>
                <button class="control-feature-btn" data-feature="premium">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Capacidades Premium</h3>
                <ul class="control-feature-benefits">
                  <li>Tokenización y Apple/Google Wallets</li>
                  <li>CVV dinámico para compras seguras</li>
                  <li>Prevención de fraude con Falcon</li>
                  <li>Autenticación 3D Secure (3DS)</li>
                  <li>Printing y logística personalizada</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="premium"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=800&h=500&fit=crop&q=80"
                    alt="SDK e Integración"
                  />
                </div>
                <h3 class="control-feature-title">SDK e Integración</h3>
                <p class="control-feature-description">
                  Librerías de desarrollo especializadas y recursos estratégicos
                  para escalar tu programa de forma sostenible.
                </p>
                <button class="control-feature-btn" data-feature="sdk-cards">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Recursos para Escalar</h3>
                <ul class="control-feature-benefits">
                  <li>SDK de Cards nativo y ágil</li>
                  <li>Fondeo inicial y garantías</li>
                  <li>Programas especiales de expansión</li>
                  <li>Integración avanzada vía APIs</li>
                  <li>Soporte técnico en implementación</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="sdk-cards"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Contacto -->
    <section class="contact-section">
      <div class="contact-container">
        <div class="contact-content">
          <!-- Texto izquierdo -->
          <div class="contact-text">
            <h2 class="contact-title">
              Comienza a construir el banco del futuro, hoy.
            </h2>
          </div>

          <!-- Formulario derecho -->
          <div class="contact-form-wrapper">
            <div class="contact-form-card">
              <h3 class="contact-form-title">Habla con nuestro equipo</h3>

              <form class="contact-form" id="contactForm">
                <div class="form-row">
                  <div class="form-group">
                    <input
                      type="text"
                      id="nombres"
                      placeholder="Nombres"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <input
                      type="text"
                      id="apellidos"
                      placeholder="Apellidos"
                      required
                    />
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <input
                      type="text"
                      id="compania"
                      placeholder="Nombre de la compañía"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <input
                      type="email"
                      id="email"
                      placeholder="Email de la compañía"
                      required
                    />
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <select id="pais" required>
                      <option value="">País</option>
                      <option value="mx">México</option>
                      <option value="co">Colombia</option>
                      <option value="ar">Argentina</option>
                      <option value="cl">Chile</option>
                      <option value="pe">Perú</option>
                      <option value="es">España</option>
                      <option value="us">Estados Unidos</option>
                    </select>
                    <svg
                      class="select-arrow"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </div>
                  <div class="form-group">
                    <input
                      type="tel"
                      id="telefono"
                      placeholder="Teléfono (opcional)"
                    />
                  </div>
                </div>

                <p class="contact-legal">
                  Al enviar este formulario, aceptas nuestros <a href="#"
                    >Términos de Servicio</a
                  > y <a href="#">Política de Privacidad</a>.
                </p>

                <button type="submit" class="contact-submit-btn">
                  Hablemos
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de FAQ -->
    <section class="faq-section">
      <div class="faq-container">
        <h2 class="faq-title">Preguntas frecuentes</h2>

        <div class="faq-list">
          <!-- FAQ 1 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="1">
              <span>¿Qué funcionalidades incluye el producto?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Nuestro producto incluye autenticación avanzada con biometría,
                registro personalizable de usuarios, validación de email y
                teléfono, información detallada del dispositivo, geolocalización
                estratégica, detección temprana de fraudes, y un SDK de
                integración sencillo para incorporar todas estas funcionalidades
                en una sola línea de código.
              </p>
            </div>
          </div>

          <!-- FAQ 2 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="2">
              <span>¿Es seguro usar biometría y doble factor?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Sí, es completamente seguro. La biometría y la autenticación de
                doble factor (2FA) son estándares de la industria que
                proporcionan capas adicionales de seguridad. Nuestro sistema
                utiliza encriptación de extremo a extremo y cumple con los más
                altos estándares de seguridad para proteger los datos
                biométricos y las credenciales de tus usuarios.
              </p>
            </div>
          </div>

          <!-- FAQ 3 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="3">
              <span
                >¿Puedo personalizar los campos de registro para mis usuarios?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Absolutamente. Nuestro sistema de registro es completamente
                personalizable. Puedes agregar, eliminar o modificar campos
                según las necesidades de tu negocio. Los campos se adaptan
                dinámicamente a tus usuarios, permitiéndote crear experiencias
                de registro únicas y relevantes para tu plataforma.
              </p>
            </div>
          </div>

          <!-- FAQ 4 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="4">
              <span>¿Cómo detecta fraudes y accesos sospechosos?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Nuestro sistema utiliza inteligencia artificial y machine
                learning para analizar patrones de comportamiento, detectar
                tráfico inusual, identificar el uso de VPNs, analizar la
                geolocalización de accesos, y monitorear información del
                dispositivo en tiempo real. Todo esto permite identificar y
                prevenir accesos sospechosos antes de que representen una
                amenaza.
              </p>
            </div>
          </div>

          <!-- FAQ 5 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="5">
              <span>¿Funciona en cualquier dispositivo?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Sí, nuestro producto es multiplataforma y funciona en cualquier
                dispositivo: smartphones (iOS y Android), tablets, computadoras
                de escritorio y laptops. La interfaz se adapta automáticamente a
                cada dispositivo, proporcionando una experiencia óptima sin
                importar desde dónde accedan tus usuarios.
              </p>
            </div>
          </div>

          <!-- FAQ 6 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="6">
              <span>¿Es fácil de integrar a mi sistema actual?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Muy fácil. Nuestro SDK de integración está diseñado para ser
                implementado con una sola línea de código. Proporcionamos
                documentación completa, ejemplos de código, y soporte técnico
                especializado para ayudarte en el proceso de integración. La
                mayoría de nuestros clientes completan la integración en menos
                de una hora.
              </p>
            </div>
          </div>

          <!-- FAQ 7 -->
          <div class="faq-item">
            <button class="faq-question" data-faq="7">
              <span
                >¿Puedo escalar la seguridad a medida que crece mi plataforma?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Definitivamente. Nuestra arquitectura está construida para
                escalar automáticamente. A medida que tu plataforma crece,
                nuestro sistema se adapta sin necesidad de cambios adicionales.
                Puedes manejar desde cientos hasta millones de usuarios sin
                preocuparte por la capacidad o el rendimiento del sistema de
                seguridad.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección CTA Final -->
    <section class="cta-section">
      <div class="cta-container">
        <h2 class="cta-title">
          Comienza hoy y<br />
          asegura cada acceso.
        </h2>
        <a
          href="https://alaiza.zelify.com"
          class="cta-button"
          target="_blank"
