  // Función para actualizar contenidos
  function updateCardsContent(lang) {
    const t = cardsTranslations[lang.toLowerCase()] || cardsTranslations.es;
    document.documentElement.lang = lang.toLowerCase();

    // Hero
    const heroTitle = document.querySelector(".auth-title");
