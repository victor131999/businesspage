---
import Layout from '../../layouts/Layout.astro';
import BackButton from '../../components/BackButton.astro';
import JobPageTranslations from '../../components/JobPageTranslations.astro';

const currentPath = Astro.url.pathname;
const jobId = currentPath.split('/').pop();
const selectedLang = Astro.url.searchParams.get('lang')?.toLowerCase();
const defaultLanguage: 'en' | 'es' = selectedLang === 'es' ? 'es' : 'en';
const jobsHref = `/jobs${defaultLanguage === 'es' ? '?lang=es' : ''}`;

const jobContent = {
  supportedLanguages: ['en', 'es'],
  hero: {
    title: {
      en: 'Backend Developer',
      es: 'Desarrollador Backend',
    },
    location: {
      en: 'Remote',
      es: 'Remoto',
    },
    type: {
      en: 'Full-time',
      es: 'Tiempo completo',
    },
  },
  sections: {
    about: {
      title: {
        en: 'About Us',
        es: 'Sobre nosotros',
      },
      paragraphs: {
        en: [
          "Founded in 2018, we're on a mission to combat complexity and empower people by reinventing financial services and facilitating international transfers in Latin America. Zelify transforms banking for personal and business users, enabling you to send, split, or gift money instantly, without complications or waiting. With fluid transactions as easy as sending a message, you have the power to connect, pay, and share instantly.",
        ],
        es: [
          'Fundada en 2018, nuestra misión es combatir la complejidad y empoderar a las personas reinventando los servicios financieros y facilitando transferencias internacionales en Latinoamérica. Zelify transforma la banca para usuarios personales y empresas, permitiendo enviar, dividir o regalar dinero al instante, sin complicaciones ni esperas. Con transacciones tan fluidas como enviar un mensaje, puedes conectar, pagar y compartir de inmediato.',
        ],
      },
    },
    workModel: {
      title: {
        en: 'Our Work Model',
        es: 'Nuestro modelo de trabajo',
      },
      paragraphs: {
        en: [
          'At Zelify, we create multifunctional, diverse, and inclusive teams, attracting the best talent to develop revolutionary technology. Our engineering team uses advanced technologies and agile methodologies that allow rapid adaptation to market needs. Our hybrid model provides independence and promotes professional responsibility to meet goals aligned with our global objectives. Our Engineering team transforms technology into high-impact financial solutions.',
        ],
        es: [
          'En Zelify formamos equipos multifuncionales, diversos e inclusivos, atrayendo el mejor talento para desarrollar tecnología revolucionaria. Nuestro equipo de ingeniería utiliza tecnologías avanzadas y metodologías ágiles que permiten adaptarse rápidamente a las necesidades del mercado. Nuestro modelo híbrido brinda independencia y fomenta la responsabilidad profesional para cumplir metas alineadas a nuestros objetivos globales. El equipo de Ingeniería transforma la tecnología en soluciones financieras de alto impacto.',
        ],
      },
    },
    culture: {
      title: {
        en: 'Our Culture',
        es: 'Nuestra cultura',
      },
      paragraphs: {
        en: [
          "At Zelify, we've created an international neo-banking platform centered on the user, constantly challenging the limits of technology. Our promise is to connect payments and unite people, empowering our users to pay, share, and connect instantly. We cultivate a culture of professional growth, innovation, and entrepreneurship, promoting autonomy and responsibility where engineers own their projects from conception to implementation.",
        ],
        es: [
          'En Zelify hemos creado una plataforma de neobanca internacional centrada en el usuario, desafiando constantemente los límites de la tecnología. Nuestra promesa es conectar pagos y unir personas, empoderando a nuestros usuarios para pagar, compartir y conectar al instante. Fomentamos una cultura de crecimiento profesional, innovación y emprendimiento, promoviendo autonomía y responsabilidad para que los ingenieros sean dueños de sus proyectos desde la concepción hasta la implementación.',
        ],
      },
    },
    technicalRequirements: {
      title: {
        en: 'Technical Requirements',
        es: 'Requisitos técnicos',
      },
      items: {
        en: [
          'Strong experience with Node.js and frameworks like Express or NestJS',
          'Proficiency in designing and implementing RESTful APIs',
          'Experience with SQL databases (PostgreSQL, MySQL) and query optimization',
          'Knowledge of NoSQL databases (MongoDB, Redis)',
          'Understanding of microservices architecture and containerization (Docker)',
          'Experience with message brokers (Kafka, RabbitMQ)',
          'Familiarity with cloud services (AWS, GCP, or Azure)',
          'Strong understanding of security best practices',
          'Experience with testing frameworks and methodologies',
        ],
        es: [
          'Amplia experiencia con Node.js y frameworks como Express o NestJS',
          'Dominio en el diseño e implementación de APIs REST',
          'Experiencia con bases de datos SQL (PostgreSQL, MySQL) y optimización de consultas',
          'Conocimiento de bases de datos NoSQL (MongoDB, Redis)',
          'Comprensión de arquitectura de microservicios y contenedores (Docker)',
          'Experiencia con brokers de mensajería (Kafka, RabbitMQ)',
          'Familiaridad con servicios en la nube (AWS, GCP o Azure)',
          'Sólido entendimiento de las mejores prácticas de seguridad',
          'Experiencia con frameworks y metodologías de pruebas',
        ],
      },
    },
    expectations: {
      title: {
        en: 'What We Expect',
        es: 'Lo que esperamos',
      },
      items: {
        en: [
          'Design, build, and maintain efficient, reusable, and reliable backend code',
          'Implement data storage solutions with a focus on security, performance, and scalability',
          'Integrate user-facing elements with server-side logic',
          'Identify and address performance bottlenecks',
          'Collaborate with frontend developers to integrate user-facing elements',
          'Participate in code reviews and provide constructive feedback',
          'Troubleshoot and debug applications',
          'Follow best practices in version control, documentation, and testing',
        ],
        es: [
          'Diseñar, construir y mantener código backend eficiente, reutilizable y confiable',
          'Implementar soluciones de almacenamiento con enfoque en seguridad, rendimiento y escalabilidad',
          'Integrar componentes de frontend con la lógica del servidor',
          'Identificar y resolver cuellos de botella de rendimiento',
          'Colaborar con desarrolladores frontend para integrar componentes de usuario',
          'Participar en revisiones de código y brindar retroalimentación constructiva',
          'Diagnosticar y depurar aplicaciones',
          'Seguir buenas prácticas de control de versiones, documentación y pruebas',
        ],
      },
    },
    niceToHave: {
      title: {
        en: 'Nice to Have',
        es: 'Deseable',
      },
      items: {
        en: [
          'Experience with GraphQL',
          'Knowledge of serverless architectures',
          'Experience with CI/CD pipelines',
          'Understanding of DevOps practices',
          'Experience in the fintech or banking industry',
          'Knowledge of payment processing systems',
          'Experience with real-time data processing',
        ],
        es: [
          'Experiencia con GraphQL',
          'Conocimiento de arquitecturas serverless',
          'Experiencia con pipelines de CI/CD',
          'Comprensión de prácticas DevOps',
          'Experiencia en la industria fintech o bancaria',
          'Conocimiento de sistemas de procesamiento de pagos',
          'Experiencia con procesamiento de datos en tiempo real',
        ],
      },
    },
  },
  applyCta: {
    en: 'Apply for this position',
    es: 'Postúlate a esta vacante',
  },
  backCta: {
    en: 'Back to roles',
    es: 'Volver a vacantes',
  },
};
---

<Layout title="Backend Developer | Zelify">
  <JobPageTranslations contentId="job-backend-content" content={jobContent} initialLanguage={defaultLanguage} />
  <div class="min-h-screen bg-gray-50">
    <!-- Banner -->
    <div class="relative h-64 bg-gradient-to-r from-blue-600 to-blue-800">
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="absolute inset-0 flex flex-col items-center justify-center">
        <div class="text-center">
          <h1 class="text-4xl font-bold text-white mb-4" data-hero="title">
            {jobContent.hero.title[defaultLanguage]}
          </h1>
          <div class="flex items-center justify-center gap-4 text-sm text-white/90">
            <span class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span data-hero="location">{jobContent.hero.location[defaultLanguage]}</span>
            </span>
            <span class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span data-hero="type">{jobContent.hero.type[defaultLanguage]}</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-4xl mx-auto px-4 py-12">
      <div class="bg-white rounded-xl shadow-sm p-8">
        <!-- About Us -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4" data-heading="about">
            {jobContent.sections.about.title[defaultLanguage]}
          </h2>
          <div data-paragraphs="about">
            {jobContent.sections.about.paragraphs[defaultLanguage].map((paragraph) => (
              <p class="text-gray-600 mb-6">{paragraph}</p>
            ))}
          </div>
        </section>

        <!-- Our Work Model -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4" data-heading="workModel">
            {jobContent.sections.workModel.title[defaultLanguage]}
          </h2>
          <div data-paragraphs="workModel">
            {jobContent.sections.workModel.paragraphs[defaultLanguage].map((paragraph) => (
              <p class="text-gray-600 mb-6">{paragraph}</p>
            ))}
          </div>
        </section>

        <!-- Our Culture -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4" data-heading="culture">
            {jobContent.sections.culture.title[defaultLanguage]}
          </h2>
          <div data-paragraphs="culture">
            {jobContent.sections.culture.paragraphs[defaultLanguage].map((paragraph) => (
              <p class="text-gray-600 mb-6">{paragraph}</p>
            ))}
          </div>
        </section>

        <!-- Technical Requirements -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4" data-heading="technicalRequirements">
            {jobContent.sections.technicalRequirements.title[defaultLanguage]}
          </h2>
          <ul class="list-disc list-inside text-gray-600 space-y-3" data-list="technicalRequirements">
            {jobContent.sections.technicalRequirements.items[defaultLanguage].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <!-- Role Expectations -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4" data-heading="expectations">
            {jobContent.sections.expectations.title[defaultLanguage]}
          </h2>
          <ul class="list-disc list-inside text-gray-600 space-y-3" data-list="expectations">
            {jobContent.sections.expectations.items[defaultLanguage].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <!-- Nice to Have -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4" data-heading="niceToHave">
            {jobContent.sections.niceToHave.title[defaultLanguage]}
          </h2>
          <ul class="list-disc list-inside text-gray-600 space-y-3" data-list="niceToHave">
            {jobContent.sections.niceToHave.items[defaultLanguage].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <!-- Apply Button -->
        <div class="flex justify-center">
          <a
            href={`/jobs/apply?position=${jobId}`}
            class="inline-flex items-center justify-center px-8 py-4 border border-transparent text-lg font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 transition-colors duration-300 shadow-sm hover:shadow-md"
            aria-label={jobContent.applyCta[defaultLanguage]}
          >
            <span class="job-apply-label" data-i18n="job.apply">
              {jobContent.applyCta[defaultLanguage]}
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <BackButton href={jobsHref} label={jobContent.backCta[defaultLanguage]} i18nKey="job.back" />
</Layout>

<style>
  /* Smooth transitions */
  .transition-colors {
    transition-property: background-color, border-color, color, fill, stroke;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 300ms;
  }
</style> 
