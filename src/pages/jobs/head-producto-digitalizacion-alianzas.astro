---
import Layout from '../../layouts/Layout.astro';
import BackButton from '../../components/BackButton.astro';
import JobPageTranslations from '../../components/JobPageTranslations.astro';

const currentPath = Astro.url.pathname;
const jobId = currentPath.split('/').pop();
const selectedLang = Astro.url.searchParams.get('lang')?.toLowerCase();
const defaultLanguage: 'en' | 'es' = selectedLang === 'es' ? 'es' : 'en';
const jobsHref = `/jobs${defaultLanguage === 'es' ? '?lang=es' : ''}`;

const jobContent = {
  supportedLanguages: ['en', 'es'],
  hero: {
    title: {
      en: 'Head of Product, Digitalization & Alliances',
      es: 'Head de Producto, Digitalización y Alianzas',
    },
    location: {
      en: 'LATAM',
      es: 'Latinoamérica',
    },
    type: {
      en: 'Full-time / Part-time',
      es: 'Tiempo completo / Medio tiempo',
    },
  },
  sections: {
    about: {
      title: {
        en: 'About Zelify',
        es: 'Sobre Zelify',
      },
      paragraphs: {
        en: [
          "Founded in 2018, we're on a mission to combat complexity and empower people by reinventing financial services and facilitating international transfers in Latin America.",
          'Zelify is the neo-banking platform of Zwippetech Inc. that facilitates banking for users and businesses through cutting-edge technology, eliminating transactional borders and enabling 100% digital accounts and international transfers.',
        ],
        es: [
          'Fundada en 2018, nuestra misión es combatir la complejidad y empoderar a las personas reinventando los servicios financieros y facilitando las transferencias internacionales en Latinoamérica.',
          'Zelify es la plataforma de neobanca de Zwippetech Inc. que facilita la bancarización de usuarios y empresas mediante tecnología de punta, eliminando fronteras transaccionales y permitiendo cuentas 100% digitales y transferencias internacionales.',
        ],
      },
    },
    workModel: {
      title: {
        en: 'Our Work Model',
        es: 'Nuestro modelo de trabajo',
      },
      paragraphs: {
        en: [
          'At Zwippetech, we create multifunctional, diverse, and inclusive teams, attracting the best talent to develop revolutionary technology. Our engineering team relies on advanced technologies and agile methodologies to adapt quickly to market needs.',
          'Our hybrid model provides independence and promotes professional responsibility to meet goals aligned with our global objectives. Engineering transforms technology into high-impact financial solutions.',
        ],
        es: [
          'En Zwippetech formamos equipos multifuncionales, diversos e inclusivos para atraer el mejor talento y desarrollar tecnología revolucionaria. Nuestro equipo de ingeniería se apoya en tecnologías avanzadas y metodologías ágiles para adaptarse rápidamente al mercado.',
          'Nuestro modelo híbrido brinda independencia y fomenta la responsabilidad profesional para cumplir metas alineadas con nuestros objetivos globales. Ingeniería transforma la tecnología en soluciones financieras de alto impacto.',
        ],
      },
    },
    culture: {
      title: {
        en: 'Our Culture',
        es: 'Nuestra cultura',
      },
      paragraphs: {
        en: [
          "At Zelify, we've created an international neo-banking platform centered on the user, constantly challenging the limits of technology.",
          'We cultivate a culture of professional growth, innovation, and entrepreneurship that promotes autonomy and responsibility; teams own their projects from conception to implementation.',
        ],
        es: [
          'En Zelify construimos una plataforma de neobanca internacional centrada en el usuario, desafiando constantemente los límites de la tecnología.',
          'Fomentamos una cultura de crecimiento, innovación y emprendimiento que promueve autonomía y responsabilidad; los equipos son dueños de sus proyectos desde la concepción hasta la implementación.',
        ],
      },
    },
    roleOverview: {
      title: {
        en: 'About the Role',
        es: 'Sobre el rol',
      },
      paragraphs: {
        en: [
          'As Head of Product, Digitalization & Alliances, you will lead the strategy that connects our financial products with partner institutions.',
        ],
        es: [
          'Como Head de Producto, Digitalización y Alianzas liderarás la estrategia que conecta nuestros productos financieros con instituciones aliadas.',
        ],
      },
      items: {
        en: [
          'Product strategy and roadmap',
          'Financial institution relationship management',
          'Internal coordination for banking integrations',
          'Product lifecycle management',
          'Business expansion and development',
          'Communication and PR',
        ],
        es: [
          'Estrategia y roadmap de producto',
          'Gestión de relaciones con instituciones financieras',
          'Coordinación interna para integraciones bancarias',
          'Gestión del ciclo de vida del producto',
          'Expansión y desarrollo de negocio',
          'Comunicación y relaciones públicas',
        ],
      },
    },
    objectives: {
      title: {
        en: 'Role Objectives (KPIs)',
        es: 'Objetivos del rol (KPIs)',
      },
      items: {
        en: [
          'Growth of active users and transaction volume in target markets',
          'Number of new banking alliances integrated',
          'Improvement in activation and retention rates of launched products',
          'Average integration time with new financial partners',
          'SLA/SLO compliance in banking service integrations',
          'Market penetration and revenue generation from new products',
          'Product NPS and customer experience',
        ],
        es: [
          'Crecimiento de usuarios activos y volumen transaccional en mercados objetivo',
          'Número de nuevas alianzas bancarias integradas',
          'Mejora en tasas de activación y retención de productos lanzados',
          'Tiempo promedio de integración con nuevos socios financieros',
          'Cumplimiento de SLA/SLO en integraciones de servicios bancarios',
          'Penetración de mercado y generación de ingresos de nuevos productos',
          'NPS del producto y experiencia del cliente',
        ],
      },
    },
    contribution: {
      title: {
        en: 'Expected Contribution',
        es: 'Contribución esperada',
      },
      items: {
        en: [
          "Bring experience in payment methods, strategic alliances, and financial product development to lead priority projects in Colombia and other key markets.",
          'Implement commercial and product strategies that position Zelify as a leader in financial innovation and digital banking.',
          'Optimize onboarding processes, product launches, and user experience.',
          "Strengthen existing alliances and open new relationships that facilitate Zelify's expansion.",
        ],
        es: [
          'Aportar experiencia en medios de pago, alianzas estratégicas y desarrollo de productos financieros para liderar proyectos prioritarios en Colombia y otros mercados clave.',
          'Implementar estrategias comerciales y de producto que posicionen a Zelify como líder en innovación financiera y banca digital.',
          'Optimizar procesos de onboarding, lanzamientos de productos y experiencia del usuario.',
          'Fortalecer alianzas existentes y abrir nuevas relaciones que faciliten la expansión de Zelify.',
        ],
      },
    },
    compensation: {
      title: {
        en: 'Compensation & Engagement',
        es: 'Compensación y engagement',
      },
      paragraphs: {
        en: [
          'Equity Participation: 1% in ordinary shares of Zwippetech S.A.S Colombia with 12-month vesting and 3-month cliff, aligned with local standards for high-impact executive roles.',
          'Performance Bonus: An additional 0.5% in ordinary shares subject to achieving strategic KPIs defined during the first 180 days.',
        ],
        es: [
          'Participación accionaria: 1% en acciones ordinarias de Zwippetech S.A.S Colombia con vesting de 12 meses y cliff de 3 meses, alineado con estándares locales para roles ejecutivos de alto impacto.',
          'Bono por desempeño: 0,5% adicional en acciones ordinarias sujeto al cumplimiento de KPIs estratégicos definidos en los primeros 180 días.',
        ],
      },
    },
    benefits: {
      title: {
        en: 'Benefits (Perks)',
        es: 'Beneficios',
      },
      items: {
        en: [
          'Health insurance',
          'Annual performance-based bonuses',
          'Monthly technology tool allocation',
          'Additional benefits according to seniority level',
          'Hybrid work with flexibility for on-site client needs',
          'One course on Udemy or Platzi',
          'Year-end bonus as an additional benefit',
          'Monthly discount coupon for transfers in our app',
          'Free dress code',
          'Birthday day off',
          'Laptop gift after two years',
          'New car after five years of seniority',
        ],
        es: [
          'Seguro de salud',
          'Bonos anuales por desempeño',
          'Asignación mensual para herramientas tecnológicas',
          'Beneficios adicionales según nivel de seniority',
          'Trabajo híbrido con flexibilidad para necesidades presenciales',
          'Un curso en Udemy o Platzi',
          'Bono de fin de año como beneficio adicional',
          'Cupón mensual de descuento para transferencias en la app',
          'Código de vestimenta libre',
          'Día libre en tu cumpleaños',
          'Computador como regalo después de dos años',
          'Auto 0 km después de cinco años de antigüedad',
        ],
      },
    },
  },
  applyCta: {
    en: 'Apply for this position',
    es: 'Postúlate a esta vacante',
  },
  backCta: {
    en: 'Back to roles',
    es: 'Volver a vacantes',
  },
};
---

<Layout title="Head of Product, Digitalization and Alliances | Zelify">
  <JobPageTranslations contentId="job-head-product-content" content={jobContent} initialLanguage={defaultLanguage} />
  <div class="min-h-screen bg-gray-50">
    <div class="relative h-64 bg-gradient-to-r from-blue-600 to-blue-800">
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="absolute inset-0 flex flex-col items-center justify-center">
        <div class="text-center">
          <h1 class="text-4xl font-bold text-white mb-4" data-hero="title">
            {jobContent.hero.title[defaultLanguage]}
          </h1>
          <div class="flex items-center justify-center gap-4 text-sm text-white/90">
            <span class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span data-hero="location">{jobContent.hero.location[defaultLanguage]}</span>
            </span>
            <span class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span data-hero="type">{jobContent.hero.type[defaultLanguage]}</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 py-12">
      <div class="bg-white rounded-xl shadow-sm p-8">
        {Object.entries(jobContent.sections).map(([key, section]) => (
          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-4" data-heading={key}>
              {section.title[defaultLanguage]}
            </h2>
            {section?.paragraphs && (
              <div data-paragraphs={key}>
                {section.paragraphs[defaultLanguage].map((paragraph) => (
                  <p class="text-gray-600 mb-6">{paragraph}</p>
                ))}
              </div>
            )}
            {section?.items && (
              <ul class="list-disc list-inside text-gray-600 space-y-3" data-list={key}>
                {section.items[defaultLanguage].map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </section>
        ))}

        <div class="flex justify-center">
          <a
            href={`/jobs/apply?position=${jobId}`}
            class="inline-flex items-center justify-center px-8 py-4 border border-transparent text-lg font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 transition-colors duration-300 shadow-sm hover:shadow-md"
            aria-label={jobContent.applyCta[defaultLanguage]}
          >
            <span class="job-apply-label" data-i18n="job.apply">
              {jobContent.applyCta[defaultLanguage]}
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
  
  <BackButton href={jobsHref} label={jobContent.backCta[defaultLanguage]} i18nKey="job.back" />
</Layout>

<style>
  .transition-colors {
    transition-property: background-color, border-color, color, fill, stroke;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 300ms;
  }
</style>
