---
import Layout from '../../layouts/Layout.astro';
import BackButton from '../../components/BackButton.astro';
import JobPageTranslations from '../../components/JobPageTranslations.astro';

const currentPath = Astro.url.pathname;
const jobId = currentPath.split('/').pop();
const selectedLang = Astro.url.searchParams.get('lang')?.toLowerCase();
const defaultLanguage: 'en' | 'es' = selectedLang === 'es' ? 'es' : 'en';
const jobsHref = `/jobs${defaultLanguage === 'es' ? '?lang=es' : ''}`;

const jobContent = {
  supportedLanguages: ['en', 'es'],
  hero: {
    title: {
      en: 'Senior Frontend Developer',
      es: 'Senior Frontend Developer',
    },
    location: {
      en: 'Remote',
      es: 'Remoto',
    },
    type: {
      en: 'Full-time',
      es: 'Tiempo completo',
    },
  },
  sections: {
    about: {
      title: {
        en: 'About the Role',
        es: 'Sobre el rol',
      },
      paragraphs: {
        en: [
          "We're looking for a Senior Frontend Developer to join our team and lead the development of our web application. As part of our engineering team, you'll be responsible for creating exceptional user experiences and helping define the technical direction of our frontend products.",
        ],
        es: [
          'Buscamos un Senior Frontend Developer para liderar el desarrollo de nuestra aplicación web. Como parte del equipo de ingeniería serás responsable de crear experiencias excepcionales y de contribuir a definir la dirección técnica de nuestros productos frontend.',
        ],
      },
    },
    responsibilities: {
      title: {
        en: 'Responsibilities',
        es: 'Responsabilidades',
      },
      items: {
        en: [
          'Lead the development of new features and improvements to our web application',
          'Collaborate with designers and other developers to implement user interfaces',
          'Optimize performance and scalability of our frontend applications',
          'Mentor junior developers and contribute to the team’s engineering culture',
          'Participate in code reviews and provide constructive feedback',
        ],
        es: [
          'Liderar el desarrollo de nuevas funcionalidades y mejoras en nuestra aplicación web',
          'Colaborar con diseñadores y otros desarrolladores para implementar interfaces',
          'Optimizar el rendimiento y la escalabilidad de nuestras aplicaciones frontend',
          'Mentorear a desarrolladores junior y fortalecer la cultura de ingeniería del equipo',
          'Participar en revisiones de código y brindar retroalimentación constructiva',
        ],
      },
    },
    requirements: {
      title: {
        en: 'Requirements',
        es: 'Requisitos',
      },
      items: {
        en: [
          '5+ years of frontend development experience',
          'Strong experience with React, TypeScript, and modern web technologies',
          'Deep knowledge of HTML, CSS, and JavaScript',
          'Experience with design systems and reusable components',
          'Excellent communication and teamwork skills',
        ],
        es: [
          'Más de 5 años de experiencia en desarrollo frontend',
          'Sólida experiencia con React, TypeScript y tecnologías web modernas',
          'Dominio profundo de HTML, CSS y JavaScript',
          'Experiencia con sistemas de diseño y componentes reutilizables',
          'Excelentes habilidades de comunicación y trabajo en equipo',
        ],
      },
    },
    benefits: {
      title: {
        en: 'Benefits',
        es: 'Beneficios',
      },
      items: {
        en: [
          'Competitive salary and performance bonuses',
          'Comprehensive health insurance',
          'Flexible schedule and remote work',
          'Professional development budget',
          'State-of-the-art work equipment',
        ],
        es: [
          'Salario competitivo y bonos por desempeño',
          'Seguro de salud integral',
          'Horario flexible y trabajo remoto',
          'Presupuesto para desarrollo profesional',
          'Equipo de trabajo de última generación',
        ],
      },
    },
  },
  applyCta: {
    en: 'Apply for this position',
    es: 'Postúlate a esta vacante',
  },
  backCta: {
    en: 'Back to roles',
    es: 'Volver a vacantes',
  },
};
---

<Layout title="Senior Frontend Developer | Zelify">
  <JobPageTranslations contentId="job-senior-frontend-content" content={jobContent} initialLanguage={defaultLanguage} />
  <div class="min-h-screen bg-gray-50">
    <div class="relative h-64 bg-gradient-to-r from-blue-600 to-blue-800">
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="absolute inset-0 flex flex-col items-center justify-center">
        <div class="text-center">
          <h1 class="text-4xl font-bold text-white mb-4" data-hero="title">
            {jobContent.hero.title[defaultLanguage]}
          </h1>
          <div class="flex items-center justify-center gap-4 text-sm text-white/90">
            <span class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span data-hero="location">{jobContent.hero.location[defaultLanguage]}</span>
            </span>
            <span class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span data-hero="type">{jobContent.hero.type[defaultLanguage]}</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 py-12">
      <div class="bg-white rounded-xl shadow-sm p-8">
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4" data-heading="about">
            {jobContent.sections.about.title[defaultLanguage]}
          </h2>
          <div data-paragraphs="about">
            {jobContent.sections.about.paragraphs[defaultLanguage].map((paragraph) => (
              <p class="text-gray-600 mb-6">{paragraph}</p>
            ))}
          </div>
        </section>

        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4" data-heading="responsibilities">
            {jobContent.sections.responsibilities.title[defaultLanguage]}
          </h2>
          <ul class="list-disc list-inside text-gray-600 space-y-3" data-list="responsibilities">
            {jobContent.sections.responsibilities.items[defaultLanguage].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4" data-heading="requirements">
            {jobContent.sections.requirements.title[defaultLanguage]}
          </h2>
          <ul class="list-disc list-inside text-gray-600 space-y-3" data-list="requirements">
            {jobContent.sections.requirements.items[defaultLanguage].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4" data-heading="benefits">
            {jobContent.sections.benefits.title[defaultLanguage]}
          </h2>
          <ul class="list-disc list-inside text-gray-600 space-y-3" data-list="benefits">
            {jobContent.sections.benefits.items[defaultLanguage].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <div class="flex justify-center">
          <a
            href={`/jobs/apply?position=${jobId}`}
            class="inline-flex items-center justify-center px-8 py-4 border border-transparent text-lg font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 transition-colors duration-300 shadow-sm hover:shadow-md"
            aria-label={jobContent.applyCta[defaultLanguage]}
          >
            <span class="job-apply-label" data-i18n="job.apply">
              {jobContent.applyCta[defaultLanguage]}
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
  
  <BackButton href={jobsHref} label={jobContent.backCta[defaultLanguage]} i18nKey="job.back" />
</Layout>

<style>
  .transition-colors {
    transition-property: background-color, border-color, color, fill, stroke;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 300ms;
  }
</style>
