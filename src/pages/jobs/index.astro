---

<script
  type="application/json"
  id="jobs-page-copy"
  set:html={JSON.stringify(jobPageCopy).replace(/</g, '\\u003C')}
/>

<script is:inline>
  const JOB_PAGE_COPY = JSON.parse(document.getElementById('jobs-page-copy')?.textContent ?? '{}');
  const fallbackLang = 'en';
  const supportedLangs = ['en', 'es'];
  const tagClass = 'job-tag-pill';

  const resolveLang = (rawLang) => {
    const normalized = (rawLang || fallbackLang).toLowerCase();
    return supportedLangs.includes(normalized) ? normalized : fallbackLang;
  };

  const translate = (dictionary, lang) => {
    if (!dictionary) return '';
    return dictionary[lang] ?? dictionary[fallbackLang] ?? '';
  };

  const updateJobLinks = (rawLang) => {
    const lang = resolveLang(rawLang);
    const shouldAppend = lang !== fallbackLang;
    document.querySelectorAll('[data-job-link]').forEach((anchor) => {
      const href = anchor.getAttribute('href');
      if (!href) return;
      try {
        const url = new URL(href, window.location.origin);
        if (shouldAppend) {
          url.searchParams.set('lang', lang);
        } else {
          url.searchParams.delete('lang');
        }
        anchor.setAttribute('href', url.pathname + url.search + url.hash);
      } catch (error) {
        console.warn('Unable to update job link', error);
      }
    });
  };

  const updateJobsPage = (rawLang) => {
    const lang = resolveLang(rawLang);
    const { hero, stats, infoCards, openRoles, jobs, culture, general } = JOB_PAGE_COPY;

    const heroBadge = document.querySelector('[data-i18n="hero.badge"]');
    if (heroBadge) heroBadge.textContent = translate(hero.badge, lang);

    const heroTitle = document.querySelector('[data-i18n="hero.title"]');
    if (heroTitle) heroTitle.innerHTML = translate(hero.title, lang);

    const heroDescription = document.querySelector('[data-i18n="hero.description"]');
    if (heroDescription) heroDescription.textContent = translate(hero.description, lang);

    const primaryCta = document.querySelector('[data-i18n="hero.primaryCta"]');
    if (primaryCta) primaryCta.textContent = translate(hero.primaryCta, lang);

    const secondaryCta = document.querySelector('[data-i18n="hero.secondaryCta"]');
    if (secondaryCta) secondaryCta.textContent = translate(hero.secondaryCta, lang);

    stats?.forEach((stat, index) => {
      const label = document.querySelector(`[data-stat-label-index="${index}"]`);
      if (label) label.textContent = translate(stat.label, lang);
    });

    infoCards?.forEach((card, index) => {
      const label = document.querySelector(`[data-info-card-index="${index}"]`);
      if (label) label.textContent = translate(card.label, lang);
    });

    const openRolesLabel = document.querySelector('[data-i18n="openRoles.label"]');
    if (openRolesLabel) openRolesLabel.textContent = translate(openRoles.label, lang);

    const openRolesCount = document.querySelector('[data-i18n="openRoles.count"]');
    if (openRolesCount) {
        openRolesCount.textContent = `${jobs.length} ${translate(openRoles.label, lang).toLowerCase()}`;
    }

    // Update CTA buttons
    document.querySelectorAll('[data-job-card-cta]').forEach((node) => {
      node.textContent = translate(openRoles.cardCta, lang);
    });

    jobs?.forEach((job) => {
      const card = document.querySelector(`[data-job-card="${job.slug}"]`);
      if (!card) return;

      const setField = (field) => {
        const target = card.querySelector(`[data-job-field="${field}"]`);
        if (!target) return;
        target.textContent = translate(job[field], lang);
      };

      ['location', 'type', 'title', 'summary'].forEach(setField);

      const tagsContainer = card.querySelector('[data-job-tags]');
      if (tagsContainer && job.tags) {
        const tags = job.tags[lang] ?? job.tags[fallbackLang] ?? [];
        tagsContainer.innerHTML = tags
          .map((tag) => `<span class="${tagClass}">${tag}</span>`)
          .join('');
      }
    });

    culture?.forEach((pillar, index) => {
      const title = document.querySelector(`[data-culture-title="${index}"]`);
      if (title) title.textContent = translate(pillar.title, lang);
      const copy = document.querySelector(`[data-culture-copy="${index}"]`);
      if (copy) copy.textContent = translate(pillar.copy, lang);
    });

    const generalPrompt = document.querySelector('[data-i18n="general.prompt"]');
    if (generalPrompt) generalPrompt.textContent = translate(general.prompt, lang);

    const generalTitle = document.querySelector('[data-i18n="general.title"]');
    if (generalTitle) generalTitle.textContent = translate(general.title, lang);

    const generalDescription = document.querySelector('[data-i18n="general.description"]');
    if (generalDescription) generalDescription.textContent = translate(general.description, lang);

    const generalButton = document.querySelector('[data-i18n="general.button"]');
    if (generalButton) generalButton.textContent = translate(general.button, lang);

    updateJobLinks(lang);
  };

  window.addEventListener('ui:languagechange', (event) => {
    const language = event?.detail?.language;
    if (language) updateJobsPage(language);
  });

  document.addEventListener('DOMContentLoaded', () => {
    const storedLang = localStorage.getItem('ui-language') || fallbackLang;
    const initialLang = (storedLang === 'EN' || storedLang === 'ES' || storedLang === 'en' || storedLang === 'es') ? storedLang : 'en';
    updateJobsPage(initialLang);
  });
</script>


<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/png"
      href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png"
    />
    <title>Work with us | Zelify</title>
    <meta name="description" content="Join Zelify and help us build the financial operating system that connects payments, credit, and compliance across Latin America." />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/hover.css/2.3.1/css/hover-min.css"
    />
  </head>
  <body class="demo-page">
    <NavbarSimple />
    <ProductsPanel />

    <main class="jobs-main">
      <!-- Hero Section -->
      <section class="jobs-hero">
        <div class="jobs-container">
          <div class="hero-top-row">
            <Text variant="subtitle" class="hero-badge" data-i18n="hero.badge">
              {heroCopy.badge[defaultLanguage]}
            </Text>
            <Title level={1} variant="hero" class="hero-title text-balance" data-i18n="hero.title" set:html={heroCopy.title[defaultLanguage]} />
          </div>
        </div>

        <div class="hero-image-container">
            <img src="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/background-images/jobs-background.png" alt="Zelify Team" class="hero-image" />
        </div>
        
        

        <div class="jobs-container">
          <div class="hero-bottom-row">
            <Text variant="primary" size="2xl" class="hero-description text-balance" data-i18n="hero.description">
              {heroCopy.description[defaultLanguage]}
            </Text>

            <div class="hero-actions">
              <Button
                href="#jobs-list"
                variant="primary"
                dataI18n="hero.primaryCta"
              >
                {heroCopy.primaryCta[defaultLanguage]}
              </Button>
              <Button
                href="mailto:jobs@zelify.com"
                variant="secondary"
                dataI18n="hero.secondaryCta"
              >
                {heroCopy.secondaryCta[defaultLanguage]}
              </Button>
            </div>
          </div>
        </div>




      </section>

      <!-- Info Cards Section -->
      <section class="jobs-section bg-white">
        <div class="jobs-container">
          <div class="info-cards-grid">
            {infoCards.map((card, index) => (
              <div class="info-card">
                <Title level={3} variant="card" class="info-card-title">{card.value}</Title>
                <Text variant="caption" class="info-card-text" data-info-card-index={index}>
                  {card.label[defaultLanguage]}
                </Text>
              </div>
            ))}
          </div>

        </div>
      </section>
      <section>
        <Divider />
        <Divider vertical={true} />
      </section>
      
      <!-- Open Roles Section -->
      <section id="jobs-list" class="jobs-section bg-white">
        <div class="jobs-container">
          <div class="section-header-row">
            <Text variant="subtitle" class="hero-badge" data-i18n="openRoles.label">
              {openRolesCopy.label[defaultLanguage]}
            </Text>
            <Title level={2} variant="section" class="section-count-title" data-i18n="openRoles.count">
              {jobOpenings.length} {openRolesCopy.label[defaultLanguage].toLowerCase()}
            </Title>
          </div>

          <div class="jobs-grid-list">
            {jobOpenings.map((job) => (
              <div
                class="job-listing-row group"
                data-job-card={job.slug}
              >
                <div class="job-info-card">
                    <div class="job-meta-top">
                       <div class="meta-item">
                         <img src="/icons/jobs/location.svg" alt="" class="meta-icon" />
                         <Text variant="subtitle" class="job-meta-text">
                           <span data-job-field="location">{job.location[defaultLanguage]}</span>
                         </Text>
                       </div>
                       
                       <div class="meta-item">
                         <img src="/icons/jobs/clock.svg" alt="" class="meta-icon" />
                         <Text variant="subtitle" class="job-meta-text">
                           <span data-job-field="type">{job.type[defaultLanguage]}</span>
                         </Text>
                       </div>
                    </div>
                    
                    <Title level={3} variant="card" class="job-title-row" data-job-field="title">
                      {job.title[defaultLanguage]}
                    </Title>
                    
                    <div class="job-tags-row" job-tags>
                      {job.tags[defaultLanguage].map((tag) => (
                        <span class="job-tag-pill">
                          {tag}
                        </span>
                      ))}
                    </div>
                </div>
                  
                <div class="job-description-side">
                     <Text variant="subtitle" class="job-summary-row" data-job-field="summary">
                      {job.summary[defaultLanguage]}
                    </Text>
                    <div class="job-cta-row">
                      <Button 
                        href={`/jobs/${job.slug}`} 
                        variant="secondary" 
                        size="md"
                        data-job-link
                      >
                        <span data-job-card-cta>{openRolesCopy.cardCta[defaultLanguage]}</span>
                      </Button>
                    </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <Divider />
      <Divider vertical={true} />

      <!-- Culture Section -->
      <section class="jobs-section">
        <div class="jobs-container">
          <div class="culture-grid">
            {culturePillars.map((pillar, index) => {
              const icons = [
                '/icons/alaiza/behaviorAnalysis.svg',
                '/icons/jobs/user-lapt.svg',
                '/icons/jobs/book.svg'
              ];
              return (
                <div class="culture-item">
                  <img src={icons[index]} alt="" class="culture-icon" />
                  <Title level={3} variant="card" class="culture-title" data-culture-title={index}>
                    {pillar.title[defaultLanguage]}
                  </Title>
                  <Text variant="subtitle" size="xl" class="hero-description" data-culture-copy={index}>
                    {pillar.copy[defaultLanguage]}
                  </Text>
                </div>
              );
            })}
          </div>
        </div>
      </section>

      <!-- General Application -->
      <section class="jobs-section pb-24 bg-gray">
        <div class="jobs-container">
            <div class="general-app-card">
              <div class="content-wrapper">
                <Title level={2} variant="hero" class="general-prompt" data-i18n="general.prompt">
                  {generalApplicationCopy.prompt[defaultLanguage]}
                </Title>
                <Title level={3} variant="card" class="general-title" data-i18n="general.title">
                  {generalApplicationCopy.title[defaultLanguage]}
                </Title>
                <Text variant="primary" size="2xl" class="general-description" data-i18n="general.description">
                  {generalApplicationCopy.description[defaultLanguage]}
                </Text>
                <Button
                  href="mailto:jobs@zelify.com"
                  variant="secondary"
                  dataI18n="general.button"
                >
                  {generalApplicationCopy.button[defaultLanguage]}
                </Button>
              </div>
            </div>
        </div>
      </section>

    </main>

    <Footer />
    <AlaizaAssistant client:load />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  html, body {
    margin: 0;
    padding: 0;
    font-family: "NataSans", system-ui, sans-serif;
    color: #0d1117;
    background-color: #fff;

  }

  .jobs-main {
    width: 100%;
  }

  .jobs-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .text-center {
    text-align: center;
  }

  /* Typography Utilities */
  .text-balance {
    text-wrap: balance;
  }

  /* Hero Section */
  .jobs-hero {
    padding-top: 8rem;
    padding-bottom: 4rem;
    background-color: #f3f4f6;
  }

  .hero-top-row {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 768px) {
    .hero-top-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }

    .hero-top-row .hero-title {
        max-width: 50%;
        text-align: left;
        margin-left: auto;
    }
  }

  .hero-badge {
    color: #0066cc;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }

  .hero-title {
    margin: 0;
    font-size: 3rem;
  }

  .hero-image-container {
    width: 100%;
    margin-bottom: 4rem;
    overflow: hidden;
  }

  .hero-image {
    width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: cover;
    display: block;
  }

  .hero-bottom-row {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      margin-left: auto;
      max-width: 100%;
      text-align: left;
  }

  @media (min-width: 768px) {
      .hero-bottom-row {
        align-items: flex-start;
        max-width: 50%;
        text-align: left;
      }
  }

  .hero-description {
    width: 100%;
    margin-bottom: 2rem;
  }


  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  @media (min-width: 640px) {
    .hero-actions {
        width: auto;
        flex-direction: row;
    }
  }

  .hero-stats-grid {
    margin-top: 5rem;
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .hero-stats-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .stat-item {
    text-align: center;
  }

  .stat-value {
    font-size: 2.25rem;
    font-weight: 700;
    color: #0d1117;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Sections General */
  .jobs-section {
    padding: 2.5rem 0;
  }

  .bg-gray {
    background-color: #f9fafb;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .section-badge {
    color: #0066cc;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    display: block;
  }

  .section-title {
    margin-bottom: 1rem;
  }

  .section-description {
    max-width: 48rem;
  }

  /* Jobs Grid */
  .jobs-grid {
    display: grid;
