};

const culturePillars = [
  {
    title: {
      en: "Borderless mindset",
      es: "Mentalidad sin fronteras",
    },
    copy: {
      en: "We build for LATAM and work from wherever talent thrives. Our rhythm is async, transparent, and bias-free.",
      es: "Construimos para LATAM y trabajamos desde donde florece el talento. Nuestro ritmo es asíncrono, transparente y libre de sesgos.",
    },
  },
  {
    title: {
      en: "Autonomy with impact",
      es: "Autonomía con impacto",
    },
    copy: {
      en: "Owning problems end-to-end means architects, designers, and operators ship measurable outcomes faster.",
      es: "Ser dueños de los problemas de principio a fin nos permite entregar resultados medibles con más velocidad.",
    },
  },
  {
