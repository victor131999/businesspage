---
import NavbarSimple from '../../components/NavbarSimple.astro';
import Footer from '../../components/design-system/organisms/Footer.astro';
import Title from '../../components/design-system/atoms/Title.astro';
import Text from '../../components/design-system/atoms/Text.astro';
import Button from '../../components/design-system/atoms/Button.astro';
import '../../components/design-system/tokens.css';
import '../../styles/navbar.css';
import { AlaizaAssistant } from "../../components/AlaizaAssistant";

const defaultLanguage = 'en';

const jobOpenings = [
