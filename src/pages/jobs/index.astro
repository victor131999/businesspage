---

<script
  type="application/json"
  id="jobs-page-copy"
  set:html={JSON.stringify(jobPageCopy).replace(/</g, '\\u003C')}
/>

<script is:inline>
  const JOB_PAGE_COPY = JSON.parse(document.getElementById('jobs-page-copy')?.textContent ?? '{}');
  const fallbackLang = 'en';
  const supportedLangs = ['en', 'es'];
  const tagClass = 'job-tag';

  const resolveLang = (rawLang) => {
    const normalized = (rawLang || fallbackLang).toLowerCase();
    return supportedLangs.includes(normalized) ? normalized : fallbackLang;
  };

  const translate = (dictionary, lang) => {
    if (!dictionary) return '';
    return dictionary[lang] ?? dictionary[fallbackLang] ?? '';
  };

  const updateJobLinks = (rawLang) => {
    const lang = resolveLang(rawLang);
    const shouldAppend = lang !== fallbackLang;
    document.querySelectorAll('[data-job-link]').forEach((anchor) => {
      const href = anchor.getAttribute('href');
      if (!href) return;
      try {
        const url = new URL(href, window.location.origin);
        if (shouldAppend) {
          url.searchParams.set('lang', lang);
        } else {
          url.searchParams.delete('lang');
        }
        anchor.setAttribute('href', url.pathname + url.search + url.hash);
      } catch (error) {
        console.warn('Unable to update job link', error);
      }
    });
  };

  const updateJobsPage = (rawLang) => {
    const lang = resolveLang(rawLang);
    const { hero, stats, openRoles, jobs, culture, general } = JOB_PAGE_COPY;

    const heroBadge = document.querySelector('[data-i18n="hero.badge"]');
    if (heroBadge) heroBadge.textContent = translate(hero.badge, lang);

    const heroTitle = document.querySelector('[data-i18n="hero.title"]');
    if (heroTitle) heroTitle.innerHTML = translate(hero.title, lang);

    const heroDescription = document.querySelector('[data-i18n="hero.description"]');
    if (heroDescription) heroDescription.textContent = translate(hero.description, lang);

    const primaryCta = document.querySelector('[data-i18n="hero.primaryCta"]');
    if (primaryCta) primaryCta.textContent = translate(hero.primaryCta, lang);

    const secondaryCta = document.querySelector('[data-i18n="hero.secondaryCta"]');
    if (secondaryCta) secondaryCta.textContent = translate(hero.secondaryCta, lang);

    stats?.forEach((stat, index) => {
      const label = document.querySelector(`[data-stat-label-index="${index}"]`);
      if (label) label.textContent = translate(stat.label, lang);
    });

    const openRolesLabel = document.querySelector('[data-i18n="openRoles.label"]');
    if (openRolesLabel) openRolesLabel.textContent = translate(openRoles.label, lang);

    const openRolesTitle = document.querySelector('[data-i18n="openRoles.title"]');
    if (openRolesTitle) openRolesTitle.textContent = translate(openRoles.title, lang);

    const openRolesDescription = document.querySelector('[data-i18n="openRoles.description"]');
    if (openRolesDescription) openRolesDescription.textContent = translate(openRoles.description, lang);

    document.querySelectorAll('[data-job-card-cta]').forEach((node) => {
      node.textContent = translate(openRoles.cardCta, lang);
    });

    jobs?.forEach((job) => {
      const card = document.querySelector(`[data-job-card="${job.slug}"]`);
      if (!card) return;

      const setField = (field) => {
        const target = card.querySelector(`[data-job-field="${field}"]`);
        if (!target) return;
        target.textContent = translate(job[field], lang);
      };

      ['location', 'type', 'title', 'summary'].forEach(setField);

      const tagsContainer = card.querySelector('[data-job-tags]');
      if (tagsContainer && job.tags) {
        const tags = job.tags[lang] ?? job.tags[fallbackLang] ?? [];
        tagsContainer.innerHTML = tags
          .map((tag) => `<span class="${tagClass}">${tag}</span>`)
          .join('');
      }
    });

    culture?.forEach((pillar, index) => {
      const title = document.querySelector(`[data-culture-title="${index}"]`);
      if (title) title.textContent = translate(pillar.title, lang);
      const copy = document.querySelector(`[data-culture-copy="${index}"]`);
      if (copy) copy.textContent = translate(pillar.copy, lang);
    });

    const generalPrompt = document.querySelector('[data-i18n="general.prompt"]');
    if (generalPrompt) generalPrompt.textContent = translate(general.prompt, lang);

    const generalTitle = document.querySelector('[data-i18n="general.title"]');
    if (generalTitle) generalTitle.textContent = translate(general.title, lang);

    const generalDescription = document.querySelector('[data-i18n="general.description"]');
    if (generalDescription) generalDescription.textContent = translate(general.description, lang);

    const generalButton = document.querySelector('[data-i18n="general.button"]');
    if (generalButton) generalButton.textContent = translate(general.button, lang);

    updateJobLinks(lang);
  };

  window.addEventListener('ui:languagechange', (event) => {
    const language = event?.detail?.language;
    if (language) updateJobsPage(language);
  });

  document.addEventListener('DOMContentLoaded', () => {
    const storedLang = localStorage.getItem('ui-language') || fallbackLang;
    const initialLang = (storedLang === 'EN' || storedLang === 'ES' || storedLang === 'en' || storedLang === 'es') ? storedLang : 'en';
    updateJobsPage(initialLang);
  });
</script>


<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/png"
      href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png"
    />
    <title>Work with us | Zelify</title>
    <meta name="description" content="Join Zelify and help us build the financial operating system that connects payments, credit, and compliance across Latin America." />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/hover.css/2.3.1/css/hover-min.css"
    />
  </head>
  <body class="demo-page">
    <NavbarSimple/>

    <main class="jobs-main">
      <!-- Hero Section -->
      <section class="jobs-hero">
        <div class="jobs-container text-center">
          <Text variant="subtitle" class="hero-badge" data-i18n="hero.badge">
            {heroCopy.badge[defaultLanguage]}
          </Text>
          <Title level={1} variant="hero" class="hero-title text-balance" data-i18n="hero.title" set:html={heroCopy.title[defaultLanguage]} />
          <Text variant="subtitle" class="hero-description text-balance" data-i18n="hero.description">
            {heroCopy.description[defaultLanguage]}
          </Text>

          <div class="hero-actions">
            <Button
              href="#jobs-list"
              variant="primary"
              dataI18n="hero.primaryCta"
            >
              {heroCopy.primaryCta[defaultLanguage]}
            </Button>
            <Button
              href="mailto:jobs@zelify.com"
              variant="secondary"
              dataI18n="hero.secondaryCta"
            >
              {heroCopy.secondaryCta[defaultLanguage]}
            </Button>
          </div>
        </div>

        <div class="jobs-container hero-stats-grid">
          {heroHighlights.map((item, index) => (
            <div class="stat-item">
              <p class="stat-value">{item.value}</p>
              <Text variant="caption" class="stat-label" data-stat-label-index={index}>
                {item.label[defaultLanguage]}
              </Text>
            </div>
          ))}
        </div>
      </section>

      <!-- Open Roles Section -->
      <section id="jobs-list" class="jobs-section bg-gray">
        <div class="jobs-container">
          <div class="section-header">
            <Text variant="caption" class="section-badge" data-i18n="openRoles.label">
              {openRolesCopy.label[defaultLanguage]}
            </Text>
            <Title level={2} variant="section" class="section-title" data-i18n="openRoles.title">
              {openRolesCopy.title[defaultLanguage]}
            </Title>
            <Text variant="body" class="section-description text-balance" data-i18n="openRoles.description">
              {openRolesCopy.description[defaultLanguage]}
            </Text>
          </div>

          <div class="jobs-grid">
            {jobOpenings.map((job) => (
              <a
                href={`/jobs/${job.slug}`}
                class="job-card group"
                data-job-card={job.slug}
                data-job-link
              >
                <div class="job-card-content">
                  <div class="job-meta">
                    <span class="meta-item">
                       <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M17.657 16.657 13.414 20.9a2 2 0 0 1-2.828 0l-4.243-4.243a8 8 0 1 1 11.314 0Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M15 11a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                      </svg>
                      <span data-job-field="location">{job.location[defaultLanguage]}</span>
                    </span>
                    <span class="meta-item">
                      <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M2 7h20M2 12h20M2 17h20M5 7V5h14v2M5 17v2h14v-2" />
                      </svg>
                      <span data-job-field="type">{job.type[defaultLanguage]}</span>
                    </span>
                  </div>

                  <Title level={3} variant="card" class="job-title" data-job-field="title">
                    {job.title[defaultLanguage]}
                  </Title>
                  <Text variant="body" class="job-summary" data-job-field="summary">
                    {job.summary[defaultLanguage]}
                  </Text>

                  <div class="job-tags" data-job-tags>
                    {job.tags[defaultLanguage].map((tag) => (
                      <span class="job-tag">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>

                <div class="job-cta">
                  <span data-job-card-cta>{openRolesCopy.cardCta[defaultLanguage]}</span>
                  <svg
                    class="cta-icon"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- Culture Section -->
      <section class="jobs-section">
        <div class="jobs-container">
          <div class="culture-grid">
            {culturePillars.map((pillar, index) => (
              <div class="culture-item">
                <Text variant="caption" class="culture-title" data-culture-title={index}>
                  {pillar.title[defaultLanguage]}
                </Text>
                <Text variant="body" data-culture-copy={index}>
                  {pillar.copy[defaultLanguage]}
                </Text>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- General Application -->
      <section class="jobs-section pb-24">
        <div class="jobs-container">
            <div class="general-app-card text-center">
              <Text variant="caption" class="section-badge" data-i18n="general.prompt">
                {generalApplicationCopy.prompt[defaultLanguage]}
              </Text>
              <Title level={3} variant="section" class="general-title" data-i18n="general.title">
                {generalApplicationCopy.title[defaultLanguage]}
              </Title>
              <Text variant="subtitle" class="general-description text-balance" data-i18n="general.description">
                {generalApplicationCopy.description[defaultLanguage]}
              </Text>
              <Button
                href="mailto:jobs@zelify.com"
                variant="primary"
                dataI18n="general.button"
              >
                {generalApplicationCopy.button[defaultLanguage]}
              </Button>
            </div>
        </div>
      </section>
    </main>

    <Footer />
    <AlaizaAssistant client:load />
  </body>
</html>

<style>
  html, body {
    margin: 0;
    padding: 0;
    font-family: 'Inter', system-ui, sans-serif;
    color: #0d1117;
    background-color: #fff;
  }

  .jobs-main {
    width: 100%;
  }

  .jobs-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .text-center {
    text-align: center;
  }

  /* Typography Utilities */
  .text-balance {
    text-wrap: balance;
  }

  /* Hero Section */
  .jobs-hero {
    padding-top: 8rem;
    padding-bottom: 4rem;
  }

  .hero-badge {
    color: #0066cc;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
    display: block;
  }

  .hero-title {
    margin-bottom: 2rem;
  }

  .hero-description {
    max-width: 48rem; /* 3xl */
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 3rem;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: center;
    align-items: center;
  }

  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
    }
  }

  .hero-stats-grid {
    margin-top: 5rem;
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .hero-stats-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .stat-item {
    text-align: center;
  }

  .stat-value {
    font-size: 2.25rem;
    font-weight: 700;
    color: #0d1117;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Sections General */
  .jobs-section {
    padding: 6rem 0;
  }

  .bg-gray {
    background-color: #f9fafb;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .section-badge {
    color: #0066cc;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    display: block;
  }

  .section-title {
    margin-bottom: 1rem;
  }

  .section-description {
    max-width: 48rem;
  }

  /* Jobs Grid */
  .jobs-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .jobs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Job Card */
  .job-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    background-color: #fff;
    border-radius: 1.5rem;
    padding: 2rem;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    border: 1px solid #f3f4f6;
    transition: all 0.2s ease;
    text-decoration: none;
    color: inherit;
  }

  .job-card:hover {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    border-color: #0066cc;
  }

  .job-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    font-size: 0.875rem;
    color: #6b7280;
    margin-bottom: 1.5rem;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .meta-icon {
    height: 1rem;
    width: 1rem;
  }

  .job-title {
    margin-bottom: 1rem;
  }

  .job-summary {
    margin-bottom: 1.5rem;
  }

  .job-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .job-tag {
    background-color: #f3f4f6;
    color: #4b5563;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
  }

  .job-cta {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: #0066cc;
  }

  .cta-icon {
    height: 1.25rem;
    width: 1.25rem;
    transition: transform 0.2s ease;
  }

  .job-card:hover .cta-icon {
    transform: translateX(4px);
  }

  /* Culture Section */
