---
import Layout from '../../layouts/Layout.astro';
import BackButton from '../../components/BackButton.astro';
import JobPageTranslations from '../../components/JobPageTranslations.astro';

const currentPath = Astro.url.pathname;
const jobId = currentPath.split('/').pop();
const selectedLang = Astro.url.searchParams.get('lang')?.toLowerCase();
const defaultLanguage: 'en' | 'es' = selectedLang === 'es' ? 'es' : 'en';
const jobsHref = `/jobs${defaultLanguage === 'es' ? '?lang=es' : ''}`;

const jobContent = {
  supportedLanguages: ['en', 'es'],
  hero: {
    title: {
      en: 'UI/UX Designer',
      es: 'Diseñador UI/UX',
    },
    location: {
      en: 'Remote',
      es: 'Remoto',
    },
    type: {
      en: 'Full-time',
      es: 'Tiempo completo',
    },
  },
  sections: {
    about: {
      title: {
        en: 'About Us',
        es: 'Sobre nosotros',
      },
      paragraphs: {
        en: [
          "Founded in 2018, we're on a mission to combat complexity and empower people by reinventing financial services and facilitating international transfers in Latin America. Zelify transforms banking for personal and business users, enabling you to send, split, or gift money instantly, without complications or waiting. With fluid transactions as easy as sending a message, you have the power to connect, pay, and share instantly.",
        ],
        es: [
          'Fundada en 2018, nuestra misión es combatir la complejidad y empoderar a las personas reinventando los servicios financieros y facilitando transferencias internacionales en Latinoamérica. Zelify transforma la banca para usuarios personales y empresas, permitiendo enviar, dividir o regalar dinero al instante, sin complicaciones ni esperas. Con transacciones tan fluidas como enviar un mensaje, puedes conectar, pagar y compartir de inmediato.',
        ],
      },
    },
    workModel: {
      title: {
        en: 'Our Work Model',
        es: 'Nuestro modelo de trabajo',
      },
      paragraphs: {
        en: [
          'At Zelify, we create multifunctional, diverse, and inclusive teams, attracting the best talent to develop revolutionary technology. Our design team works closely with product and engineering to create intuitive, accessible, and delightful user experiences. Our hybrid model provides independence and promotes professional responsibility to meet goals aligned with our global objectives. Our Design team transforms complex financial processes into simple, engaging user experiences.',
        ],
        es: [
          'En Zelify formamos equipos multifuncionales, diversos e inclusivos para atraer el mejor talento y desarrollar tecnología revolucionaria. El equipo de Diseño trabaja de cerca con Producto e Ingeniería para crear experiencias intuitivas, accesibles y memorables. Nuestro modelo híbrido brinda independencia y fomenta la responsabilidad profesional para cumplir metas alineadas con nuestros objetivos globales.',
        ],
      },
    },
    culture: {
      title: {
        en: 'Our Culture',
        es: 'Nuestra cultura',
      },
      paragraphs: {
        en: [
          "At Zelify, we've created an international neo-banking platform centered on the user, constantly challenging the limits of technology and design. Our promise is to connect payments and unite people, empowering our users to pay, share, and connect instantly. We cultivate a culture of professional growth, innovation, and entrepreneurship, promoting autonomy and responsibility where designers own their projects from conception to implementation.",
        ],
        es: [
          'En Zelify construimos una plataforma de neobanca internacional centrada en el usuario, desafiando los límites de la tecnología y el diseño. Nuestra promesa es conectar pagos y unir personas, empoderando a nuestros usuarios para pagar, compartir y conectar al instante. Fomentamos una cultura de crecimiento, innovación y emprendimiento que promueve autonomía y responsabilidad; los diseñadores son dueños de sus proyectos de principio a fin.',
        ],
      },
    },
    technicalRequirements: {
      title: {
        en: 'Technical Requirements',
        es: 'Requisitos técnicos',
      },
      items: {
        en: [
          '3+ years of experience in UI/UX design for digital products',
          'Strong portfolio demonstrating user-centered design solutions',
          'Proficiency in design tools such as Figma, Sketch, or Adobe XD',
          'Experience with prototyping tools (Principle, Framer, ProtoPie)',
          'Understanding of design systems and component libraries',
          'Knowledge of accessibility standards and best practices',
          'Experience conducting user research and usability testing',
          'Ability to translate complex requirements into intuitive user flows',
          'Understanding of mobile and responsive design principles',
        ],
        es: [
          'Más de 3 años de experiencia en diseño UI/UX para productos digitales',
          'Portafolio sólido que demuestre soluciones centradas en el usuario',
          'Dominio de herramientas de diseño como Figma, Sketch o Adobe XD',
          'Experiencia con herramientas de prototipado (Principle, Framer, ProtoPie)',
          'Comprensión de sistemas de diseño y librerías de componentes',
          'Conocimiento de estándares y buenas prácticas de accesibilidad',
          'Experiencia realizando investigación con usuarios y pruebas de usabilidad',
          'Capacidad para traducir requerimientos complejos en flujos intuitivos',
          'Comprensión de principios de diseño móvil y responsive',
        ],
      },
    },
    expectations: {
      title: {
        en: 'What We Expect',
        es: 'Lo que esperamos',
      },
      items: {
        en: [
          'Create user-centered designs by understanding business requirements, user feedback, and research insights',
          'Design flows, prototypes, and high-fidelity mockups for mobile and web applications',
          'Contribute to and maintain our design system',
          'Collaborate with product managers to define features and user stories',
          'Work closely with developers to ensure high-quality implementation',
          'Conduct usability testing and iterate on designs based on user feedback',
          'Stay up-to-date with the latest UI/UX trends, tools, and technologies',
          'Present and defend design decisions based on research and best practices',
        ],
        es: [
          'Crear diseños centrados en el usuario entendiendo requerimientos de negocio, retroalimentación y hallazgos de investigación',
          'Diseñar flujos, prototipos y maquetas de alta fidelidad para aplicaciones web y móviles',
          'Contribuir y mantener nuestro sistema de diseño',
          'Colaborar con product managers para definir funcionalidades e historias de usuario',
          'Trabajar de la mano con desarrolladores para asegurar implementaciones de calidad',
          'Realizar pruebas de usabilidad e iterar con base en la retroalimentación',
          'Mantenerse actualizado con las últimas tendencias, herramientas y tecnologías de UI/UX',
          'Presentar y defender decisiones de diseño basadas en investigación y mejores prácticas',
        ],
      },
    },
    niceToHave: {
      title: {
        en: 'Nice to Have',
        es: 'Deseable',
      },
      items: {
        en: [
          'Experience in fintech or banking applications',
          'Knowledge of HTML, CSS, and basic front-end development',
          'Experience with animation and micro-interactions',
          'Understanding of data visualization techniques',
          'Experience with A/B testing and analytics',
          'Knowledge of behavioral psychology and its application to UX',
          'Experience working in agile environments',
          'Multilingual capabilities (Spanish and English)',
        ],
        es: [
          'Experiencia en aplicaciones fintech o bancarias',
          'Conocimiento de HTML, CSS y desarrollo frontend básico',
          'Experiencia con animaciones y microinteracciones',
          'Comprensión de técnicas de visualización de datos',
          'Experiencia con pruebas A/B y analítica',
          'Conocimiento de psicología del comportamiento aplicada a UX',
          'Experiencia trabajando en entornos ágiles',
          'Habilidades bilingües (español e inglés)',
        ],
      },
    },
  },
  applyCta: {
    en: 'Apply for this position',
    es: 'Postúlate a esta vacante',
  },
  backCta: {
    en: 'Back to roles',
    es: 'Volver a vacantes',
  },
};
---

<Layout title="UI/UX Designer | Zelify">
  <JobPageTranslations contentId="job-ui-designer-content" content={jobContent} initialLanguage={defaultLanguage} />
  <div class="min-h-screen bg-gray-50">
    <!-- Banner -->
    <div class="relative h-64 bg-gradient-to-r from-blue-600 to-blue-800">
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="absolute inset-0 flex flex-col items-center justify-center">
        <div class="text-center">
          <h1 class="text-4xl font-bold text-white mb-4" data-hero="title">
            {jobContent.hero.title[defaultLanguage]}
          </h1>
          <div class="flex items-center justify-center gap-4 text-sm text-white/90">
            <span class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span data-hero="location">{jobContent.hero.location[defaultLanguage]}</span>
            </span>
            <span class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span data-hero="type">{jobContent.hero.type[defaultLanguage]}</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-4xl mx-auto px-4 py-12">
      <div class="bg-white rounded-xl shadow-sm p-8">
        <!-- About Us -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4" data-heading="about">
            {jobContent.sections.about.title[defaultLanguage]}
          </h2>
          <div data-paragraphs="about">
            {jobContent.sections.about.paragraphs[defaultLanguage].map((paragraph) => (
              <p class="text-gray-600 mb-6">{paragraph}</p>
            ))}
          </div>
        </section>

        <!-- Our Work Model -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4" data-heading="workModel">
            {jobContent.sections.workModel.title[defaultLanguage]}
          </h2>
          <div data-paragraphs="workModel">
            {jobContent.sections.workModel.paragraphs[defaultLanguage].map((paragraph) => (
              <p class="text-gray-600 mb-6">{paragraph}</p>
            ))}
          </div>
        </section>

        <!-- Our Culture -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4" data-heading="culture">
            {jobContent.sections.culture.title[defaultLanguage]}
          </h2>
          <div data-paragraphs="culture">
            {jobContent.sections.culture.paragraphs[defaultLanguage].map((paragraph) => (
              <p class="text-gray-600 mb-6">{paragraph}</p>
            ))}
          </div>
        </section>

        <!-- Technical Requirements -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4" data-heading="technicalRequirements">
            {jobContent.sections.technicalRequirements.title[defaultLanguage]}
          </h2>
          <ul class="list-disc list-inside text-gray-600 space-y-3" data-list="technicalRequirements">
            {jobContent.sections.technicalRequirements.items[defaultLanguage].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <!-- Role Expectations -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4" data-heading="expectations">
            {jobContent.sections.expectations.title[defaultLanguage]}
          </h2>
          <ul class="list-disc list-inside text-gray-600 space-y-3" data-list="expectations">
            {jobContent.sections.expectations.items[defaultLanguage].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <!-- Nice to Have -->
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-4" data-heading="niceToHave">
            {jobContent.sections.niceToHave.title[defaultLanguage]}
          </h2>
          <ul class="list-disc list-inside text-gray-600 space-y-3" data-list="niceToHave">
            {jobContent.sections.niceToHave.items[defaultLanguage].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <!-- Apply Button -->
        <div class="flex justify-center">
          <a
            href={`/jobs/apply?position=${jobId}`}
            class="inline-flex items-center justify-center px-8 py-4 border border-transparent text-lg font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 transition-colors duration-300 shadow-sm hover:shadow-md"
            aria-label={jobContent.applyCta[defaultLanguage]}
          >
            <span class="job-apply-label" data-i18n="job.apply">
              {jobContent.applyCta[defaultLanguage]}
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
  
  <BackButton href={jobsHref} label={jobContent.backCta[defaultLanguage]} i18nKey="job.back" />
</Layout>

<style>
  /* Smooth transitions */
  .transition-colors {
    transition-property: background-color, border-color, color, fill, stroke;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 300ms;
  }
</style>
