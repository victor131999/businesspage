---
import Navbar from "../components/navbar.astro";
import "../styles/navbar.css";

const demoVideoUrl =
  "https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/video/demo_zelify.mp4";
const demoVideoPoster = "";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png" />
    <title>Zelify — Video Demo</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/hover.css/2.3.1/css/hover-min.css" />
  </head>

  <body>
    <Navbar />
    
    <section class="video-section">
      <div class="video-container">
        {demoVideoUrl ? (
          <div class="video-player" data-video-player>
            <video
              class="demo-video"
              src={demoVideoUrl}
              poster={demoVideoPoster || undefined}
              preload="metadata"
              controls
              playsinline
            ></video>
          </div>
        ) : (
          <div class="video-placeholder">
            Agrega la URL del video en <code>demoVideoUrl</code>.
          </div>
        )}
      </div>
    </section>
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  body {
    font-family:
      "NataSans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    color: #fff;
    background-color: #020b18;
    margin: 0;
    padding: 0;
    min-height: 100vh;
    overflow-x: hidden;
  }

  .video-section {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 80px);
    padding: 2rem;
    position: relative;
    z-index: 1;
  }

  .video-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .video-player {
    width: 100%;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  }

  .demo-video {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
  }

  .video-placeholder {
    border: 2px dashed #495057;
    border-radius: 12px;
    padding: 4rem 2rem;
    text-align: center;
    color: #ced4da;
    font-size: 1rem;
    background: rgba(255, 255, 255, 0.05);
  }

  .video-placeholder code {
    background: rgba(149, 255, 11, 0.2);
    color: #95FF0B;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-family: monospace;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .video-section {
      padding: 1rem;
      min-height: calc(100vh - 60px);
    }

    .video-placeholder {
      padding: 2rem 1rem;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .video-section {
      padding: 0.5rem;
    }
  }
</style>
