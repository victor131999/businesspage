---
import Navbar3 from "../components/NavbarSimple.astro";
import "../styles/navbar.css";
import ProductsPanel from "../components/productsPanel.astro";
import { AlaizaAssistant } from "../components/AlaizaAssistant"; 


const demoVideoUrlEs =
  "https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/videos/demo_zelify.mp4";
const demoVideoUrlEn =
  "https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/videos/demo_zelify_en.mp4";
const demoVideoPoster = "";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png" />
    <title>Zelify — Video Demo</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/hover.css/2.3.1/css/hover-min.css" />
  </head>

  <body>
    <Navbar3 />
    <ProductsPanel />
    <section class="video-section">
      <div class="video-container">
        {demoVideoUrlEs ? (
          <div class="video-player" data-video-player>
            <video
              class="demo-video"
              src={demoVideoUrlEs}
              poster={demoVideoPoster || undefined}
              preload="metadata"
              controls
              playsinline
              data-video-es={demoVideoUrlEs}
              data-video-en={demoVideoUrlEn}
            ></video>
          </div>
          <div class="video-note" role="note" data-video-note>
            <span class="video-note__label">Consejo</span>
            <span class="video-note__text">
              Para ver el video en otro idioma, usa el switch del navbar y cambia a Español o Inglés.
            </span>
          </div>
        ) : (
          <div class="video-placeholder">
            Agrega la URL del video en <code>demoVideoUrl</code>.
          </div>
        )}
      </div>
    </section>
  </body>
  <AlaizaAssistant client:load />
  <script>
    const resolveInitialLang = () => {
      try {
        const stored = localStorage.getItem("ui-language");
        if (stored) return stored.toUpperCase() === "ES" ? "ES" : "EN";
      } catch (error) {
        console.warn("Unable to read stored language preference.", error);
      }
      return "EN";
    };

    const updateVideoByLanguage = (lang) => {
      const video = document.querySelector(".demo-video");
      const noteText = document.querySelector("[data-video-note] .video-note__text");
      const noteLabel = document.querySelector("[data-video-note] .video-note__label");
      if (!video) return;
      const nextLang = lang === "ES" ? "ES" : "EN";
      const src =
        nextLang === "ES"
          ? video.dataset.videoEs
          : video.dataset.videoEn || video.dataset.videoEs;

      if (noteText) {
        noteText.textContent =
          nextLang === "ES"
            ? "Para ver el video en otro idioma, usa el switch del navbar y cambia a Español o Inglés."
            : "To watch the video in another language, use the navbar switch and toggle to Spanish or English.";
      }
      if (noteLabel) {
        noteLabel.textContent = nextLang === "ES" ? "Consejo" : "Tip";
      }

      if (!src || video.getAttribute("src") === src) return;
      video.setAttribute("src", src);
      video.load();
    };

    updateVideoByLanguage(resolveInitialLang());

    window.addEventListener("ui:languagechange", (event) => {
      const customEvent = event;
      const lang = customEvent?.detail?.language || "EN";
      updateVideoByLanguage(lang);
    });
  </script>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  body {
    font-family:
      "NataSans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    color: #111827;
    background-color: #ffffff;
    margin: 0;
    padding: 0;
    min-height: 100vh;
    overflow-x: hidden;
  }

  .video-section {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 96px);
    padding: 6.5rem 2rem 2rem;
    position: relative;
    z-index: 1;
  }

  .video-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .video-player {
    width: 100%;
    background: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12);
    position: relative;
  }

  .demo-video {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
  }

  .video-placeholder {
    border: 2px dashed #cbd5f5;
    border-radius: 12px;
    padding: 4rem 2rem;
    text-align: center;
    color: #475569;
    font-size: 1rem;
    background: #f8fafc;
  }

  .video-placeholder code {
    background: rgba(149, 255, 11, 0.2);
    color: #184090;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-family: monospace;
  }

  .video-note {
    margin: 1rem auto 0;
    padding: 0.45rem 0.9rem;
    font-size: 0.85rem;
    color: #475569;
    text-align: center;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
    width: max-content;
    max-width: min(92%, 960px);
  }

  .video-note__label {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1f2937;
    background: #e2e8f0;
    border-radius: 999px;
    padding: 0.2rem 0.5rem;
    font-weight: 700;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .video-section {
      padding: 5.5rem 1rem 1.5rem;
      min-height: calc(100vh - 72px);
    }

    .video-placeholder {
      padding: 2rem 1rem;
      font-size: 0.9rem;
    }

    .video-note {
      font-size: 0.85rem;
      margin-top: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .video-section {
      padding: 0.5rem;
    }
  }
</style>
