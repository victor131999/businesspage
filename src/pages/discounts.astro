	      ".discounts-success-subtitle",
	    );
	    if (successSubtitle) successSubtitle.textContent = t.device.successSubtitle;

	    const resetBtn = document.querySelector(".discounts-reset-label");
	    if (resetBtn) resetBtn.textContent = t.device.reset;

	    const promoTitleLight = document.querySelector(
	      ".discounts-promo-title-light",
	    );
	    if (promoTitleLight) promoTitleLight.textContent = t.device.promoTitleLight;
	    const promoTitleBold = document.querySelector(".discounts-promo-title-bold");
	    if (promoTitleBold) promoTitleBold.textContent = t.device.promoTitleBold;
	    const promoSubtitle = document.querySelector(".discounts-promo-subtitle");
	    if (promoSubtitle) promoSubtitle.textContent = t.device.promoSubtitle;

	    document.querySelectorAll(".discounts-promo-brand").forEach((el) => {
	      el.textContent = t.device.promoBrand;
	    });
	    document.querySelectorAll(".discounts-promo-offer").forEach((el) => {
	      el.textContent = t.device.promoOffer;
	    });

	    const configureTitleLight = document.querySelector(
	      ".discounts-configure-title-light",
	    );
	    if (configureTitleLight)
	      configureTitleLight.textContent = t.device.configureTitleLight;
	    const configureTitleBold = document.querySelector(
	      ".discounts-configure-title-bold",
	    );
	    if (configureTitleBold)
	      configureTitleBold.textContent = t.device.configureTitleBold;
	    const configureSubtitle = document.querySelector(
	      ".discounts-configure-subtitle",
	    );
	    if (configureSubtitle)
	      configureSubtitle.textContent = t.device.configureSubtitle;

	    const startDateLabel = document.querySelector(".discounts-start-date-label");
	    if (startDateLabel) startDateLabel.textContent = t.device.startDateLabel;
	    const endDateLabel = document.querySelector(".discounts-end-date-label");
	    if (endDateLabel) endDateLabel.textContent = t.device.endDateLabel;

	    const dateParts = Array.isArray(t.device.dateParts)
	      ? t.device.dateParts
	      : [];
	    if (dateParts.length) {
	      document.querySelectorAll(".discounts-date-part").forEach((el, idx) => {
	        const value = dateParts[idx % dateParts.length];
	        if (value) el.textContent = value;
	      });
	    }

	    document.querySelectorAll(".discounts-hour-label").forEach((el) => {
	      el.textContent = t.device.hour;
	    });

	    const step01Title = document.querySelector(".discounts-step01-title");
	    if (step01Title) step01Title.textContent = t.device.step01Title;
	    const step01Subtitle = document.querySelector(".discounts-step01-subtitle");
	    if (step01Subtitle) step01Subtitle.textContent = t.device.step01Subtitle;
	    const planBasicTitle = document.querySelectorAll(".discounts-plan-basic-title");
	    planBasicTitle.forEach((el) => { el.textContent = t.device.planBasicTitle; });
	    const planBasicPrice = document.querySelector(".discounts-plan-basic-price");
	    if (planBasicPrice) planBasicPrice.textContent = t.device.planBasicPrice;
	    const planPremiumTitle = document.querySelectorAll(".discounts-plan-premium-title");
	    planPremiumTitle.forEach((el) => { el.textContent = t.device.planPremiumTitle; });
	    const planPremiumPrice = document.querySelector(".discounts-plan-premium-price");
	    if (planPremiumPrice) planPremiumPrice.textContent = t.device.planPremiumPrice;
	    document.querySelectorAll(".discounts-plan-permonth").forEach((el) => { el.textContent = t.device.perMonth; });
	    const planBasicFeatures = document.querySelectorAll(".discounts-plan-basic-feature");
	    (t.device.planBasicFeatures || []).forEach((val, i) => { if (planBasicFeatures[i]) planBasicFeatures[i].textContent = val; });
	    const planPremiumFeatures = document.querySelectorAll(".discounts-plan-premium-feature");
	    (t.device.planPremiumFeatures || []).forEach((val, i) => { if (planPremiumFeatures[i]) planPremiumFeatures[i].textContent = val; });

	    const step02Title = document.querySelector(".discounts-step02-title");
	    if (step02Title) step02Title.textContent = t.device.step02Title;
	    const step02Subtitle = document.querySelector(".discounts-step02-subtitle");
	    if (step02Subtitle) step02Subtitle.textContent = t.device.step02Subtitle;
	    const step02BusinessNameLabel = document.querySelector(".discounts-step02-business-name-label");
	    if (step02BusinessNameLabel) step02BusinessNameLabel.textContent = t.device.step02BusinessNameLabel;
	    const step02BusinessNamePh = document.querySelector(".discounts-step02-business-name-placeholder");
	    if (step02BusinessNamePh && step02BusinessNamePh instanceof HTMLInputElement) step02BusinessNamePh.placeholder = t.device.step02BusinessNamePlaceholder;
	    const step02RucLabel = document.querySelector(".discounts-step02-ruc-label");
	    if (step02RucLabel) step02RucLabel.textContent = t.device.step02RucLabel;
	    const step02RucPh = document.querySelector(".discounts-step02-ruc-placeholder");
	    if (step02RucPh && step02RucPh instanceof HTMLInputElement) step02RucPh.placeholder = t.device.step02RucPlaceholder;

	    const step03SearchPh = document.querySelector(".discounts-step03-search-placeholder");
	    if (step03SearchPh) step03SearchPh.textContent = t.device.step03SearchPlaceholder;

	    const step04Title = document.querySelector(".discounts-step04-title");
	    if (step04Title) step04Title.textContent = t.device.step04Title;
	    const step04PhoneLabel = document.querySelector(".discounts-step04-phone-label");
	    if (step04PhoneLabel) step04PhoneLabel.textContent = t.device.step04PhoneLabel;
	    const step04OfficeName = document.querySelector(".discounts-step04-office-name");
	    if (step04OfficeName) step04OfficeName.textContent = t.device.step04OfficeName;
	    const step04OfficeAddress = document.querySelector(".discounts-step04-office-address");
	    if (step04OfficeAddress) step04OfficeAddress.textContent = t.device.step04OfficeAddress;
	    const step04BuildingLabel = document.querySelector(".discounts-step04-building-label");
	    if (step04BuildingLabel) step04BuildingLabel.textContent = t.device.step04BuildingLabel;
	    const step04BuildingPh = document.querySelector(".discounts-step04-building-placeholder");
	    if (step04BuildingPh && step04BuildingPh instanceof HTMLInputElement) step04BuildingPh.placeholder = t.device.step04BuildingPlaceholder;
	    const step04FloorLabel = document.querySelector(".discounts-step04-floor-label");
	    if (step04FloorLabel) step04FloorLabel.textContent = t.device.step04FloorLabel;
	    const step04FloorPh = document.querySelector(".discounts-step04-floor-placeholder");
	    if (step04FloorPh && step04FloorPh instanceof HTMLInputElement) step04FloorPh.placeholder = t.device.step04FloorPlaceholder;
	    const step04RefLabel = document.querySelector(".discounts-step04-reference-label");
	    if (step04RefLabel) step04RefLabel.textContent = t.device.step04ReferenceLabel;
	    const step04RefPh = document.querySelector(".discounts-step04-reference-placeholder");
	    if (step04RefPh && step04RefPh instanceof HTMLTextAreaElement) step04RefPh.placeholder = t.device.step04ReferencePlaceholder;

	    const step05Title = document.querySelector(".discounts-step05-title");
	    if (step05Title) step05Title.textContent = t.device.step05Title;
	    const step05Subtitle = document.querySelector(".discounts-step05-subtitle");
	    if (step05Subtitle) step05Subtitle.textContent = t.device.step05Subtitle;
	    const step05DescLabel = document.querySelector(".discounts-step05-description-label");
	    if (step05DescLabel) step05DescLabel.textContent = t.device.step05DescriptionLabel;
	    const step05DescPh = document.querySelector(".discounts-step05-description-placeholder");
	    if (step05DescPh && step05DescPh instanceof HTMLTextAreaElement) step05DescPh.placeholder = t.device.step05DescriptionPlaceholder;
	    const step05CharCount = document.querySelector(".discounts-step05-char-count");
	    if (step05CharCount) step05CharCount.textContent = t.device.step05CharCount;

	    const step06Subtitle = document.querySelector(".discounts-step06-subtitle");
	    if (step06Subtitle) step06Subtitle.textContent = t.device.step06Subtitle;
	    const step06CategoryName = document.querySelector(".discounts-step06-category-name");
	    if (step06CategoryName) step06CategoryName.textContent = t.device.step06CategoryName;

	    const step07Title = document.querySelector(".discounts-step07-title");
	    if (step07Title) step07Title.textContent = t.device.step07Title;
	    const step07Subtitle = document.querySelector(".discounts-step07-subtitle");
	    if (step07Subtitle) step07Subtitle.textContent = t.device.step07Subtitle;
	    const step07ProductLabel = document.querySelector(".discounts-step07-product-label");
	    if (step07ProductLabel) step07ProductLabel.textContent = t.device.step07ProductNameLabel;
	    const step07PriceLabel = document.querySelector(".discounts-step07-price-label");
	    if (step07PriceLabel) step07PriceLabel.textContent = t.device.step07PriceLabel;
	    const step07ProfileLabel = document.querySelector(".discounts-step07-profile-label");
	    if (step07ProfileLabel) step07ProfileLabel.textContent = t.device.step07CustomerProfileLabel;

	    // Security section
	    const securityTitle = document.querySelector(".security-title");
	    if (securityTitle) securityTitle.innerHTML = t.security.title;

    const securityFeatures = document.querySelectorAll(".security-feature");
    securityFeatures.forEach((feature, index) => {
      if (t.security.features[index]) {
        const titleEl = feature.querySelector(".feature-title");
        const descEl = feature.querySelector(".feature-description");
        if (titleEl) titleEl.textContent = t.security.features[index].title;
        if (descEl) descEl.textContent = t.security.features[index].description;
      }
    });

    // Control section
    const controlTitle = document.querySelector(".control-title");
    if (controlTitle) controlTitle.innerHTML = t.control.title;

    const controlFeatures = document.querySelectorAll(".control-feature");
    controlFeatures.forEach((feature, index) => {
      if (t.control.features[index]) {
        const frontTitle = feature.querySelector(
          ".control-feature-front .control-feature-title",
        );
        const frontDesc = feature.querySelector(
          ".control-feature-front .control-feature-description",
        );
        const backTitle = feature.querySelector(
          ".control-feature-back .control-feature-title",
        );
        const benefitsList = feature.querySelector(".control-feature-benefits");

        if (frontTitle)
          frontTitle.textContent = t.control.features[index].title;
        if (frontDesc)
          frontDesc.textContent = t.control.features[index].description;
        if (backTitle)
          backTitle.textContent = t.control.features[index].title + " Benefits";

        if (benefitsList) {
          benefitsList.innerHTML = t.control.features[index].benefits
            .map((benefit) => `<li>${benefit}</li>`)
            .join("");
        }
      }
    });

    // Contact section
    const contactTitle = document.querySelector(".contact-title");
    if (contactTitle) contactTitle.innerHTML = t.contact.title;

    const formTitle = document.querySelector(".contact-form-title");
    if (formTitle) formTitle.textContent = t.contact.formTitle;

    const contactForm = document.getElementById("contactForm");
    if (contactForm) {
      const nombresInput = contactForm.querySelector("#nombres");
      if (nombresInput instanceof HTMLInputElement)
        nombresInput.placeholder = t.contact.placeholders.nombres;

      const apellidosInput = contactForm.querySelector("#apellidos");
      if (apellidosInput instanceof HTMLInputElement)
        apellidosInput.placeholder = t.contact.placeholders.apellidos;

      const companiaInput = contactForm.querySelector("#compania");
      if (companiaInput instanceof HTMLInputElement)
        companiaInput.placeholder = t.contact.placeholders.compania;

      const emailInput2 = contactForm.querySelector("#email");
      if (emailInput2 instanceof HTMLInputElement)
        emailInput2.placeholder = t.contact.placeholders.email;

      const telefonoInput = contactForm.querySelector("#telefono");
      if (telefonoInput instanceof HTMLInputElement)
        telefonoInput.placeholder = t.contact.placeholders.telefono;

      const countrySelect = contactForm.querySelector("#pais");
      if (
        countrySelect instanceof HTMLSelectElement &&
        countrySelect.options.length > 0
      ) {
        countrySelect.options[0].textContent = t.contact.countryDefault;
      }

      const submitBtn = contactForm.querySelector(
        ".contact-submit-btn, .hubspot-contact-submit-btn",
      );
      if (submitBtn instanceof HTMLInputElement) {
        submitBtn.value = t.contact.submitButton;
      } else if (submitBtn) {
        submitBtn.textContent = t.contact.submitButton;
      }

      const legalText = contactForm.querySelector(
        ".contact-legal, .hubspot-contact-legal",
      );
      if (legalText) legalText.innerHTML = t.contact.legal;
    }

    // CTA section
    const ctaTitle = document.querySelector(".cta-title");
    if (ctaTitle) ctaTitle.innerHTML = t.cta.title;

    const ctaButton = document.querySelector(".cta-button");
    if (ctaButton) ctaButton.textContent = t.cta.button;

    // FAQ section
    const faqTitle = document.querySelector(".faq-title");
    if (faqTitle) faqTitle.textContent = t.faq.title;

    const faqItems = document.querySelectorAll(".faq-item");
    faqItems.forEach((item, index) => {
      if (t.faq.items[index]) {
        const questionSpan = item.querySelector(".faq-question span");
        const answerP = item.querySelector(".faq-answer p");
        if (questionSpan) questionSpan.textContent = t.faq.items[index].q;
        if (answerP) answerP.textContent = t.faq.items[index].a;
      }
    });

    // Footer
    const footerLinksTitle = document.querySelector(".quick-links-title");
    if (footerLinksTitle) footerLinksTitle.textContent = t.footer.linksTitle;

    const footerDisclaimer = document.querySelector(".footer-legal");
    if (footerDisclaimer) footerDisclaimer.textContent = t.footer.disclaimer;

    const footerCopyright = document.querySelector(".footer-copyright");
    if (footerCopyright) footerCopyright.textContent = t.footer.copyright;
  }

  const detectBrowserLanguage = () => {
    const locale =
      (navigator.languages && navigator.languages[0]) ||
      navigator.language ||
      "";
    return locale.toLowerCase().startsWith("es") ? "ES" : "EN";
  };

  // Listen for language change event
  window.addEventListener("ui:languagechange", (event: Event) => {
    const customEvent = event as CustomEvent<{ language: string }>;
    const lang = customEvent.detail?.language || "ES";
    updateDiscountsContent(lang);
  });

  // Initialize on page load
  document.addEventListener("DOMContentLoaded", () => {
    const stored = localStorage.getItem("ui-language");
    const initialLang =
      (window as any).__uiLanguage || stored || detectBrowserLanguage();
    updateDiscountsContent(initialLang);
  });
</script>
