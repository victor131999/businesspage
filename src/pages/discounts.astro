---
import DeviceFrame from "@/components/DeviceFrame.astro";
import DiscountApp from "@/components/discounts/DiscountApp.astro";
import TransferApp from "@/components/tx/TransferApp.astro";
import Navbar3 from "../components/NavbarSimple.astro";
import ProductsPanel from "../components/productsPanel.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/png"
      href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png"
    />
    <title>Zelify — Discounts</title>
  </head>

  <body>
    <header class="auth-header">
      <Navbar3 />
      <ProductsPanel />
    </header>

    <main class="auth-main">
      <section class="auth-hero">
        <h1 class="auth-title">
          Gestión integral de<br />
          descuentos y beneficios
        </h1>
        <p class="auth-description">
          Centraliza la relación con comercios para crear y difundir beneficios.
          Permite registrar negocios con su información operativa, diseñar y
          publicar descuentos o campañas, geolocalizar establecimientos en el
          mapa y habilitar pagos con posterior liquidación dentro de la red
          Zelify. Incluye reportes comerciales para seguimiento de ventas,
          redenciones y conciliación.
        </p>
        <div class="auth-cta">
          <form
            class="welcome-input-group"
            action="#"
            aria-label="Solicitar cotización"
            novalidate
          >
            <input
              class="welcome-input"
              type="email"
              name="email"
              placeholder="ingresa tu correo"
              aria-label="Ingresa tu correo"
              data-i18n-placeholder="home.welcome.email.placeholder"
              data-i18n-aria="home.welcome.email.aria"
            />
            <button class="welcome-quote-button" type="submit">cotizar</button>
          </form>
          <a
            href="https://www.zelify.com/clips"
            class="welcome-demo-button"
            target="_blank"
            rel="noopener noreferrer">demo</a
          >
        </div>
      </section>
    </main>

    <div class="auth-background-section">
      <div class="auth-background-overlay"></div>
      <div class="auth-background-image">
        <video class="auth-video" autoplay loop muted playsinline>
          <source
            src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/video/circlesmov.mp4"
            type="video/mp4"
          />
        </video>
      </div>

      <!-- Contenedor del dispositivo móvil -->
      <DeviceFrame class="device-container">
        <DiscountApp />
      </DeviceFrame>
    </div>

    <!-- Sección de Seguridad Inteligente -->
    <section class="security-section">
      <div class="security-container">
        <h2 class="security-title">
          Registro de comercios<br />
          y gestión operativa
        </h2>

        <div class="security-features">
          <!-- Feature 1: Gestión de Comercios -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 21h18v-8a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8z"></path>
                <path d="M9 10a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2"></path>
                <path d="M3 10l2-8h14l2 8"></path>
              </svg>
            </div>
            <h3 class="feature-title">Gestión de Comercios</h3>
            <p class="feature-description">
              Permite la gestión integral de la identidad del negocio: crear,
              actualizar y cancelar el perfil del comercio de forma sencilla.
            </p>
          </div>

          <!-- Feature 2: Catálogo de Productos -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
                ></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </div>
            <h3 class="feature-title">Catálogo y Categorías</h3>
            <p class="feature-description">
              Administra tu oferta: crea, consulta y modifica productos y
              categorías, asegurando un inventario siempre actualizado.
            </p>
          </div>

          <!-- Feature 3: Descuentos y Promociones -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"
                ></path>
                <line x1="7" y1="7" x2="7.01" y2="7"></line>
              </svg>
            </div>
            <h3 class="feature-title">Descuentos y Promociones</h3>
            <p class="feature-description">
              Control total del ciclo de vida de beneficios. Diseña estrategias
              dinámicas activando y gestionando ofertas individuales.
            </p>
          </div>

          <!-- Feature 4: Geolocalización -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <h3 class="feature-title">Geolocalización</h3>
            <p class="feature-description">
              Visibilidad espacial para tu negocio. Permite a los usuarios
              encontrar puntos de venta y beneficios cercanos en el mapa.
            </p>
          </div>

          <!-- Feature 5: Pagos y Liquidación -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
                <line x1="12" y1="15" x2="12" y2="15"></line>
              </svg>
            </div>
            <h3 class="feature-title">Pagos y Liquidación</h3>
            <p class="feature-description">
              Control financiero transparente: consulta estatus de pagos y
              liquidaciones derivadas de las promociones redimidas.
            </p>
          </div>

          <!-- Feature 6: Análisis y Reportes -->
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
              </svg>
            </div>
            <h3 class="feature-title">Análisis y Reportes</h3>
            <p class="feature-description">
              Inteligencia de negocios: genera informes de ventas detallados y
              evalúa el rendimiento de tus descuentos y clientes.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Control Total -->
    <section class="control-section">
      <div class="control-container">
        <div class="control-divider"></div>
        <h2 class="control-title">
          Gestión integral de beneficios y comercios
        </h2>

        <div class="control-features">
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://plus.unsplash.com/premium_photo-1682126756544-a551c4d43987?q=80&w=1234&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                    alt="Gestión de Comercios"
                  />
                </div>
                <h3 class="control-feature-title">Gestión de Comercios</h3>
                <p class="control-feature-description">
                  Administración integral de la identidad del negocio,
                  catálogos, productos y categorías para mantener la oferta
                  actualizada.
                </p>
                <button class="control-feature-btn" data-feature="merchants">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Beneficios de Comercios</h3>
                <ul class="control-feature-benefits">
                  <li>Perfil de negocio completo y editable</li>
                  <li>Gestión de catálogo de productos</li>
                  <li>Alta y baja de categorías</li>
                  <li>Actualización de oferta en tiempo real</li>
                  <li>Control de identidad corporativa</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="merchants"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?w=800&h=500&fit=crop&q=80"
                    alt="Descuentos y Promociones"
                  />
                </div>
                <h3 class="control-feature-title">Descuentos y Promociones</h3>
                <p class="control-feature-description">
                  Control total del ciclo de vida de los beneficios para diseñar
                  estrategias dinámicas y campañas ágiles.
                </p>
                <button class="control-feature-btn" data-feature="discounts">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Beneficios de Descuentos</h3>
                <ul class="control-feature-benefits">
                  <li>Creación de campañas dinámicas</li>
                  <li>Control de vigencia y disponibilidad</li>
                  <li>Activación y desactivación inmediata</li>
                  <li>Gestión individual de promociones</li>
                  <li>Respuesta ágil al mercado</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="discounts"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1569336415962-a4bd9f69cd83?w=800&h=500&fit=crop&q=80"
                    alt="Geolocalización"
                  />
                </div>
                <h3 class="control-feature-title">Geolocalización</h3>
                <p class="control-feature-description">
                  Visibilidad espacial en mapas interactivos para que los
                  usuarios encuentren puntos de venta y beneficios cercanos.
                </p>
                <button class="control-feature-btn" data-feature="geo">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">
                  Beneficios de Geolocalización
                </h3>
                <ul class="control-feature-benefits">
                  <li>Visibilidad en mapa interactivo</li>
                  <li>Tráfico a puntos de venta físicos</li>
                  <li>Descuentos basados en cercanía</li>
                  <li>Actualización de coordenadas</li>
                  <li>Geolocalización de establecimientos</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="geo"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&h=500&fit=crop&q=80"
                    alt="Análisis y Reportes"
                  />
                </div>
                <h3 class="control-feature-title">Análisis y Reportes</h3>
                <p class="control-feature-description">
                  Inteligencia de negocios para la toma de decisiones, control
                  financiero y conciliación de pagos y redenciones.
                </p>
                <button class="control-feature-btn" data-feature="analytics">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Beneficios de Análisis</h3>
                <ul class="control-feature-benefits">
                  <li>Informes de ventas detallados</li>
                  <li>Rendimiento de descuentos</li>
                  <li>Estatus de pagos y liquidación</li>
                  <li>Análisis de comportamiento de clientes</li>
                  <li>Resúmenes transaccionales</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="analytics"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Contacto -->
    <section class="contact-section">
      <div class="contact-container">
        <div class="contact-content">
          <!-- Texto izquierdo -->
          <div class="contact-text">
            <h2 class="contact-title">
              Empieza hoy<br />
              y protege tu<br />
              plataforma.
            </h2>
          </div>

          <!-- Formulario derecho -->
          <div class="contact-form-wrapper">
            <div class="contact-form-card">
              <h3 class="contact-form-title">Habla con nuestro equipo</h3>

              <form class="contact-form" id="contactForm">
                <div class="form-row">
                  <div class="form-group">
                    <input
                      type="text"
                      id="nombres"
                      placeholder="Nombres"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <input
                      type="text"
                      id="apellidos"
                      placeholder="Apellidos"
                      required
                    />
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <input
                      type="text"
                      id="compania"
                      placeholder="Nombre de la compañía"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <input
                      type="email"
                      id="email"
                      placeholder="Email de la compañía"
                      required
                    />
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <select id="pais" required>
                      <option value="">País</option>
                      <option value="mx">México</option>
                      <option value="co">Colombia</option>
                      <option value="ar">Argentina</option>
                      <option value="cl">Chile</option>
                      <option value="pe">Perú</option>
                      <option value="es">España</option>
                      <option value="us">Estados Unidos</option>
                    </select>
                    <svg
                      class="select-arrow"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </div>
                  <div class="form-group">
                    <input
                      type="tel"
                      id="telefono"
                      placeholder="Teléfono (opcional)"
                    />
                  </div>
                </div>

                <p class="contact-legal">
                  Al enviar este formulario, aceptas nuestros <a href="#"
                    >Términos de Servicio</a
                  > y <a href="#">Política de Privacidad</a>.
                </p>

                <button type="submit" class="contact-submit-btn">
                  Hablemos
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de FAQ -->
    <section class="faq-section">
      <div class="faq-container">
        <h2 class="faq-title">Preguntas frecuentes</h2>

        <div class="faq-list">
          <div class="faq-item">
            <button class="faq-question" data-faq="1">
              <span>¿Qué funcionalidades incluye el módulo de Discounts?</span>
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                El módulo centraliza la relación con comercios para crear y
                difundir beneficios. Permite registrar negocios, gestionar
                catálogos de productos y categorías, diseñar campañas de
                descuentos, geolocalizar establecimientos en un mapa interactivo
                y habilitar pagos con su respectiva liquidación dentro de la red
                Zelify.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="2">
              <span
                >¿Cómo puedo gestionar los productos y categorías de mi
                comercio?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                A través de la gestión integral de identidad, puedes crear,
                actualizar y organizar tu catálogo. El sistema permite
                administrar categorías y productos de forma independiente,
                dándote la flexibilidad de activar, desactivar o eliminar
                artículos según la disponibilidad de tu inventario en tiempo
                real.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="3">
              <span
                >¿Qué control tengo sobre la vigencia de mis promociones?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Tienes control total sobre el ciclo de vida de cada beneficio.
                Puedes crear, activar o desactivar descuentos y promociones de
                manera individual, lo que te permite responder ágilmente a las
                necesidades del mercado y gestionar la disponibilidad de cada
                oferta de forma estratégica.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="4">
              <span
                >¿Cómo ayuda la geolocalización a la visibilidad de mi negocio?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                El módulo incluye herramientas de visibilidad espacial que
                permiten a los usuarios finales localizar físicamente tus puntos
                de venta a través de un mapa interactivo. Esto asegura que los
                beneficios disponibles se muestren a los clientes que se
                encuentren en la cercanía de tu establecimiento.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="5">
              <span
                >¿Cómo se maneja la liquidación de las promociones redimidas?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Zelify proporciona un control financiero transparente. Puedes
                consultar el estado de pago de las transacciones y obtener
