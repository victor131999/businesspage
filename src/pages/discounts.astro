  function updateDiscountsContent(lang = "ES") {
    const langKey = (
      lang.toUpperCase() === "EN" ? "en" : "es"
    ) as keyof typeof discountsTranslations;
    const t = discountsTranslations[langKey];
    document.documentElement.lang = langKey;

    // Hero section
    const heroTitle = document.querySelector(".auth-title");
    if (heroTitle) heroTitle.innerHTML = t.hero.title;

    const heroDesc = document.querySelector(".auth-description");
    if (heroDesc) heroDesc.textContent = t.hero.description;

    const emailInput = document.querySelector(".welcome-input");
    if (emailInput instanceof HTMLInputElement)
      emailInput.placeholder = t.hero.inputPlaceholder;

    const quoteBtn = document.querySelector(".welcome-quote-button");
    if (quoteBtn) quoteBtn.textContent = t.hero.quoteButton;

	    const demoBtn = document.querySelector(".welcome-demo-button");
	    if (demoBtn) demoBtn.textContent = t.hero.demoButton;

	    // Device preview
	    document.querySelectorAll(".discounts-back-label").forEach((el) => {
