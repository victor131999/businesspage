	      el.textContent = t.device.continue;
	    });

	    const categoryNo = document.querySelector(".discounts-cat-no");
	    if (categoryNo) categoryNo.textContent = t.device.categoryNo;

	    const categoryYes = document.querySelector(".discounts-cat-yes");
	    if (categoryYes) categoryYes.textContent = t.device.categoryYes;

	    const launchBtn = document.querySelector(".discounts-launch-label");
	    if (launchBtn) launchBtn.textContent = t.device.launch;

	    document.querySelectorAll(".discounts-launching-title").forEach((el) => {
	      el.textContent = t.device.launchingTitle;
	    });
