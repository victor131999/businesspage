</style>

<script>
  let currentStep = 1;
  const formData = {
    fullName: "",
    email: "",
    emailOTP: "",
    phone: "",
    phoneOTP: "",
    password: "",
    confirmPassword: "",
  };

  const validationErrors = {};
  let emailOTPStatus = "idle"; // 'idle' | 'verifying' | 'success' | 'error'
  let phoneOTPStatus = "idle";

  // Inicializar OTP inputs
  function initOTPInputs(containerId) {
    const container = document.getElementById(containerId);
    if (!container) return;

    const inputs = container.querySelectorAll(".otp-input");

    inputs.forEach((input, index) => {
      input.addEventListener("input", (e) => {
        const value = e.target.value.replace(/[^0-9]/g, "");
        e.target.value = value;

        if (value && index < inputs.length - 1) {
          inputs[index + 1].focus();
        }
      });

      input.addEventListener("keydown", (e) => {
        if (e.key === "Backspace" && !e.target.value && index > 0) {
          inputs[index - 1].focus();
        }
      });

      input.addEventListener("paste", (e) => {
        e.preventDefault();
        const pasted = e.clipboardData
          .getData("text")
          .replace(/[^0-9]/g, "")
          .slice(0, 6);
        pasted.split("").forEach((char, i) => {
          if (inputs[i]) {
            inputs[i].value = char;
          }
        });
        if (pasted.length === 6) {
          inputs[5].focus();
        }
      });
    });
  }

  // Actualizar dots de progreso
  function updateProgressDots(step) {
    const dots = document.querySelectorAll(".phone-card-dots .dot");
    dots.forEach((dot, index) => {
      if (index < step) {
        dot.classList.add("active");
      } else {
        dot.classList.remove("active");
      }
    });
  }

  // Mostrar paso
  function showStep(step) {
    document.querySelectorAll(".auth-step").forEach((el, index) => {
      el.style.display = index + 1 === step ? "block" : "none";
    });

    // Actualizar título y descripción según el paso
    const titleEl = document.getElementById("step-title");
    const descEl = document.getElementById("step-description");
    const loginLink = document.getElementById("login-link");

    if (step === 1) {
      titleEl.textContent = "Crear Cuenta";
      descEl.innerHTML =
        "Ingresa tu nombre y correo electrónico para empezar. Te enviaremos un código de verificación.";
      loginLink.style.display = "none";
    } else if (step === 2) {
      titleEl.textContent = "Verifica tu Correo";
      descEl.innerHTML =
        'Hemos enviado un código de 6 dígitos a<br /><strong id="email-display">' +
        formData.email +
        "</strong>";
      loginLink.style.display = "none";
    } else if (step === 3) {
      titleEl.textContent = "Agrega tu Teléfono";
      descEl.textContent =
        "Te enviaremos un código de verificación por SMS para confirmar tu número de teléfono.";
      loginLink.style.display = "none";
    } else if (step === 4) {
      titleEl.textContent = "Verifica tu Teléfono";
      descEl.innerHTML =
        'Hemos enviado un código de 6 dígitos a<br /><strong id="phone-display">' +
        formData.phone +
        "</strong>";
      loginLink.style.display = "none";
    } else if (step === 5) {
      titleEl.textContent = "Completa tu Perfil";
      descEl.textContent =
        "Completa la información restante para finalizar la configuración de tu cuenta.";
      loginLink.style.display = "block";
    }

    updateProgressDots(step);
    currentStep = step;
  }

  // Funciones de validación
  function validateFullName(name) {
    return name.trim().length >= 2;
  }

  function validateEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function validatePhone(phone) {
    return phone.trim().length >= 10;
  }

  function validatePassword(password) {
    return password.length >= 8;
  }

  function showFieldError(fieldId, message) {
    validationErrors[fieldId] = message;
    const field = document.getElementById(fieldId);
    if (field) {
      field.classList.add("field-error");
      const errorEl = field.parentElement.querySelector(".field-error-message");
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.style.display = "block";
      }
    }
  }

  function clearFieldError(fieldId) {
    delete validationErrors[fieldId];
    const field = document.getElementById(fieldId);
    if (field) {
      field.classList.remove("field-error");
      const errorEl = field.parentElement.querySelector(".field-error-message");
      if (errorEl) {
        errorEl.style.display = "none";
      }
    }
  }

  function clearAllErrors() {
    Object.keys(validationErrors).forEach((key) => clearFieldError(key));
  }

  // Paso 1: Crear cuenta
  document.getElementById("form-step-1")?.addEventListener("submit", (e) => {
    e.preventDefault();
    clearAllErrors();

    const fullName = document.getElementById("fullName").value.trim();
    const email = document.getElementById("email").value.trim();

    let hasErrors = false;

    if (!validateFullName(fullName)) {
      showFieldError("fullName", "El nombre debe tener al menos 2 caracteres");
      hasErrors = true;
    }

    if (!validateEmail(email)) {
      showFieldError("email", "Correo electrónico inválido");
      hasErrors = true;
    }

    if (hasErrors) {
      return;
    }

    formData.fullName = fullName;
    formData.email = email;

    showStep(2);
    initOTPInputs("otp-email");
  });

  // Limpiar errores al escribir
  document.getElementById("fullName")?.addEventListener("input", () => {
    clearFieldError("fullName");
  });

  document.getElementById("email")?.addEventListener("input", () => {
    clearFieldError("email");
  });

  // Paso 2: Verificar email
  document.getElementById("form-step-2")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const inputs = document.querySelectorAll("#otp-email .otp-input");
    const otp = Array.from(inputs)
      .map((input) => input.value)
      .join("");

    if (otp.length !== 6) {
      return;
    }

    emailOTPStatus = "verifying";
    updateOTPStatus("otp-email", "verifying");

    // Código quemado: 202601
    const isValid = otp === "202601";

    setTimeout(() => {
      if (isValid) {
        emailOTPStatus = "success";
        updateOTPStatus("otp-email", "success");
        formData.emailOTP = otp;

        setTimeout(() => {
          emailOTPStatus = "idle";
          showStep(3);
        }, 3000);
      } else {
        emailOTPStatus = "error";
        updateOTPStatus("otp-email", "error");

        setTimeout(() => {
          emailOTPStatus = "idle";
          updateOTPStatus("otp-email", "idle");
          inputs.forEach((input) => (input.value = ""));
          inputs[0].focus();
        }, 2000);
      }
    }, 1000);
  });

  function updateOTPStatus(containerId, status) {
    const container = document.getElementById(containerId);
    if (!container) return;

    const inputs = container.querySelectorAll(".otp-input");
    inputs.forEach((input) => {
      input.classList.remove("otp-verifying", "otp-success", "otp-error");
      if (status !== "idle") {
        input.classList.add(`otp-${status}`);
      }
    });
  }

  // Paso 3: Agregar teléfono
  document.getElementById("form-step-3")?.addEventListener("submit", (e) => {
    e.preventDefault();
    clearAllErrors();

    const phone = document.getElementById("phone").value.trim();

    if (!validatePhone(phone)) {
      showFieldError("phone", "Número de teléfono inválido");
      return;
    }

    formData.phone = phone;
    showStep(4);
    initOTPInputs("otp-phone");
  });

  document.getElementById("phone")?.addEventListener("input", () => {
    clearFieldError("phone");
  });

  // Paso 4: Verificar teléfono
  document.getElementById("form-step-4")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const inputs = document.querySelectorAll("#otp-phone .otp-input");
    const otp = Array.from(inputs)
      .map((input) => input.value)
      .join("");

    if (otp.length !== 6) {
      return;
    }

    phoneOTPStatus = "verifying";
    updateOTPStatus("otp-phone", "verifying");

    // Código quemado: 202601
    const isValid = otp === "202601";

    setTimeout(() => {
      if (isValid) {
        phoneOTPStatus = "success";
        updateOTPStatus("otp-phone", "success");
        formData.phoneOTP = otp;

        setTimeout(() => {
          phoneOTPStatus = "idle";
          showStep(5);
        }, 3000);
      } else {
        phoneOTPStatus = "error";
        updateOTPStatus("otp-phone", "error");

        setTimeout(() => {
          phoneOTPStatus = "idle";
          updateOTPStatus("otp-phone", "idle");
          inputs.forEach((input) => (input.value = ""));
          inputs[0].focus();
        }, 2000);
      }
    }, 1000);
  });

  // Paso 5: Completar perfil
  document.getElementById("form-step-5")?.addEventListener("submit", (e) => {
    e.preventDefault();
    clearAllErrors();

    const password = document.getElementById("password").value;
    const confirmPassword = document.getElementById("confirmPassword").value;

    let hasErrors = false;

    if (!validatePassword(password)) {
      showFieldError(
        "password",
        "La contraseña debe tener al menos 8 caracteres",
      );
      hasErrors = true;
    }

    if (password !== confirmPassword) {
      showFieldError("confirmPassword", "Las contraseñas no coinciden");
      hasErrors = true;
    }

    if (hasErrors) {
      return;
    }

    formData.password = password;
    formData.confirmPassword = confirmPassword;

    // Cuenta creada exitosamente
    console.log("Registro completado", formData);
    // Aquí podrías redirigir o hacer una llamada a la API
  });

  document.getElementById("password")?.addEventListener("input", () => {
    clearFieldError("password");
  });

  document.getElementById("confirmPassword")?.addEventListener("input", () => {
    clearFieldError("confirmPassword");
  });

  // Reenviar códigos
  document.getElementById("resend-email")?.addEventListener("click", (e) => {
    e.preventDefault();
    // Simular reenvío - en producción harías una llamada a la API
    console.log("Código reenviado a", formData.email);
  });

  document.getElementById("resend-phone")?.addEventListener("click", (e) => {
    e.preventDefault();
    // Simular reenvío - en producción harías una llamada a la API
    console.log("Código reenviado a", formData.phone);
  });

  // Inicializar
  updateProgressDots(1);

  // Control de flip cards para beneficios
  document.querySelectorAll(".control-feature-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const card = btn.closest(".control-feature-card");

      if (card) {
        card.classList.toggle("flipped");
      }
    });
  });

  // Formulario de contacto
  document.getElementById("contactForm")?.addEventListener("submit", (e) => {
    e.preventDefault();

    const formData = {
      nombres: document.getElementById("nombres").value,
      apellidos: document.getElementById("apellidos").value,
      compania: document.getElementById("compania").value,
      email: document.getElementById("email").value,
      pais: document.getElementById("pais").value,
      telefono: document.getElementById("telefono").value,
    };

    console.log("Formulario enviado:", formData);
    // Aquí podrías hacer una llamada a la API para enviar el formulario
  });

  // FAQ Accordion
  document.querySelectorAll(".faq-question").forEach((question) => {
    question.addEventListener("click", () => {
      const faqItem = question.closest(".faq-item");
      const isActive = faqItem.classList.contains("active");

      // Cerrar todos los demás items
      document.querySelectorAll(".faq-item").forEach((item) => {
        item.classList.remove("active");
      });

      // Abrir el item clickeado si no estaba activo
      if (!isActive) {
        faqItem.classList.add("active");
      }
    });
  });
</script>
