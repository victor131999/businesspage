  function updateIdentityContent(lang: keyof typeof identityTranslations) {
    const t = identityTranslations[lang] || identityTranslations.es;
    currentLang = lang;

    // Hero
    const heroTitle = document.querySelector(".auth-title");
    if (heroTitle) heroTitle.innerHTML = t.hero.title;

    const heroDesc = document.querySelector(".auth-description");
    if (heroDesc) heroDesc.innerHTML = t.hero.description;

    const heroEmail = document.querySelector(".welcome-input");
    if (heroEmail instanceof HTMLInputElement) {
      heroEmail.placeholder = t.hero.ctaInputPlaceholder;
      heroEmail.ariaLabel = t.hero.ctaInputPlaceholder;
    }
    const heroBtn = document.querySelector(".welcome-quote-button");
    if (heroBtn) heroBtn.textContent = t.hero.ctaButton;

    const demoBtn = document.querySelector(".welcome-demo-button");
    if (demoBtn) demoBtn.textContent = t.hero.demoButton;

    // Control Section
    const ctrlTitle = document.querySelector(".control-title");
    if (ctrlTitle) ctrlTitle.textContent = t.control.title;

    const ctrlFeatures = document.querySelectorAll(".control-feature");
    ctrlFeatures.forEach((el, idx) => {
      if (t.control.features[idx]) {
        const data = t.control.features[idx];
        const titleFront = el.querySelector(
          ".control-feature-front .control-feature-title",
        );
        if (titleFront) titleFront.textContent = data.title;

        const descFront = el.querySelector(
          ".control-feature-front .control-feature-description",
        );
        if (descFront) descFront.textContent = data.desc;

        const titleBack = el.querySelector(
          ".control-feature-back .control-feature-title",
        );
        if (titleBack) titleBack.textContent = data.backTitle;

        if (data.benefits) {
          const ul = el.querySelector(".control-feature-benefits");
          if (ul)
            ul.innerHTML = data.benefits.map((b) => `<li>${b}</li>`).join("");
        } else if (data.benefitsHTML) {
          const div = el.querySelector(".control-feature-benefits");
          if (div) div.innerHTML = data.benefitsHTML;
        }
      }
    });

    // Contact Section
    const contactTitle = document.querySelector(".contact-title");
    if (contactTitle) contactTitle.innerHTML = t.contact.title;

    const contactFormTitle = document.querySelector(".contact-form-title");
    if (contactFormTitle) contactFormTitle.textContent = t.contact.formTitle;

    const contactForm = document.getElementById("contactForm");
    if (contactForm) {
      const names = contactForm.querySelector("#nombres");
      if (names instanceof HTMLInputElement)
        names.placeholder = t.contact.placeholders.names;

      const surnames = contactForm.querySelector("#apellidos");
      if (surnames instanceof HTMLInputElement)
        surnames.placeholder = t.contact.placeholders.surnames;

      const company = contactForm.querySelector("#compania");
      if (company instanceof HTMLInputElement)
        company.placeholder = t.contact.placeholders.company;

      const email = contactForm.querySelector("#email");
      if (email instanceof HTMLInputElement)
        email.placeholder = t.contact.placeholders.email;

      const phone = contactForm.querySelector("#telefono");
      if (phone instanceof HTMLInputElement)
        phone.placeholder = t.contact.placeholders.phone;

      const submitBtn = contactForm.querySelector(
        ".contact-submit-btn, .hubspot-contact-submit-btn",
      );
      if (submitBtn instanceof HTMLInputElement) {
        submitBtn.value = t.contact.submit;
      } else if (submitBtn) {
        submitBtn.textContent = t.contact.submit;
      }

      const legal = contactForm.querySelector(
        ".contact-legal, .contact-legal-terms, .hubspot-contact-legal",
      );
      if (legal) legal.innerHTML = t.contact.legal;

      const countrySelect = contactForm.querySelector("#pais");
      if (
        countrySelect instanceof HTMLSelectElement &&
        countrySelect.options.length > 0
      ) {
        countrySelect.options[0].textContent = t.contact.countryDefault;
