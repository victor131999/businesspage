---
import Navbar from "../components/navbar.astro";
import ProductsPanel from "../components/productsPanel.astro";
import "../styles/navbar.css";
---

<script>
  import { updateContent } from '../scripts/identityTranslations.js';

  function handleLanguageChange(lang: string) {
    const normalizedLang = lang.toLowerCase();
    updateContent(normalizedLang);
  }

  // Escuchar cambios de idioma desde el navbar
  window.addEventListener('ui:languagechange', ((event: Event) => {
    const customEvent = event as CustomEvent<{language: string}>;
    if (customEvent.detail?.language) {
      handleLanguageChange(customEvent.detail.language);
    }
  }) as EventListener);

  // Aplicar traducciones iniciales
  document.addEventListener('DOMContentLoaded', () => {
    // Obtener el idioma actual del localStorage
    const storedLang = localStorage.getItem('ui-language') || 'EN';
    handleLanguageChange(storedLang);
  });
</script>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Zelify — Identity</title>
  </head>

  <body
    style="
      background-color: #020b18;
      background-image: url('/images/FONDO 3.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      min-height: 100vh;
      margin: 0;
    "
  >
    <Navbar
      logoSrc="/images/zelify_logo2.png"
      colors={{
        text: "#ffffff",
        textHover: "#ffffff",
        highlightBg: "#6AFF00",
        highlightText: "#0b132b",
        btnLightBg: "#E7EDF6",
        btnLightHoverBg: "#DAE4F1",
        btnLightText: "#004195",
        btnOutline: "#E7EDF6",
        btnOutlineHover: "#ffffff",
        dropdownBg: "#ffffff",
        dropdownLink: "#1e2b3a",
        dropdownHoverBg: "#EEF3F9",
        radius: "22px",
      }}
      buttons={{
        first: { label: "Work with us", href: "https://www.zelify.com/jobs" },
        second: { label: "Business access", href: "https://www.zelify.io/" },
        third: { label: "EN", href: "/" },
      }}
    />
    <ProductsPanel />
    <section class="hero">
      <div class="content">
        <span class="badge">Identity</span>

        <h1 class="title">
          Unshakeable Identity Security:<br/>Face, Document &<br/>Liveness Verification
        </h1>

        <p class="description">
          Advanced face and document verification meets liveness detection<br/>
          for total authenticity. Compliant and seamlessly connected to<br/>
          <span style="white-space: nowrap;">onboarding, AML, and card issuance for secure, trusted user identity.</span>
        </p>

        <div class="cta">
          <a href="/hablemos" class="btn">Let's talk</a>
          <a href="https://documentations.zelify.com/servicios-financieros/zelify-identity" target="_blank" rel="noopener noreferrer" class="btn">View API Docs</a>
        </div>
      </div>
    </section>
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  body {
    font-family:
      "NataSans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    color: #e9eff7;
  }

  .hero {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: calc(100vh - 80px);
    padding-top: 4rem;
    padding-right: 8%;
    padding-left: 8%;
    padding-bottom: 4rem;
  }

  .content {
    max-width: 760px;
    text-align: right;
    margin-right: 8%;
  }

  .badge {
    display: inline-block;
    max-width: 350px;
    background: #e7edf6;
    color: #1f4d93;
    padding: 0.8rem 2rem;
    border-radius: 25px;
    font-weight: 700;
    font-size: 1.1rem;
    margin: 0 0 2rem auto;
    text-align: left;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
  }

  .title {
    color: #f0f3f8;
    font-size: clamp(1.2rem, 4vw, 3.2rem);
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 1.5rem 0;
    text-shadow: 0 3px 14px rgba(0, 0, 0, 0.4);
    max-width: 100%;
  }

  .description {
    color: #6aff00;
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.55;
    margin: 0 0 2.5rem 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
  }

  .cta {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    background: #e7edf6;
    color: #1f4d93;
    font-weight: 700;
    text-decoration: none;
    padding: 0.8rem 1.4rem;
    border-radius: 10px;
    transition: all 0.2s ease;
    font-size: 1rem;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
  }

  .btn:hover {
    background: #d6deeb;
    transform: translateY(-2px);
  }

  @media (max-width: 960px) {
    .hero {
      justify-content: center;
      padding: 4rem 2rem;
      text-align: center;
    }

    .content {
      text-align: center;
    }

    .cta {
      justify-content: center;
    }
  }
</style>
