  const detectBrowserLanguage = () => {
    const locale =
      (navigator.languages && navigator.languages[0]) ||
      navigator.language ||
      "";
    return locale.toLowerCase().startsWith("es") ? "es" : "en";
  };

  // Event Listeners for Language Change
  window.addEventListener("ui:languagechange", (event) => {
    const customEvent = event as CustomEvent;
    const lang = customEvent.detail?.language || "es";
    updateIdentityContent(lang.toLowerCase());
  });

  document.addEventListener("DOMContentLoaded", () => {
    const stored = (localStorage.getItem("ui-language") === "en") ? "en" : "es";
    // Delay slightly to ensure elements exist
    setTimeout(() => updateIdentityContent(stored), 100);
  });

  let currentStep = 1;

  const formData = {
    fullName: "",
    email: "",
    emailOTP: "",
    phone: "",
    phoneOTP: "",
    password: "",
    confirmPassword: "",
  };

  const validationErrors: Record<string, string> = {};
  let emailOTPStatus = "idle"; // 'idle' | 'verifying' | 'success' | 'error'
  let phoneOTPStatus = "idle";

  function getInputValue(id: string) {
    const el = document.getElementById(id);
    if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement) {
      return el.value;
    }
    return "";
  }

  // Inicializar OTP inputs
  function initOTPInputs(containerId: string) {
    const container = document.getElementById(containerId);
    if (!container) return;

    const inputs = container.querySelectorAll(".otp-input");

    inputs.forEach((input, index) => {
      if (!(input instanceof HTMLInputElement)) return;
      input.addEventListener("input", (e) => {
        if (!(e.target instanceof HTMLInputElement)) return;
        const value = e.target.value.replace(/[^0-9]/g, "");
        e.target.value = value;

        if (value && index < inputs.length - 1) {
          const nextInput = inputs[index + 1];
          if (nextInput instanceof HTMLInputElement) {
            nextInput.focus();
          }
        }
      });

      input.addEventListener("keydown", (e) => {
        if (
          e.key === "Backspace" &&
          e.target instanceof HTMLInputElement &&
          !e.target.value &&
          index > 0
        ) {
          const prevInput = inputs[index - 1];
          if (prevInput instanceof HTMLInputElement) {
            prevInput.focus();
          }
        }
      });

      input.addEventListener("paste", (e) => {
        e.preventDefault();
        const clipboard = e.clipboardData;
        if (!clipboard) return;
        const pasted = clipboard
          .getData("text")
          .replace(/[^0-9]/g, "")
          .slice(0, 6);
        pasted.split("").forEach((char, i) => {
          const targetInput = inputs[i];
          if (targetInput instanceof HTMLInputElement) {
            targetInput.value = char;
          }
        });
        if (pasted.length === 6 && inputs[5] instanceof HTMLInputElement) {
          inputs[5].focus();
        }
      });
    });
  }

  // Actualizar dots de progreso
  function updateProgressDots(step: number) {
    const dots = document.querySelectorAll(".phone-card-dots .dot");
    dots.forEach((dot, index) => {
      if (index < step) {
        dot.classList.add("active");
      } else {
        dot.classList.remove("active");
      }
    });
  }

  // Mostrar paso
  function showStep(step: number) {
    document.querySelectorAll(".auth-step").forEach((el, index) => {
      if (!(el instanceof HTMLElement)) return;
      el.style.display = index + 1 === step ? "block" : "none";
    });

    // Actualizar título y descripción según el paso
    const titleEl = document.getElementById("step-title");
    const descEl = document.getElementById("step-description");
    const loginLink = document.getElementById("login-link");
    if (!titleEl || !descEl || !loginLink) return;

    const t = identityTranslations[currentLang as keyof typeof identityTranslations] || identityTranslations.es;

    if (step === 1) {
      titleEl.textContent = t.steps.step1.title;
      descEl.innerHTML = t.steps.step1.desc;
      loginLink.style.display = "none";
    } else if (step === 2) {
      titleEl.textContent = t.steps.step2.title;
      descEl.innerHTML =
        t.steps.step2.descPrefix +
        '<strong id="email-display">' +
        formData.email +
        "</strong>";
      loginLink.style.display = "none";
    } else if (step === 3) {
      titleEl.textContent = t.steps.step3.title;
      descEl.textContent = t.steps.step3.desc;
      loginLink.style.display = "none";
    } else if (step === 4) {
      titleEl.textContent = t.steps.step4.title;
      descEl.innerHTML =
        t.steps.step4.descPrefix +
        '<strong id="phone-display">' +
        formData.phone +
        "</strong>";
      loginLink.style.display = "none";
    } else if (step === 5) {
      titleEl.textContent = t.steps.step5.title;
      descEl.textContent = t.steps.step5.desc;
      loginLink.style.display = "block";
    }

    updateProgressDots(step);
    currentStep = step;
  }

  // Funciones de validación
  function validateFullName(name: string) {
    return name.trim().length >= 2;
  }

  function validateEmail(email: string) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function validatePhone(phone: string) {
    return phone.trim().length >= 10;
  }

  function validatePassword(password: string | any[]) {
    return password.length >= 8;
  }

  function showFieldError(fieldId: string, message: string | null) {
    if (!message) return;
    validationErrors[fieldId] = message;
    const field = document.getElementById(fieldId);
    if (field) {
      field.classList.add("field-error");
      const parent = field.parentElement;
      if (!parent) return;
      const errorEl = parent.querySelector(".field-error-message");
      if (errorEl instanceof HTMLElement) {
        errorEl.textContent = message;
        errorEl.style.display = "block";
      }
    }
  }

  function clearFieldError(fieldId: string) {
    delete validationErrors[fieldId];
    const field = document.getElementById(fieldId);
    if (field) {
      field.classList.remove("field-error");
      const parent = field.parentElement;
      if (!parent) return;
      const errorEl = parent.querySelector(".field-error-message");
      if (errorEl instanceof HTMLElement) {
        errorEl.style.display = "none";
      }
    }
  }

  function clearAllErrors() {
    Object.keys(validationErrors).forEach((key) => clearFieldError(key));
  }

  // Paso 1: Crear cuenta
  document.getElementById("form-step-1")?.addEventListener("submit", (e) => {
    e.preventDefault();
    clearAllErrors();

    const fullNameEl = document.getElementById("fullName");
    const emailEl = document.getElementById("email");
    if (
      !(fullNameEl instanceof HTMLInputElement) ||
      !(emailEl instanceof HTMLInputElement)
    ) {
      return;
    }

    const fullName = fullNameEl.value.trim();
    const email = emailEl.value.trim();

    let hasErrors = false;

    const t = identityTranslations[currentLang as keyof typeof identityTranslations] || identityTranslations.es;

    if (!validateFullName(fullName)) {
      showFieldError("fullName", t.steps.step1.errorName);
      hasErrors = true;
    }

    if (!validateEmail(email)) {
      showFieldError("email", t.steps.step1.errorEmail);
      hasErrors = true;
    }

    if (hasErrors) {
      return;
    }

    formData.fullName = fullName;
    formData.email = email;

    showStep(2);
    initOTPInputs("otp-email");
  });

  // Limpiar errores al escribir
  document.getElementById("fullName")?.addEventListener("input", () => {
    clearFieldError("fullName");
  });

  document.getElementById("email")?.addEventListener("input", () => {
    clearFieldError("email");
  });

  // Paso 2: Verificar email
  document.getElementById("form-step-2")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const inputs = Array.from(
      document.querySelectorAll("#otp-email .otp-input"),
    ).filter((input) => input instanceof HTMLInputElement);
    const otp = Array.from(inputs)
      .map((input) => input.value)
      .join("");

    if (otp.length !== 6) {
      return;
    }

    emailOTPStatus = "verifying";
    updateOTPStatus("otp-email", "verifying");

    // Código quemado: 202601
    const isValid = otp === "202601";

    setTimeout(() => {
      if (isValid) {
        emailOTPStatus = "success";
        updateOTPStatus("otp-email", "success");
        formData.emailOTP = otp;

        setTimeout(() => {
          emailOTPStatus = "idle";
          showStep(3);
        }, 3000);
      } else {
        emailOTPStatus = "error";
        updateOTPStatus("otp-email", "error");

        setTimeout(() => {
          emailOTPStatus = "idle";
          updateOTPStatus("otp-email", "idle");
          inputs.forEach((input) => (input.value = ""));
          inputs[0]?.focus();
        }, 2000);
      }
    }, 1000);
  });

  function updateOTPStatus(containerId: string, status: string) {
    const container = document.getElementById(containerId);
    if (!container) return;

    const inputs = container.querySelectorAll(".otp-input");
    inputs.forEach((input) => {
      input.classList.remove("otp-verifying", "otp-success", "otp-error");
      if (status !== "idle") {
        input.classList.add(`otp-${status}`);
      }
    });
  }

  // Paso 3: Agregar teléfono
  document.getElementById("form-step-3")?.addEventListener("submit", (e) => {
    e.preventDefault();
    clearAllErrors();

    const phoneEl = document.getElementById("phone");
    if (!(phoneEl instanceof HTMLInputElement)) return;
    const phone = phoneEl.value.trim();

    if (!validatePhone(phone)) {
      const t = identityTranslations[currentLang as keyof typeof identityTranslations] || identityTranslations.es;
      showFieldError("phone", t.steps.step3.errorPhone);
      return;
    }

    formData.phone = phone;
    showStep(4);
    initOTPInputs("otp-phone");
  });

  document.getElementById("phone")?.addEventListener("input", () => {
    clearFieldError("phone");
  });

  // Paso 4: Verificar teléfono
  document.getElementById("form-step-4")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const inputs = Array.from(
      document.querySelectorAll("#otp-phone .otp-input"),
    ).filter((input) => input instanceof HTMLInputElement);
    const otp = Array.from(inputs)
      .map((input) => input.value)
      .join("");

    if (otp.length !== 6) {
      return;
    }

    phoneOTPStatus = "verifying";
    updateOTPStatus("otp-phone", "verifying");

    // Código quemado: 202601
    const isValid = otp === "202601";

    setTimeout(() => {
      if (isValid) {
        phoneOTPStatus = "success";
        updateOTPStatus("otp-phone", "success");
        formData.phoneOTP = otp;

        setTimeout(() => {
          phoneOTPStatus = "idle";
          showStep(5);
        }, 3000);
      } else {
        phoneOTPStatus = "error";
        updateOTPStatus("otp-phone", "error");

        setTimeout(() => {
          phoneOTPStatus = "idle";
          updateOTPStatus("otp-phone", "idle");
          inputs.forEach((input) => (input.value = ""));
          inputs[0]?.focus();
        }, 2000);
      }
    }, 1000);
  });

  // Paso 5: Completar perfil
  document.getElementById("form-step-5")?.addEventListener("submit", (e) => {
    e.preventDefault();
    clearAllErrors();

    const passwordEl = document.getElementById("password");
    const confirmPasswordEl = document.getElementById("confirmPassword");
    if (
      !(passwordEl instanceof HTMLInputElement) ||
      !(confirmPasswordEl instanceof HTMLInputElement)
    ) {
      return;
    }

    const password = passwordEl.value;
    const confirmPassword = confirmPasswordEl.value;

    let hasErrors = false;

    const t = identityTranslations[currentLang as keyof typeof identityTranslations] || identityTranslations.es;

    if (!validatePassword(password)) {
      showFieldError("password", t.steps.step5.errorPass);
      hasErrors = true;
    }

    if (password !== confirmPassword) {
      showFieldError("confirmPassword", t.steps.step5.errorMatch);
      hasErrors = true;
    }

    if (hasErrors) {
      return;
    }

    formData.password = password;
    formData.confirmPassword = confirmPassword;

    // Cuenta creada exitosamente
    console.log("Registro completado", formData);
    // Aquí podrías redirigir o hacer una llamada a la API
  });

  document.getElementById("password")?.addEventListener("input", () => {
    clearFieldError("password");
  });

  document.getElementById("confirmPassword")?.addEventListener("input", () => {
    clearFieldError("confirmPassword");
  });

  // Reenviar códigos
  document.getElementById("resend-email")?.addEventListener("click", (e) => {
    e.preventDefault();
    // Simular reenvío - en producción harías una llamada a la API
    console.log("Código reenviado a", formData.email);
  });

  document.getElementById("resend-phone")?.addEventListener("click", (e) => {
    e.preventDefault();
    // Simular reenvío - en producción harías una llamada a la API
    console.log("Código reenviado a", formData.phone);
  });

  // Inicializar
  updateProgressDots(1);

  // Control de flip cards para beneficios
  document.querySelectorAll(".control-feature-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const card = btn.closest(".control-feature-card");

      if (card) {
        card.classList.toggle("flipped");
      }
    });
  });

  // FAQ Accordion
  document.querySelectorAll(".faq-question").forEach((question) => {
    question.addEventListener("click", () => {
      const faqItem = question.closest(".faq-item");
      if (!faqItem) return;
      const isActive = faqItem.classList.contains("active");

      // Cerrar todos los demás items
      document.querySelectorAll(".faq-item").forEach((item) => {
        item.classList.remove("active");
      });
      // Abrir el item clickeado si no estaba activo

      if (!isActive) {
        faqItem.classList.add("active");
      }
    });
  });
</script>
