---
import Navbar from "../components/navbar.astro";
import ProductsPanel from "../components/productsPanel.astro";
import "../styles/navbar.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Zelify Page 2 — Identity</title>
  </head>

  <body
    style="
      background-color: #020b18;
      background-image: url('/images/FONDO 3.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      min-height: 100vh;
      margin: 0;
    "
  >
    <Navbar
      logoSrc="/images/zelify_logo2.png"
      colors={{
        text: "#ffffff",
        textHover: "#ffffff",
        highlightBg: "#6AFF00",
        highlightText: "#0b132b",
        btnLightBg: "#E7EDF6",
        btnLightHoverBg: "#DAE4F1",
        btnLightText: "#004195",
        btnOutline: "#E7EDF6",
        btnOutlineHover: "#ffffff",
        dropdownBg: "#ffffff",
        dropdownLink: "#1e2b3a",
        dropdownHoverBg: "#EEF3F9",
        radius: "22px",
      }}
      buttons={{
        first: { label: "Work with us", href: "/" },
        second: { label: "Bank access", href: "/" },
        third: { label: "EN", href: "/" },
      }}
    />
    <ProductsPanel />
    <section class="hero">
      <div class="content">
        <h2 class="section-label">Identity</h2>

        <h1 class="title">
          Unshakeable Identity Security:<br />
          Face, Document &amp; Liveness Verification
        </h1>

        <p class="description">
          Advanced face and document verification meets liveness detection for
          total authenticity.<br />
          Compliant and seamlessly connected to onboarding, AML, and card issuance
          for secure, trusted user identity.
        </p>

        <div class="cta">
          <a href="/" class="btn">Let’s talk</a>
          <a href="/" class="btn">View API Docs</a>
        </div>
      </div>
    </section>
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  body {
    font-family:
      "NataSans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    color: #e9eff7;
  }

  .hero {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: calc(100vh - 80px);
    padding-top: 10rem;
    padding-right: 8%;
    padding-left: 8%;
    padding-bottom: 4rem;
  }

  .content {
    max-width: 760px;
    text-align: right;
    margin-right: 8%;
  }

  .section-label {
    padding-top: 6rem;
    color: #182b45;
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0 0 2rem auto;
    letter-spacing: 0.5px;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  .title {
    color: #f0f3f8;
    font-size: clamp(1.2rem, 4vw, 3.2rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 1.5rem 0;
    text-shadow: 0 3px 14px rgba(0, 0, 0, 0.4);
  }

  .description {
    color: #6aff00;
    font-size: 1.05rem;
    line-height: 1.55;
    margin: 0 0 2.5rem 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
  }

  .cta {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    background: #e7edf6;
    color: #1f4d93;
    font-weight: 700;
    text-decoration: none;
    padding: 0.8rem 1.4rem;
    border-radius: 10px;
    transition: all 0.2s ease;
    font-size: 1rem;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
  }

  .btn:hover {
    background: #d6deeb;
    transform: translateY(-2px);
  }

  @media (max-width: 960px) {
    .hero {
      justify-content: center;
      padding: 4rem 2rem;
      text-align: center;
    }

    .content {
      text-align: center;
    }

    .cta {
      justify-content: center;
    }
  }
</style>
