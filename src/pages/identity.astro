---
import Navbar3 from "../components/NavbarSimple.astro";
import ProductsPanel from "../components/productsPanel.astro";
import IdentityApp from "../components/identity/IdentityApp.astro";
import EmailQuoteForm from "../components/design-system/molecules/EmailQuoteForm.astro";
import CtaGroup from "../components/design-system/molecules/CtaGroup.astro";
import Button from "../components/design-system/atoms/Button.astro";
import ContactFormHubSpot from "../components/design-system/organisms/ContactFormHubSpot.astro";
import QuoteModalHubSpot from "../components/design-system/organisms/QuoteModalHubSpot.astro";
import Footer from "../components/design-system/organisms/Footer.astro";
import "../components/design-system/tokens.css";
import { AlaizaAssistant } from "../components/AlaizaAssistant";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/png"
      href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png"
    />
    <title>Zelify — Identity</title>
  </head>

  <body>
    <header class="auth-header">
      <Navbar3 />
      <ProductsPanel />
    </header>

    <main class="auth-main">
      <section class="auth-hero">
        <h1 class="auth-title">Zelify Identity</h1>
        <p class="auth-description">
          Permite verificar la identidad de los usuarios mediante 
          validación de documentos y reconocimiento facial, 
          reduciendo el fraude y asegurando que cada persona es quien dice ser..
        </p>
        <CtaGroup class="auth-cta">
          <EmailQuoteForm
            dataI18nPlaceholder="hero.ctaInputPlaceholder"
            dataI18nAria="hero.ctaInputPlaceholder"
            buttonLabel="Let's talk"
          />
          <Button
            href="https://www.zelify.com/clips"
            variant="secondary"
            class="welcome-demo-button"
            target="_blank"
            rel="noopener noreferrer"
            dataI18n="hero.demoButton"
          >
            Demo
          </Button>
        </CtaGroup>
      </section>
    </main>

    <div class="auth-background-section">
      <div class="auth-background-overlay"></div>
      <div class="auth-background-image">
        <video class="auth-video" autoplay loop muted playsinline>
          <source
            src="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/background_videos/identity.mp4"
            type="video/mp4"
          />
        </video>
      </div>

      <!-- Contenedor del dispositivo móvil -->
      <div class="device-container">
        <IdentityApp />
      </div>
    </div>
    <QuoteModalHubSpot />
    <script is:inline>
      function initQuoteModal() {
        var form = document.querySelector(".welcome-input-group");
        var quoteModal = document.querySelector("#quote-modal");
        var closeQuoteBtn = document.querySelector("#close-quote-modal");
        var quoteModalOverlay = document.querySelector("[data-close-quote-modal]");
        var MEETINGS_BASE_URL = "https://meetings.hubspot.com/gmantilla?embed=true";
        function openQuoteModal() {
          if (!quoteModal) return;
          var emailInput = document.querySelector(".welcome-input");
          var email = emailInput && emailInput.value ? emailInput.value.trim() : "";
          var embedUrl = email ? MEETINGS_BASE_URL + "&email=" + encodeURIComponent(email) : MEETINGS_BASE_URL;
          var container = document.querySelector(".meetings-iframe-container");
          if (container) {
            container.setAttribute("data-src", embedUrl);
            var iframe = container.querySelector("iframe");
            if (iframe) iframe.src = embedUrl;
            else setTimeout(function() { var iframeLater = container.querySelector("iframe"); if (iframeLater) iframeLater.src = embedUrl; }, 500);
          }
          quoteModal.classList.add("is-active");
          quoteModal.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
        }
        function closeQuoteModal() {
          if (!quoteModal) return;
          quoteModal.classList.remove("is-active");
          quoteModal.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
        }
        if (closeQuoteBtn) closeQuoteBtn.addEventListener("click", closeQuoteModal);
        if (quoteModalOverlay) quoteModalOverlay.addEventListener("click", closeQuoteModal);
        if (form) form.addEventListener("submit", function(e) { e.preventDefault(); openQuoteModal(); });
        var openBtns = document.querySelectorAll("[data-open-quote-modal]");
        for (var i = 0; i < openBtns.length; i++) {
          openBtns[i].addEventListener("click", function(e) { e.preventDefault(); openQuoteModal(); });
        }
      }
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initQuoteModal);
      } else {
        initQuoteModal();
      }
    </script>
    <!-- Start of HubSpot Embed Code -->
    <script type="text/javascript" id="hs-script-loader" async defer src="//js.hs-scripts.com/50894304.js"></script>
    <!-- End of HubSpot Embed Code -->
  </body>

  <!-- Sección de Control Total -->
  <section class="control-section">
    <div class="control-container">
      <div class="control-divider"></div>
      <h2 class="control-title">
        Verificación de identidad inteligente y segura
      </h2>

      <div class="control-features">
        <!-- Feature 1: Extracción documental -->
        <div class="control-feature">
          <div class="control-feature-card">
            <div class="control-feature-front">
              <div class="control-feature-image">
                <video
                  src="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/image-products/identity/IDENTITY+01.mp4"
                  alt="Extracción Documental"
                  autoplay
                  loop
                  muted
                  playsinline
                  style="width: 100%; height: 100%; object-fit: cover; display: block;"
                />
              </div>
              <h3 class="control-feature-title">Extracción Documental</h3>
              <p class="control-feature-description">
                Tecnología avanzada de escaneo y OCR que permite extraer datos
                automáticamente de documentos oficiales como cédulas de
                ciudadanía, pasaportes y licencias de conducir, validando su
                autenticidad y agilizando el proceso de registro.
              </p>
              <button class="control-feature-btn" data-feature="ocr">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
            </div>
            <div class="control-feature-back">
              <h3 class="control-feature-title">Documentos Soportados</h3>
              <ul class="control-feature-benefits">
                <li>Escaneo de cédula de ciudadanía</li>
                <li>Escaneo de pasaporte</li>
                <li>Escaneo de licencia de conducir</li>
              </ul>
              <button
                class="control-feature-btn control-feature-btn-close"
                data-feature="ocr"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Feature 2: Verificación de Prueba de Vida -->
        <div class="control-feature">
          <div class="control-feature-card">
            <div class="control-feature-front">
              <div class="control-feature-image">
                <video
                  src="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/image-products/identity/IDENTITY+02.mp4"
                  alt="Prueba de Vida"
                  autoplay
                  loop
                  muted
                  playsinline
                  style="width: 100%; height: 100%; object-fit: cover; display: block;"
                />
              </div>
              <h3 class="control-feature-title">
                Verificación de Prueba de Vida
              </h3>
              <p class="control-feature-description">
                Confirma la identidad del usuario comparando su rostro con la
                imagen del documento oficial y aplicando pruebas de vida
                avanzadas.
              </p>
              <button class="control-feature-btn" data-feature="liveness">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
            </div>
            <div class="control-feature-back">
              <h3 class="control-feature-title">Métodos de Validación</h3>
              <div class="control-feature-benefits space-y-4">
                <p class="text-sm">
                  <strong>Selfie:</strong> Captura de imagen facial optimizada con
                  detección automática de calidad, iluminación y posición, diseñada
                  para una validación rápida, precisa y con alta tasa de aprobación.
                </p>
                <p class="text-sm">
                  <strong>Video Selfie (Toma):</strong> Grabación de video en tiempo
                  real que permite verificar movimientos, gestos y profundidad facial,
                  fortaleciendo la prueba de vida.
                </p>
              </div>
              <button
                class="control-feature-btn control-feature-btn-close"
                data-feature="liveness"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ContactFormHubSpot headline="Comienza a construir el banco del futuro, hoy." formTitle="Habla con nuestro equipo" />

  <!-- Sección de FAQ -->
  <section class="faq-section">
    <div class="faq-container">
      <h2 class="faq-title">Preguntas frecuentes</h2>

      <div class="faq-list">
        <!-- FAQ 1 -->
        <div class="faq-item">
          <button class="faq-question" data-faq="1">
            <span>¿Qué documentos puedo verificar con Zelify Identity?</span>
            <svg
              class="faq-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="faq-answer">
            <p>
              La extracción documental usa tecnología avanzada de escaneo y OCR
              para extraer datos automáticamente de documentos oficiales como
              cédulas de ciudadanía, pasaportes y licencias de conducir,
              validando su autenticidad y agilizando el proceso de registro.
            </p>
          </div>
        </div>

        <!-- FAQ 2 -->
        <div class="faq-item">
          <button class="faq-question" data-faq="2">
            <span>¿En qué consiste la verificación de prueba de vida?</span>
            <svg
              class="faq-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="faq-answer">
            <p>
              Confirma la identidad del usuario comparando su rostro con la
              imagen del documento oficial y aplicando pruebas de vida. Selfie:
              captura de imagen facial optimizada con detección automática de
              calidad, iluminación y posición, para validación rápida, precisa y
              con alta tasa de aprobación. Video Selfie (Toma): grabación en
              tiempo real para verificar movimientos, gestos y profundidad
              facial, fortaleciendo la prueba de vida en onboarding,
              autenticación y cumplimiento regulatorio.
            </p>
          </div>
        </div>

        <!-- FAQ 3 -->
        <div class="faq-item">
          <button class="faq-question" data-faq="3">
            <span>¿Cómo se integra Identity con Auth, AML y Cards?</span>
            <svg
              class="faq-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="faq-answer">
            <p>
              La capa de integración (SDK/API) centraliza la identidad digital
              para su reutilización en otros módulos a través de APIs o SDKs.
              Identity se integra de forma nativa con Auth, AML y Cards, con
              flujos de verificación personalizables, bajo demanda y desde una
              única integración.
            </p>
          </div>
        </div>

        <!-- FAQ 4 -->
        <div class="faq-item">
          <button class="faq-question" data-faq="4">
            <span>¿Qué estándares de seguridad y protección de datos cumple?</span>
            <svg
              class="faq-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="faq-answer">
            <p>
              Zelify Identity cumple con estándares internacionales de seguridad
              y protección de datos. La verificación de documentos y biometría
              está diseñada para reducir el fraude y asegurar que cada persona
              sea quien dice ser, con los niveles de cumplimiento necesarios
              para servicios financieros.
            </p>
          </div>
        </div>

        <!-- FAQ 5 -->
        <div class="faq-item">
          <button class="faq-question" data-faq="5">
            <span>¿Puedo personalizar el flujo de verificación para mi negocio?</span>
            <svg
              class="faq-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="faq-answer">
            <p>
              Sí. Ofrecemos flujos de verificación personalizables y bajo
              demanda. Puedes definir qué tipo de documento solicitar, si
              requieres selfie o video selfie, y adaptar el proceso a tu
              onboarding o requisitos de cumplimiento desde una única
              integración.
            </p>
          </div>
        </div>

        <!-- FAQ 6 -->
        <div class="faq-item">
          <button class="faq-question" data-faq="6">
            <span>¿Qué diferencia hay entre selfie y video selfie?</span>
            <svg
              class="faq-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="faq-answer">
            <p>
              Selfie: captura de imagen facial optimizada con detección
              automática de calidad, iluminación y posición, diseñada para
              validación rápida, precisa y con alta tasa de aprobación. Video
              Selfie (Toma): grabación en tiempo real que verifica movimientos,
              gestos y profundidad facial, fortaleciendo la prueba de vida y
              elevando el nivel de seguridad en onboarding, autenticación y
              cumplimiento regulatorio.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección CTA Final -->
  <section class="cta-section">
    <div class="cta-container">
      <h2 class="cta-title">
        Comienza hoy y<br />
        asegura cada acceso.
      </h2>
      <button type="button" class="cta-button" data-open-quote-modal>
        Hablemos
      </button>
    </div>
  </section>

  <!-- Footer (mismo que index) -->
  <Footer
    quickLinksTitle="Quick links"
    links={[
      { href: "", label: "Products", key: "products", dataI18n: "footer.products" },
      { href: "https://docs.zelify.com", label: "Developers", key: "developers", dataI18n: "footer.developers", openInNewTab: true },
      { href: "/blog", label: "Blog", key: "blog", dataI18n: "footer.blog" },
    ]}
    legalText="Zelify is a technology platform currently in a development phase, not yet deployed or operational, and does not provide or process financial services directly; all financial operations are conducted exclusively through regulated third-party partners."
    copyrightText="© 2025 Zelify. All rights reserved."
    dataI18n={{ quicklinks: "footer.quicklinks", legal: "footer.legal", copyright: "footer.copyright" }}
  />
  <AlaizaAssistant client:load />
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    width: 100%;
  }

  body {
    font-family:
      "NataSans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    font-variant-ligatures: none; /* evita ligaduras fl, fi, etc. */
    background-color: #ffffff;
    color: #0a203f;
  }

  .auth-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 3rem;
    position: sticky;
    top: 0;
    z-index: 1000;
    max-width: 1400px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .welcome-input-group {
    display: flex;
    align-items: center;
    border: 2px solid #00223e;
    border-radius: 10px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 1px;
    padding-right: 3px;
    background: #ffffff;
    min-width: min(560px, 100%);
    max-width: 620px;
  }

  .welcome-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 1.05rem;
    padding: 0.75rem 1.25rem;
    color: #00223e;
    background: transparent;
  }

  .welcome-input::placeholder {
    color: #213f8c;
    opacity: 0.9;
  }

  .welcome-quote-button {
    border: none;
    background: #213f8c;
    color: #ffffff;
    padding: 0.7rem 2.9rem;
    border-radius: 9px;
    font-size: 1.1rem;
    font-weight: 400;
    cursor: pointer;
    width: 170px;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .welcome-demo-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #93fb4d;
    color: #00223e;
    padding-top: 10px;
    padding-bottom: 10px;
    border-radius: 9px;
    width: 20%;
    text-decoration: none;
    font-weight: 400;
    font-size: 1.1rem;
    box-shadow: 0 10px 22px rgba(147, 251, 77, 0.35);
    margin-left: 1rem;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .welcome-demo-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 26px rgba(147, 251, 77, 0.4);
  }

  .auth-main {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 2rem 2rem;
    margin-top: 30px;
  }

  .auth-hero {
    margin-top: 30px;
    max-width: 800px;
    width: 100%;
    text-align: center;
  }

  .auth-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.2;
    color: #0a203f;
    margin: 0 0 2rem 0;
    font-weight: 400;
  }

  .auth-title br {
    display: block;
  }

  .auth-description {
    font-size: clamp(1rem, 2vw, 1.1rem);
    line-height: 1.6;
    color: #213f8c;
    margin: 0 0 3rem 0;
  }

  .auth-description br {
    display: block;
  }

  .auth-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-cotizar {
    border: none;
    background: #0a203f;
    color: #ffffff;
    border-radius: 999px;
    padding: 0.65rem 1.75rem;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    text-transform: lowercase;
    transition: all 0.2s ease;
    text-decoration: none;
    display: inline-block;
  }

  .btn-cotizar:hover {
    background: #0d2a4f;
    transform: translateY(-1px);
  }

  .btn-demo-hero {
    border: none;
    background: #8dff2b;
    color: #082436;
    text-transform: lowercase;
    padding: 0.65rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    box-shadow: 0 10px 20px rgba(141, 255, 43, 0.45);
    transition: all 0.2s ease;
  }

  .btn-demo-hero:hover {
    background: #a5ff4d;
    transform: translateY(-1px);
    box-shadow: 0 12px 24px rgba(141, 255, 43, 0.5);
  }

  .auth-background-section {
    position: relative;
    width: 100%;
    /* background: #ffffff; */
    padding: 4rem 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .auth-background-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      #ffffff 0%,
      transparent 15%,
      transparent 85%,
      #ffffff 100%
    );
    pointer-events: none;
  }

  .auth-background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .auth-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Contenedor del dispositivo */
  .device-container {
    position: relative;
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
    z-index: 10;
    padding: 1rem 0 2rem;
  }

  /* Frame del iPhone */
  .device-frame-wrapper {
    position: relative;
    z-index: 10;
    transform: scale(1);
    padding: 2.5rem 2rem;
    background-color: #f3f4f6;
    border-radius: 2rem;
    margin: 3rem auto;
  }

  .device-frame {
    position: relative;
    overflow: hidden;
    border-radius: 3rem;
    border: none;
    background: transparent;
    box-shadow: none;
  }

  /* Pantalla del dispositivo */
  .device-screen {
    position: relative;
    height: 750px;
    overflow: hidden;
    border-radius: 2.5rem;
    background: #ffffff;
    margin: 0;
    display: flex;
    flex-direction: column;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.05),
      0 20px 60px rgba(0, 0, 0, 0.15);
  }

  /* Status Bar */
  .device-status-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    padding: 2.5rem 1.5rem 0.5rem;
    flex-shrink: 0;
  }

  .status-time {
    position: absolute;
    left: 1.5rem;
    top: 1rem;
    font-size: 0.75rem;
