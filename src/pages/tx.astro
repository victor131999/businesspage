<script>
  let currentStep = 1;
  const formData = {
    fullName: "",
    email: "",
    emailOTP: "",
    phone: "",
    phoneOTP: "",
    password: "",
    confirmPassword: "",
  };

  const validationErrors: Record<string, string> = {};
  let emailOTPStatus = "idle"; // 'idle' | 'verifying' | 'success' | 'error'
  let phoneOTPStatus = "idle";

  // Inicializar OTP inputs
  // Inicializar OTP inputs
  function initOTPInputs(containerId: string) {
    const container = document.getElementById(containerId);
    if (!container) return;

    const inputs = container.querySelectorAll(".otp-input");

    inputs.forEach((input, index) => {
      if (!(input instanceof HTMLInputElement)) return;
      input.addEventListener("input", (e) => {
        const target = e.target as HTMLInputElement;
        const value = target.value.replace(/[^0-9]/g, "");
        target.value = value;

        if (value && index < inputs.length - 1) {
          const nextInput = inputs[index + 1];
          if (nextInput instanceof HTMLInputElement) nextInput.focus();
        }
      });

      input.addEventListener("keydown", (e) => {
        const keyboardEvent = e as KeyboardEvent;
        const target = e.target as HTMLInputElement;
        if (keyboardEvent.key === "Backspace" && !target.value && index > 0) {
          const prevInput = inputs[index - 1];
          if (prevInput instanceof HTMLInputElement) prevInput.focus();
        }
      });

      input.addEventListener("paste", (e) => {
        const clipboardEvent = e as ClipboardEvent;
        clipboardEvent.preventDefault();
        const pasted = (clipboardEvent.clipboardData?.getData("text") || "")
          .replace(/[^0-9]/g, "")
          .slice(0, 6);
        pasted.split("").forEach((char, i) => {
          const charInput = inputs[i];
          if (charInput instanceof HTMLInputElement) {
            charInput.value = char;
          }
        });
        if (pasted.length === 6) {
          const lastInput = inputs[5];
          if (lastInput instanceof HTMLInputElement) lastInput.focus();
        }
      });
    });
  }

  // Actualizar dots de progreso
  function updateProgressDots(step: number) {
    const dots = document.querySelectorAll(".phone-card-dots .dot");
    dots.forEach((dot, index) => {
      if (index < step) {
        dot.classList.add("active");
      } else {
        dot.classList.remove("active");
      }
    });
  }

  // Mostrar paso
  function showStep(step: number) {
    document.querySelectorAll(".auth-step").forEach((el, index) => {
      if (el instanceof HTMLElement) {
        el.style.display = index + 1 === step ? "block" : "none";
      }
    });

    // Actualizar título y descripción según el paso
    const titleEl = document.getElementById("step-title");
    const descEl = document.getElementById("step-description");
    const loginLink = document.getElementById("login-link");

    if (titleEl && descEl && loginLink) {
      if (step === 1) {
        titleEl.textContent = "Crear Cuenta";
        descEl.innerHTML =
          "Ingresa tu nombre y correo electrónico para empezar. Te enviaremos un código de verificación.";
        loginLink.style.display = "none";
      } else if (step === 2) {
        titleEl.textContent = "Verifica tu Correo";
        descEl.innerHTML =
          'Hemos enviado un código de 6 dígitos a<br /><strong id="email-display">' +
          formData.email +
          "</strong>";
        loginLink.style.display = "none";
      } else if (step === 3) {
        titleEl.textContent = "Agrega tu Teléfono";
        descEl.textContent =
          "Te enviaremos un código de verificación por SMS para confirmar tu número de teléfono.";
        loginLink.style.display = "none";
      } else if (step === 4) {
        titleEl.textContent = "Verifica tu Teléfono";
        descEl.innerHTML =
          'Hemos enviado un código de 6 dígitos a<br /><strong id="phone-display">' +
          formData.phone +
          "</strong>";
        loginLink.style.display = "none";
      } else if (step === 5) {
        titleEl.textContent = "Completa tu Perfil";
        descEl.textContent =
          "Completa la información restante para finalizar la configuración de tu cuenta.";
        loginLink.style.display = "block";
      }
    }

    updateProgressDots(step);
    currentStep = step;
  }

  // Funciones de validación
  function validateFullName(name: string) {
    return name.trim().length >= 2;
  }

  function validateEmail(email: string) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function validatePhone(phone: string) {
    return phone.trim().length >= 10;
  }

  function validatePassword(password: string) {
    return password.length >= 8;
  }

  function showFieldError(fieldId: string, message: string) {
    validationErrors[fieldId] = message;
    const field = document.getElementById(fieldId);
    if (field) {
      field.classList.add("field-error");
      const errorEl = field.parentElement?.querySelector(
        ".field-error-message",
      );
      if (errorEl instanceof HTMLElement) {
        errorEl.textContent = message;
        errorEl.style.display = "block";
      }
    }
  }

  function clearFieldError(fieldId: string) {
    delete validationErrors[fieldId];
    const field = document.getElementById(fieldId);
    if (field) {
      field.classList.remove("field-error");
      const errorEl = field.parentElement?.querySelector(
        ".field-error-message",
      );
      if (errorEl instanceof HTMLElement) {
        errorEl.style.display = "none";
      }
    }
  }

  function clearAllErrors() {
    Object.keys(validationErrors).forEach((key) => clearFieldError(key));
  }

  // Paso 1: Crear cuenta
  document.getElementById("form-step-1")?.addEventListener("submit", (e) => {
    e.preventDefault();
    clearAllErrors();

    const fullNameInput = document.getElementById("fullName");
    const emailInput = document.getElementById("email");

    if (
      !(fullNameInput instanceof HTMLInputElement) ||
      !(emailInput instanceof HTMLInputElement)
    ) {
      return;
    }

    const fullName = fullNameInput.value.trim();
    const email = emailInput.value.trim();

    let hasErrors = false;

    if (!validateFullName(fullName)) {
      showFieldError("fullName", "El nombre debe tener al menos 2 caracteres");
      hasErrors = true;
    }

    if (!validateEmail(email)) {
      showFieldError("email", "Correo electrónico inválido");
      hasErrors = true;
    }

    if (hasErrors) {
      return;
    }

    formData.fullName = fullName;
    formData.email = email;

    showStep(2);
    initOTPInputs("otp-email");
  });

  // Limpiar errores al escribir
  document.getElementById("fullName")?.addEventListener("input", () => {
    clearFieldError("fullName");
  });

  document.getElementById("email")?.addEventListener("input", () => {
    clearFieldError("email");
  });

  // Paso 2: Verificar email
  document.getElementById("form-step-2")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const inputs = document.querySelectorAll("#otp-email .otp-input");
    const otp = Array.from(inputs)
      .map((input) => (input instanceof HTMLInputElement ? input.value : ""))
      .join("");

    if (otp.length !== 6) {
      return;
    }

    emailOTPStatus = "verifying";
    updateOTPStatus("otp-email", "verifying");

    // Código quemado: 202601
    const isValid = otp === "202601";

    setTimeout(() => {
      if (isValid) {
        emailOTPStatus = "success";
        updateOTPStatus("otp-email", "success");
        formData.emailOTP = otp;

        setTimeout(() => {
          emailOTPStatus = "idle";
          showStep(3);
        }, 3000);
      } else {
        emailOTPStatus = "error";
        updateOTPStatus("otp-email", "error");

        setTimeout(() => {
          emailOTPStatus = "idle";
          updateOTPStatus("otp-email", "idle");
          inputs.forEach((input) => {
            if (input instanceof HTMLInputElement) input.value = "";
          });
          const firstInput = inputs[0];
          if (firstInput instanceof HTMLInputElement) firstInput.focus();
        }, 2000);
      }
    }, 1000);
  });

  function updateOTPStatus(containerId: string, status: string) {
    const container = document.getElementById(containerId);
    if (!container) return;

    const inputs = container.querySelectorAll(".otp-input");
    inputs.forEach((input) => {
      input.classList.remove("otp-verifying", "otp-success", "otp-error");
      if (status !== "idle") {
        input.classList.add(`otp-${status}`);
      }
    });
  }

