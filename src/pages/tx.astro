---
import TxApp from "../components/tx/TxApp.astro";
import Navbar3 from "../components/NavbarSimple.astro";
import ProductsPanel from "../components/productsPanel.astro";
import { AlaizaAssistant } from "../components/AlaizaAssistant";
import EmailQuoteForm from "../components/design-system/molecules/EmailQuoteForm.astro";
import CtaGroup from "../components/design-system/molecules/CtaGroup.astro";
import Button from "../components/design-system/atoms/Button.astro";
import "../components/design-system/tokens.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/png"
      href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png"
    />
    <title>Zelify — Tx</title>
  </head>

  <body>
    <header class="auth-header">
      <Navbar3 />
      <ProductsPanel />
    </header>

    <main class="auth-main">
      <section class="auth-hero">
        <h1 class="auth-title">
          Transferencias internacionales<br />
          instantáneas
        </h1>
        <p class="auth-description">
          Mecanismo integral que permite generar y obtener cotizaciones precisas
          en tiempo real,<br />        </p>
        <CtaGroup class="auth-cta">
          <EmailQuoteForm
            dataI18nPlaceholder="home.welcome.email.placeholder"
            dataI18nAria="home.welcome.email.aria"
            buttonLabel="Let's talk"
          />
          <Button
            href="https://www.zelify.com/clips"
            variant="secondary"
            class="welcome-demo-button"
            target="_blank"
            rel="noopener noreferrer"
          >
            Demo
          </Button>
        </CtaGroup>
      </section>
    </main>

    <div class="auth-background-section">
      <div class="auth-background-overlay"></div>
      <div class="auth-background-image">
        <video class="auth-video" autoplay loop muted playsinline>
          <source
            src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/videos/tx.mp4"
            type="video/mp4"
          />
        </video>
      </div>

      <!-- Contenedor del dispositivo móvil -->
      <div class="device-container">
        <TxApp />
      </div>
    </div>

    <!-- Sección de Seguridad Inteligente -->
    <section class="security-section">
      <div class="security-container">
        <h2 class="security-title">
          Ciclo de vida<br />
          de la transacción
        </h2>

        <div class="security-features">
          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
                ></path>
              </svg>
            </div>
            <h3 class="feature-title">Cotización FX</h3>
            <p class="feature-description">
              Acceso a tasas de cambio dinámicas con márgenes y comisiones
              configurables en tiempo real.
            </p>
          </div>

          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="M9 12l2 2 4-4"></path>
              </svg>
            </div>
            <h3 class="feature-title">Valida cuentas</h3>
            <p class="feature-description">
              Verificación de formatos estandarizados IBAN, CLABE o SWIFT para
              reducir rechazos.
            </p>
          </div>

          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </div>
            <h3 class="feature-title">Inicio de transferencia</h3>
            <p class="feature-description">
              Procesamiento ágil capturando datos de remitente, beneficiario y
              propósito del pago.
            </p>
          </div>

          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </div>
            <h3 class="feature-title">Seguimiento Real-time</h3>
            <p class="feature-description">
              Visibilidad total del ciclo de vida y obtención de estados a
              medida que avanza la red.
            </p>
          </div>

          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <h3 class="feature-title">Liquidación y Lotes</h3>
            <p class="feature-description">
              Procesos con proveedores de liquidez y consulta de estados por
              lotes de operaciones.
            </p>
          </div>

          <div class="security-feature">
            <div class="feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                ></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
            <h3 class="feature-title">Conciliación Perfecta</h3>
            <p class="feature-description">
              Informes detallados por montos, divisas convertidas y cargos
              aplicados.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="control-section">
      <div class="control-container">
        <div class="control-divider"></div>
        <h2 class="control-title">Control total de transferencias</h2>

        <div class="control-features">
          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/image-products/tx/img-1.png"
                    alt="Validación de cuentas"
                  />
                </div>
                <h3 class="control-feature-title">Validación Internacional</h3>
                <p class="control-feature-description">
                  Herramienta de seguridad para validar la cuenta del
                  beneficiario antes de procesar el pago.
                </p>
                <button class="control-feature-btn" data-feature="validation">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Seguridad Operativa</h3>
                <ul class="control-feature-benefits">
                  <li>Verifica cumplimiento de formato IBAN</li>
                  <li>Soporte para cuentas CLABE y SWIFT</li>
                  <li>Reduce drásticamente errores operativos</li>
                  <li>Validación previa al movimiento de fondos</li>
                  <li>Minimiza el riesgo de rechazos bancarios</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="validation"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/image-products/tx/img-2.png"
                    alt="Cotización FX"
                  />
                </div>
                <h3 class="control-feature-title">Conversión de Divisas</h3>
                <p class="control-feature-description">
                  Mecanismo integral para generar cotizaciones precisas con
                  tasas de cambio dinámicas.
                </p>
                <button class="control-feature-btn" data-feature="fx">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Transparencia en FX</h3>
                <ul class="control-feature-benefits">
                  <li>Acceso a múltiples monedas admitidas</li>
                  <li>Márgenes y comisiones configurables</li>
                  <li>Generación de cotizaciones en tiempo real</li>
                  <li>Asegura transparencia en la conversión</li>
                  <li>Cotización previa al inicio de operación</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="fx"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/image-products/tx/img-3.png"
                    alt="Seguimiento y confirmación"
                  />
                </div>
                <h3 class="control-feature-title">Seguimiento y Recibos</h3>
                <p class="control-feature-description">
                  Obtén estados de la transferencia en tiempo real y genera
                  comprobantes oficiales automáticos.
                </p>
                <button class="control-feature-btn" data-feature="tracking">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Trazabilidad Total</h3>
                <ul class="control-feature-benefits">
                  <li>Estados de transferencia en tiempo real</li>
                  <li>Generación de recibo digital automático</li>
                  <li>Comprobante oficial para usuario final</li>
                  <li>Visibilidad del ciclo de vida operativo</li>
                  <li>Monitoreo por la red de pagos</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="tracking"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="control-feature">
            <div class="control-feature-card">
              <div class="control-feature-front">
                <div class="control-feature-image">
                  <img
                    src="https://zelify-proposals-pdf-prod.s3.us-east-1.amazonaws.com/image-products/tx/img-4.png"
                    alt="Liquidación y conciliación"
                  />
                </div>
                <h3 class="control-feature-title">Control Pos-operativo</h3>
                <p class="control-feature-description">
                  Módulo avanzado para conciliación contable e informes de
                  liquidación detallados.
                </p>
                <button class="control-feature-btn" data-feature="settlement">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
              <div class="control-feature-back">
                <h3 class="control-feature-title">Conciliación Financiera</h3>
                <ul class="control-feature-benefits">
                  <li>Informes por montos y divisas</li>
                  <li>Reporte de cargos y comisiones aplicados</li>
                  <li>Liquidación manual o automática</li>
                  <li>Conciliación contable garantizada</li>
                  <li>Consulta de estados de lotes (batches)</li>
                </ul>
                <button
                  class="control-feature-btn control-feature-btn-close"
                  data-feature="settlement"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Contacto -->
    <section class="contact-section">
      <div class="contact-container">
        <div class="contact-content">
          <!-- Texto izquierdo -->
          <div class="contact-text">
            <h2 class="contact-title">
              Comienza a construir el banco del futuro, hoy.
            </h2>
          </div>

          <!-- Formulario derecho -->
          <div class="contact-form-wrapper">
            <div class="contact-form-card">
              <h3 class="contact-form-title">Habla con nuestro equipo</h3>

              <form class="contact-form" id="contactForm">
                <div class="form-row">
                  <div class="form-group">
                    <input
                      type="text"
                      id="nombres"
                      placeholder="Nombres"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <input
                      type="text"
                      id="apellidos"
                      placeholder="Apellidos"
                      required
                    />
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <input
                      type="text"
                      id="compania"
                      placeholder="Nombre de la compañía"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <input
                      type="email"
                      id="email"
                      placeholder="Email de la compañía"
                      required
                    />
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <select id="pais" required>
                      <option value="">País</option>
                      <option value="mx">México</option>
                      <option value="co">Colombia</option>
                      <option value="ar">Argentina</option>
                      <option value="cl">Chile</option>
                      <option value="pe">Perú</option>
                      <option value="es">España</option>
                      <option value="us">Estados Unidos</option>
                    </select>
                    <svg
                      class="select-arrow"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </div>
                  <div class="form-group">
                    <input
                      type="tel"
                      id="telefono"
                      placeholder="Teléfono (opcional)"
                    />
                  </div>
                </div>

                <p class="contact-legal">
                  Al enviar este formulario, aceptas nuestros <a href="#"
                    >Términos de Servicio</a
                  > y <a href="#">Política de Privacidad</a>.
                </p>

                <button type="submit" class="contact-submit-btn">
                  Hablemos
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="faq-section">
      <div class="faq-container">
        <h2 class="faq-title">Preguntas frecuentes</h2>

        <div class="faq-list">
          <div class="faq-item">
            <button class="faq-question" data-faq="1">
              <span
                >¿Qué funcionalidades incluye el módulo de International
                Transfers?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Nuestro módulo permite cotizar FX con márgenes configurables,
                validar cuentas internacionales (SWIFT, IBAN, CLABE), procesar
                transferencias de forma segura y realizar un seguimiento en
                tiempo real con comprobantes digitales. Además, incluye
                herramientas avanzadas de liquidación y conciliación contable.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="2">
              <span
                >¿Cómo se gestionan las tasas de cambio y las comisiones?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                El sistema ofrece un mecanismo de cotización en tiempo real con
                acceso a tasas de cambio dinámicas para múltiples divisas.
                Permite aplicar márgenes y comisiones personalizables antes de
                confirmar la operación, garantizando total transparencia en la
                conversión de fondos.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="3">
              <span
                >¿Qué tipos de cuentas internacionales se pueden validar?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Para reducir errores operativos y rechazos, nuestra herramienta
                valida automáticamente formatos estandarizados como SWIFT, IBAN
                y CLABE. Esto asegura que la información del beneficiario sea
                correcta antes de orquestar el movimiento de fondos.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="4">
              <span
                >¿Cómo pueden los usuarios rastrear el estado de su envío?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Ofrecemos visibilidad total sobre el ciclo de vida de la
                transacción. Los usuarios pueden consultar los estados en tiempo
                real mientras la transferencia avanza por la red de pagos y
                obtener un recibo digital automático que sirve como comprobante
                oficial de la operación.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="5">
              <span
                >¿Cómo se maneja la liquidación con proveedores de liquidez?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                Contamos con un módulo de control financiero pos-operativo que
                permite generar informes detallados y realizar procesos de
                liquidación manuales o automáticos. Esto facilita la consulta
                del estado de cada lote de operaciones para asegurar una
                conciliación contable perfecta.
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" data-faq="6">
              <span
                >¿Es difícil integrar las transferencias internacionales en mi
                App?</span
              >
              <svg
                class="faq-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="faq-answer">
              <p>
                No, gracias al SDK de Zelify TX, la integración es ágil y
                sencilla. El SDK está diseñado para reducir la complejidad
                técnica y el cumplimiento normativo, permitiendo a las
                instituciones financieras acelerar su tiempo de salida al
                mercado con una solución robusta.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer-section">
      <div class="footer-container">
        <div class="footer-top">
          <!-- Logo -->
          <div class="footer-logo">
            <img
              src="/images/zelify_logo2.png"
              alt="Zelify"
              style="height: 40px;"
            />
          </div>

          <!-- Quick Links -->
          <div class="footer-quick-links">
            <h3 class="quick-links-title">Quick links</h3>
            <ul class="quick-links-list">
              <li><a href="/products">Products</a></li>
              <li><a href="/nosotros">About us</a></li>
              <li><a href="/desarrollo">Developers</a></li>
              <li><a href="/otros">Others</a></li>
            </ul>
          </div>
        </div>

