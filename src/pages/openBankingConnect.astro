---
import Navbar from "../components/navbar.astro";
import ProductsPanel from "../components/productsPanel.astro";
import "../styles/navbar.css";
---

<script>
  type Translation = {
    badge: string;
    title: string;
    description: string;
    ctaTalk: string;
    ctaDocs: string;
  };

  type Translations = {
    en: Translation;
    es: Translation;
  };

  const translations: Translations = {
    en: {
      badge: "Connect",
      title: "Seamless Banking\nConnections with\nno frontiers.",
      description: "Allow users to connect their bank accounts, safely authorize access to their data, and generate secure tokens, making it easy for your app to read information and initiate payments with confidence.",
      ctaTalk: "Let's talk",
      ctaDocs: "View API Docs"
    },
    es: {
      badge: "Connect",
      title: "Conexiones Bancarias\nFluidas sin\nFronteras.",
      description: "Permite a los usuarios conectar sus cuentas bancarias, autorizar de forma segura el acceso a sus datos y generar tokens seguros, facilitando que tu aplicación lea información e inicie pagos con confianza.",
      ctaTalk: "Hablemos",
      ctaDocs: "Ver documentación API"
    }
  };

  function updateContent(rawLang: string) {
    const lang = rawLang.toLowerCase() as keyof Translations;
    const content = translations[lang] || translations.en;
    
    const elements = {
      badge: document.querySelector('.badge'),
      title: document.querySelector('.title'),
      description: document.querySelector('.description'),
      ctaTalk: document.querySelector('.cta .btn:first-child'),
      ctaDocs: document.querySelector('.cta .btn:last-child')
    };

    if (elements.badge) elements.badge.textContent = content.badge;
    if (elements.title) elements.title.innerHTML = content.title.replace(/\n/g, '<br>');
    if (elements.description) elements.description.textContent = content.description;
    if (elements.ctaTalk) elements.ctaTalk.textContent = content.ctaTalk;
    if (elements.ctaDocs) elements.ctaDocs.textContent = content.ctaDocs;
  }

  // Escuchar cambios de idioma desde el navbar
  window.addEventListener('ui:languagechange', ((event) => {
    const customEvent = event as CustomEvent<{language: string}>;
    if (customEvent.detail?.language) {
      updateContent(customEvent.detail.language);
    }
  }) as EventListener);

  // Aplicar traducciones iniciales
  document.addEventListener('DOMContentLoaded', () => {
    const storedLang = localStorage.getItem('ui-language') || 'EN';
    updateContent(storedLang);
  });
</script>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Zelify Page 4 — Connect</title>
  </head>

  <body
    style="
      background-color: #020b18;
      background-image: url('/images/FONDO 6.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      min-height: 100vh;
      margin: 0;
    "
  >
    <Navbar
      logoSrc="/images/zelify_logo2.png"
      colors={{
        text: "#ffffff",
        textHover: "#ffffff",
        highlightBg: "#6AFF00",
        highlightText: "#0b132b",
        btnLightBg: "#E7EDF6",
        btnLightHoverBg: "#DAE4F1",
        btnLightText: "#004195",
        btnOutline: "#E7EDF6",
        btnOutlineHover: "#ffffff",
        dropdownBg: "#ffffff",
        dropdownLink: "#1e2b3a",
        dropdownHoverBg: "#EEF3F9",
        radius: "22px",
      }}
      buttons={{
        first: { label: "Work with us", href: "https://www.zelify.com/jobs" },
        second: { label: "Business access", href: "https://www.zelify.io/" },
        third: { label: "EN", href: "/" },
      }}
    />
    <ProductsPanel />

    <section class="hero">
      <div class="content">
        <span class="badge"></span>

        <h1 class="title"></h1>

        <p class="description"></p>

        <div class="cta">
          <a href="/hablemos" class="btn"></a>
          <a href="https://documentations.zelify.com/zelify-servicios-financieros/zelify-connect" class="btn"></a>
        </div>
      </div>
    </section>
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  body {
    font-family: "NataSans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #e9eff7;
  }

  .hero {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 6rem 8%;
  }

  .content {
    max-width: 640px;
    text-align: right;
    margin-right: 8%;
  }

  .badge {
    display: inline-block;
    max-width: 320px;
    background: #6AFF00;
    color: #0b132b;
    padding: 0.8rem 2rem;
    border-radius: 25px;
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 2rem;
    margin-left: auto;
    text-align: left;
    box-shadow: 0 0 12px rgba(184, 255, 42, 0.4);
  }

  .title {
    color: #b8ff2a;
    font-weight: 800;
    line-height: 1.15;
    font-size: clamp(2rem, 4.6vw, 3.1rem);
    margin: 0 0 1rem 0;
  }

  .description {
    color: #bfcfe4;
    font-size: 1.05rem;
    line-height: 1.65;
    max-width: 520px;
    margin: 0 0 2rem auto;
  }

  .cta {
    display: flex;
    justify-content: flex-end;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .btn {
    background: rgba(231, 237, 246, 0.95);
    color: #1f4d93;
    text-decoration: none;
    font-weight: 700;
    padding: 0.7rem 1.2rem;
    border-radius: 10px;
    font-size: 0.98rem;
    transition:
      background-color 0.2s ease,
      transform 0.15s ease;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
  }
  .btn:hover {
    background: rgba(215, 224, 236, 0.98);
    transform: translateY(-1px);
  }

  @media (max-width: 960px) {
    .hero {
      justify-content: center;
      padding: 4rem 6%;
      text-align: center;
    }

    .content {
      text-align: center;
      margin: 0 auto;
    }

    .badge {
      margin: 0 auto 2rem;
      text-align: center;
      max-width: 280px;
    }

    .cta {
      justify-content: center;
    }
  }
</style>