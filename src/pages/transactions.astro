---
import Navbar from "../components/navbar.astro";
import ProductsPanel from "../components/productsPanel.astro";
import "../styles/navbar.css";
---

<script>
  type Translation = {
    badge: string;
    title: string;
    description: string;
    ctaTalk: string;
    ctaDocs: string;
  };

  type Translations = {
    en: Translation;
    es: Translation;
  };

  const translations: Translations = {
    en: {
      badge: "TX",
      title: "Seamless Cross-Border<br />Transfers, Instantly.",
      description: "Zelify International Transfers enables instant B2C, B2B, and P2P transactions between Latin America and the United States, delivering speed, security, and efficiency for global money movement.",
      ctaTalk: "Let's talk",
      ctaDocs: "View API Docs"
    },
    es: {
      badge: "TX",
      title: "Transferencias Transfronterizas<br />Sin Fricción, Instantáneas.",
      description: "Zelify International Transfers permite transacciones instantáneas B2C, B2B y P2P entre Latinoamérica y Estados Unidos, ofreciendo velocidad, seguridad y eficiencia para el movimiento global de dinero.",
      ctaTalk: "Hablemos",
      ctaDocs: "Ver documentación API"
    }
  };

  function updateContent(rawLang: string) {
    const lang = rawLang.toLowerCase() as keyof Translations;
    const content = translations[lang] || translations.en;
    
    const elements = {
      badge: document.querySelector('.badge'),
      title: document.querySelector('.title'),
      description: document.querySelector('.description'),
      ctaTalk: document.querySelector('.cta a:first-child'),
      ctaDocs: document.querySelector('.cta a:last-child')
    };

    if (elements.badge) elements.badge.textContent = content.badge;
    if (elements.title) {
      const titleHTML = content.title.replace(/\n/g, '<br>');
      const badgeHTML = elements.badge ? `<span class="badge">${content.badge}</span> ` : '';
      elements.title.innerHTML = badgeHTML + titleHTML;
    }
    if (elements.description) elements.description.textContent = content.description;
    if (elements.ctaTalk) elements.ctaTalk.textContent = content.ctaTalk;
    if (elements.ctaDocs) elements.ctaDocs.textContent = content.ctaDocs;
  }

  // Escuchar cambios de idioma desde el navbar
  window.addEventListener('ui:languagechange', ((event: Event) => {
    const customEvent = event as CustomEvent<{language: string}>;
    if (customEvent.detail?.language) {
      updateContent(customEvent.detail.language);
    }
  }) as EventListener);

  // Aplicar traducciones iniciales
  document.addEventListener('DOMContentLoaded', () => {
    const storedLang = localStorage.getItem('ui-language') || 'EN';
    updateContent(storedLang);
  });
</script>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Zelify Page 7 — TX</title>
  </head>

  <body
    style="
      background-color: #e6edf4;
      background-image: url('/images/FONDO 9.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      min-height: 100vh;
      margin: 0;
    "
  >
    <Navbar
      logoSrc="/images/zelify_logo.png"
      colors={{
        text: "#004195",
        textHover: "#000000",
        background: "transparent",
        highlightBg: "#6AFF00",
        highlightText: "#0b132b",
        btnLightBg: "transparent",
        btnLightHoverBg: "rgba(255,255,255,0.1)",
        btnLightText: "#004195",
        btnLightBorder: "#00419566",
        btnOutline: "#004195",
        btnOutlineHover: "#6AFF00",
        dropdownBg: "#ffffff",
        dropdownLink: "#1e2b3a",
        dropdownHoverBg: "#EEF3F9",
        radius: "22px",
      }}
      buttons={{
        first: { label: "Work with us", href: "https://www.zelify.com/jobs" },
        second: { label: "Business access", href: "https://www.zelify.io/" },
        third: { label: "EN", href: "/" },
      }}
    />
    <ProductsPanel />

    <section class="hero">
      <div class="content">
        <h1 class="title">
          <span class="badge">TX</span>
          Seamless Cross-Border<br />
          Transfers, Instantly.
        </h1>

        <p class="description">
          Zelify International Transfers enables instant B2C, B2B, and P2P
          transactions between Latin America and the United States, delivering
          speed, security, and efficiency for global money movement.
        </p>

        <div class="cta">
          <a href="/hablemos" class="btn">Let's talk</a>
          <a href="https://documentations.zelify.com/servicios-financieros/zelify-tx" target="_blank" rel="noopener noreferrer" class="btn">View API Docs</a>
        </div>
      </div>
    </section>
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  body {
    font-family:
      "NataSans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    color: #0b132b;
  }

  .hero {
    display: flex;
    align-items: center;
    justify-content: flex-end; 
    min-height: calc(100vh - 80px);
    padding: 6rem 8%;
  }

  .content {
    max-width: 720px;
    text-align: center; 
    position: relative;
    margin-right: 6%;
  }

  .title {
    color: #1b4b97; 
    font-weight: 500;
    line-height: 1.18;
    font-size: clamp(2rem, 4.6vw, 3.2rem);
    margin: 0 0 1rem 0;
    position: relative;
    padding-right: 0;
  }

  .badge {
    position: absolute;
    top: 0;
    right: 0;
    display: inline-block;
    background: #6aff00;
    color: #0b132b;
    padding: 0.8rem 2rem;
    border-radius: 25px;
    font-weight: 700;
    font-size: 1.1rem;
    text-align: center;
    box-shadow: 0 0 12px rgba(184, 255, 42, 0.4);
    word-wrap: break-word;
    overflow-wrap: break-word;
    box-sizing: border-box;
    transform: translateY(-100%);
    margin-bottom: 0.5rem;
    white-space: nowrap;
  }

  .description {
    color: #1b4b97;
    font-size: 1.05rem;
    line-height: 1.5;
    max-width: 520px; 
    text-align: center; 
    margin: 0 auto 2.5rem auto; 
    font-weight: 400;
  }

  .cta {
    display: flex;
    gap: 0.9rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    background: #6aff00;
    color: #0b132b;
    text-decoration: none;
    font-weight: 800;
    padding: 0.65rem 1.2rem;
    border-radius: 12px;
    font-size: 0.95rem;
    transition:
      background-color 0.2s ease,
      transform 0.15s ease;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
  }

  .btn:hover {
    background: #87ff4b;
    transform: translateY(-1px);
  }

  @media (max-width: 960px) {
    .hero {
      justify-content: center;
      padding: 4rem 6%;
    }
    .content {
      margin-right: 0;
      text-align: center;
    }
    .badge {
      position: static;
      top: auto;
      right: auto;
      transform: none;
      display: inline-block;
      max-width: 100%;
      text-align: center;
      margin: 0 auto 2rem;
      margin-left: auto;
      margin-right: auto;
    }
    
    .title {
      margin-top: 0;
    }
  }
</style>
