<script is:inline>
  (() => {
    const form = document.querySelector(".welcome-input-group");
    const quoteModal = document.querySelector("#quote-modal");
    const closeQuoteBtn = document.querySelector("#close-quote-modal");
    const quoteModalOverlay = document.querySelector(
      "[data-close-quote-modal]",
    );

    const MEETINGS_BASE_URL =
      "https://meetings.hubspot.com/gmantilla?embed=true";

    const openQuoteModal = () => {
      if (!quoteModal) return;

      const emailInput = document.querySelector(".welcome-input");
      const email =
        emailInput && emailInput.value ? emailInput.value.trim() : "";
      const embedUrl = email
        ? MEETINGS_BASE_URL + "&email=" + encodeURIComponent(email)
        : MEETINGS_BASE_URL;

      const container = document.querySelector(".meetings-iframe-container");
      if (container) {
        container.setAttribute("data-src", embedUrl);
        const iframe = container.querySelector("iframe");
        if (iframe) {
          iframe.src = embedUrl;
        } else {
          setTimeout(() => {
            const iframeLater = container.querySelector("iframe");
            if (iframeLater) iframeLater.src = embedUrl;
          }, 500);
        }
      }

      quoteModal.classList.add("is-active");
      quoteModal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    const closeQuoteModal = () => {
      if (!quoteModal) return;
      quoteModal.classList.remove("is-active");
      quoteModal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    if (closeQuoteBtn) {
      closeQuoteBtn.addEventListener("click", closeQuoteModal);
    }
    if (quoteModalOverlay) {
      quoteModalOverlay.addEventListener("click", closeQuoteModal);
    }

    if (form) {
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        openQuoteModal();
      });
    }

    // Botones "Hablemos" que abren el modal de cotización (ej. sección AI)
    document.querySelectorAll("[data-open-quote-modal]").forEach((el) => {
      el.addEventListener("click", (e) => {
        e.preventDefault();
        openQuoteModal();
      });
    });
  })();
</script>

<script>
  /* Ensure this script runs after DOM load */
  document.addEventListener("DOMContentLoaded", () => {
    const playBtn = document.getElementById("demo-play-button");
    const playIcon = document.getElementById("demo-play-icon");
    const pauseIcon = document.getElementById("demo-pause-icon");

    // Internal state to track status
    let isDemoPlaying = false;

    if (playBtn && playIcon && pauseIcon) {
      // Visual toggle logic
      const setPlaying = (isPlaying: boolean) => {
        isDemoPlaying = isPlaying;
        if (isPlaying) {
          playIcon.style.display = "none";
          pauseIcon.style.display = "block";
          playBtn.setAttribute("aria-label", "Detener Demo");
        } else {
          playIcon.style.display = "block";
          pauseIcon.style.display = "none";
          playBtn.setAttribute("aria-label", "Reproducir Demo");
        }
      };

      // Listeners for React Events
      window.addEventListener("zelify:demo-start", () => setPlaying(true));
      window.addEventListener("zelify:demo-end", () => setPlaying(false));

      // Click Trigger
      playBtn.addEventListener("click", () => {
        // Visual feedback
        playBtn.style.transform = "scale(0.95)";
        setTimeout(() => (playBtn.style.transform = ""), 150);

        // Find active module
        const activeItem = document.querySelector(
          ".product-showcase__item.is-active",
        );
        const moduleId = activeItem
          ? activeItem.getAttribute("data-ps-item")
          : "auth";

        // Dispatch toggle event based on current state and active module
        if (isDemoPlaying) {
          window.dispatchEvent(new CustomEvent(`zelify:stop-demo:${moduleId}`));
        } else {
          window.dispatchEvent(new CustomEvent(`zelify:play-demo:${moduleId}`));
        }
      });
    }
  });

  // Action Products Navigation
  document.addEventListener("DOMContentLoaded", () => {
    const actionButtons = document.querySelectorAll(".action-nav-button");
    const actionCards = document.querySelectorAll(".action-card-wrapper");

    function updateActionCard(actionId: string) {
      // Hide all cards
      actionCards.forEach((card) => {
        (card as HTMLElement).style.display = "none";
      });

      // Show the active card
      const activeCard = document.querySelector(
        `[data-action-card="${actionId}"]`,
      );
      if (activeCard) {
        (activeCard as HTMLElement).style.display = "block";
      }
    }

    actionButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const actionId = button.getAttribute("data-action");
        if (!actionId) return;

        // Remove active class from all buttons
        actionButtons.forEach((btn) => {
          btn.classList.remove("active");
        });

        // Add active class to clicked button
        button.classList.add("active");

        // Update the displayed card
        updateActionCard(actionId);
      });
    });
    // Initialize with first active button
    const firstActive = document.querySelector(".action-nav-button.active");
    if (firstActive) {
      const firstActionId = firstActive.getAttribute("data-action");
      if (firstActionId) {
        updateActionCard(firstActionId);
      }
    }
  });

  // Home Bench Tabs Logic (CardTabs)
  document.addEventListener("DOMContentLoaded", () => {
    const benchTabButtons = document.querySelectorAll(
      "button[data-tab-group='home-bench-tabs']",
    );
    const benchContents = document.querySelectorAll(
      ".bench-section .bench-content-placeholder",
    );
    const benchCardTabs = document.querySelector(
      ".bench-section-tabs.ds-card-tabs",
    );
    const benchCtaBtn = benchCardTabs?.querySelector(".ds-card-tabs__cta");

    benchTabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const val = btn.getAttribute("data-tab-value");

        // Update active state
        benchTabButtons.forEach((b) => {
          const isActive = b.getAttribute("data-tab-value") === val;
          b.classList.toggle("active", isActive);
          b.setAttribute("aria-selected", isActive ? "true" : "false");
        });

        // Update content (flex para centrar placeholders)
        benchContents.forEach((c) => {
          if (c instanceof HTMLElement && c.hasAttribute("data-card-content")) {
            c.style.display =
              c.getAttribute("data-card-content") === val ? "flex" : "none";
          }
        });

        // CTA button muestra el label del tab activo
        if (benchCtaBtn && btn.textContent) {
          benchCtaBtn.textContent = btn.textContent.trim();
        }
      });
    });
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const setupVideoControl = (btnId: string, videoId: string) => {
      const btn = document.getElementById(btnId);
      const video = document.getElementById(videoId);
      if (!btn || !video) return;

      const icon = btn.querySelector("img");

      const updateState = () => {
        if (video instanceof HTMLVideoElement && video.paused) {
          if (icon) icon.src = "/icons/play.svg";
          btn.setAttribute("aria-label", "Reproducir");
        } else {
          if (icon) icon.src = "/icons/pause.svg";
          btn.setAttribute("aria-label", "Pausar");
        }
      };

      btn.addEventListener("click", () => {
        if (video instanceof HTMLVideoElement) {
          if (video.muted) video.muted = false;
          if (video.paused) {
            video.play();
          } else {
            video.pause();
          }
        }
      });

      if (video instanceof HTMLVideoElement) {
        video.addEventListener("play", updateState);
        video.addEventListener("pause", updateState);
        updateState();
      }
    };

    setupVideoControl("how-it-works-play-btn", "how-it-works-video");
    setupVideoControl("why-zelify-play-btn", "why-zelify-video");
  });
</script>
