    height: 840px;
    min-height: 840px;
    max-height: 640px;
    overflow: hidden;
  }

  .product-showcase__video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 640px;
    min-height: 640px;
    max-height: 640px;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    opacity: 0.4;
  }

  .product-showcase__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    /* Gradient fade: solid white at top, transparent middle, solid white at bottom */
    background: linear-gradient(
      to bottom,
      #ffffff 0%,
      transparent 15%,
      transparent 85%,
      #ffffff 100%
    );
    pointer-events: none; /* Allow clicks to pass through to content if needed */
  }

