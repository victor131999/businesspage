  /* Modal Cotizar (vacío) */
  .quote-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .quote-modal.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .quote-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 34, 62, 0.4);
    backdrop-filter: blur(8px);
  }

  .quote-modal-content {
    position: relative;
    background: #ffffff;
    border-radius: 24px;
    width: 90%;
    max-width: 700px;
    min-height: 320px;
    box-shadow:
      0 20px 25px -5px rgba(0, 0, 0, 0.1),
      0 10px 10px -5px rgba(0, 0, 0, 0.04);
    transform: translateY(20px);
    transition: transform 0.3s ease;
  }

  .quote-modal.is-active .quote-modal-content {
    transform: translateY(0);
  }

  .quote-modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 40px;
    height: 40px;
    border: none;
    background: transparent;
    color: #94a3b8;
    cursor: pointer;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

