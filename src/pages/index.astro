<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const showcase = document.querySelector("[data-showcase]");
    if (!showcase) return;

    const items = showcase.querySelectorAll(".product-showcase__item");
    const cardWrappers = document.querySelectorAll(".product-card-wrapper");
    const playBtn = document.getElementById("demo-play-button");
    let currentActiveModule = "auth";

    function updateProductCard(moduleId) {
      // Stop the previous module's demo
      if (currentActiveModule && currentActiveModule !== moduleId) {
        window.dispatchEvent(
          new CustomEvent(`zelify:stop-demo:${currentActiveModule}`),
        );
      }

      // Hide all cards
      cardWrappers.forEach((wrapper) => {
        wrapper.style.display = "none";
      });

      // Show the active card
      const activeCard = document.querySelector(`[data-card-id="${moduleId}"]`);
      if (activeCard) {
        activeCard.style.display = "block";
      }

      // Auto-play the new module's demo
      currentActiveModule = moduleId;
      setTimeout(() => {
        window.dispatchEvent(new CustomEvent(`zelify:play-demo:${moduleId}`));
      }, 300); // Small delay for visual transition
    }

    items.forEach((item) => {
      const button = item.querySelector(".product-showcase__nav-item");
      const moduleId = item.getAttribute("data-ps-item");

      button?.addEventListener("click", () => {
        if (item.classList.contains("is-active")) return;

        items.forEach((other) => {
          other.classList.remove("is-active");
        });

        item.classList.add("is-active");

        if (moduleId) {
          updateProductCard(moduleId);
        }
      });
    });

    // Initialize with first active item
    const firstActive = document.querySelector(
      ".product-showcase__item.is-active",
    );
    if (firstActive) {
      const firstModuleId = firstActive.getAttribute("data-ps-item");
      if (firstModuleId) {
        // Trigger initial play
        setTimeout(() => {
          updateProductCard(firstModuleId);
        }, 1000); // Wait a bit after load
      }
    }
  });

  // Bench Section 2 Tabs
  document.addEventListener("DOMContentLoaded", () => {
    const benchTabs = document.querySelectorAll(".bench-tab");
    const benchContents = document.querySelectorAll(
      ".bench-content-placeholder",
    );
    const benchCtaButton = document.querySelector(".bench-cta-button");

    benchTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const benchNumber = tab.getAttribute("data-bench");

        // Remove active class from all tabs
        benchTabs.forEach((t) => t.classList.remove("active"));

        // Add active class to clicked tab
        tab.classList.add("active");

        // Hide all content
        benchContents.forEach((content) => {
          content.style.display = "none";
        });

        // Show selected content
        const selectedContent = document.querySelector(
          `[data-bench-content="${benchNumber}"]`,
        );
        if (selectedContent) {
          selectedContent.style.display = "flex";
        }

        // Update CTA button text
        if (benchCtaButton) {
          benchCtaButton.textContent = `bench ${benchNumber}`;
        }
      });
    });
  });

  // Tokens: play/pause del video (o animación) en el panel
  document.addEventListener("DOMContentLoaded", () => {
    const tokensBtn = document.getElementById("tokens-play-pause-btn");
    const tokensPlayIcon = document.getElementById("tokens-play-icon");
    const tokensPauseIcon = document.getElementById("tokens-pause-icon");
    const tokensVideo = document.getElementById("tokens-panel-video");
    if (!tokensBtn || !tokensPlayIcon || !tokensPauseIcon) return;

    let tokensIsPlaying = tokensVideo ? !tokensVideo.paused : false;

    function setTokensButtonState(playing) {
      tokensIsPlaying = playing;
      tokensPlayIcon.style.display = playing ? "none" : "block";
      tokensPauseIcon.style.display = playing ? "block" : "none";
      tokensBtn?.setAttribute(
        "aria-label",
        playing ? "Pausar animación" : "Reproducir animación",
      );
    }

    // Sincronizar botón con el video si existe
    if (tokensVideo) {
      tokensVideo.addEventListener("play", () => setTokensButtonState(true));
      tokensVideo.addEventListener("pause", () => setTokensButtonState(false));
      setTokensButtonState(!tokensVideo.paused);
    }

    window.addEventListener("tokens:state", (e) => {
      const isPlaying = e.detail && e.detail.isPlaying === true;
      setTokensButtonState(isPlaying);
    });

    tokensBtn.addEventListener("click", () => {
      if (tokensVideo) {
        if (tokensIsPlaying) {
          tokensVideo.pause();
        } else {
          tokensVideo.play();
        }
      } else {
        if (tokensIsPlaying) {
          window.dispatchEvent(new CustomEvent("tokens:pause"));
        } else {
          window.dispatchEvent(new CustomEvent("tokens:play"));
        }
      }
    });
  });
</script>

