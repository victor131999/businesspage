    id: "auth",
    label: "Auth",
    titleStrong: "Autenticación",
    titleAccent: "y Control",
    copy: "Autenticación y control de acceso de usuarios. Protege el acceso y gestiona identidades de forma segura.",
    cta: "Explorar Auth",
    href: "/auth",
  },
  {
    id: "identity",
    label: "Identity",
    titleStrong: "Identidad Digital",
    titleAccent: "",
    copy: "Gestión y validación de identidad digital. Verifica usuarios con biometría y análisis de documentos.",
    cta: "Explorar Identity",
    href: "/identity",
  },
  {
    id: "aml",
    label: "AML",
    titleStrong: "Prevención de Lavado",
    titleAccent: "",
    copy: "Evaluación de riesgo y cumplimiento regulatorio. Monitoreo continuo y listas de control.",
    cta: "Explorar AML",
    href: "/aml",
  },
