                        y posiblemente agendar una reunión.
                      </p>
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f8fafc;border-radius:10px;">
                        <tr>
                          <td style="padding:14px 16px;font-size:14px;color:#0b1d3a;">
                            <strong>Email del interesado:</strong> ${email}
                          </td>
                        </tr>
                      </table>
                      <p style="margin:18px 0 0;font-size:12px;line-height:1.5;color:#64748b;">
                        Origen: Formulario “Cotizar” en www.zelify.com
                      </p>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:16px 32px 28px;color:#64748b;font-size:12px;">
                      Este mensaje fue generado automáticamente por Zelify.
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        `,
        text: `Nueva solicitud desde la página principal. Email: ${email}. Interés en más información y posible reunión.`,
        cc: "",
        bcc: "",
      };

      try {
        const response = await fetch(
          "https://mailing-production.up.railway.app/email/send",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
          }
        );

        if (!response.ok) throw new Error("Request failed");

        setMessage("¡Listo! Te contactaremos pronto.");
        if (form) form.reset();
        captchaToken = "";
        if (typeof turnstile !== "undefined" && widgetId !== null) {
          turnstile.reset(widgetId);
        }
      } catch (error) {
        setMessage("No pudimos enviar tu solicitud. Intenta más tarde.", true);
      }
    };

    if (closeModal) {
      closeModal.addEventListener("click", () => toggleModal(false));
    }

    if (!form || !emailInput) return;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (honeypot && honeypot.value) return;

      const email = emailInput.value.trim();
      if (!isValidEmail(email)) {
        setMessage("Ingresa un correo válido.", true);
        emailInput.focus();
        return;
      }

      setMessage("", false);

      if (!captchaToken || !isModalOpen) {
        toggleModal(true);
        return;
      }

      await submitForm(email);
    });

    emailInput.addEventListener("input", () => {
      if (emailInput.classList.contains("is-error")) {
        setMessage("", false);
      }
    });
  })();
</script>

<script>
  /* Ensure this script runs after DOM load */
  document.addEventListener("DOMContentLoaded", () => {
    const playBtn = document.getElementById("demo-play-button");
    const playIcon = document.getElementById("demo-play-icon");
    const pauseIcon = document.getElementById("demo-pause-icon");

    // Internal state to track status
    let isDemoPlaying = false;

    if (playBtn && playIcon && pauseIcon) {
      // Visual toggle logic
      const setPlaying = (isPlaying: boolean) => {
        isDemoPlaying = isPlaying;
        if (isPlaying) {
          playIcon.style.display = "none";
          pauseIcon.style.display = "block";
          playBtn.setAttribute("aria-label", "Detener Demo");
        } else {
          playIcon.style.display = "block";
          pauseIcon.style.display = "none";
          playBtn.setAttribute("aria-label", "Reproducir Demo");
        }
      };

      // Listeners for React Events
      window.addEventListener("zelify:demo-start", () => setPlaying(true));
      window.addEventListener("zelify:demo-end", () => setPlaying(false));

      // Click Trigger
      playBtn.addEventListener("click", () => {
        // Visual feedback
        playBtn.style.transform = "scale(0.95)";
        setTimeout(() => (playBtn.style.transform = ""), 150);

        // Find active module
        const activeItem = document.querySelector(
          ".product-showcase__item.is-active"
        );
        const moduleId = activeItem
          ? activeItem.getAttribute("data-ps-item")
          : "auth";

        // Dispatch toggle event based on current state and active module
        if (isDemoPlaying) {
          window.dispatchEvent(new CustomEvent(`zelify:stop-demo:${moduleId}`));
        } else {
          window.dispatchEvent(new CustomEvent(`zelify:play-demo:${moduleId}`));
        }
      });
    }
  });

  // Action Products Navigation
  document.addEventListener("DOMContentLoaded", () => {
    const actionButtons = document.querySelectorAll(".action-nav-button");
    const actionCards = document.querySelectorAll(".action-card-wrapper");

    function updateActionCard(actionId: string) {
      // Hide all cards
      actionCards.forEach((card) => {
        (card as HTMLElement).style.display = "none";
      });

      // Show the active card
      const activeCard = document.querySelector(
        `[data-action-card="${actionId}"]`
      );
      if (activeCard) {
        (activeCard as HTMLElement).style.display = "block";
      }
    }

    actionButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const actionId = button.getAttribute("data-action");
        if (!actionId) return;

        // Remove active class from all buttons
        actionButtons.forEach((btn) => {
          btn.classList.remove("active");
        });

        // Add active class to clicked button
        button.classList.add("active");

        // Update the displayed card
        updateActionCard(actionId);
      });
    });

    // Initialize with first active button
    const firstActive = document.querySelector(".action-nav-button.active");
    if (firstActive) {
      const firstActionId = firstActive.getAttribute("data-action");
      if (firstActionId) {
        updateActionCard(firstActionId);
      }
    }
  });
</script>
