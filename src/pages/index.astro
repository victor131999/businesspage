      ctaTalk: string;
    };
    capabilities: {
      title: string;
      description: string;
      modules: {
        auth: { name: string; desc: string };
        identity: { name: string; desc: string };
        aml: { name: string; desc: string };
        connect: { name: string; desc: string };
        cards: { name: string; desc: string };
        "payments-transfers": { name: string; desc: string };
        tx: { name: string; desc: string };
        discounts: { name: string; desc: string };
      };
    };
    composition: {
      title: string;
      description: string;
      example: string;
      note: string;
    };
    alaiza: {
      title: string;
      description: string;
      description2: string;
      cta: string;
    };
    whoWePower: {
      title: string;
      banks: { title: string; desc: string };
      fintechs: { title: string; desc: string };
      cooperatives: { title: string; desc: string };
      institutions: { title: string; desc: string };
    };
    tokens: {
      title: string;
      description: string;
      description2: string;
    };
    pricing: {
      title: string;
      description: string;
      cta: string;
    };
    footer: {
