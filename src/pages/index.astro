---
import Navbar from "../components/navbar.astro";
import ProductsPanel from "../components/productsPanel.astro";
import "../styles/navbar.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Zelify — Business Finances</title>
  </head>

  <body
    style="
    background-color: #020b18;
    background-image: url('/images/FONDO%201.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    height: 100vh;             /* ocupa exactamente la ventana visible */
    width: 100vw;              /* ocupa todo el ancho de la ventana */
    margin: 0;
    overflow: hidden;          /* evita desplazamiento vertical u horizontal */
  "
  >
    <Navbar />
    <ProductsPanel />
    <!-- ← antes estaba <productsPanel /> y NO renderiza -->

    <section class="hero">
      <div class="hero-content">
        <h2 class="subtitle">The New Standard in</h2>
        <h1 class="title">Business<br />Finances</h1>
        <p class="description">
          Zelify simplifies business finance: <br />connecting payments, credit,
          and cash flow in one smart platform.
        </p>
        <a href="/" class="btn-primary">Let’s start</a>
      </div>
    </section>
    <!-- 🔥 Línea verde translúcida -->
    <div class="green-line"></div>
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  body {
    font-family:
      "NataSans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    color: #fff;
  }

  .hero {
    display: flex;
    align-items: flex-start; /* puedes cambiar a center o flex-end */
    justify-content: flex-start; /* puedes cambiar a center o flex-end */
    height: 100vh; /* ocupa toda la ventana */
    width: 100vw;
    position: relative;
    overflow: hidden;
  }

  /* Aquí controlas la posición manual del contenido */
  .hero-content {
    position: absolute;
    top: 20%; /* mueve hacia abajo */
    left: 20%; /* mueve hacia la derecha */
    transform: translate(0, 0); /* puedes ajustar manualmente con translate */
    max-width: 600px;
  }

  .subtitle {
    font-size: 2.5rem;
    font-weight: 600;
    color: #6aff00;
    margin-bottom: 0.5rem;
  }

  .title {
    font-size: 6.5rem;
    font-weight: 800;
    line-height: 1.1;
    color: #f8f9fa;
    margin-bottom: 1.5rem;
  }

  .description {
    font-size: 1.1rem;
    line-height: 1.55;
    color: #ced4da;
    margin-bottom: 2rem;
    max-width: 520px;
    text-align: left;
    text-wrap: balance;
  }

  .btn-primary {
    background-color: #6aff00;
    color: #0d1117;
    text-decoration: none;
    font-weight: 600;
    padding: 0.3rem 1.5rem;
    border-radius: 8px;
    display: inline-block;
    transition: background-color 0.2s ease;
  }

  .btn-primary:hover {
    background-color: #6aff00;
  }
  .green-line {
    position: absolute;
    bottom: 10%; /* controla la altura de la línea (ajústala a gusto) */
    left: 0;
    width: 100%;
    height: 50px; /* grosor de la franja */
    background: rgba(106, 255, 0, 0.15); /* verde translúcido */
    box-shadow: 0 0 5px rgba(106, 255, 0, 0.6); /* brillo suave */
    backdrop-filter: blur(1px); /* efecto translúcido elegante */
    z-index: 1; /* detrás del texto pero visible sobre el fondo */
  }
  background: linear-gradient(
    to right,
    rgba(106, 255, 0, 0.05) 0%,
    rgba(106, 255, 0, 0.3) 50%,
    rgba(106, 255, 0, 0.05) 100%
  );
</style>
