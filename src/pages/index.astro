        "modules.payments-transfers.titleAccent": "<br />locales",
        "modules.payments-transfers.copy":
          "Pagos de servicios básicos con información precargada y transferencias entre usuarios de forma rápida.",
        "modules.payments-transfers.cta": "Explorar Pago y Transferencias",
        "modules.tx.label": "TX",
        "modules.tx.titleStrong": "Transacciones",
        "modules.tx.titleAccent": "Internacionales",
        "modules.tx.copy":
          "Transferencias internacionales inmediatas y conversión de múltiples divisas.",
        "modules.tx.cta": "Explorar TX",
        "modules.discounts.label": "Discounts",
        "modules.discounts.titleStrong": "Descuentos y",
        "modules.discounts.titleAccent": "<br />Beneficios",
        "modules.discounts.copy":
          "Gestión de descuentos en una sola plataforma.",
        "modules.discounts.cta": "Explorar Discounts",
        "modules.alaiza.label": "Alaiza Fintech AI Core",
        "modules.alaiza.titleStrong": "IA Financiera",
        "modules.alaiza.titleAccent": "",
        "modules.alaiza.copy":
          "Inteligencia artificial para atención al cliente, notificaciones y recomendaciones del comportamiento transaccional y educación financiera. ",
        "modules.alaiza.cta": "Explora Alaiza",
      },
    };

    function applyHomeTranslations(lang = "es") {
      const langKey = lang.toLowerCase();
      const translations = homeTranslations[langKey] || homeTranslations.es;

      // Actualizar elementos con data-i18n
      const elements = document.querySelectorAll("[data-i18n]");
      elements.forEach((element) => {
        const key = element.getAttribute("data-i18n");
        if (!key || !translations[key]) return;

        // Para títulos con múltiples líneas (welcome-title)
        if (element.classList.contains("welcome-title")) {
          const line1Key = "home.welcome.title.line1";
          const line2Key = "home.welcome.title.line2";
          if (translations[line1Key] && translations[line2Key]) {
            element.innerHTML = `${translations[line1Key]} <span class="welcome-title-line" data-i18n="${line2Key}">${translations[line2Key]}</span>`;
          }
        }
        // Para títulos con múltiples líneas (ai-section-title)
        else if (element.classList.contains("ai-section-title")) {
          const line1Key = "home.ai.title.line1";
          const line2Key = "home.ai.title.line2";
          if (translations[line1Key] && translations[line2Key]) {
            element.innerHTML = `${translations[line1Key]}<br />${translations[line2Key]}`;
          }
        }
        // Para contenido normal
        else {
          element.innerHTML = translations[key];
        }
      });

      // Actualizar placeholders
      document
        .querySelectorAll("[data-i18n-placeholder]")
        .forEach((element) => {
          const key = element.getAttribute("data-i18n-placeholder");
          if (translations[key]) {
            element.setAttribute("placeholder", translations[key]);
          }
        });

      // Actualizar aria-labels
      document
        .querySelectorAll("[data-i18n-aria], [data-i18n-aria-label]")
        .forEach((element) => {
          const key =
            element.getAttribute("data-i18n-aria") ||
            element.getAttribute("data-i18n-aria-label");
          if (translations[key]) {
            element.setAttribute("aria-label", translations[key]);
          }
        });

      // Actualizar módulos del product-showcase (elementos dinámicos)
      const moduleItems = document.querySelectorAll("[data-ps-item]");
      moduleItems.forEach((item) => {
        const moduleId = item.getAttribute("data-ps-item");
        if (!moduleId) return;

        // Actualizar label del botón
        const navButton = item.querySelector(".product-showcase__nav-item");
        if (navButton) {
          const labelKey = `modules.${moduleId}.label`;
          if (translations[labelKey]) {
            navButton.textContent = translations[labelKey];
          }
        }

        // Actualizar título
        const titleStrong = item.querySelector("[data-ps-title-strong]");
        if (titleStrong) {
          const strongKey = `modules.${moduleId}.titleStrong`;
          if (translations[strongKey]) {
            titleStrong.innerHTML = translations[strongKey];
          }
        }

        const titleAccent = item.querySelector("[data-ps-title-accent]");
        if (titleAccent) {
          const accentKey = `modules.${moduleId}.titleAccent`;
          if (translations[accentKey] !== undefined) {
            titleAccent.innerHTML = translations[accentKey];
          }
        }

        // Actualizar copy
        const copy = item.querySelector("[data-ps-copy]");
        if (copy) {
          const copyKey = `modules.${moduleId}.copy`;
          if (translations[copyKey]) {
            copy.textContent = translations[copyKey];
          }
        }

        // Actualizar CTA
        const cta = item.querySelector("[data-ps-cta]");
        if (cta) {
          const ctaKey = `modules.${moduleId}.cta`;
          if (translations[ctaKey]) {
            cta.textContent = translations[ctaKey];
          }
        }
      });

      // Sección bench (tarjetas): pestaña y botón CTA "Borderless" / "Sin fronteras"
      const benchSection = document.querySelector(".bench-section .ds-card-tabs");
      if (benchSection) {
        const tabLabel = translations["home.bench.tabLabel"];
        const ctaLabel = translations["home.bench.cta"];
        if (tabLabel) {
          benchSection.querySelectorAll('[role="tab"]').forEach((tab) => {
            tab.textContent = tabLabel;
          });
        }
        if (ctaLabel) {
          const ctaBtn = benchSection.querySelector(".ds-card-tabs__cta");
          if (ctaBtn) ctaBtn.textContent = ctaLabel;
        }
      }
    }

    // Función para aplicar traducciones
    function applyTranslations(lang) {
      const langKey = lang === "EN" ? "en" : "es";
      // Usar requestAnimationFrame para asegurar que el DOM esté listo
      requestAnimationFrame(() => {
        applyHomeTranslations(langKey);
      });
    }

    // Registrar listener inmediatamente (antes de DOMContentLoaded)
    window.addEventListener(
      "ui:languagechange",
      (event) => {
        const lang = event.detail?.language || "ES";
        applyTranslations(lang);
      },
      true,
    );

    // Aplicar traducciones al cargar la página
    function initTranslations() {
      let currentLang = "ES";
      try {
        const stored = localStorage.getItem("ui-language");
        if (stored && (stored === "EN" || stored === "ES")) {
          currentLang = stored;
        }
      } catch (error) {
        console.warn("Unable to access localStorage.", error);
      }
      applyTranslations(currentLang);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        setTimeout(initTranslations, 100);
      });
    } else {
      setTimeout(initTranslations, 100);
    }
  })();
</script>
