<script is:inline>
  (() => {
    const form = document.querySelector(".welcome-input-group");
    const emailInput = document.querySelector(".welcome-input");
    const honeypot = document.querySelector(".welcome-honeypot");
    const message = document.querySelector(".welcome-form-message");
    const modal = document.querySelector("#captcha-modal");
    const closeModal = document.querySelector("#close-captcha");
    let captchaToken = "";
    let isModalOpen = false;
    let widgetId = null;

    const setMessage = (text, isError = false) => {
      if (!message) return;
      message.textContent = text;
      message.style.color = isError ? "#b42318" : "#00223e";
      if (emailInput) {
        emailInput.classList.toggle("is-error", isError);
      }
    };

    const toggleModal = (show) => {
      if (!modal) return;
      isModalOpen = show;
      modal.classList.toggle("is-active", show);
      if (show) {
        document.body.style.overflow = "hidden";

        // Renderizado manual del captcha cuando el modal es visible
        if (typeof turnstile !== "undefined") {
          if (widgetId === null) {
            widgetId = turnstile.render("#turnstile-widget", {
              sitekey: "0x4AAAAAACTr8BCSls7WtvbZ",
              callback: (token) => {
                captchaToken = token;
                const email = emailInput?.value.trim();
                // Si el modal está abierto y tenemos email válido
                if (isModalOpen && email && isValidEmail(email)) {
                  setTimeout(() => {
                    toggleModal(false);
                    submitForm(email);
                  }, 800);
                }
              },
              "expired-callback": () => {
                captchaToken = "";
                if (isModalOpen) {
                  setMessage("El captcha expiró. Inténtalo de nuevo.", true);
                }
              },
            });
          } else {
            turnstile.reset(widgetId);
            captchaToken = "";
          }
        }
      } else {
        document.body.style.overflow = "";
      }
    };

    const isValidEmail = (value) =>
      /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value.trim());

    const submitForm = async (email) => {
      setMessage("Enviando...", false);
      const toAddress = "vicente.narvaez@zwippe.com";
      const payload = {
        to: toAddress,
        subject: "Nueva solicitud de cotización",
        html: `
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f3f4f6;padding:24px 0;font-family:Arial,Helvetica,sans-serif;">
            <tr>
              <td align="center">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;border-radius:14px;overflow:hidden;">
                  <tr>
                    <td align="center" bgcolor="#001c40" style="padding:20px;">
                      <img src="https://rlerklikpjwhzloyqpnk.supabase.co/storage/v1/object/sign/a/header_logo.png?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV9hMGY0YTQzMC00MDRhLTQyM2EtYWM1OS1lNjlhOTA3ZWIyYzEiLCJhbGciOiJIUzI1NiJ9.eyJ1cmwiOiJhL2hlYWRlcl9sb2dvLnBuZyIsImlhdCI6MTc1Nzk1NDcyNSwiZXhwIjoxNzg5NDkwNzI1fQ.F3IDj7sZ9eB2p9ne9MM-PG6FJFWDCR8-8e6lw2yManc"
                        alt="Zelify Logo" width="123" height="35"
                        style="max-width:100%;height:auto;display:block;">
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:28px 32px 10px;color:#0b1d3a;">
                      <h2 style="margin:0 0 12px;font-size:20px;line-height:1.3;">Nueva solicitud desde la página principal</h2>
                      <p style="margin:0 0 16px;font-size:14px;line-height:1.6;color:#334155;">
