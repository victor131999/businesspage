---
import Navbar from "../components/navbar.astro";
import ProductsPanel from "../components/productsPanel.astro";
import "../styles/navbar.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Zelify Page 9 — Matilda AI</title>
  </head>

  <body
    style="
      background-color: #020b18;
      background-image: url('/images/FONDO 12.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      min-height: 100vh;
      margin: 0;
    "
  >
    <Navbar
      logoSrc="/images/zelify_logo.png"
      colors={{
        text: "#004195",
        textHover: "#ffffff",
        highlightBg: "#6AFF00",
        highlightText: "#0b132b",
        btnLightBg: "#E7EDF6",
        btnLightHoverBg: "#DAE4F1",
        btnLightText: "#004195",
        btnOutline: "#E7EDF6",
        btnOutlineHover: "#ffffff",
        dropdownBg: "#ffffff",
        dropdownLink: "#1e2b3a",
        dropdownHoverBg: "#EEF3F9",
        radius: "22px",
      }}
      buttons={{
        first: { label: "Work with us", href: "/" },
        second: { label: "Bank access", href: "/" },
        third: { label: "EN", href: "/" },
      }}
    />
    <ProductsPanel />

    <section class="hero">
      <div class="content">
        <!-- Texto sobre la franja del fondo -->
        <div class="band">
          <span class="band-text">Matilda AI Fintech Core</span>
        </div>

        <h1 class="title">
          AI-Powered<br />
          Financial<br />
          Intelligence.
        </h1>

        <p class="description">
          A central Artificial Intelligence module designed to enhance the user
          financial experience through behavioral analysis, automated education,
          and intelligent support.
        </p>

        <div class="cta">
          <a href="/" class="btn">Let’s talk</a>
          <a href="/" class="btn">View API Docs</a>
        </div>
      </div>
    </section>
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  body {
    font-family:
      "NataSans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    color: #fff;
    overflow-x: hidden;
  }

  .hero {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 6rem 8%;
  }

  /* Contenedor principal */
  .content {
  text-align: right;         /* todo el contenido sigue alineado a la derecha */
  max-width: 560px;
  margin-left: auto;         /* empuja el bloque hacia el borde derecho */
  position: relative;
  top: 70px;                 /* 🔽 mueve todo el bloque hacia abajo */
  right: 200px;               /* ⬅️ mueve todo el bloque hacia la izquierda */
}

  /* Solo texto sobre la franja (sin fondo adicional) */
  .band {
    position: relative;
    top: -10px;
    width: 100%;
    display: flex;
    justify-content: flex-end; /* texto dentro alineado al borde derecho */
    margin-bottom: 1.6rem;
  }

  .band-text {
    color: #0b132b;
    font-weight: 800;
    font-size: 1.05rem;
    background: transparent;
  }

  /* Título alineado al borde derecho */
  .title {
    color: #1f3f86;
    font-weight: 900;
    line-height: 1.1;
    font-size: clamp(2.8rem, 4vw, 3.4rem);
    margin: 1rem 0 1.2rem 0;
    text-align: right; /* fuerza la alineación */
  }

  /* Descripción alineada al borde derecho */
  .description {
    color: #91a4c2;
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 480px;
    text-align: right;
    margin-left: auto; /* empuja el texto a la derecha dentro del bloque */
  }

  /* CTA (botones) también alineados al borde derecho */
  .cta {
    display: flex;
    gap: 0.8rem;
    justify-content: flex-end; /* botones pegados a la derecha */
    flex-wrap: wrap;
  }

  .btn {
    background: #84ff11;
    color: #0b132b;
    text-decoration: none;
    font-weight: 600;
    padding: 0.35rem 1.25rem;
    border-radius: 8px;
    font-size: 0.95rem;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.18);
    transition:
      background-color 0.2s ease,
      transform 0.15s ease;
  }

  .btn:hover {
    background: #9bff4b;
    transform: translateY(-1px);
  }

  /* Responsive */
  @media (max-width: 1000px) {
    .hero {
      justify-content: center;
      padding: 4rem 6%;
    }
    .content {
      transform: none;
      text-align: center;
    }
    .band {
      justify-content: center;
      margin-bottom: 1rem;
    }
    .cta {
      justify-content: center;
    }
  }
</style>
