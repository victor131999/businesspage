        }

        const bankSubtitle = document.querySelector(".wallet-bank-subtitle");
        if (bankSubtitle)
          bankSubtitle.textContent = t.device.wallet.connectedBank;

        // Deposit Screen
        const depositTitle = document.querySelector(".deposit-title");
        if (depositTitle) depositTitle.textContent = t.device.deposit.title;

        const depositSubtitle = document.querySelector(".deposit-subtitle");
        if (depositSubtitle)
          depositSubtitle.textContent = t.device.deposit.subtitle;

        const depositAccountLabel = document.querySelector(
          ".deposit-section-label",
        );
        if (depositAccountLabel)
          depositAccountLabel.textContent = t.device.deposit.accountLabel;

        const amountLabel = document.querySelector(".deposit-amount-label");
        if (amountLabel) amountLabel.textContent = t.device.deposit.amountLabel;

        const amountInput = document.querySelector(".deposit-amount-input");
        if (amountInput)
          amountInput.placeholder = t.device.deposit.amountPlaceholder;

        // Security Section
        const secTitle = document.querySelector(".security-title");
        if (secTitle) secTitle.innerHTML = t.security.title;

        const secFeatures = document.querySelectorAll(".security-feature");
        secFeatures.forEach((el, idx) => {
          if (t.security.features[idx]) {
            el.querySelector(".feature-title").textContent =
              t.security.features[idx].title;
            el.querySelector(".feature-description").textContent =
              t.security.features[idx].desc;
          }
        });

        // Control Section
        const ctrlTitle = document.querySelector(".control-title");
        if (ctrlTitle) ctrlTitle.textContent = t.control.title;

        const ctrlFeatures = document.querySelectorAll(".control-feature");
        ctrlFeatures.forEach((el, idx) => {
          if (t.control.features[idx]) {
            const data = t.control.features[idx];
            el.querySelector(
              ".control-feature-front .control-feature-title",
            ).textContent = data.title;
            el.querySelector(
              ".control-feature-front .control-feature-description",
            ).textContent = data.desc;
            el.querySelector(
              ".control-feature-back .control-feature-title",
            ).textContent = data.backTitle;
            const ul = el.querySelector(".control-feature-benefits");
            ul.innerHTML = data.benefits.map((b) => `<li>${b}</li>`).join("");
          }
        });

        // Contact Section
        const contactTitle = document.querySelector(".contact-title");
        if (contactTitle) contactTitle.innerHTML = t.contact.title;

        const contactFormTitle = document.querySelector(".contact-form-title");
        if (contactFormTitle)
          contactFormTitle.textContent = t.contact.formTitle;

        const contactForm = document.getElementById("contactForm");
        if (contactForm) {
          contactForm.querySelector("#nombres").placeholder =
            t.contact.placeholders.names;
          contactForm.querySelector("#apellidos").placeholder =
            t.contact.placeholders.surnames;
          contactForm.querySelector("#compania").placeholder =
            t.contact.placeholders.company;
          contactForm.querySelector("#email").placeholder =
            t.contact.placeholders.email;
          contactForm.querySelector("#telefono").placeholder =
            t.contact.placeholders.phone;
          const submitBtn = contactForm.querySelector(".contact-submit-btn");
          if (submitBtn) submitBtn.textContent = t.contact.submit;
          const legalText = contactForm.querySelector(".contact-legal");
          if (legalText) legalText.innerHTML = t.contact.legal;

          const countrySelect = contactForm.querySelector("#pais");
          if (countrySelect && countrySelect.options.length > 0) {
            countrySelect.options[0].textContent = t.contact.countryDefault;
          }
        }

        // CTA Section
        const ctaTitle = document.querySelector(".cta-title");
        if (ctaTitle) ctaTitle.innerHTML = t.cta.title;

        const ctaBtn = document.querySelector(".cta-button");
        if (ctaBtn) ctaBtn.textContent = t.cta.button;

        // FAQ Section
        const faqTitle = document.querySelector(".faq-title");
        if (faqTitle) faqTitle.textContent = t.faq.title;

        const faqItems = document.querySelectorAll(".faq-item");
        faqItems.forEach((item, index) => {
          if (t.faq.items[index]) {
            const questionSpan = item.querySelector(".faq-question span");
            const answerP = item.querySelector(".faq-answer p");
            if (questionSpan) questionSpan.textContent = t.faq.items[index].q;
            if (answerP) answerP.textContent = t.faq.items[index].a;
          }
        });

        // Footer
        const footerLinksTitle = document.querySelector(".footer-links-title");
        if (footerLinksTitle)
          footerLinksTitle.textContent = t.footer.quickLinks;

        const footerDisclaimer = document.querySelector(".footer-disclaimer");
        if (footerDisclaimer)
          footerDisclaimer.textContent = t.footer.disclaimer;

        const footerCopyright = document.querySelector(".footer-copyright");
        if (footerCopyright) footerCopyright.textContent = t.footer.copyright;
      }

      // Event Listeners for Language Change
      window.addEventListener("ui:languagechange", (event) => {
        const lang = event.detail?.language || "ES";
        updateConnectContent(lang);
      });

      document.addEventListener("DOMContentLoaded", () => {
        const stored = localStorage.getItem("ui-language");
        const initialLang =
          window.__uiLanguage || stored || detectBrowserLanguage();
        updateConnectContent(initialLang);
      });
    </script>
    <AlaizaAssistant client:load />
  </body>
</html>
