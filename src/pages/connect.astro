    </style>

    <script>
      // @ts-nocheck
      // State
      let currentScreen = "banks"; // banks | credentials | loading | success | wallet | deposit
      let walletBalance = 0;
      let selectedBank = null;
      let selectedBankName = "Banco";

      // DOM Elements
      const screens = {
        banks: document.getElementById("screen-banks"),
        credentials: document.getElementById("screen-credentials"),
        connecting:
          document.getElementById("screen-connecting") /* The new screen */,
        wallet: document.getElementById("screen-wallet"),
        deposit: document.getElementById("screen-deposit"),
      };

      // Helper: Show Screen
      function showScreen(screenId) {
        // Hide all
        Object.values(screens).forEach((el) => {
          if (el) el.style.display = "none";
        });
        // Show target
        if (screens[screenId]) {
          screens[screenId].style.display = "flex"; // or block depending on layout, flex is better for centering
        }
        currentScreen = screenId;
      }

      // --- 1. Banks Screen Logic ---
      const bankItems = document.querySelectorAll(".bank-item");
      const searchInput = document.querySelector(".bank-search-input");

      if (bankItems.length > 0) {
        // Helper to update visual stack
        const updateStack = (activeIndex) => {
          bankItems.forEach((item, index) => {
            if (!(item instanceof HTMLElement)) return;

            // Calculate distance from active
            const distanceFromActive = Math.abs(activeIndex - index);
            // Base z-index logic: closer to active = higher z-index
            const zIndex = 50 - distanceFromActive;

            item.style.zIndex = zIndex.toString();

            if (index === activeIndex) {
              item.classList.add("active");
            } else {
              item.classList.remove("active");
            }
          });
        };

        // Initialize stack (Santander active by default matches design)
        updateStack(1);

        bankItems.forEach((item, index) => {
          item.addEventListener("click", () => {
            updateStack(index);
            selectedBank = item.getAttribute("data-bank");
          });
        });

        if (searchInput instanceof HTMLInputElement) {
          searchInput.addEventListener("input", (e) => {
            if (!(e.target instanceof HTMLInputElement)) return;
            const term = e.target.value.toLowerCase();
            bankItems.forEach((item) => {
              if (!(item instanceof HTMLElement)) return;
              const name =
                item.querySelector(".bank-name")?.textContent?.toLowerCase() ||
                "";
              if (name.includes(term)) item.style.display = "flex";
              else item.style.display = "none";
            });
          });
        }

        document
          .getElementById("btn-continue-banks")
          ?.addEventListener("click", () => {
            // Get active item
            const active = document.querySelector(".bank-item.active");
            if (active) {
              // Get name
              const bankName =
                active.querySelector(".bank-name")?.textContent || "Banco";
              selectedBankName = bankName;
              // Set title on next screen
              const titleEl = document.getElementById("auth-bank-name");
              if (titleEl) titleEl.textContent = bankName;

              showScreen("credentials");
            } else {
              // Fallback
              showScreen("credentials");
            }
          });
      }

      // --- 2. Credentials Screen Logic ---
      const userInput = document.getElementById("cred-username");
      const passInput = document.getElementById("cred-password");
      const submitCredBtn = document.getElementById("btn-submit-credentials");

      function checkCreds() {
        if (
          userInput instanceof HTMLInputElement &&
          passInput instanceof HTMLInputElement &&
          submitCredBtn instanceof HTMLButtonElement
        ) {
          if (userInput.value.length > 0 && passInput.value.length > 0) {
            submitCredBtn.disabled = false;
          } else {
            submitCredBtn.disabled = true;
          }
        }
      }

      userInput?.addEventListener("input", checkCreds);
      passInput?.addEventListener("input", checkCreds);

      // --- 3. Loading Animation Logic (Ported from React) ---
      let animationFrameId;
      let loadingStartTime = null;
      const DURATION = 3000; // 3 seconds total

      function startLoadingFlow({
        titleText,
        subtitleText,
        successTitle,
        successSubtitle,
        onComplete,
      }) {
        showScreen("connecting"); // Shared loading screen
        const fillLayer = document.getElementById("loading-fill-layer");
        const barFill = document.getElementById("loading-bar-fill");
        const contentLoading = document.getElementById("content-loading");
        const contentSuccess = document.getElementById("content-success");

        // Reset states
        if (contentLoading) contentLoading.classList.add("active");
        if (contentSuccess) contentSuccess.classList.remove("active");
        if (fillLayer) {
          fillLayer.style.clipPath = "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)"; // Empty
          const mask = buildMaskGradient(0);
          fillLayer.style.maskImage = mask;
          fillLayer.style.webkitMaskImage = mask;
        }

        wrapChars("loading-text-container", titleText);
        wrapChars("loading-subtext-container", subtitleText);

        loadingStartTime = performance.now();

        function frame(currentTime) {
          const elapsed = currentTime - loadingStartTime;
          let progress = Math.min((elapsed / DURATION) * 100, 100);

          // Update Bar
          if (barFill) barFill.style.width = `${progress}%`;

          // Update Wave / Clip Path
          if (fillLayer) {
            const clipPoly = calculateWavePolygon(progress);
            fillLayer.style.clipPath = clipPoly;
            const mask = buildMaskGradient(progress);
            fillLayer.style.maskImage = mask;
            fillLayer.style.webkitMaskImage = mask;
          }

          // Update Text Colors
          updateTextColors("loading-text-container", progress);
          updateTextColors("loading-subtext-container", progress);

          if (progress < 100) {
            animationFrameId = requestAnimationFrame(frame);
          } else {
            // Complete
            if (fillLayer) {
              fillLayer.style.clipPath =
                "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)";
              fillLayer.style.maskImage = "none";
              fillLayer.style.webkitMaskImage = "none";
            }
            setTimeout(() => {
              if (contentLoading) contentLoading.classList.remove("active");
              if (contentSuccess) contentSuccess.classList.add("active");
              const successTitleEl = document.querySelector(".success-title");
              const successSubtitleEl =
                document.querySelector(".success-subtitle");
              if (successTitleEl) successTitleEl.textContent = successTitle;
              if (successSubtitleEl)
                successSubtitleEl.textContent = successSubtitle;

              setTimeout(() => {
                if (onComplete) onComplete();
              }, 2000);
            }, 500);
          }
        }

        animationFrameId = requestAnimationFrame(frame);
      }

      function startConnectFlow() {
        startLoadingFlow({
          titleText: "Conectando tu cuenta",
          subtitleText: "Espera por favor",
          successTitle: "Vinculación Exitosa",
          successSubtitle: "Tu cuenta bancaria ha sido vinculada exitosamente",
          onComplete: () => {
            const walletBankName = document.getElementById("wallet-bank-name");
            if (walletBankName) walletBankName.textContent = selectedBankName;
            showScreen("wallet");
            updateBalance(2500.5); // Example update
          },
        });
      }

      function wrapChars(elementId, text) {
        const oldEl = document.getElementById(elementId);
        if (!oldEl) return;
        oldEl.innerHTML = "";
        text.split("").forEach((char) => {
          const span = document.createElement("span");
          span.textContent = char === " " ? "\u00A0" : char;
          span.className = "loading-char";
          oldEl.appendChild(span);
        });
      }

      function updateTextColors(elementId, progress) {
        const el = document.getElementById(elementId);
        if (!el) return;
        const spans = el.querySelectorAll("span");
        spans.forEach((span, index) => {
          const charProgress = (index / spans.length) * 100;
          // Logic: if overall progress > this char's position % roughly, it becomes white
          // Adjusting logic to match visual feeling of wave passing
          const isWhite = progress >= charProgress;
          span.style.color = isWhite ? "white" : "#0a203f";
          if (elementId.includes("subtext")) {
            span.style.color = isWhite ? "rgba(255,255,255,0.9)" : "#666";
          }
        });
      }

      function calculateWavePolygon(loadingProgress) {
        // Ported logic
        const progress = loadingProgress + 20; // Lookahead
        let points = `0% 0%, `; // Top Left start? usage in clip-path is tricky.
        // Wait, React clip-path was: polygon(points)
        // Points logic:
        // x changes with progress.
        // React logic:
        // for i 0 to 50:
        // y = (i/50)*100
        // wave = sin(...)
        // x = progress + wave

        // CSS clip-path coords are X% Y%
        // We want to fill from Left to Right?
        // React gradient was "to right".
        // The polygon seems to define the RIGHT edge of the fill.
        // So it should start at Top-Left (0 0), go down to Bottom-Left (0 100), then trace the wave on the right side?
        // Actually let's look at the React points generation:
        // It generates points x% y%.
        // If x is roughly 'progress', then it creates a vertical-ish line moving right.
        // So the polygon should enclose the FILLED area (Left side).

        // Start point: Top Left
        let poly = `0% 0%, `;

        // Wave line (Right edge of the fill)
        for (let i = 0; i <= 50; i++) {
          const y = (i / 50) * 100;
          const distanceFromCenter = Math.abs(y - 50) / 50;
          const delay = distanceFromCenter * 15;
          const adjustedProgress = Math.max(0, progress - delay);

          const wave =
            Math.sin(
              (adjustedProgress / 100) * Math.PI * 5 + (y / 100) * Math.PI * 3,
            ) * 10;

          // Ensure we don't go below 0 or above 100 visual bound if needed,
          // but clip-path handles overflow fine usually.
          // Logic: x increases as progress increases.
          const x = Math.min(
            100,
            Math.max(0, adjustedProgress + (wave / 100) * 12),
          );

          poly += `${x}% ${y}%, `;
        }

        // End point: Bottom Left
        poly += `0% 100%`;

        return `polygon(${poly})`;
      }

      function buildMaskGradient(loadingProgress) {
        const stopA = Math.max(0, loadingProgress - 50);
        const stopB = Math.max(0, loadingProgress - 40);
        const stopC = Math.max(0, loadingProgress - 25);
        const stopD = Math.max(0, loadingProgress - 15);
        return `linear-gradient(to right,
          rgba(0,0,0,1) 0%,
          rgba(0,0,0,1) ${stopA}%,
          rgba(0,0,0,0.9) ${stopB}%,
          rgba(0,0,0,0.6) ${stopC}%,
          rgba(0,0,0,0.3) ${stopD}%,
          rgba(0,0,0,0) ${loadingProgress}%,
          rgba(0,0,0,0) 100%
        )`;
      }

      // Hook up Ingredients Button

      submitCredBtn?.addEventListener("click", () => {
        // showScreen("loading"); // Old flow
        startConnectFlow(); // New flow
      });

      // --- 4. Wallet Logic ---
      function updateBalance(amount) {
        walletBalance = amount;
        const el = document.getElementById("wallet-balance");
        if (el)
          el.textContent = `$${amount.toLocaleString("en-US", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          })}`;
      }

      document
        .getElementById("btn-go-deposit")
        ?.addEventListener("click", () => {
          showScreen("deposit");
        });

      // Deposit account selection
      const depositCards = document.querySelectorAll(".deposit-account-card");
      if (depositCards.length > 0) {
        const setActiveDeposit = (activeIndex) => {
          depositCards.forEach((card, index) => {
            if (!(card instanceof HTMLElement)) return;
            const distance = Math.abs(activeIndex - index);
            card.style.zIndex = (20 - distance).toString();
            if (index === activeIndex) card.classList.add("active");
            else card.classList.remove("active");
          });
        };

        setActiveDeposit(0);
        depositCards.forEach((card, index) => {
          card.addEventListener("click", () => setActiveDeposit(index));
        });
      }

      // --- 5. Deposit & Slider Logic ---
      const slideTrack = document.getElementById("slide-track");
      const slideThumb = document.getElementById("slide-thumb");
      const slideFill = document.getElementById("slide-fill");
      const slideText = document.getElementById("slide-text");
      let isDragging = false;
      let startX = 0;
      let currentX = 0;
      let maxSlide = 0;

      if (slideTrack && slideThumb && slideFill) {
        const getSlideMetrics = () => {
          const trackRect = slideTrack.getBoundingClientRect();
          const thumbWidth = slideThumb.getBoundingClientRect().width;
          maxSlide = Math.max(0, trackRect.width - thumbWidth - 8);
          return { trackRect, thumbWidth };
        };

        const resetSlider = () => {
          slideTrack.classList.remove("success");
          slideThumb.style.transition = "transform 0.3s ease";
          slideFill.style.transition = "width 0.3s ease";
          slideThumb.style.transform = `translateX(0px)`;
          slideFill.style.width = `0px`;
          currentX = 0;
          if (slideText) slideText.textContent = "Desliza para confirmar";
        };

        const startDrag = (e) => {
          isDragging = true;
          const { trackRect } = getSlideMetrics();
          startX =
            (e.type === "touchstart" ? e.touches[0].clientX : e.clientX) -
            currentX -
            trackRect.left;
          slideThumb.style.transition = "none";
          slideFill.style.transition = "none";
        };

        const moveDrag = (e) => {
          if (!isDragging) return;
          e.preventDefault(); // Prevent scroll on mobile

          const clientX =
            e.type === "touchmove" ? e.touches[0].clientX : e.clientX;
          const { trackRect, thumbWidth } = getSlideMetrics();
          let x = clientX - trackRect.left - startX;

          if (x < 0) x = 0;
          if (x > maxSlide) x = maxSlide;

          currentX = x;
          slideThumb.style.transform = `translateX(${x}px)`;
          slideFill.style.width = `${x + thumbWidth / 2}px`;

          // Check completion (90% threshold)
          if (x > maxSlide * 0.9) {
            completeSlide();
          }
        };

        const endDrag = () => {
          if (!isDragging) return;
          isDragging = false;

          // If not completed, snap back
          if (currentX <= maxSlide * 0.9) {
            resetSlider();
          }
        };

        const completeSlide = () => {
          isDragging = false;
          slideTrack.classList.add("success");
          if (slideText) slideText.textContent = "Confirmando...";
          // Simulate processing
          setTimeout(() => {
            startLoadingFlow({
              titleText: "Transfiriendo fondos",
              subtitleText: "Espera por favor",
              successTitle: "Transferencia Exitosa",
              successSubtitle: "Los fondos han sido acreditados",
              onComplete: () => {
                showScreen("wallet");
                updateBalance(walletBalance + 500); // Simulate adding amount

                // Reset slider for next time
                resetSlider();
              },
            });
          }, 500);
        };

        slideTrack.addEventListener("mousedown", startDrag);
        slideTrack.addEventListener("touchstart", startDrag, {
          passive: false,
        });

        document.addEventListener("mousemove", moveDrag);
        document.addEventListener("touchmove", moveDrag, { passive: false });

        document.addEventListener("mouseup", endDrag);
        document.addEventListener("touchend", endDrag);

        window.addEventListener("resize", () => {
          getSlideMetrics();
          resetSlider();
        });

        // Ensure slider starts clean when entering deposit screen
        document
          .getElementById("btn-go-deposit")
          ?.addEventListener("click", () => {
            resetSlider();
          });
      }

