---
/**
 * About us — Página institucional. Sistema de diseño, espaciado uniforme, ES/EN.
 */
import "../styles/navbar.css";
import "../components/design-system/tokens.css";
import Navbar3 from "../components/NavbarSimple.astro";
import ProductsPanel from "../components/productsPanel.astro";
import Footer from "../components/design-system/organisms/Footer.astro";
import Title from "../components/design-system/atoms/Title.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png" />
    <title>Nosotros — Zelify</title>
  </head>
  <body class="about-page">
    <Navbar3 />
    <ProductsPanel />

    <main class="about-main">
      <section class="about-hero">
        <div class="about-hero__inner">
          <Title level={1} variant="hero" class="about-title" id="about-hero-title">Nosotros</Title>
          <p class="about-lead" id="about-hero-lead">Construimos la infraestructura que impulsa los productos financieros modernos.</p>
        </div>
      </section>

      <section class="about-content ds-content">
        <div class="about-content__inner">
          <Title level={2} variant="section" class="about-content__heading" data-about-section-1-title>Nuestra misión</Title>
          <p class="about-body" data-about-section-1-p1>
            Zelify digitaliza servicios a instituciones financieras reguladas en latinoamérica, construye tu stack neobancario con una sola línea de código; lo que significa romper con los modelos tradicionales que han limitado el acceso al sistema financiero.
          </p>
          <p class="about-body" data-about-section-1-p2>
            Buscamos potenciar las instituciones financieras con inteligencia artificial accesible, democratizar los servicios financieros y simplificar las finanzas.
          </p>

          <Title level={2} variant="section" class="about-content__heading" data-about-section-2-title>Quiénes somos</Title>
          <p class="about-body" data-about-section-2-p1>
            Zelify integra en una sola plataforma digital: autenticación y validación de identidad, cumplimiento AML, digitalización de cuentas, emisión y procesamiento de tarjetas, transferencias locales e internacionales, pagos múltiples, programas de descuentos y cupones.
          </p>
          <p class="about-body" data-about-section-2-p2>
            Identificamos las necesidades de digitalización financiera y activamos los productos requeridos en una sola implementación a través de un onboarding simple y sin fricción.
          </p>
          <p class="about-body" data-about-section-2-p3>
            Potenciados por IA, operamos como un stack tecnológico neobancario con modelos entrenados para el sector financiero. Desde el monitoreo continuo hasta la optimización operativa, la IA es el núcleo con el cual revolucionamos los servicios financieros.
          </p>
          <p class="about-body" data-about-section-2-p4>
            Dividimos los servicios individualizados que se entregan en APIs o SDKs que facilitan una rápida integración sobre las tecnologías de nuestros clientes.
          </p>

          <Title level={2} variant="section" class="about-content__heading" data-about-section-3-title>Beneficios clave</Title>
          <ul class="about-benefits" aria-label="Beneficios clave">
            <li class="about-benefits__item" data-about-benefit="1">Paga solo lo que usas y escala sin fricción con los precios más bajos del mercado.</li>
            <li class="about-benefits__item" data-about-benefit="2">Una sola integración, un solo proveedor de múltiples servicios.</li>
            <li class="about-benefits__item" data-about-benefit="3">De diseño a producción con una sola línea de integración.</li>
            <li class="about-benefits__item" data-about-benefit="4">Distintos mecanismos de entrega de servicios como SDKs o APIs.</li>
            <li class="about-benefits__item" data-about-benefit="5">Servicios diseñados para que nuestros clientes moneticen y generen un retorno de inversión.</li>
            <li class="about-benefits__item" data-about-benefit="6">Time to market reducido.</li>
          </ul>
        </div>
      </section>
    </main>

    <Footer
      quickLinksTitle="Quick links"
      links={[
        { href: "", label: "Products", key: "products", dataI18n: "footer.products" },
        { href: "https://docs.zelify.com", label: "Developers", key: "developers", dataI18n: "footer.developers", openInNewTab: true },
        { href: "/blog", label: "Blog", key: "blog", dataI18n: "footer.blog" },
        { href: "/jobs", label: "Work with us", key: "workWithUs", dataI18n: "footer.workWithUs" },
        { href: "/about", label: "About us", key: "aboutUs", dataI18n: "footer.aboutUs" },
        { href: "/privacy", label: "Privacy policy", key: "privacyPolicy", dataI18n: "footer.privacyPolicy" },
      ]}
      legalText="Zelify is a technology platform currently in a development phase, not yet deployed or operational, and does not provide or process financial services directly; all financial operations are conducted exclusively through regulated third-party partners."
      copyrightText="© 2025 Zelify. All rights reserved."
      dataI18n={{ legal: "footer.legal", copyright: "footer.copyright" }}
    />
  </body>
</html>

<script>
  const ABOUT_T = {
    es: {
      heroTitle: "Nosotros",
      heroLead: "Construimos la infraestructura que impulsa los productos financieros modernos.",
      section1Title: "Nuestra misión",
      section1P1: "Zelify digitaliza servicios a instituciones financieras reguladas en latinoamérica, construye tu stack neobancario con una sola línea de código; lo que significa romper con los modelos tradicionales que han limitado el acceso al sistema financiero.",
      section1P2: "Buscamos potenciar las instituciones financieras con inteligencia artificial accesible, democratizar los servicios financieros y simplificar las finanzas.",
      section2Title: "Quiénes somos",
      section2P1: "Zelify integra en una sola plataforma digital: autenticación y validación de identidad, cumplimiento AML, digitalización de cuentas, emisión y procesamiento de tarjetas, transferencias locales e internacionales, pagos múltiples, programas de descuentos y cupones.",
      section2P2: "Identificamos las necesidades de digitalización financiera y activamos los productos requeridos en una sola implementación a través de un onboarding simple y sin fricción.",
      section2P3: "Potenciados por IA, operamos como un stack tecnológico neobancario con modelos entrenados para el sector financiero. Desde el monitoreo continuo hasta la optimización operativa, la IA es el núcleo con el cual revolucionamos los servicios financieros.",
      section2P4: "Dividimos los servicios individualizados que se entregan en APIs o SDKs que facilitan una rápida integración sobre las tecnologías de nuestros clientes.",
      section3Title: "Beneficios clave",
      benefit1: "Paga solo lo que usas y escala sin fricción con los precios más bajos del mercado.",
      benefit2: "Una sola integración, un solo proveedor de múltiples servicios.",
      benefit3: "De diseño a producción con una sola línea de integración.",
      benefit4: "Distintos mecanismos de entrega de servicios como SDKs o APIs.",
      benefit5: "Servicios diseñados para que nuestros clientes moneticen y generen un retorno de inversión.",
      benefit6: "Time to market reducido.",
    },
    en: {
      heroTitle: "About us",
      heroLead: "We build the infrastructure that powers modern financial products.",
      section1Title: "Our mission",
      section1P1: "Zelify digitizes services for regulated financial institutions in Latin America—build your neobanking stack with a single line of code; breaking away from traditional models that have limited access to the financial system.",
      section1P2: "We aim to empower financial institutions with accessible artificial intelligence, democratize financial services, and simplify finance.",
      section2Title: "Who we are",
      section2P1: "Zelify integrates into a single digital platform: authentication and identity verification, AML compliance, account digitization, card issuance and processing, local and international transfers, multiple payment methods, and discount and coupon programs.",
      section2P2: "We identify financial digitalization needs and activate the required products in a single implementation through a simple, frictionless onboarding.",
      section2P3: "Powered by AI, we operate as a neobanking technology stack with models trained for the financial sector. From continuous monitoring to operational optimization, AI is the core with which we are revolutionizing financial services.",
      section2P4: "We deliver individualized services through APIs or SDKs that enable rapid integration with our clients' technologies.",
      section3Title: "Key benefits",
      benefit1: "Pay only for what you use and scale without friction with the lowest market prices.",
      benefit2: "One integration, one provider for multiple services.",
      benefit3: "From design to production with a single integration line.",
      benefit4: "Different service delivery mechanisms such as SDKs or APIs.",
      benefit5: "Services designed so our clients can monetize and generate a return on investment.",
      benefit6: "Reduced time to market.",
    },
  };
  function getLang() {
    try {
      const stored = localStorage.getItem("ui-language");
      return (stored && stored.toUpperCase() === "ES") ? "es" : "en";
    } catch { return "en"; }
  }
  function applyAboutTranslations(lang: string) {
    const t = (ABOUT_T as Record<string, typeof ABOUT_T.en>)[lang] || ABOUT_T.en;
    const set = (sel: string, text: string) => {
      const el = document.querySelector(sel);
      if (el) el.textContent = text;
    };
    const titleEl = document.getElementById("about-hero-title");
    const leadEl = document.getElementById("about-hero-lead");
    if (titleEl) titleEl.textContent = t.heroTitle;
    if (leadEl) leadEl.textContent = t.heroLead;
    set("[data-about-section-1-title]", t.section1Title);
    set("[data-about-section-1-p1]", t.section1P1);
    set("[data-about-section-1-p2]", t.section1P2);
    set("[data-about-section-2-title]", t.section2Title);
    set("[data-about-section-2-p1]", t.section2P1);
    set("[data-about-section-2-p2]", t.section2P2);
    set("[data-about-section-2-p3]", t.section2P3);
    set("[data-about-section-2-p4]", t.section2P4);
    set("[data-about-section-3-title]", t.section3Title);
    for (let i = 1; i <= 6; i++) {
      set(`[data-about-benefit="${i}"]`, (t as Record<string, string>)[`benefit${i}`] || "");
    }
    const list = document.querySelector(".about-benefits");
    if (list) list.setAttribute("aria-label", lang === "es" ? "Beneficios clave" : "Key benefits");
    document.documentElement.lang = lang === "es" ? "es" : "en";
  }
  if (typeof document !== "undefined") {
    document.addEventListener("DOMContentLoaded", () => applyAboutTranslations(getLang()));
    window.addEventListener("ui:languagechange", (e: Event) => {
      const d = (e as CustomEvent<{ language?: string }>).detail?.language;
      const next = d ? (d.toUpperCase() === "ES" ? "es" : "en") : getLang();
      applyAboutTranslations(next);
    });
  }
</script>

<style>
  /* --- Espaciado coherente y uniforme (mismo criterio que privacy) --- */
  .about-page {
    font-family: var(--ds-font-family);
    color: var(--ds-color-text);
    background: var(--ds-color-bg);
    margin: 0;
    min-height: 100vh;
  }

  .about-main {
    padding-top: var(--ds-space-16);
    padding-bottom: var(--ds-section-gap-md);
  }

  .about-hero {
    padding: var(--ds-space-12) var(--ds-space-8) var(--ds-space-12);
    text-align: center;
    background: var(--ds-color-bg-subtle);
  }
  .about-hero__inner {
    max-width: 800px;
    margin: 0 auto;
  }
  .about-title {
    color: var(--ds-color-primary);
    margin: 0 0 var(--ds-space-4);
  }
  .about-lead {
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    color: var(--ds-color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .about-content {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--ds-space-8);
  }
  .about-content__inner {
    padding: var(--ds-space-12) 0 var(--ds-space-16);
  }

  .about-content__heading {
    color: var(--ds-color-primary);
    margin: var(--ds-space-12) 0 var(--ds-space-5);
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
  }
  .about-content__heading:first-of-type {
    margin-top: 0;
  }

  .about-body {
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.65;
    color: var(--ds-color-text);
    margin: 0 0 var(--ds-space-6);
  }

  .about-benefits {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--ds-space-6);
  }
  .about-benefits__item {
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.65;
    color: var(--ds-color-text);
    margin: 0 0 var(--ds-space-3);
    padding-left: 1.5rem;
    position: relative;
  }
  .about-benefits__item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.4em;
    height: 0.4em;
    background: var(--ds-color-primary);
    border-radius: 50%;
  }

  @media (max-width: 639px) {
    .about-main {
      padding-top: var(--ds-space-12);
    }
    .about-hero,
    .about-content {
      padding-left: var(--ds-space-4);
      padding-right: var(--ds-space-4);
    }
    .about-content__inner {
      padding-top: var(--ds-space-10);
      padding-bottom: var(--ds-space-12);
    }
  }
</style>
