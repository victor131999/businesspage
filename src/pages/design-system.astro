---
/**
 * Documentación del Sistema de Diseño
 * Ruta: /design-system
 * Layout: sidebar izquierdo (nav) + contenido central + "On this page" derecho
 */
import Layout from "../layouts/Layout.astro";
import Button from "../components/design-system/atoms/Button.astro";
import "../components/design-system/tokens.css";

// Atoms
import Input from "../components/design-system/atoms/Input.astro";
import Title from "../components/design-system/atoms/Title.astro";
import Text from "../components/design-system/atoms/Text.astro";
import IconButton from "../components/design-system/atoms/IconButton.astro";
import Divider from "../components/design-system/atoms/Divider.astro";

// Molecules
import EmailQuoteForm from "../components/design-system/molecules/EmailQuoteForm.astro";
import CtaGroup from "../components/design-system/molecules/CtaGroup.astro";
import LoginFormCard from "../components/design-system/molecules/LoginFormCard.astro";
import Modal from "../components/design-system/molecules/Modal.astro";
import TabList from "../components/design-system/molecules/TabList.astro";
import UnderlineTabs from "../components/design-system/molecules/UnderlineTabs.astro";
import HighlightPanel from "../components/design-system/molecules/HighlightPanel.astro";
import ComponentShowcase from "../components/design-system/molecules/ComponentShowcase.astro";

// Organisms
import WelcomeHero from "../components/design-system/organisms/WelcomeHero.astro";
import QuoteModalHubSpot from "../components/design-system/organisms/QuoteModalHubSpot.astro";
import SectionTwoCol from "../components/design-system/organisms/SectionTwoCol.astro";
import CardTabs from "../components/design-system/organisms/CardTabs.astro";

const navSections = [
  { id: "overview", label: "Resumen", active: true },
  { id: "phone-frame", label: "Marco iPhone", expandable: false },
  { id: "atomic-design", label: "Atomic Design", expandable: false },
  { id: "breakpoints", label: "Breakpoints", expandable: false },
  { id: "tokens", label: "Design tokens", expandable: false },
  {
    id: "atoms",
    label: "Átomos",
    expandable: true,
    sub: ["Buttons", "Input", "Title", "Text", "IconButton", "Divider"],
  },
  {
    id: "molecules",
    label: "Moléculas",
    expandable: true,
    sub: [
      "EmailQuoteForm",
      "CtaGroup",
      "LoginFormCard",
      "Modal",
      "TabList",
      "UnderlineTabs",
    ],
  },
  {
    id: "organisms",
    label: "Organismos",
    expandable: true,
    sub: ["WelcomeHero", "QuoteModalHubSpot", "SectionTwoCol", "CardTabs"],
  },
  { id: "icons", label: "Iconos (SVG)", expandable: false },
  { id: "usage", label: "Uso en home", expandable: false },
];
---

<Layout
  title="Design System — Zelify"
  description="Documentación del design system: Atomic Design, tokens y marco iPhone"
>
  <div class="ds-page">
    <aside class="ds-sidebar" aria-label="Navegación del design system">
      <div class="ds-sidebar__header">
        <span class="ds-sidebar__title">Design System</span>
      </div>
      <nav class="ds-sidebar__nav">
        {
          navSections.map((item) => (
            <div class="ds-sidebar__group">
              <a
                href={`#${item.id}`}
                class:list={[
                  "ds-sidebar__link",
                  item.active && "ds-sidebar__link--active",
                ]}
                data-section={item.id}
              >
                {item.label}
              </a>
              {item.expandable && (
                <span class="ds-sidebar__chevron" aria-hidden="true">
                  ▼
                </span>
              )}
            </div>
          ))
        }
      </nav>
    </aside>

    <main class="ds-main">
      <div class="ds-main__inner">
        <header id="overview" class="ds-hero">
          <h1 class="ds-hero__title">Design System Zelify</h1>
          <p class="ds-hero__lead">
            Atomic Design, tokens, componentes y marco tipo iPhone del product
            showcase. Cada componente incluye ejemplo de código de uso.
          </p>
        </header>

        <section id="phone-frame" class="ds-section">
          <h2 class="ds-section__title">Marco iPhone (Product Showcase)</h2>
          <p class="ds-section__p">
            En la home, la demo del producto (Auth, Identity, AML, etc.) está
            dentro de un <strong>marco tipo iPhone</strong>: bezel oscuro,
            pantalla blanca, Dynamic Island, barra de estado (hora, señal,
            batería) y home indicator. El botón play/pause queda <strong
              >fuera del dispositivo</strong
            >, esquina inferior derecha.
          </p>
          <p class="ds-section__p">
            <strong>Ubicación:</strong>
            <code>src/pages/index.astro</code> — <code
              >.product-showcase__phone-frame</code
            >, <code>.phone-frame__screen</code>, <code
              >.phone-frame__status-bar</code
            >, <code>.phone-frame__dynamic-island</code>, <code
              >.phone-frame__home-indicator</code
            >.
          </p>
          <div class="ds-section__block">
            <h3 class="ds-section__subtitle">
              Dimensiones (ajustables en código)
            </h3>
            <table class="ds-table">
              <thead>
                <tr><th>Qué</th><th>Valor actual</th></tr>
              </thead>
              <tbody>
                <tr
                  ><td>Ancho</td><td><code>clamp(260px, 25vw, 350px)</code></td
                  ></tr
                >
                <tr><td>Alto</td><td><code>680px</code></td></tr>
                <tr><td>Grosor bezel</td><td><code>padding: 5px</code></td></tr>
                <tr><td>Dynamic Island</td><td>126px × 28px</td></tr>
                <tr
                  ><td>Botón play</td><td
                    ><code>bottom: -20px; right: -20px</code></td
                  ></tr
                >
              </tbody>
            </table>
          </div>
        </section>

        <section id="atomic-design" class="ds-section">
          <h2 class="ds-section__title">Atomic Design</h2>
          <p class="ds-section__p">
            Tres niveles en <code>src/components/design-system/</code>: <strong
              >Átomos</strong
            > (botones, inputs, texto, iconos), <strong>Moléculas</strong> (formularios,
            CTA group, modal, tabs), <strong>Organismos</strong> (WelcomeHero, QuoteModalHubSpot,
            SectionTwoCol).
          </p>
        </section>

        <section id="breakpoints" class="ds-section">
          <h2 class="ds-section__title">Breakpoints</h2>
          <p class="ds-section__p">
            xs 0–479px · sm 480–639px · md 640–767px · lg 768–1023px · xl
            1024–1199px · 2xl 1200px+
          </p>
        </section>

        <section id="tokens" class="ds-section">
          <h2 class="ds-section__title">Design tokens</h2>
          <p class="ds-section__p">
            <code>src/components/design-system/tokens.css</code>: colores
            (--ds-color-primary, --ds-color-accent), tipografía, espaciado,
            radios, sombras. Uso: <code>var(--ds-color-primary)</code>, <code
              >var(--ds-radius-md)</code
            >.
          </p>
        </section>

        <section id="atoms" class="ds-section">
          <h2 class="ds-section__title">Átomos</h2>
          <p class="ds-section__p">
            Ubicación: <code>src/components/design-system/atoms/</code>
          </p>

          <div id="atoms-buttons" class="ds-section__block">
            <ComponentShowcase
              title="Buttons"
              description="Variantes: primary, secondary, ghost, outline. Tamaños: sm, md, lg."
              code={`<Button variant="primary">Primary</Button>
<Button variant="secondary">Secondary</Button>
<Button variant="outline">Outline</Button>
<Button variant="ghost">Ghost</Button>
<Button variant="primary" size="sm">Small</Button>`}
            >
              <div class="ds-preview__col">
                <div class="ds-preview__row">
                  <Button variant="primary">Primary</Button>
                  <Button variant="secondary">Secondary</Button>
                  <Button variant="outline">Outline</Button>
                  <Button variant="ghost">Ghost</Button>
                </div>
                <br />
                <div class="ds-preview__row">
                  <Button variant="primary" size="sm">Small</Button>
                  <Button variant="primary" size="md">Medium</Button>
                  <Button variant="primary" size="lg">Large</Button>
                </div>
              </div>
            </ComponentShowcase>
          </div>

          <div id="atoms-input" class="ds-section__block">
            <ComponentShowcase
              title="Input"
              description="Campos de texto con diferentes estados."
              code={`<Input name="demo-text" placeholder="Text input" />
<Input name="demo-email" type="email" value="user@example.com" />
<Input name="demo-error" placeholder="Error" invalid={true} />`}
            >
              <div class="ds-preview__col">
                <Input name="demo-text" placeholder="Text input placeholder" />
                <div style="height: 1rem;"></div>
                <Input
                  name="demo-email"
                  type="email"
                  placeholder="Email input"
                  value="user@example.com"
                />
                <div style="height: 1rem;"></div>
                <Input
                  name="demo-error"
                  placeholder="Error state"
                  invalid={true}
                />
              </div>
            </ComponentShowcase>
          </div>

          <div id="atoms-title" class="ds-section__block">
            <ComponentShowcase
              title="Title"
              description="Encabezados con level (1|2|3) y variant (hero, section, card)."
              code={`<Title level={1} variant="hero">Hero Title (h1)</Title>
<Title level={2} variant="section">Section Title (h2)</Title>
<Title level={3} variant="card">Card Title (h3)</Title>`}
            >
              <div class="ds-preview__col">
                <Title level={1} variant="hero">Hero Title (h1)</Title>
                <Title level={2} variant="section">Section Title (h2)</Title>
                <Title level={3} variant="card">Card Title (h3)</Title>
              </div>
            </ComponentShowcase>
          </div>

          <div id="atoms-text" class="ds-section__block">
            <ComponentShowcase
              title="Text"
              description="Cuerpo de texto: variant body, subtitle, caption, muted."
              code={`<Text variant="body">Body text.</Text>
<Text variant="subtitle">Subtitle or lead.</Text>
<Text variant="caption">Caption or metadata.</Text>
<Text variant="muted">Muted text.</Text>`}
            >
              <div class="ds-preview__col">
                <Text variant="body"
                  >Body: The quick brown fox jumps over the lazy dog.</Text
                >
                <Text variant="subtitle"
                  >Subtitle: A brief description or lead.</Text
                >
                <Text variant="caption">Caption: Small text for details.</Text>
                <Text variant="muted">Muted: Less prominent text.</Text>
              </div>
            </ComponentShowcase>
          </div>

          <div id="atoms-icon-button" class="ds-section__block">
            <ComponentShowcase
              title="IconButton"
              description="Botón circular para iconos. Slot: SVG (recomendado 24×24)."
              code={`<IconButton ariaLabel="Play">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
    <path d="M8 5v14l11-7z"/>
  </svg>
</IconButton>`}
            >
              <div class="ds-preview__row">
                <IconButton ariaLabel="Play">
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="currentColor"><path d="M8 5v14l11-7z"></path></svg
                  >
                </IconButton>
                <IconButton ariaLabel="Settings">
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><path d="M12 15a3 3 0 100-6 3 3 0 000 6z"></path><path
                      d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"
                    ></path></svg
                  >
                </IconButton>
              </div>
            </ComponentShowcase>
          </div>

          <div id="atoms-divider" class="ds-section__block">
            <ComponentShowcase
              title="Divider"
              description="Línea separadora horizontal o vertical."
              code={`<Divider />
<Divider vertical={true} />`}
            >
              <div class="ds-preview__col" style="padding: 1rem 0;">
                <p>Content above</p>
                <Divider />
                <p>Content below</p>
                <div
                  style="display: flex; height: 50px; align-items: center; gap: 1rem; margin-top: 1rem;"
                >
                  <span>Left</span>
                  <Divider vertical={true} />
                  <span>Right</span>
                </div>
              </div>
            </ComponentShowcase>
          </div>
        </section>

        <section id="molecules" class="ds-section">
          <h2 class="ds-section__title">Moléculas</h2>
          <p class="ds-section__p">
            Ubicación: <code>src/components/design-system/molecules/</code>
          </p>
          <h3 class="ds-section__subtitle">EmailQuoteForm & CtaGroup</h3>
          <p class="ds-section__p">
            Formulario de captura de correo y grupo de llamada a la acción.
          </p>
          <div class="ds-preview" style="background: #f8f9fa;">
            <CtaGroup>
              <EmailQuoteForm buttonLabel="Let's talk" />
            </CtaGroup>

            <div id="molecules-email-quote" class="ds-section__block">
              <ComponentShowcase
                title="EmailQuoteForm & CtaGroup"
                description="Formulario de captura de correo dentro de un grupo CTA."
                code={`<CtaGroup>
  <EmailQuoteForm />
</CtaGroup>`}
              >
                <div
                  style="background: #f8f9fa; padding: 1rem; border-radius: 8px;"
                >
                  <CtaGroup>
                    <EmailQuoteForm />
                  </CtaGroup>
                </div>
              </ComponentShowcase>
            </div>

            <div id="molecules-login-form" class="ds-section__block">
              <ComponentShowcase
                title="LoginFormCard"
                description="Tarjeta con título, subtítulo, campos email/password y botón."
                code={`<LoginFormCard
  title="Iniciar Sesión"
  subtitle="Accede a tu cuenta"
  submitLabel="Ingresa"
  createAccountText="O crea una nueva cuenta"
/>`}
              >
                <div style="max-width: 400px; margin: 0 auto;">
                  <LoginFormCard
                    title="Iniciar Sesión"
                    subtitle="Accede a tu cuenta"
                  />
                </div>
              </ComponentShowcase>
            </div>

            <div id="molecules-modal" class="ds-section__block">
              <ComponentShowcase
                title="Modal"
                description="Ventana modal con overlay y botón cerrar. Requiere JS para toggle is-active."
                code={`<button id="open-demo-modal">Abrir</button>
<Modal id="demo-modal" ariaLabel="Demo" closeAriaLabel="Cerrar">
  <div>Contenido del modal. Cerrar con X o overlay.</div>
</Modal>`}
              >
                <div>
                  <button
                    id="open-demo-modal"
                    class="ds-button ds-button--primary"
                    >Abrir Modal Demo</button
                  >
                  <Modal
                    id="demo-modal"
                    ariaLabel="Demo Modal"
                    closeAriaLabel="Cerrar modal"
                  >
                    <div style="text-align: center;">
                      <Title level={2} variant="card">Hola desde el Modal</Title
                      >
                      <p
                        style="color: var(--ds-color-text-muted); margin: 1rem 0;"
                      >
                        Este es un componente modal reutilizable.
                      </p>
                      <div style="margin-top: 1.5rem;">
                        <button
                          class="ds-button ds-button--secondary"
                          onclick="document.getElementById('close-demo-modal').click()"
                          >Entendido</button
                        >
                      </div>
                    </div>
                  </Modal>
                </div>
              </ComponentShowcase>
            </div>

            <div id="molecules-tab-list" class="ds-section__block">
              <ComponentShowcase
                title="TabList"
                description="Lista de pestañas tipo botón (pill)."
                code={`<TabList
  tabs={[
    { value: "tab1", label: "Pestaña 1", active: true },
    { value: "tab2", label: "Pestaña 2" }
  ]}
  dataAttr="data-demo-tab"
/>`}
              >
                <div>
                  <TabList
                    tabs={[
                      { value: "tab1", label: "Pestaña 1", active: true },
                      { value: "tab2", label: "Pestaña 2" },
                      { value: "tab3", label: "Pestaña 3" },
                    ]}
                    dataAttr="data-demo-tab"
                  />
                  <div
                    style="margin-top: 1rem; padding: 1rem; border: 1px dashed #ccc; border-radius: 8px;"
                  >
                    <div class="demo-tab-content" data-tab="tab1">
                      Contenido de Pestaña 1
                    </div>
                    <div
                      class="demo-tab-content"
                      data-tab="tab2"
                      style="display: none;"
                    >
                      Contenido de Pestaña 2
                    </div>
                    <div
                      class="demo-tab-content"
                      data-tab="tab3"
                      style="display: none;"
                    >
                      Contenido de Pestaña 3
                    </div>
                  </div>
                </div>
              </ComponentShowcase>
            </div>

            <div id="molecules-underline-tabs" class="ds-section__block">
              <ComponentShowcase
                title="UnderlineTabs"
                description="Pestañas minimalistas con borde inferior."
                code={`<UnderlineTabs
  name="demo-underline"
  tabs={[
    { value: "u1", label: "Bench 1", active: true },
    { value: "u2", label: "Bench 2" }
  ]}
/>`}
              >
                <div>
                  <UnderlineTabs
                    name="demo-underline"
                    tabs={[
                      { value: "u1", label: "Bench 1", active: true },
                      { value: "u2", label: "Bench 2" },
                      { value: "u3", label: "Bench 3" },
                      { value: "u4", label: "Bench 4" },
                    ]}
                  />
                  <div style="margin-top: 1rem; padding: 1rem;">
                    <div class="demo-underline-content" data-content="u1">
                      Panel 1
                    </div>
                    <div
                      class="demo-underline-content"
                      data-content="u2"
                      style="display: none;"
                    >
                      Panel 2
                    </div>
                    <div
                      class="demo-underline-content"
                      data-content="u3"
                      style="display: none;"
                    >
                      Panel 3
                    </div>
                    <div
                      class="demo-underline-content"
                      data-content="u4"
                      style="display: none;"
                    >
                      Panel 4
                    </div>
                  </div>
                </div>
              </ComponentShowcase>
            </div>
          </div>

          <section id="organisms" class="ds-section">
            <h2 class="ds-section__title">Organismos</h2>
            <p class="ds-section__p">
              Ubicación: <code>src/components/design-system/organisms/</code>
            </p>

            <div id="organisms-welcome-hero" class="ds-section__block">
              <ComponentShowcase
                title="WelcomeHero"
                description="Hero section principal del product showcase. (Visual reducido por escala)"
                code={`<WelcomeHero />`}
              >
                <div
                  style="position: relative; overflow: hidden; height: 520px; border: 1px solid #eee; border-radius: 8px;"
                >
                  <div
                    style="transform: scale(0.75); transform-origin: top center; width: 100%;"
                  >
                    <WelcomeHero />
                  </div>
                </div>
              </ComponentShowcase>
            </div>

            <div id="organisms-section-two-col" class="ds-section__block">
              <ComponentShowcase
                title="SectionTwoCol"
                description="Sección de dos columnas con divider opcional, replicando la sección 'Cómo Funciona'."
                code={`<SectionTwoCol divider={true} sectionClass="my-section">
  <div slot="left">
    <Title level={2} variant="hero">¿Cómo Funciona?</Title>
    <Text variant="body">Descripción del funcionamiento...</Text>
    <Button variant="secondary">Demo</Button>
  </div>
  <div slot="right">
    <div class="right-bg-panel-demo">
       <LoginFormCard ... />
       <IconButton ... />
    </div>
  </div>
</SectionTwoCol>`}
              >
                <div style="padding: 0; border: 1px solid #eee;">
                  <SectionTwoCol divider={true}>
                    <div
                      slot="left"
                      style="display: flex; flex-direction: column; gap: 1rem; align-items: flex-start;"
                    >
                      <Title
                        level={2}
                        variant="hero"
                        style="font-size: 3rem; line-height: 1.1;"
                      >
                        ¿Cómo <br /> Funciona <br /> Zelify?
                      </Title>
                      <Text
                        variant="body"
                        style="max-width: 440px; margin-top: 1rem;"
                      >
                        Zelify integra en una sola plataforma digital:
                        autenticación y validación de identidad, cumplimiento
                        AML, digitalización de cuentas, emisión y procesamiento
                        de tarjetas.
                      </Text>
                      <div style="margin-top: 1rem;">
                        <Button variant="secondary">Demo</Button>
                      </div>
                    </div>
                    <div
                      slot="right"
                      style="display: flex; justify-content: flex-end;"
                    >
                      <HighlightPanel>
                        <LoginFormCard
                          title="Ingreso"
                          subtitle="Bienvenido de regreso"
                          submitLabel="Ingresa"
                          createAccountText="O crea una nueva cuenta"
                        />
                        <IconButton ariaLabel="Reproducir" slot="action">
                          <img
                            src="/icons/play.svg"
                            alt=""
                            width="32"
                            height="32"
                          />
                        </IconButton>
                      </HighlightPanel>
                    </div>
                  </SectionTwoCol>
                </div>
              </ComponentShowcase>
              <!-- Removed inline style block as it is now handled by HighlightPanel -->
            </div>

            <div id="organisms-card-tabs" class="ds-section__block">
              <ComponentShowcase
                title="CardTabs"
                description="Organismo que combina TabList con páneles de contenido."
                code={`<CardTabs
  id="demo-card-tabs"
  tabs={[
    { value: "c1", label: "Borderless", active: true },
    { value: "c2", label: "Bench 2" }
  ]}
>
  <div class="demo-card-content" data-card-content="c1">
     <!-- Contenido 1 -->
  </div>
  <div class="demo-card-content" data-card-content="c2" style="display:none">
     <!-- Contenido 2 -->
  </div>
</CardTabs>`}
              >
                <CardTabs
                  id="demo-card-tabs"
                  tabs={[
                    { value: "c1", label: "Borderless", active: true },
                    { value: "c2", label: "Bench 2" },
                    { value: "c3", label: "Bench 3" },
                  ]}
                >
                  <div
                    class="demo-card-content"
                    data-card-content="c1"
                    style="padding: 2rem;"
                  >
                    <Title level={3} variant="section"
                      >Contenido 1: Borderless</Title
                    >
                    <Text>Este es el panel activo inicial.</Text>
                  </div>
                  <div
                    class="demo-card-content"
                    data-card-content="c2"
                    style="display: none; padding: 2rem;"
                  >
                    <Title level={3} variant="section">Contenido 2: Bench</Title
                    >
                    <Text>Segundo panel de contenido.</Text>
                  </div>
                  <div
                    class="demo-card-content"
                    data-card-content="c3"
                    style="display: none; padding: 2rem;"
                  >
                    <Title level={3} variant="section">Contenido 3: Info</Title>
                    <Text>Tercer panel con más información.</Text>
                  </div>
                </CardTabs>
              </ComponentShowcase>
            </div>

            <div id="organisms-quote-modal" class="ds-section__block">
              <ComponentShowcase
                title="QuoteModalHubSpot"
                description="Modal de cotización con embed de HubSpot Meetings. Se abre desde un CTA en la home."
                code={`<QuoteModalHubSpot />
<!-- En la home, un botón abre el modal con id "quote-modal" -->`}
              >
