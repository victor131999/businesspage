  <script>
    function setActiveNav() {
      const hash = window.location.hash.slice(1) || "overview";
      document.querySelectorAll(".ds-sidebar__link").forEach((a) => {
        a.classList.toggle(
          "ds-sidebar__link--active",
          a.getAttribute("data-section") === hash ||
            (hash === "" && a.getAttribute("data-section") === "overview"),
        );
      });
    }
    setActiveNav();
    window.addEventListener("hashchange", setActiveNav);

    // --- Logic for Design System Demos ---

    // Modal Demo
    const openModalBtn = document.getElementById("open-demo-modal");
    const modal = document.getElementById("demo-modal");
    const closeModalBtn = document.getElementById("close-demo-modal"); // button inside 'Entendido'
    const modalOverlay = modal?.querySelector(".ds-modal__overlay");
    const closeX = modal?.querySelector(".ds-modal__close");

    function toggleModal(show: boolean) {
      if (!modal) return;
      if (show) modal.classList.add("is-active");
      else modal.classList.remove("is-active");
    }

    openModalBtn?.addEventListener("click", () => toggleModal(true));
    closeModalBtn?.addEventListener("click", () => toggleModal(false));
    modalOverlay?.addEventListener("click", () => toggleModal(false));
    closeX?.addEventListener("click", () => toggleModal(false));

    // Tabs Demo
    const tabButtons = document.querySelectorAll("button[data-demo-tab]");
    const tabContents = document.querySelectorAll(".demo-tab-content");

    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetVal = btn.getAttribute("data-demo-tab");

        // Update buttons state
        tabButtons.forEach((b) => {
          const isActive = b.getAttribute("data-demo-tab") === targetVal;
          b.classList.toggle("active", isActive);
          b.setAttribute("aria-selected", isActive ? "true" : "false");
        });

        // Update content visibility
        tabContents.forEach((content) => {
          if (content instanceof HTMLElement) {
            content.style.display =
              content.getAttribute("data-tab") === targetVal ? "block" : "none";
          }
        });
      });
    });

    // Underline Tabs Demo
    // We attach logic to all buttons inside [data-tab-group="demo-underline"]
    const underlineTabs = document.querySelectorAll(
      "button[data-tab-group='demo-underline']",
    );
    const underlineContents = document.querySelectorAll(
      ".demo-underline-content",
    );

    underlineTabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        const val = btn.getAttribute("data-tab-value");

        // Update active state
        underlineTabs.forEach((t) => {
          const isActive = t.getAttribute("data-tab-value") === val;
          t.classList.toggle("active", isActive);
          t.setAttribute("aria-selected", isActive ? "true" : "false");

          // Toggle helper indicator if necessary?
          // CSS handles ::after opacity/display based on .active class usually.
          // In our implementation, we rendered the indicator span manually.
          const indicator = t.querySelector(".ds-underline-tabs__indicator");
          if (isActive) {
            if (!indicator) {
              const span = document.createElement("span");
              span.className = "ds-underline-tabs__indicator";
              t.appendChild(span);
            }
          } else {
            if (indicator) indicator.remove();
          }
        });

        // Update content
        underlineContents.forEach((c) => {
          if (c instanceof HTMLElement) {
            c.style.display =
              c.getAttribute("data-content") === val ? "block" : "none";
          }
        });
      });
    });

    // CardTabs Demo
    // We attach logic to all buttons inside [data-tab-group="demo-card-tabs"]
    // Since CardTabs uses UnderlineTabs internally, it outputs buttons with that group name.
    const cardTabButtons = document.querySelectorAll(
      "button[data-tab-group='demo-card-tabs']",
    );
    const cardContents = document.querySelectorAll(".demo-card-content");

    cardTabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const val = btn.getAttribute("data-tab-value");

        // Update active state across all buttons in this group
        cardTabButtons.forEach((t) => {
          const isActive = t.getAttribute("data-tab-value") === val;
          t.classList.toggle("active", isActive);
          t.setAttribute("aria-selected", isActive ? "true" : "false");
        });

        // Update content
        cardContents.forEach((c) => {
          if (c instanceof HTMLElement) {
            c.style.display =
              c.getAttribute("data-card-content") === val ? "block" : "none";
          }
        });
      });
    });
  </script>

