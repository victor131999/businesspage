        description:
          "Each Zelify capability is offered as an independent module. Institutions can integrate only what they need or combine multiple modules to build complete financial flows.",
        modules: {
          auth: {
            name: "Auth",
            desc: "User authentication and access control.",
          },
          identity: {
            name: "Identity",
            desc: "Digital identity management and validation.",
          },
          aml: {
            name: "AML",
            desc: "Risk assessment and regulatory compliance.",
          },
          connect: {
            name: "Connect",
            desc: "Secure connection to bank accounts.",
          },
          cards: { name: "Cards", desc: "Card issuance and processing." },
          payments: {
            name: "Payments",
            desc: "Payment acceptance and processing.",
          },
          transfers: {
            name: "Transfers",
            desc: "Money movement between accounts.",
          },
          tx: { name: "Tx", desc: "Transaction management and traceability." },
          discounts: {
            name: "Discounts",
            desc: "Benefits and promotion rules.",
          },
        },
      },
      composition: {
        title: "Designed to work together",
        description:
          "Zelify modules can be used independently or combined to build complete financial flows, adapted to each institution's needs.",
        example: "Auth + Identity + AML → Access and verification flow",
        note: "Onboarding is not a module or product. It is a flow that can be built by combining capabilities such as Auth, Identity and AML.",
      },
      alaiza: {
        title: "Alaiza AI — intelligence integrated into infrastructure",
        description:
          "Alaiza is Zelify's own artificial intelligence layer, trained internally to enhance each module with analysis, automation and real-time insights.",
        description2:
          "It operates transversally across the entire platform, supporting decision-making, risk detection, flow optimization and operational efficiency.",
        cta: "Learn about Alaiza AI",
      },
      whoWePower: {
        title: "Infrastructure for those building the financial system",
        banks: {
          title: "Banks",
          desc: "Modernize and launch digital products without replacing core systems.",
        },
        fintechs: {
          title: "Fintechs",
          desc: "Build fast, scale securely and comply with regulations from day one.",
        },
        cooperatives: {
          title: "Cooperatives",
          desc: "Digitize operations and enable services centered on their members.",
        },
        institutions: {
          title: "Financial Institutions",
          desc: "Integrate financial capabilities on existing infrastructures.",
        },
      },
      tokens: {
        title: "A token-based consumption model",
        description:
          "Zelify operates under a pay-as-you-go model. Each module consumes tokens based on actual usage, allowing you to pay only for the infrastructure you use.",
        description2:
          "This model eliminates rigid plans and allows flexible scaling as the business grows.",
      },
      pricing: {
        title: "Pricing that scales with your business",
        description:
          "Zelify pricing is defined based on token consumption, integrated modules and the specific needs of each institution.",
        cta: "Request a quote",
      },
      footer: {
        products: "Products",
        about: "About Zelify",
        developers: "Developers",
        company: "Company",
        blog: "Blog",
        careers: "Careers",
        contact: "Contact",
        documentation: "Documentation",
        apis: "APIs",
      },
    },
    es: {
      hero: {
        title:
          "El nuevo estándar modular para construir productos financieros empresariales",
        description:
          "Zelify provee infraestructura financiera y de cumplimiento que permite a instituciones construir, integrar y escalar productos financieros modernos mediante APIs seguras, flexibles y componibles.",
        ctaTalk: "Habla con nuestro equipo",
      },
      capabilities: {
        title: "Capacidades financieras modulares",
        description:
          "Cada capacidad de Zelify se ofrece como un módulo independiente. Las instituciones pueden integrar solo lo que necesitan o combinar múltiples módulos para construir flujos financieros completos.",
        modules: {
          auth: {
            name: "Auth",
            desc: "Autenticación y control de acceso de usuarios.",
          },
          identity: {
            name: "Identity",
            desc: "Gestión y validación de identidad digital.",
          },
          aml: {
            name: "AML",
            desc: "Evaluación de riesgo y cumplimiento regulatorio.",
          },
          connect: {
            name: "Connect",
            desc: "Conexión segura a cuentas bancarias.",
          },
          cards: {
            name: "Cards",
            desc: "Emisión y procesamiento de tarjetas.",
          },
          payments: {
            name: "Payments",
            desc: "Aceptación y procesamiento de pagos.",
          },
          transfers: {
            name: "Transfers",
            desc: "Movimiento de dinero entre cuentas.",
          },
          tx: { name: "Tx", desc: "Gestión y trazabilidad de transacciones." },
          discounts: {
            name: "Discounts",
            desc: "Reglas de beneficios y promociones.",
          },
        },
      },
      composition: {
        title: "Diseñados para funcionar juntos",
        description:
          "Los módulos de Zelify pueden utilizarse de forma independiente o combinarse para construir flujos financieros completos, adaptados a las necesidades de cada institución.",
        example: "Auth + Identity + AML → Flujo de acceso y verificación",
        note: "El onboarding no es un módulo ni un producto. Es un flujo que puede construirse combinando capacidades como Auth, Identity y AML.",
      },
      alaiza: {
        title: "Alaiza AI — inteligencia integrada en la infraestructura",
        description:
          "Alaiza es la capa de inteligencia artificial propia de Zelify, entrenada internamente para potenciar cada módulo con análisis, automatización e insights en tiempo real.",
        description2:
          "Opera de forma transversal en toda la plataforma, apoyando la toma de decisiones, detección de riesgos, optimización de flujos y eficiencia operativa.",
        cta: "Conocer Alaiza AI",
      },
      whoWePower: {
        title: "Infraestructura para quienes construyen el sistema financiero",
        banks: {
          title: "Bancos",
          desc: "Modernizan y lanzan productos digitales sin reemplazar sistemas core.",
        },
        fintechs: {
          title: "Fintechs",
          desc: "Construyen rápido, escalan con seguridad y cumplen regulación desde el inicio.",
        },
        cooperatives: {
          title: "Cooperativas",
          desc: "Digitalizan operaciones y habilitan servicios centrados en sus miembros.",
        },
        institutions: {
          title: "Instituciones financieras",
          desc: "Integran capacidades financieras sobre infraestructuras existentes.",
        },
      },
      tokens: {
        title: "Un modelo de consumo basado en tokens",
        description:
          "Zelify opera bajo un modelo paga‑lo‑que‑usas. Cada módulo consume tokens según su uso real, permitiendo pagar únicamente por la infraestructura que se utiliza.",
        description2:
          "Este modelo elimina planes rígidos y permite escalar de forma flexible conforme crece el negocio.",
      },
      pricing: {
        title: "Pricing que escala con tu negocio",
        description:
          "El pricing de Zelify se define en función del consumo de tokens, los módulos integrados y las necesidades específicas de cada institución.",
        cta: "Solicitar cotización",
      },
      footer: {
        products: "Productos",
        about: "Sobre Zelify",
        developers: "Desarrolladores",
        company: "Compañía",
        blog: "Blog",
        careers: "Carreras",
        contact: "Contacto",
        documentation: "Documentación",
        apis: "APIs",
      },
    },
  };

  function updateContent(rawLang: string) {
    const lang = rawLang.toLowerCase() as "en" | "es";
    const content = translations[lang] || translations.en;

    // Hero
    const heroTitle = document.querySelector(".hero-title");
    const heroDescription = document.querySelector(".hero-description");
    const heroCta = document.querySelector(".hero-cta");
    if (heroTitle) heroTitle.textContent = content.hero.title;
    if (heroDescription) heroDescription.textContent = content.hero.description;
    if (heroCta) heroCta.textContent = content.hero.ctaTalk;

    // Capabilities
    const capTitle = document.querySelector(".capabilities-title");
    const capDesc = document.querySelector(".capabilities-description");
    if (capTitle) capTitle.textContent = content.capabilities.title;
    if (capDesc) capDesc.textContent = content.capabilities.description;

    // Modules
    document.querySelectorAll(".module-name").forEach((el, idx) => {
      const keys = [
        "auth",
        "identity",
        "aml",
        "connect",
        "cards",
        "payments",
        "transfers",
        "tx",
        "discounts",
      ];
      if (keys[idx]) {
        const module =
          content.capabilities.modules[
            keys[idx] as keyof typeof content.capabilities.modules
          ];
        if (module) el.textContent = module.name;
      }
    });

    document.querySelectorAll(".module-desc").forEach((el, idx) => {
      const keys = [
        "auth",
        "identity",
        "aml",
        "connect",
        "cards",
        "payments",
        "transfers",
        "tx",
        "discounts",
      ];
      if (keys[idx]) {
        const module =
          content.capabilities.modules[
            keys[idx] as keyof typeof content.capabilities.modules
          ];
        if (module) el.textContent = module.desc;
      }
    });

    // Composition
    const compTitle = document.querySelector(".composition-title");
    const compDesc = document.querySelector(".composition-description");
    const compExample = document.querySelector(".composition-example");
    const compNote = document.querySelector(".composition-note");
    if (compTitle) compTitle.textContent = content.composition.title;
    if (compDesc) compDesc.textContent = content.composition.description;
    if (compExample) compExample.textContent = content.composition.example;
    if (compNote) compNote.textContent = content.composition.note;

    // Alaiza
    const alaizaTitle = document.querySelector(".alaiza-title");
    const alaizaDesc = document.querySelector(".alaiza-description");
    const alaizaDesc2 = document.querySelector(".alaiza-description2");
    const alaizaCta = document.querySelector(".alaiza-cta");
    if (alaizaTitle) alaizaTitle.textContent = content.alaiza.title;
    if (alaizaDesc) alaizaDesc.textContent = content.alaiza.description;
    if (alaizaDesc2) alaizaDesc2.textContent = content.alaiza.description2;
    if (alaizaCta) alaizaCta.textContent = content.alaiza.cta;

    // Who We Power
    const whoTitle = document.querySelector(".who-title");
    if (whoTitle) whoTitle.textContent = content.whoWePower.title;

    const whoCards = document.querySelectorAll(".who-card");
    whoCards.forEach((card, idx) => {
      const keys: Array<keyof typeof content.whoWePower> = [
        "banks",
        "fintechs",
        "cooperatives",
        "institutions",
      ];
      if (keys[idx]) {
        const key = keys[idx];
        const data = content.whoWePower[key];
        const title = card.querySelector(".who-card-title");
        const desc = card.querySelector(".who-card-desc");
        if (title && data && typeof data === "object" && "title" in data) {
          title.textContent = data.title;
        }
        if (desc && data && typeof data === "object" && "desc" in data) {
          desc.textContent = data.desc;
        }
      }
    });

    // Tokens
    const tokensTitle = document.querySelector(".tokens-title");
    const tokensDesc = document.querySelector(".tokens-description");
    const tokensDesc2 = document.querySelector(".tokens-description2");
    if (tokensTitle) tokensTitle.textContent = content.tokens.title;
    if (tokensDesc) tokensDesc.textContent = content.tokens.description;
    if (tokensDesc2) tokensDesc2.textContent = content.tokens.description2;

    // Pricing
    const pricingTitle = document.querySelector(".pricing-title");
    const pricingDesc = document.querySelector(".pricing-description");
    const pricingCta = document.querySelector(".pricing-cta");
    if (pricingTitle) pricingTitle.textContent = content.pricing.title;
    if (pricingDesc) pricingDesc.textContent = content.pricing.description;
    if (pricingCta) pricingCta.textContent = content.pricing.cta;

    // Footer
    const footerProducts = document.querySelector(".footer-products-title");
    const footerAbout = document.querySelector(".footer-about-title");
    const footerDevelopers = document.querySelector(".footer-developers-title");
    if (footerProducts) footerProducts.textContent = content.footer.products;
    if (footerAbout) footerAbout.textContent = content.footer.about;
    if (footerDevelopers)
      footerDevelopers.textContent = content.footer.developers;
  }

  // Escuchar cambios de idioma
  window.addEventListener("ui:languagechange", ((event: Event) => {
    const customEvent = event as CustomEvent<{ language: string }>;
    if (customEvent.detail?.language) {
      updateContent(customEvent.detail.language);
    }
  }) as EventListener);

  // Aplicar traducciones iniciales
  document.addEventListener("DOMContentLoaded", () => {
    const storedLang = localStorage.getItem("ui-language") || "EN";
    updateContent(storedLang);
  });
</script>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/png"
      href="https://flowchart-diagrams-zelify.s3.us-east-1.amazonaws.com/ISO-ZELIFY-2025.png"
    />
    <title>Zelify — Infrastructure for Financial Products</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/hover.css/2.3.1/css/hover-min.css"
    />
  </head>

  <body class="demo-page">
    <Navbar3 />
    <section class="welcome-section">
      <div class="welcome-content">
        <h1 class="welcome-title">
          Construye la banca del futuro, en una integración.
          <span class="welcome-title-line">Potenciada por IA.</span>
        </h1>
        <p class="welcome-subtitle">
          Digitalizamos servicios a instituciones financieras, construyendo
          stacks neobancarios con una sola línea de código
        </p>
        <div class="welcome-cta">
          <form
            class="welcome-input-group"
            action="#"
            aria-label="Solicitar cotización"
          >
            <input
              class="welcome-input"
              type="email"
              name="email"
              placeholder="ingresa tu correo"
              aria-label="Ingresa tu correo"
            />
            <button class="welcome-quote-button" type="submit">cotizar</button>
          </form>
          <a class="welcome-demo-button" href="/demo">demo</a>
        </div>
      </div>
    </section>
    <section class="product-showcase">
      <div class="product-showcase__grid" data-showcase>
        <div class="product-showcase__overlay-card">
          <div class="product-showcase__inner-card" data-product-card>
            <div class="product-card-wrapper" data-card-id="auth">
              <AuthProd />
            </div>
            <div
              class="product-card-wrapper"
              data-card-id="identity"
              style="display: none;"
            >
              <IdentityProd />
            </div>
            <div
              class="product-card-wrapper"
              data-card-id="aml"
              style="display: none;"
            >
              <AmlProd />
            </div>
            <div
              class="product-card-wrapper"
              data-card-id="connect"
              style="display: none;"
            >
              <ConnectProd />
            </div>
            <div
              class="product-card-wrapper"
              data-card-id="cards"
              style="display: none;"
            >
              <CardsProd />
            </div>
            <div
              class="product-card-wrapper"
              data-card-id="payments"
              style="display: none;"
            >
              <PaymentsProd />
            </div>
            <div
              class="product-card-wrapper"
              data-card-id="transfers"
              style="display: none;"
            >
              <TransfersProd />
            </div>
            <div
              class="product-card-wrapper"
              data-card-id="tx"
              style="display: none;"
            >
              <TxProd />
            </div>
            <div
              class="product-card-wrapper"
              data-card-id="discounts"
              style="display: none;"
            >
              <DiscountsProd />
            </div>
            <div
              class="product-card-wrapper"
              data-card-id="alaiza"
              style="display: none;"
            >
              <AlaizaProd />
            </div>
          </div>
          <button
            class="product-showcase__play-button"
            type="button"
            aria-label="Reproducir"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M8 5V19L19 12L8 5Z" fill="#213f8c"></path>
            </svg>
          </button>
        </div>
        <aside class="product-showcase__menu">
          <nav class="product-showcase__nav" aria-label="Módulos">
            {
              modulesList.map((module, index) => (
                <div
                  class={`product-showcase__item ${index === 0 ? "is-active" : ""}`}
                  data-ps-item={module.id}
                >
                  <button class="product-showcase__nav-item" type="button">
                    {module.label}
                  </button>
                  <div class="product-showcase__panel" data-ps-panel>
                    <div class="product-showcase__panel-inner">
                      <div class="product-showcase__panel-left">
                        <span class="product-showcase__eyebrow" data-ps-eyebrow>
                          {module.eyebrow}
                        </span>
                        <h2 class="product-showcase__title" data-ps-title>
                          {module.title}
                        </h2>
                        <a
                          class="product-showcase__cta"
                          href={module.href}
                          data-ps-cta
                        >
                          {module.cta}
                        </a>
                      </div>
                      <p class="product-showcase__copy" data-ps-copy>
                        {module.copy}
                      </p>
                    </div>
                  </div>
                </div>
              ))
            }
          </nav>
        </aside>
      </div>
    </section>

    <section class="how-it-works-section">
      <div class="how-it-works-content">
        <div class="how-it-works-left">
          <h2 class="how-it-works-title">¿Cómo Funciona Zelify?</h2>
          <div class="how-it-works-separator"></div>
          <p class="how-it-works-description">
            Zelify integra en una sola plataforma digital: autenticación y
            validación de identidad, cumplimiento AML, digitalización de
            cuentas, emisión y procesamiento de tarjetas, transferencias locales
            e internacionales, pagos múltiples, programas de descuentos y
            cupones.
          </p>
          <a href="/demo" class="how-it-works-demo-button">demo</a>
        </div>
